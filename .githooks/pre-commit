#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

# ─── Trailer Check (BLOCKING) ──────────────────────────────────────
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

BLOCKED_REGEX=$(blocked_regex)

VIOLATIONS=""
while IFS= read -r file; do
  # The hook directory defines the check itself, so it is not subject to it.
  if [[ "$file" == .githooks/* ]]; then continue; fi
  if [ -f "$file" ]; then
    MATCHES=$(git diff --cached -- "$file" | grep -iE "$BLOCKED_REGEX" || true)
    if [ -n "$MATCHES" ]; then
      VIOLATIONS="${VIOLATIONS}\n  ✗ ${file}:\n$(echo "$MATCHES" | head -3 | sed 's/^/      /')\n"
    fi
  fi
done <<< "$STAGED_FILES"

if [ -n "$VIOLATIONS" ]; then
  echo ""
  echo "╔══════════════════════════════════════════════╗"
  echo "║  BLOCKED: disallowed trailer in staged       ║"
  echo "║  files. Remove it before committing.         ║"
  echo "╚══════════════════════════════════════════════╝"
  echo -e "$VIOLATIONS"
  exit 1
fi

# ─── Hardcoded Secrets Check (BLOCKING) ────────────────────────────
SECRET_PATTERNS='(password|passwd|api[_-]?key|secret[_-]?key|access[_-]?token|private[_-]?key)\s*[:=]\s*["\x27][^\s]{8,}'

SECRET_VIOLATIONS=""
while IFS= read -r file; do
  if [[ "$file" == .githooks/* ]]; then continue; fi
  if [ -f "$file" ]; then
    MATCHES=$(git diff --cached -- "$file" | grep -iE "$SECRET_PATTERNS" || true)
    if [ -n "$MATCHES" ]; then
      SECRET_VIOLATIONS="${SECRET_VIOLATIONS}\n  ✗ ${file}:\n$(echo "$MATCHES" | head -3 | sed 's/^/      /')\n"
    fi
  fi
done <<< "$STAGED_FILES"

if [ -n "$SECRET_VIOLATIONS" ]; then
  echo ""
  echo "╔══════════════════════════════════════════════╗"
  echo "║  BLOCKED: Possible hardcoded secrets found.  ║"
  echo "║  Remove or use environment variables.        ║"
  echo "╚══════════════════════════════════════════════╝"
  echo -e "$SECRET_VIOLATIONS"
  exit 1
fi

# ─── TODO/FIXME Warning (NON-BLOCKING) ────────────────────────────
TODO_FOUND=""
while IFS= read -r file; do
  if [ -f "$file" ]; then
    MATCHES=$(git diff --cached -- "$file" | grep -nE '^\+.*\b(TODO|FIXME|HACK|XXX)\b' || true)
    if [ -n "$MATCHES" ]; then
      TODO_FOUND="${TODO_FOUND}\n  ⚠ ${file}"
    fi
  fi
done <<< "$STAGED_FILES"

if [ -n "$TODO_FOUND" ]; then
  echo ""
  echo "⚠ WARNING: TODO/FIXME comments found (non-blocking):"
  echo -e "$TODO_FOUND"
  echo ""
fi

# ─── Debug Print Warning (NON-BLOCKING, .py only) ─────────────────
PRINT_FOUND=""
while IFS= read -r file; do
  if [[ "$file" == *.py ]] && [ -f "$file" ]; then
    MATCHES=$(git diff --cached -- "$file" | grep -nE '^\+.*\bprint\(' || true)
    if [ -n "$MATCHES" ]; then
      PRINT_FOUND="${PRINT_FOUND}\n  ⚠ ${file}"
    fi
  fi
done <<< "$STAGED_FILES"

if [ -n "$PRINT_FOUND" ]; then
  echo ""
  echo "⚠ WARNING: print() statements in Python files (non-blocking):"
  echo -e "$PRINT_FOUND"
  echo ""
fi

exit 0
