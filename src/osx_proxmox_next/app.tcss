/* Every colour is a variable of the osx-next theme (theme.py). */

Screen { background: $background; color: $foreground; }

.hidden { display: none; }
.blank { height: 1; }
.error { color: $error; }
.muted { color: $muted; }

/* ---- one-row controls ------------------------------------------------ */

Button {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 2;
    margin: 0;
    background: $raised;
    color: $foreground;
    text-style: none;
}
Button:hover { background: $edge; }
Button:focus { background: $edge; text-style: bold underline; }
Button.primary { background: $accent; color: $on-accent; text-style: bold; }
Button.primary:hover { background: $accent; }
Button.primary:focus { background: $accent; text-style: bold underline; }
Button.danger { background: $error; color: $background; text-style: bold; }
Button.danger:focus { background: $error; text-style: bold underline; }
Button:disabled { background: $surface; color: $muted; text-style: none; opacity: 1; }

Input {
    height: 1;
    border: none;
    padding: 0 1;
    background: $raised;
    color: $foreground;
}
Input:focus { border: none; background: $raised; text-style: underline; }
Input.-invalid, Input.invalid { background: $raised; color: $error; }
Input > .input--placeholder { color: $muted; }
Input > .input--cursor { background: $accent; color: $on-accent; }

Checkbox {
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $foreground;
}
Checkbox:focus { background: $raised; border: none; }
Checkbox > .toggle--button { color: $raised; background: $raised; }
Checkbox.-on > .toggle--button { color: $accent; background: $raised; }

/* ---- bars ------------------------------------------------------------ */

TopBar { background: $surface; }
KeyBar { background: $surface; }

/* ---- Home ------------------------------------------------------------ */

#home { height: 1fr; padding: 1 2 0 2; }
#home-head { height: 1; margin-bottom: 1; }
#home-title { width: 1fr; text-style: bold; }
#home-sub { width: auto; color: $muted; }
#cards { height: 1fr; min-height: 3; layout: grid; grid-size: 1; grid-gutter: 0 2; grid-columns: 30; grid-rows: auto; overflow-y: auto; }
#cards.compact { grid-rows: 1; grid-gutter: 0; grid-columns: 1fr; }
#new-strip { height: 3; margin-top: 1; border: dashed $edge; padding: 0 2; }
#new-strip:focus { border: dashed $accent; background: $surface; }
#new-strip.empty { height: 5; }
#resume { height: 1; margin-top: 1; }
#stuck { height: 1; display: none; }
#selected-line { dock: bottom; height: 1; }

VmCard {
    width: 30;
    height: auto;
    border: round $edge;
    padding: 0;
    overflow: hidden hidden;
}
VmCard:focus { border: round $accent; background: $surface; }
VmCard.compact { width: 1fr; height: 1; border: none; padding: 0 1; }
VmCard.compact:focus { background: $raised; border: none; border-left: heavy $accent; padding: 0 1 0 0; }
VmCard .thumb { height: 8; margin-bottom: 1; }
VmCard .card-head { height: 1; padding-left: 1; }
VmCard .card-status { height: 1; padding-left: 1; }
VmCard.compact .card-status { width: 1fr; }

/* ---- VM view --------------------------------------------------------- */

#vm-view { height: 1fr; padding: 1 2 0 2; }
#vm-view-head { height: 1; margin-bottom: 1; }
#vm-stuck { height: 1; display: none; }
#vm-view-title { width: 1fr; text-style: bold; }
#vm-view-status { width: auto; }
#vm-view-body { height: 1fr; }
#vm-view-screen { width: 1fr; height: 1fr; }
#vm-live { border: solid $edge; max-height: 100%; }
#vm-live-caption { height: 1; }
#vm-facts { width: 34; margin-left: 3; padding-left: 3; border-left: solid $edge; }

/* ---- New Mac --------------------------------------------------------- */

#new-mac { height: 1fr; padding: 1 1 0 1; }
#new-head { height: 1; padding: 0 1; margin-bottom: 1; }
#new-title { width: auto; text-style: bold; margin-right: 1; }
#new-sub { width: 1fr; color: $muted; }
#new-cols { height: 1fr; }
#new-form { width: 1fr; height: 100%; padding-right: 1; }
#new-form > ChoiceRow, #new-form > FieldRow, #new-form > ExpandRow { margin-bottom: 1; }
#new-mac.short #new-form > ChoiceRow, NewMacScreen.short #new-form > ChoiceRow { margin-bottom: 0; }
NewMacScreen.short #new-form > FieldRow { margin-bottom: 0; }
NewMacScreen.short #new-form > ExpandRow { margin-bottom: 0; }
NewMacScreen.more-open #new-form > ChoiceRow { margin-bottom: 0; }
NewMacScreen.more-open #new-form > FieldRow { margin-bottom: 0; }
NewMacScreen.more-open #new-form > ExpandRow { margin-bottom: 0; }
#custom-box, #more-box { height: auto; display: none; }
#new-side { width: 32; margin-left: 1; padding-left: 2; border-left: solid $edge; height: 100%; }
#new-side .side-title { color: $muted; height: 1; margin-bottom: 1; }
#new-side CapacityBar { margin-bottom: 1; }
NewMacScreen.short #new-side CapacityBar { margin-bottom: 0; }
#after { height: auto; }
NewMacScreen.narrow #new-side { width: 28; padding-left: 1; }
#errors { height: 2; padding: 0 2; }
#new-action { height: 1; padding: 0 2; }
#new-note { width: 1fr; color: $muted; }
#new-action Button { dock: right; }

ChoiceRow, ExpandRow, ActionRow {
    border-left: blank;
}
ChoiceRow:focus, ExpandRow:focus, ActionRow:focus {
    background: $raised;
    border-left: heavy $accent;
}
FieldRow:focus-within { background: $raised; border-left: heavy $accent; }
FieldRow { border-left: blank; }

/* ---- Build ----------------------------------------------------------- */

#build { height: 1fr; padding: 1 2 0 2; }
#build-head { height: 1; margin-bottom: 1; }
#build-title { width: 1fr; }
#build-elapsed { width: auto; }
#build-cols { height: 1fr; }
#build-left { width: 36; height: 100%; margin-right: 3; }
#timeline { height: auto; }
#latest { height: auto; margin-top: 1; }
#build-right { width: 1fr; height: 100%; }
#build-live { border: solid $edge; max-height: 100%; }
#build-caption { height: 1; }
#build-note { height: auto; min-height: 1; margin-top: 1; }
#full-log { height: 1fr; padding: 0 1; background: $background; }
#zoom-live { height: 1fr; }

/* ---- Host check ------------------------------------------------------ */

#hc { height: 1fr; padding: 1 2 0 2; }
#hc-head { height: 1; margin-bottom: 1; }
#hc-title { width: 1fr; }
#hc-count { width: auto; }
#hc-body { height: 1fr; }
#fix-log { height: 8; border: solid $edge; margin-bottom: 1; background: $surface; }
.hc-item { height: 1; }
.hc-why { height: auto; padding-left: 2; }
.hc-code { height: auto; background: $surface; border: solid $edge; padding: 0 2; margin: 1 0 0 2; }
.hc-fixrow { height: 1; }
.hc-fixnote { width: 1fr; }
.hc-fixrow Button { margin-left: 2; }
PassedSummary:focus { background: $raised; }

/* ---- dialogs --------------------------------------------------------- */

ModalScreen { align: center middle; background: $background 70%; }
.dialog {
    width: 64;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: solid $edge;
    padding: 1 3;
}
.dialog.danger { border: solid $error; }
.dialog-title { height: 1; text-style: bold; }
.dialog-line { height: auto; }
.dialog-line.mono { color: $foreground; }
.dialog-buttons { height: 1; align-horizontal: right; }
.dialog-buttons Button { margin-left: 2; }
.dialog-field { height: 1; }
.dialog-field Static { width: auto; }
.dialog-field Input { width: 10; }
#help-box { width: 66; }
#help-scroll { height: auto; max-height: 20; }
#e-note, #remove-log { height: auto; color: $muted; }

/* ---- Graphics card ---------------------------------------------------- */

#gpu { height: 1fr; padding: 1 2 0 2; }
#g-title, #g-run-title { height: 1; margin-bottom: 1; }
.g-notice { height: auto; margin-bottom: 1; }
#g-cols { height: 1fr; }
#g-form { width: 1fr; height: 100%; padding-right: 1; }
#g-form > ChoiceRow { margin-bottom: 1; }
#g-reason { height: auto; }
#g-safe { height: auto; margin-top: 1; }
#g-side { width: 34; margin-left: 1; padding-left: 2; border-left: solid $edge; height: 100%; }
#g-side .side-title { color: $muted; height: 1; margin-bottom: 1; }
GpuScreen.narrow #g-side { width: 30; padding-left: 1; margin-left: 0; }
#g-need { margin-bottom: 1; }
#g-part { height: auto; }
#g-result { height: auto; }
#g-action { height: 1; }
#g-note { width: 1fr; color: $muted; }
#g-action Button { dock: right; }
#g-run-cols { height: 1fr; }
#g-timeline { width: 40; height: auto; margin-right: 3; }
#g-box { width: 1fr; height: auto; max-height: 100%; border: solid $accent; padding: 1 2; }
#g-box.warn { border: solid $warning; }
#g-box.fail { border: solid $error; }
#g-box-title { height: 1; }
#g-box-text { height: auto; margin: 1 0; }
#g-box-scroll { height: auto; max-height: 14; }
#g-box-buttons { height: 1; align-horizontal: right; margin-top: 1; }
#g-box-buttons Button { margin-left: 2; }
#g-run-note { height: auto; dock: bottom; margin-bottom: 1; }
#g-bios-cols { height: 1fr; }
#g-bios-left { width: 1fr; height: 100%; padding-right: 2; }
#g-bios-qr { width: 30; height: 100%; margin-left: 1; padding-left: 3; border-left: solid $edge; }
#g-bios-code { height: auto; width: auto; }
#g-bios-caption { height: auto; }
#g-bios-foot { height: 1; dock: bottom; align-horizontal: right; }
#g-note.bios-note { dock: bottom; height: 1; margin-bottom: 1; }
#g-result.when-text { display: none; }
#g-bios-foot Button { margin-left: 2; }
GpuScreen #g-pick-info { height: auto; margin-top: 1; }
#g-typed { width: 20; }
#changes-box { width: 92%; height: 80%; }
#changes-scroll { height: 1fr; overflow-x: hidden; }
#changes-text { width: 100%; }

/* ---- Before you continue --------------------------------------------- */

#before-box { width: 76; border: solid $warning; }
#before-head { height: 1; }
#before-head .dialog-title { width: 1fr; }
#before-head .before-once { width: auto; }
.before-block { height: auto; margin-bottom: 1; }
#before-notice-title { height: 1; }
#before-notice { height: 6; }
#before-more { height: 1; }
#before-ack-label { height: auto; margin-top: 1; }
.before-phrase { height: 1; margin-top: 1; }
.before-label { width: auto; margin-right: 1; }
.before-phrase Input { width: 20; }
#before-box.tight .blank { display: none; }
#before-box.tight .before-block { margin-bottom: 0; }
#before-box.tight #before-ack-label, #before-box.tight .before-phrase { margin-top: 0; }
