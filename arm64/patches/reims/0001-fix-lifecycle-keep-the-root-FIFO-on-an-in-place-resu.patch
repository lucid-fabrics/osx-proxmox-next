From 81e0125b5594639caff4a3fc7e38446e00cb499b Mon Sep 17 00:00:00 2001
From: wmehanna <wassimmehanna@gmail.com>
Date: Thu, 19 Nov 2026 21:50:00 -0500
Subject: [PATCH] fix(lifecycle): keep the root FIFO on an in-place resume,
 drain root first

A wake after a save resumes the device in place. The root page store tore
the live root down and cleared the root FIFO's enabled, so the root FIFO
and the stamp memory were not made again while the children restarted:
their first barrier or stamp signal died (device.stamp.read_without_memory,
device.stamp.write_without_memory). Put the blob's enabled back after the
teardown.

finish_suspend drained the children before the root, so a DefineChildFifo
the root was still running could start a child that outlived the suspend.
Drain the root first, then quiesce, wake and drain every child, as pause
does.
---
 .../reims-vgpu-core/src/device/lifecycle.rs   | 127 ++++++++++++++++--
 1 file changed, 118 insertions(+), 9 deletions(-)

diff --git a/crates/reims-vgpu-core/src/device/lifecycle.rs b/crates/reims-vgpu-core/src/device/lifecycle.rs
index 3d095095..b8979dd0 100644
--- a/crates/reims-vgpu-core/src/device/lifecycle.rs
+++ b/crates/reims-vgpu-core/src/device/lifecycle.rs
@@ -168,6 +168,22 @@ impl<P: Platform> DeviceCore<P> {
         );
         self.run_state.store(RunState::Suspended);
         self.signal_fifos();
+        // The root first, as `pause` does (P93). `will_suspend` only sets the root's quiesced
+        // flag, so its thread can still be inside a command: a DefineChildFifo then makes and
+        // starts a child after the children were quiesced (a start clears the flag), or after
+        // a children-first drain passed its slot. That child's thread ran on past the suspend
+        // and died at its next barrier, the stamp memory being gone
+        // (`device.stamp.read_without_memory`). Once the root thread has exited no child can
+        // appear, so every child is quiesced again, woken, then drained.
+        if let Some(root) = self.current_root_fifo() {
+            root.drain();
+        }
+        for index in 1..CHILD_FIFO_SLOTS {
+            if let Some(child) = self.current_child_fifo(index) {
+                child.quiesce();
+            }
+        }
+        self.signal_fifos();
         for index in 1..CHILD_FIFO_SLOTS {
             if let Some(fifo) = self.current_child_fifo(index) {
                 fifo.drain();
@@ -181,9 +197,6 @@ impl<P: Platform> DeviceCore<P> {
                 drop(slot);
             }
         }
-        if let Some(root) = self.current_root_fifo() {
-            root.drain();
-        }
         {
             let mut tasks = self.tasks.lock();
             // A real pool and a holder around the walk, under the task lock. What the tasks'
@@ -439,8 +452,8 @@ impl<P: Platform> DeviceCore<P> {
     /// the display pages the root node names now; then starts the FIFOs and interrupts once.
     ///
     /// A live root is torn down by the root page's store, which clears the root FIFO's
-    /// `enabled`: resuming in place loses the root FIFO
-    /// (`tests::did_resume_fifos::in_place_loses_root_fifo`). Tasks are rebuilt from the root
+    /// `enabled`; the blob's `enabled` is put back after it, so resuming in place keeps the root
+    /// FIFO (`tests::did_resume_fifos::in_place_keeps_root_fifo`, P93). Tasks are rebuilt from the root
     /// words as they are now (`tests::did_resume_rebuild::rebuilds_tasks_and_displays`).
     pub fn did_resume(self: &Arc<Self>, hold: Hold<'_>) {
         log::info!("device resume continues");
@@ -466,7 +479,19 @@ impl<P: Platform> DeviceCore<P> {
             .atomics()
             .root_page_number
             .load(Ordering::Relaxed);
+        // The root FIFO's `enabled` as `will_resume` stored it from the blob. Resuming in place
+        // (the host's wake after a save, on a device whose root node `finish_suspend` kept)
+        // tears the live root down at the root page's store, which clears `enabled`: the root
+        // FIFO was then not made again, the stamp memory stayed NULL, and the children came back
+        // without it, so the first barrier or stamp a child met was the device's death
+        // (`device.stamp.read_without_memory`, `device.stamp.write_without_memory`; P93). The
+        // blob's value is put back after the teardown, so an in-place resume rebuilds what a
+        // resume on a fresh device rebuilds.
+        let fifo_enabled = self.root_fifo.atomics().enabled();
         self.set_root_page(hold, root_page_number);
+        if fifo_enabled != 0 && self.root_fifo.atomics().enabled() == 0 {
+            self.root_fifo.lock().fifo.enabled = fifo_enabled;
+        }
         let root_node = self.root_node.atomics().root_node();
         if let Some(root_node) = root_node {
             self.resume_root_fifo();
@@ -854,6 +879,61 @@ mod tests {
         }
     }
 
+    mod finish_suspend_order {
+        use super::*;
+
+        /// A DefineChildFifo the root FIFO is running when the suspend begins makes and starts
+        /// its child late (here: behind a held FIFO queue, released while `finish_suspend`
+        /// drains). The child is still quiesced, drained and dropped before the stamp memory
+        /// goes, so no child thread runs on past the suspend (P93: one did, and died at its
+        /// next barrier with `device.stamp.read_without_memory`)
+        #[test]
+        #[allow(clippy::disallowed_methods)] // test scaffolding: threads and real-time sleeps
+        fn a_child_defined_during_the_suspend_is_drained() {
+            use crate::device::root::rig::rig;
+            use std::time::Duration;
+            let r = rig();
+            let node = APV_PAGE_SIZE + 0x400;
+            r.set_ram_u32(node + 0x0c, 1); // child 1: stamp index 1
+            r.set_ram_u32(node + 0x10, 5); // its page list page
+            r.set_ram_u32(5 * APV_PAGE_SIZE, 6); // page list: ring page 6
+            r.with_root_fifo(1, 2);
+            // The FIFO queue held, so the root's define waits in it.
+            let (held_tx, held_rx) = std::sync::mpsc::channel::<()>();
+            let (go_tx, go_rx) = std::sync::mpsc::channel::<()>();
+            let d = r.device.clone();
+            let holder = std::thread::spawn(move || {
+                d.fifo_queue.sync(move || {
+                    held_tx.send(()).unwrap();
+                    let _ = go_rx.recv();
+                });
+            });
+            held_rx.recv().unwrap();
+            // DefineChildFifo(1) at the head of the root ring (page 2 + start 0x400).
+            let ring = 2 * APV_PAGE_SIZE + 0x400;
+            r.set_ram_u32(ring, 48); // command 48, no barriers
+            r.set_ram_u32(ring + 4, 16); // length: header and the id
+            r.set_ram_u32(ring + 8, 1); // stamp value
+            r.set_ram_u32(ring + 12, 1); // child id 1
+            r.platform.fake_vm().sync();
+            r.device.set_fifo_written(16);
+            std::thread::sleep(Duration::from_millis(100));
+            r.device.will_suspend();
+            let release = std::thread::spawn(move || {
+                std::thread::sleep(Duration::from_millis(200));
+                go_tx.send(()).unwrap();
+            });
+            assert!(r.device.finish_suspend().is_some());
+            release.join().unwrap();
+            holder.join().unwrap();
+            assert!(r.device.stamp_memory.lock().is_none());
+            assert!(
+                r.device.child_fifos.lock().iter().all(Option::is_none),
+                "a child outlived the suspend"
+            );
+        }
+    }
+
     mod serialize_suspend_state {
         use super::*;
 
@@ -1345,9 +1425,10 @@ mod tests {
         }
 
         /// Resuming in place: the root page's store tears the live root down, which clears the
-        /// root FIFO's `enabled`, so the root FIFO is not recreated
+        /// root FIFO's `enabled`; the blob's value is put back, so the root FIFO and the stamp
+        /// memory are made again (P93; the old behaviour left both NULL)
         #[test]
-        fn in_place_loses_root_fifo() {
+        fn in_place_keeps_root_fifo() {
             let t = dev().with_root_page();
             t.device.set_fifo_base_page(2);
             t.device.set_fifo_length(0x4000);
@@ -1355,9 +1436,37 @@ mod tests {
             t.device.enable_fifo();
             assert!(t.device.root_fifo.atomics().root_fifo().is_some());
             t.device.did_resume(Hold::NONE);
-            assert!(t.device.root_fifo.atomics().root_fifo().is_none());
-            assert_eq!(t.device.root_fifo.atomics().enabled(), 0);
+            assert!(t.device.root_fifo.atomics().root_fifo().is_some());
+            assert_eq!(t.device.root_fifo.atomics().enabled(), 1);
+            assert!(t.device.stamp_memory.lock().is_some());
             assert_eq!(t.device.run_state.load(), RunState::Running);
+            t.device.stop(Hold::NONE);
+        }
+
+        /// The host's wake after a save (QEMU's `post_save`): suspend, then resume the same
+        /// device from its own blob. The root FIFO and the stamp memory come back, and a child
+        /// the root node marks signals its stamp through them instead of dying (P93: it died
+        /// with `device.stamp.write_without_memory`, and at a barrier with
+        /// `device.stamp.read_without_memory`)
+        #[test]
+        fn suspend_then_wake_in_place_keeps_stamp_memory() {
+            let t = dev().with_root_page();
+            child_node(&t, 1, 1, 1, 0x30);
+            page_list(&t, 0x30, 0x31);
+            t.device.set_fifo_base_page(2);
+            t.device.set_fifo_length(0x4000);
+            t.device.set_fifo_start(0x400);
+            t.device.enable_fifo();
+            t.device.will_suspend();
+            let blob = t.device.finish_suspend().expect("blob");
+            assert!(t.device.stamp_memory.lock().is_none());
+            assert!(t.device.will_resume(Some(&blob), None));
+            t.device.did_resume(Hold::NONE);
+            assert!(t.device.root_fifo.atomics().root_fifo().is_some());
+            assert!(t.device.stamp_memory.lock().is_some());
+            assert!(t.device.child_fifos.lock()[1].is_some());
+            t.device.signal_stamp(1, 7);
+            t.device.stop(Hold::NONE);
         }
 
         /// Children come back on the calling thread (the FIFO queue blocked throughout), and only
