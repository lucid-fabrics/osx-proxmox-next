 crates/firmware/src/main.rs      |  2 ++
 5 files changed, 28 insertions(+)

diff --git a/crates/ambrosia/src/config.rs b/crates/ambrosia/src/config.rs
index 6928f68..6099c09 100644
--- a/crates/ambrosia/src/config.rs
+++ b/crates/ambrosia/src/config.rs
@@ -138,6 +138,10 @@ pub struct Config<'a> {
     /// `gfx` and `iosurface-mapper` nodes, for a machine that has Apple's
     /// paravirtual display (apple-gfx) behind its own renderer.
     pub keep_apple_gfx: bool,
+    /// Integer properties of `/chosen` the configuration sets after Ambrosia
+    /// fills them, from `Chosen`, in order (for example
+    /// `internal-use-only-unit` to 1). Each value is 32 bits.
+    pub chosen_u32: Vec<(String, u32)>,
     /// The donor vtable symbols of `Kernel` > `ExportVtableDiscriminators`,
     /// whose per-slot PAC discriminators Ambrosia hands over for injected code.
     pub export_vtable_disc: Vec<String>,
@@ -360,6 +364,15 @@ impl<'a> Config<'a> {
             });
         }
 
+        if let Some(Value::Dict(chosen)) = root.get("Chosen") {
+            for (name, v) in chosen {
+                let n = v
+                    .as_u64()
+                    .and_then(|n| u32::try_from(n).ok())
+                    .ok_or_else(|| config_key(format!("Chosen.{name}")))?;
+                config.chosen_u32.push((name.clone(), n));
+            }
+        }
         let graphics = optional(&root, &top, "Graphics", dict)?.unwrap_or(&empty);
         if let Some(path) = optional(graphics, &graphics_at, "Driver", Value::as_str)? {
             let elf = bundle
