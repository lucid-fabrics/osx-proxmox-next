From 0057571713db36c78e80fa74b780146c33a6b60b Mon Sep 17 00:00:00 2001
From: wmehanna <wassimmehanna@gmail.com>
Date: Sun, 22 Nov 2026 17:53:43 -0500
Subject: [PATCH 3/3] fix(vmapple): drop oversized virtio-usb response chains

---
 hw/vmapple/virtio-usb.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/hw/vmapple/virtio-usb.c b/hw/vmapple/virtio-usb.c
index 325d29f6fd..58dced6110 100644
--- a/hw/vmapple/virtio-usb.c
+++ b/hw/vmapple/virtio-usb.c
@@ -180,7 +180,16 @@ static void vusb_handle_response_queue(VirtIODevice *vdev, VirtQueue *vq)
 
     while ((elem = virtqueue_pop(vq, sizeof(VirtQueueElement)))) {
         size_t len = iov_size(elem->out_sg, elem->out_num);
-        g_autofree uint8_t *buf = g_malloc(len ? len : 1);
+        g_autofree uint8_t *buf = NULL;
+
+        if (len > VUSB_FRAME_MAX) {
+            /* a guest-sized chain is never a real response: drop it */
+            virtqueue_push(vq, elem, 0);
+            g_free(elem);
+            pushed = true;
+            continue;
+        }
+        buf = g_malloc(len ? len : 1);
 
         iov_to_buf(elem->out_sg, elem->out_num, 0, buf, len);
         if (len >= 2) {
-- 
