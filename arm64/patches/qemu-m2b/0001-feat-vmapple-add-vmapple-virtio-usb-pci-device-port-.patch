 hw/vmapple/meson.build  |   1 +
 hw/vmapple/trace-events |   6 +
 hw/vmapple/virtio-usb.c | 440 ++++++++++++++++++++++++++++++++++++++++
 4 files changed, 452 insertions(+)
 create mode 100644 hw/vmapple/virtio-usb.c

