 tests/tcg/aarch64/system/bti-guarded.c    |   4 +-
 tests/tcg/aarch64/system/h1-hostops.c     | 458 ++++++++++++++++++++++
 util/cpuinfo-i386.c                       |   3 +
 8 files changed, 663 insertions(+), 2 deletions(-)
 create mode 100644 tests/tcg/aarch64/system/h1-hostops.c

