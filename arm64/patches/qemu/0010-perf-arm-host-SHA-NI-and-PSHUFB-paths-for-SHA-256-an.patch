 union CRYPTO_STATE {
     uint8_t    bytes[16];
@@ -294,6 +315,90 @@ static uint32_t s1(uint32_t x)
     return ror32(x, 17) ^ ror32(x, 19) ^ (x >> 10);
 }
 
+#ifdef H1_HOSTOPS_X86
+/*
+ * SHA-NI versions of the SHA-256 helpers.  The architectural state is
+ * abcd and efgh with element 0 holding the first letter; SHA256RNDS2
+ * wants ABEF and CDGH with the first letter in the top element, so the
+ * state is shuffled in and out around each four round group.  Operands
+ * are read before any result is stored, as vd may alias vn or vm.
+ */
+#define SHA_NI_FN __attribute__((target("sha,ssse3")))
+
+typedef struct SHA256Quad {
+    __m128i abcd, efgh;
+} SHA256Quad;
+
+SHA_NI_FN
+static inline SHA256Quad sha256_4rounds_ni(const uint64_t *rabcd,
+                                           const uint64_t *refgh,
+                                           const uint64_t *rwk)
+{
+    SHA256Quad r;
+
+    __m128i abcd = _mm_loadu_si128((const __m128i *)rabcd);
+    __m128i efgh = _mm_loadu_si128((const __m128i *)refgh);
+    __m128i wk = _mm_loadu_si128((const __m128i *)rwk);
+    __m128i abef = _mm_shuffle_epi32(_mm_unpacklo_epi32(efgh, abcd),
+                                     _MM_SHUFFLE(1, 3, 0, 2));
+    __m128i cdgh = _mm_shuffle_epi32(_mm_unpackhi_epi32(efgh, abcd),
+                                     _MM_SHUFFLE(1, 3, 0, 2));
+
+    /* After the first pair: cdgh holds ABEF2, which is also CDGH4. */
+    cdgh = _mm_sha256rnds2_epu32(cdgh, abef, wk);
+    wk = _mm_shuffle_epi32(wk, _MM_SHUFFLE(0, 0, 3, 2));
+    abef = _mm_sha256rnds2_epu32(abef, cdgh, wk);
+
+    abef = _mm_shuffle_epi32(abef, _MM_SHUFFLE(0, 1, 2, 3));
+    cdgh = _mm_shuffle_epi32(cdgh, _MM_SHUFFLE(0, 1, 2, 3));
+    r.abcd = _mm_unpacklo_epi64(abef, cdgh);
+    r.efgh = _mm_unpackhi_epi64(abef, cdgh);
+    return r;
+}
+
+SHA_NI_FN
+static void sha256h_ni(void *vd, void *vn, void *vm)
+{
+    SHA256Quad r = sha256_4rounds_ni(vd, vn, vm);
+
+    _mm_storeu_si128(vd, r.abcd);
+}
+
+SHA_NI_FN
+static void sha256h2_ni(void *vd, void *vn, void *vm)
+{
+    /* Here vd holds efgh and vn holds abcd. */
+    SHA256Quad r = sha256_4rounds_ni(vn, vd, vm);
+
+    _mm_storeu_si128(vd, r.efgh);
+}
+
+SHA_NI_FN
+static void sha256su0_ni(void *vd, void *vm)
+{
+    __m128i d = _mm_loadu_si128(vd);
+    __m128i m = _mm_loadu_si128(vm);
+
+    _mm_storeu_si128(vd, _mm_sha256msg1_epu32(d, m));
+}
+
+SHA_NI_FN
+static void sha256su1_ni(void *vd, void *vn, void *vm)
+{
+    __m128i d = _mm_loadu_si128(vd);
+    __m128i n = _mm_loadu_si128(vn);
+    __m128i m = _mm_loadu_si128(vm);
+
+    d = _mm_add_epi32(d, _mm_alignr_epi8(m, n, 4));
+    _mm_storeu_si128(vd, _mm_sha256msg2_epu32(d, m));
+}
+
+static inline bool h1_sha256_ni(void)
+{
+    return (cpuinfo & CPUINFO_SHA) && (h1_hostops & H1_HOSTOP_SHA256);
+}
+#endif
+
 void HELPER(crypto_sha256h)(void *vd, void *vn, void *vm, uint32_t desc)
 {
     uint64_t *rd = vd;
@@ -304,6 +409,13 @@ void HELPER(crypto_sha256h)(void *vd, void *vn, void *vm, uint32_t desc)
     union CRYPTO_STATE m = { .l = { rm[0], rm[1] } };
     int i;
 
+#ifdef H1_HOSTOPS_X86
+    if (h1_sha256_ni()) {
+        sha256h_ni(vd, vn, vm);
+        clear_tail_16(vd, desc);
+        return;
+    }
+#endif
     for (i = 0; i < 4; i++) {
         uint32_t t = cho(CR_ST_WORD(n, 0), CR_ST_WORD(n, 1), CR_ST_WORD(n, 2))
                      + CR_ST_WORD(n, 3) + S1(CR_ST_WORD(n, 0))
@@ -339,6 +451,13 @@ void HELPER(crypto_sha256h2)(void *vd, void *vn, void *vm, uint32_t desc)
     union CRYPTO_STATE m = { .l = { rm[0], rm[1] } };
     int i;
 
+#ifdef H1_HOSTOPS_X86
+    if (h1_sha256_ni()) {
+        sha256h2_ni(vd, vn, vm);
+        clear_tail_16(vd, desc);
+        return;
+    }
+#endif
     for (i = 0; i < 4; i++) {
         uint32_t t = cho(CR_ST_WORD(d, 0), CR_ST_WORD(d, 1), CR_ST_WORD(d, 2))
                      + CR_ST_WORD(d, 3) + S1(CR_ST_WORD(d, 0))
@@ -363,6 +482,13 @@ void HELPER(crypto_sha256su0)(void *vd, void *vm, uint32_t desc)
     union CRYPTO_STATE d = { .l = { rd[0], rd[1] } };
     union CRYPTO_STATE m = { .l = { rm[0], rm[1] } };
 
+#ifdef H1_HOSTOPS_X86
+    if (h1_sha256_ni()) {
+        sha256su0_ni(vd, vm);
+        clear_tail_16(vd, desc);
+        return;
+    }
+#endif
     CR_ST_WORD(d, 0) += s0(CR_ST_WORD(d, 1));
     CR_ST_WORD(d, 1) += s0(CR_ST_WORD(d, 2));
     CR_ST_WORD(d, 2) += s0(CR_ST_WORD(d, 3));
@@ -383,6 +509,13 @@ void HELPER(crypto_sha256su1)(void *vd, void *vn, void *vm, uint32_t desc)
     union CRYPTO_STATE n = { .l = { rn[0], rn[1] } };
     union CRYPTO_STATE m = { .l = { rm[0], rm[1] } };
 
+#ifdef H1_HOSTOPS_X86
+    if (h1_sha256_ni()) {
+        sha256su1_ni(vd, vn, vm);
+        clear_tail_16(vd, desc);
+        return;
+    }
+#endif
     CR_ST_WORD(d, 0) += s1(CR_ST_WORD(m, 2)) + CR_ST_WORD(n, 1);
     CR_ST_WORD(d, 1) += s1(CR_ST_WORD(m, 3)) + CR_ST_WORD(n, 2);
     CR_ST_WORD(d, 2) += s1(CR_ST_WORD(d, 0)) + CR_ST_WORD(n, 3);
