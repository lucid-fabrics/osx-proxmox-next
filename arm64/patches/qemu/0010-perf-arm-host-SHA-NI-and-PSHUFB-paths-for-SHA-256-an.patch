+#ifdef H1_HOSTOPS_X86
+/*
+ * TBL and TBX with PSHUFB.  Each table register is looked up with the
+ * index rebased to that register; PSHUFB returns zero when bit 7 of the
+ * index byte is set, and the saturating add of 0x70 sets it for every
+ * rebased index outside 0..15 and leaves the low four bits alone inside.
+ * The table registers and the destination are read before the store as
+ * vd may overlap either.
+ */
+__attribute__((target("ssse3")))
+static void tblx_ssse3(void *vd, const void *vm, CPUARMState *env,
+                       uint32_t rn, bool is_tbx, uint32_t table_len)
+{
+    const __m128i c70 = _mm_set1_epi8(0x70);
+    __m128i idx = _mm_loadu_si128(vm);
+    __m128i dst = _mm_loadu_si128(vd);
+    __m128i acc = _mm_setzero_si128();
+
+    for (uint32_t k = 0; k < table_len / 16; k++) {
+        __m128i t = _mm_loadu_si128((const __m128i *)
+                                    aa64_vfp_qreg(env, (rn + k) % 32));
+        __m128i ix = _mm_adds_epu8(_mm_sub_epi8(idx, _mm_set1_epi8(16 * k)),
+                                   c70);
+        acc = _mm_or_si128(acc, _mm_shuffle_epi8(t, ix));
+    }
+    if (is_tbx) {
+        __m128i lim = _mm_set1_epi8(table_len - 1);
+        __m128i inrange = _mm_cmpeq_epi8(_mm_min_epu8(idx, lim), idx);
+
+        acc = _mm_or_si128(acc, _mm_andnot_si128(inrange, dst));
+    }
+    _mm_storeu_si128(vd, acc);
+}
+#endif
+
 void HELPER(simd_tblx)(void *vd, void *vm, CPUARMState *env, uint32_t desc)
 {
     const uint8_t *indices = vm;
@@ -109,6 +148,14 @@ void HELPER(simd_tblx)(void *vd, void *vm, CPUARMState *env, uint32_t desc)
         uint64_t d[2];
     } result;
 
+#ifdef H1_HOSTOPS_X86
+    if ((cpuinfo & CPUINFO_SSSE3) && (h1_hostops & H1_HOSTOP_TBL)) {
+        tblx_ssse3(vd, vm, env, rn, is_tbx, table_len);
+        clear_tail(vd, oprsz, simd_maxsz(desc));
+        return;
+    }
+#endif
+
     /*
      * We must construct the final result in a temp, lest the output
      * overlaps the input table.  For TBL, begin with zero; for TBX,
diff --git a/target/arm/tcg/vec_internal.h b/target/arm/tcg/vec_internal.h
index 038a2a3439..015575e301 100644
--- a/target/arm/tcg/vec_internal.h
+++ b/target/arm/tcg/vec_internal.h
@@ -102,6 +102,19 @@ static inline uint64_t expand_pred_h(uint8_t byte)
     return expand_pred_h_data[byte & 0x55];
 }
 
+/*
+ * Host fast paths for guest vector and crypto helpers (x86 hosts only).
+ * Bit mask, all set by default; the environment variable H1_HOSTOPS
+ * (a number, e.g. 0 for none, 1 for SHA only, 2 for TBL/TBX only)
+ * clears bits so that a run can be compared against the portable code.
+ */
+#ifdef __x86_64__
+#define H1_HOSTOPS_X86     1
+#endif
+#define H1_HOSTOP_SHA256   1u
+#define H1_HOSTOP_TBL      2u
+extern unsigned h1_hostops;
+
 static inline void clear_tail(void *vd, uintptr_t opr_sz, uintptr_t max_sz)
 {
     uint64_t *d = vd + opr_sz;
