+++ b/host/include/x86_64/host/cpuinfo.h
@@ -28,6 +28,8 @@
 #define CPUINFO_AES             (1u << 18)
 #define CPUINFO_PCLMUL          (1u << 19)
 #define CPUINFO_GFNI            (1u << 20)
+#define CPUINFO_SSSE3           (1u << 21)
