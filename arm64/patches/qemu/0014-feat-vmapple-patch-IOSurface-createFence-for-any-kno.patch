 hw/vmapple/iofence-match.h         |  56 +++++
 hw/vmapple/iofence-patch.c         | 183 ++++++++++++++++
 hw/vmapple/meson.build             |   2 +-
 hw/vmapple/vmapple.c               |   2 +
 include/hw/vmapple/iofence-patch.h |  14 ++
 6 files changed, 597 insertions(+), 1 deletion(-)
