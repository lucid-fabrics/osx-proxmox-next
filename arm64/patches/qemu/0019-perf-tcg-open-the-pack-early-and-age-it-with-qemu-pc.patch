+/*
+ * P82: how the pack is opened. P82_PCOPEN unset: on the first lookup, in the
+ * vCPU thread that asks (the scan of a 4 GB pack held vCPU 0 for 1.5 s at
+ * time zero). "presize": the same, with the index table sized from the file
+ * size up front (no rehash while scanning). "async": the translator id is
+ * still computed by the first vCPU, then a helper thread opens and scans the
+ * pack while the vCPUs translate; every lookup before it is ready is a miss.
+ */
+static int pt_open_mode(void)
+{
+    static int m = -1;
+
+    if (m < 0) {
+        const char *e = getenv("P82_PCOPEN");
+
+        /*
+         * D3: unset means "early" on the resume path (-incoming, i.e. loadvm)
+         * and the old behaviour on a cold boot. P82_PCOPEN=off forces the old
+         * behaviour, "early" forces early.
+         */
+        m = !e ? (runstate_check(RUN_STATE_INMIGRATE) ? 3 : 0) :
+            !strcmp(e, "async") ? 2 : !strcmp(e, "presize") ? 1 :
+            !strcmp(e, "early") ? 3 : 0;
+    }
+    return m;
+}
+
+static uint8_t pt_open_id[PCACHE_ID_LEN];
+static int64_t pt_open_t0, pt_open_id_ns;
+
+static void pt_publish(PCache *c, Error *err)
+{
+    /* P84b: when the pack became usable, from tb_pcache_configure() */
+    info_report("pcache: open mode %d finished %" PRId64 " ms after configure",
+                pt_open_mode(), (get_clock() - pt.t0_ns) / SCALE_MS);
+    if (c) {
+        PCacheStats cs;
+
+        pcache_stats(c, &cs);
+        info_report("pcache: %s, %s, boot %u, %" PRIu64
+                    " records, %" PRIu64 " MiB, opened in %" PRId64
+                    " ms (id %" PRId64 " ms, open mode %d)",
+                    pcache_path(c), cs.rw ? "rw" : "ro",
+                    cs.boot_no, cs.records, cs.end >> 20,
+                    (get_clock() - pt_open_t0) / SCALE_MS,
+                    pt_open_id_ns / SCALE_MS, pt_open_mode());
+    } else if (err) {
+        warn_report_err(err);
+    }
+    /* the record path reads pt.c without the state: publish it whole */
+    qatomic_store_release((void **)&pt.c, (void *)c);
+    qatomic_store_release(&pt.state, c ? 1 : 2);
+}
+
+static CPUState *pt_open_cpu;
+
+static void *pt_open_thread(void *opaque)
+{
+    Error *err = NULL;
+    PCache *c;
+
+    if (pt_open_cpu) {
+        /* P84b early: the id is computed here, off every vCPU thread */
+        pt_compute_id(pt_open_cpu, pt_open_id);
+        pt_open_id_ns = get_clock() - pt_open_t0;
+    }
+    c = pcache_open(pt.dir, pt_open_id, pt.rw, pt.cap, &err);
+
+    pt_publish(c, err);
+    return NULL;
+}
+
 static PCache *pt_get(CPUState *cpu)
 {
     int st = qatomic_load_acquire(&pt.state);
@@ -342,16 +418,22 @@ static PCache *pt_get(CPUState *cpu)
     if (st == 1) {
         return pt.c;
     }
-    if (st == 2) {
+    {
+        static int first_seen;
+
+        if (!qatomic_read(&first_seen) && !qatomic_xchg(&first_seen, 1)) {
+            info_report("pcache: first lookup %" PRId64 " ms after configure, "
+                        "pack state %d",
+                        (get_clock() - pt.t0_ns) / SCALE_MS, st);
+        }
+    }
+    if (st == 2 || st == 3) {
         return NULL;
     }
     qemu_mutex_lock(&pt.lock);
     if (pt.state == 0) {
-        uint8_t id[PCACHE_ID_LEN];
-        Error *err = NULL;
-        PCache *c = NULL;
-        int64_t t0 = get_clock();
-
+        pt_open_t0 = get_clock();
+        pcache_set_presize(pt_open_mode() >= 1);
         if (icount_enabled() || tcg_splitwx_diff != 0 ||
             qatomic_read(&one_insn_per_tb) ||
             !cpu->cc->tcg_ops->pcache_hash_cpu || pt.img_lo < PT_PTR_LO ||
@@ -359,32 +441,75 @@ static PCache *pt_get(CPUState *cpu)
             warn_report("pcache: disabled (icount, split-wx, "
                         "one-insn-per-tb, plugins, a target without a cpu "
                         "hash, a non-PIE executable or a low mmap layout)");
+            pt_publish(NULL, NULL);
         } else {
-            pt_compute_id(cpu, id);
-            c = pcache_open(pt.dir, id, pt.rw, pt.cap, &err);
+            pt_compute_id(cpu, pt_open_id);
+            pt_open_id_ns = get_clock() - pt_open_t0;
+            if (pt_open_mode() >= 2) {
+                static QemuThread th;
+
+                qatomic_store_release(&pt.state, 3);
+                qemu_thread_create(&th, "pcache-open", pt_open_thread, NULL,
+                                   QEMU_THREAD_DETACHED);
+            } else {
+                Error *err = NULL;
+                PCache *c = pcache_open(pt.dir, pt_open_id, pt.rw, pt.cap,
+                                        &err);
+
+                pt_publish(c, err);
+            }
         }
-        if (c) {
-            PCacheStats cs;
-
-            pcache_stats(c, &cs);
-            info_report("pcache: %s, %s, boot %u, %" PRIu64
-                        " records, %" PRIu64 " MiB, opened in %" PRId64
-                        " ms", pcache_path(c), cs.rw ? "rw" : "ro",
-                        cs.boot_no, cs.records, cs.end >> 20,
-                        (get_clock() - t0) / SCALE_MS);
-        } else if (err) {
-            warn_report_err(err);
+    }
+    qemu_mutex_unlock(&pt.lock);
+    return qatomic_load_acquire(&pt.state) == 1 ? pt.c : NULL;
+}
+
+/*
+ * P84b P82_PCOPEN=early: start the open at machine init done, before an
+ * incoming snapshot is read, so the scan of the pack overlaps the load of the
+ * snapshot and the first vCPU after cont does not pay for it. The checks are
+ * those of pt_get(); the id is computed on the helper thread.
+ */
+static void pt_early_open(Notifier *n, void *data)
+{
+    CPUState *cpu = first_cpu;
+
+    qemu_mutex_lock(&pt.lock);
+    if (cpu && pt.state == 0) {
+        pt_open_t0 = get_clock();
+        pcache_set_presize(true);
+        if (icount_enabled() || tcg_splitwx_diff != 0 ||
+            qatomic_read(&one_insn_per_tb) ||
+            !cpu->cc->tcg_ops->pcache_hash_cpu || pt.img_lo < PT_PTR_LO ||
+            pt_plugins_active(cpu) || !pt_layout_ok()) {
+            warn_report("pcache: disabled (icount, split-wx, "
+                        "one-insn-per-tb, plugins, a target without a cpu "
+                        "hash, a non-PIE executable or a low mmap layout)");
+            pt_publish(NULL, NULL);
+        } else {
+            static QemuThread th;
+
+            pt_open_cpu = cpu;
+            qatomic_store_release(&pt.state, 3);
+            qemu_thread_create(&th, "pcache-open", pt_open_thread, NULL,
+                               QEMU_THREAD_DETACHED);
         }
-        pt.c = c;
-        qatomic_store_release(&pt.state, c ? 1 : 2);
     }
     qemu_mutex_unlock(&pt.lock);
-    return pt.c;
+}
+
+static Notifier pt_early_notifier = { .notify = pt_early_open };
+
+static void pt_early_register(void)
+{
+    if (pt_open_mode() == 3) {
+        qemu_add_machine_init_done_notifier(&pt_early_notifier);
+    }
 }
 
 bool tb_pcache_recording(void)
 {
-    PCache *c = pt.c;
+    PCache *c = (PCache *)qatomic_load_acquire((void **)&pt.c);
 
     return c && pcache_is_rw(c);
 }
