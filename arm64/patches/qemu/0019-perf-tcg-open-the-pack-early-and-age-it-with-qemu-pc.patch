+}
+
 static void *pc_anon(size_t n)
 {
     void *p = mmap(NULL, n, PROT_READ | PROT_WRITE,
@@ -205,6 +251,46 @@ static uint32_t pc_find_rid(PCache *c, uint32_t off8)
     return lo < c->nrec && c->off8[lo] == off8 ? lo : UINT32_MAX;
 }
 
+/*
+ * P89b P89_TOUCH=1: which 4 KiB pages of the pack a boot looked at, to tell
+ * the pages of the records it used from the ones it only inspected on the
+ * way (a hash chain neighbour, a variant with another guest byte).
+ */
+static void pc_touch_mark(PCache *c, uint32_t rid, uint8_t bit)
+{
+    uint64_t a = (uint64_t)c->off8[rid] << 3;
+
+    if (bit == 1) {
+        c->touch[a >> 12] |= 1;
+    } else {
+        uint64_t e = a + pc_rec(c, rid)->total - 1;
+
+        for (uint64_t pg = a >> 12; pg <= e >> 12; pg++) {
+            c->touch[pg] |= 2;
+        }
+    }
+}
+
+static void pc_touch_report(PCache *c)
+{
+    uint64_t hit = 0, cand = 0, none = 0, tail = 0;
+    uint64_t cold = (uint64_t)c->fh->cold4k;
+
+    for (uint64_t pg = 0; pg < (c->end + 4095) >> 12; pg++) {
+        uint8_t t = c->touch[pg];
+
+        hit += t & 2 ? 1 : 0;
+        cand += (t & 3) == 1 ? 1 : 0;
+        none += t ? 0 : 1;
+        tail += cold && pg >= cold && t ? 1 : 0;
+    }
+    info_report("pcache: pages of the pack used in this boot: %" PRIu64
+                " MiB with a hit, %" PRIu64 " MiB looked at only, %" PRIu64
+                " MiB not touched by a lookup (of %" PRIu64 " MiB), %" PRIu64
+                " MiB used in the probation tail", hit >> 8, cand >> 8,
+                none >> 8, c->end >> 20, tail >> 8);
+}
