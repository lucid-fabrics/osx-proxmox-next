+/* P89: how the pack ages. */
+enum { P89_LEGACY = 0, P89_NONE, P89_ON };
+
+static int p89_mode(void)
+{
+    const char *e = getenv("P89_PACK");
+
+    /* P89_PACK=legacy: the P47..P84b behaviour; none: legacy, no compaction */
+    if (e && !strcmp(e, "legacy")) {
