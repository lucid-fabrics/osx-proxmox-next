                 break;
             }
             pc_index_add(c, pos, h->pad);
+        } else if (h->kind == PC_KIND_USE2) {
+            /* P89: u32 boot, u32 nbits, bitmap of rids; one pass, no search */
+            const uint32_t *p = (const uint32_t *)(h + 1);
+            uint32_t nbits = p[1];
+            const uint8_t *bm = (const uint8_t *)(p + 2);
