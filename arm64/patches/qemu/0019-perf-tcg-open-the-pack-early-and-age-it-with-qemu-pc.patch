+        if (dfd >= 0) {
+            fsync(dfd);
+            close(dfd);
+        }
+        info_report("pcache: P89 compacted %s: %" PRIu64 " MiB of %" PRIu64
+                    " MiB kept (%" PRIu64 " MiB older than %u boots), "
+                    "%u of %u records, probation tail from %" PRIu64
+                    " MiB, in %" PRIu64 " ms", c->path,
+                    out >> 20, c->end >> 20, dead >> 20, keep, nk, c->nrec,
+                    (uint64_t)nh.cold4k >> 8, (get_clock() - t0) / SCALE_MS);
+        if (res) {
+            res->before = c->end;
+            res->after = out;
+            res->dead = dead;
+            res->rec_before = c->nrec;
+            res->rec_after = nk;
+            res->cold_at = (uint64_t)nh.cold4k << 12;
+            res->ms = (get_clock() - t0) / SCALE_MS;
+        }
+        g_free(buf);
+        g_free(tmp);
+        return true;
+    }
+    unlink(tmp);
+fail_nofd:
+    g_free(buf);
+    g_free(tmp);
+    return false;
+}
