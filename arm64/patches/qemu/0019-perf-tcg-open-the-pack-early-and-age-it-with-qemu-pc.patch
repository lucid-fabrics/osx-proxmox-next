+ */
+typedef struct PCacheCompactOpts {
+    uint32_t keep;          /* boots a hit record is kept */
+    uint32_t unhit;         /* boots a stored and never hit record is kept */
+    uint64_t target;        /* bytes the live part may keep, 0 default */
+    uint64_t min_dead;      /* dead bytes that make a rewrite worth it */
+    uint64_t cap;           /* pcache-max, 0 default 8 GiB */
+    bool force;
+} PCacheCompactOpts;
+
+typedef struct PCacheCompactRes {
+    uint64_t before, after, dead, cold_at, ms;
+    uint32_t rec_before, rec_after, boot_no;
+} PCacheCompactRes;
+
+typedef enum PCacheCompactRc {
+    PCACHE_COMPACT_DONE = 0,
+    PCACHE_COMPACT_NOTHING = 1,
+    PCACHE_COMPACT_BUSY = 2,
+    PCACHE_COMPACT_ERROR = 3,
+} PCacheCompactRc;
+
+PCacheCompactRc pcache_compact_file(const char *path,
+                                    const PCacheCompactOpts *o,
+                                    PCacheCompactRes *res, Error **errp);
+
 #endif
