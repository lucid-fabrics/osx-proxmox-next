+        /* records are not page aligned: the hint is the first whole page */
+        nh.cold4k = (cold_at + 4095) >> 12;
+    }
+    /* one bitmap per generation, the current boot's included */
+    for (uint32_t a = 0; ok && a <= limit; a++) {
+        uint32_t boot = (uint16_t)(c->boot_no - a);
+        uint64_t total;
+        PCacheRecHdr *h;
+        bool any = false;
+
+        for (uint32_t k = 0; k < nk && !any; k++) {
+            any = kgen[k] == boot;
+        }
+        if (!any) {
