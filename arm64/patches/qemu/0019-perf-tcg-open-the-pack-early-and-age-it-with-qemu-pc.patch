diff --git a/tools/pcache-compact.c b/tools/pcache-compact.c
new file mode 100644
index 0000000000..97d3e54176
--- /dev/null
+++ b/tools/pcache-compact.c
@@ -0,0 +1,83 @@
+/*
+ * qemu-pcache-compact: rewrite a translation pack (<dir>/<id>.pack) without
+ * its dead records while no VM uses it. See accel/tcg/pcache.c.
+ *
+ *   qemu-pcache-compact [-f] [-q] [-k BOOTS] [-u BOOTS] [-t MIB] [-d MIB] [-m MIB] PACK...
+ *
+ * Exit status: 0 rewritten, 1 nothing worth rewriting, 2 pack in use (a VM
+ * or another compactor holds its lock), 3 error. It never waits for the
+ * lock and never touches the pack until the new one is complete (tmp,
+ * fdatasync, rename, directory fsync).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "../accel/tcg/pcache.h"
+#include <getopt.h>
+
+int main(int argc, char **argv)
+{
+    PCacheCompactOpts o = { 0 };
+    bool quiet = false;
+    int rc = 1, c;
+
+    while ((c = getopt(argc, argv, "fqk:u:t:d:m:h")) != -1) {
+        switch (c) {
+        case 'f':
+            o.force = true;
+            break;
+        case 'q':
+            quiet = true;
+            break;
+        case 'k':
+            o.keep = strtoul(optarg, NULL, 0);
+            break;
+        case 'u':
+            o.unhit = strtoul(optarg, NULL, 0);
+            break;
+        case 't':
+            o.target = strtoull(optarg, NULL, 0) << 20;
+            break;
+        case 'd':
+            o.min_dead = strtoull(optarg, NULL, 0) << 20;
+            break;
+        case 'm':
+            o.cap = strtoull(optarg, NULL, 0) << 20;
+            break;
+        default:
+            fprintf(stderr, "usage: %s [-f] [-q] [-k boots] [-u boots] "
+                    "[-t MiB] [-d MiB] [-m MiB] pack...\n", argv[0]);
+            return 3;
+        }
+    }
+    if (optind >= argc) {
+        fprintf(stderr, "no pack given\n");
+        return 3;
+    }
+    for (; optind < argc; optind++) {
+        PCacheCompactRes r;
+        Error *err = NULL;
+        PCacheCompactRc k = pcache_compact_file(argv[optind], &o, &r, &err);
+
+        if (err) {
+            error_report_err(err);
+        }
+        if (!quiet) {
+            bool done = k == PCACHE_COMPACT_DONE;
+
+            printf("%s: %s, %" PRIu64 " MiB dead, %" PRIu64 " MiB -> %" PRIu64
+                   " MiB, %u -> %u records, boot %u, %" PRIu64 " ms\n",
+                   argv[optind],
+                   done ? "compacted" :
+                   k == PCACHE_COMPACT_NOTHING ? "nothing to do" :
+                   k == PCACHE_COMPACT_BUSY ? "in use" : "error",
+                   r.dead >> 20, r.before >> 20,
+                   (done ? r.after : r.before) >> 20, r.rec_before,
+                   done ? r.rec_after : r.rec_before, r.boot_no, r.ms);
+        }
+        rc = k == PCACHE_COMPACT_DONE ? 0 : (int)k;
+    }
+    return rc;
+}
