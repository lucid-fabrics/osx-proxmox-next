 accel/tcg/pcache.h       |  35 +++
 tests/unit/test-pcache.c | 312 +++++++++++++++++++
 tools/meson.build        |   5 +
 tools/pcache-compact.c   |  83 +++++
 7 files changed, 1210 insertions(+), 44 deletions(-)
 create mode 100644 tools/pcache-compact.c

