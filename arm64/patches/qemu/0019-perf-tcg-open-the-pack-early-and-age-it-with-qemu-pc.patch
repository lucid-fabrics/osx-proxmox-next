     memset(id_a, 0xa1, sizeof(id_a));
     memset(id_b, 0xb2, sizeof(id_b));
     g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/pcache/p89b/offline", test_p89b_offline);
     g_test_add_func("/pcache/roundtrip", test_roundtrip);
     g_test_add_func("/pcache/key/other-va", test_other_va);
     g_test_add_func("/pcache/key/changed-byte", test_changed_byte);
@@ -555,5 +863,9 @@ int main(int argc, char **argv)
     g_test_add_func("/pcache/compact/keeps-use", test_compact_keeps_use);
     g_test_add_func("/pcache/file/bad-crc-restore", test_bad_crc_restore);
     g_test_add_func("/pcache/file/half-created", test_half_created);
+    g_test_add_func("/pcache/p89/exit-compaction", test_p89_exit_compaction);
+    g_test_add_func("/pcache/p89/migrates-legacy", test_p89_migrates_legacy);
+    g_test_add_func("/pcache/p89/target", test_p89_target);
+    g_test_add_func("/pcache/p89/unhit", test_p89_unhit);
     return g_test_run();
 }
