+
+/*
+ * P89: with P89_PACK=on the use record is a bitmap, a run that hit next to
+ * nothing is not a boot, and the pack is compacted at exit, not at open.
+ */
+static void p89_boots(const char *dir, int n, unsigned hot)
+{
+    for (int i = 0; i < n; i++) {
+        PCache *c = open_rw(dir, id_a);
+
+        for (unsigned r = 0; r < hot; r++) {
+            g_assert_true(find_range(c, r));
+        }
+        pcache_close(c, true);
+    }
+}
+
+static void test_p89_exit_compaction(void)
+{
+    char *dir = make_dir();
+    char *path = hex_path(dir, id_a);
+    PCache *c;
+
+    g_setenv("P89_PACK", "on", true);
+    g_setenv("P89_MIN_HITS", "1", true);
+    g_setenv("P89_KEEP", "3", true);
+    g_setenv("P89_TRIGGER_MB", "100000", true);    /* not by size */
+    g_setenv("P89_TARGET_KB", "100000000", true);
+    c = open_rw(dir, id_a);
+    store_range(c, 0, 100);         /* 0..49 hot, 50..99 cold */
+    pcache_close(c, true);
+    p89_boots(dir, 3, 50);
+    /* boots 2..4 used 0..49; the cold half is 3 boots old: kept (keep 3) */
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->boot_no, ==, 5);
+    g_assert_cmpuint(c->nrec, ==, 100);
+    g_assert_cmpuint(c->use_v1_bytes, ==, 0);
+    g_assert_cmpuint(c->use2_bytes, >, 0);
+    g_assert_cmpuint(c->fh->version, ==, 2);
+    pcache_close(c, true);
+    /* a run that hits nothing is not a generation */
+    g_setenv("P89_MIN_HITS", "1024", true);
+    for (int i = 0; i < 5; i++) {
+        c = open_rw(dir, id_a);
+        pcache_close(c, true);
+    }
+    g_setenv("P89_MIN_HITS", "1", true);
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->boot_no, ==, 5);    /* the short runs took none */
+    g_assert_cmpuint(c->nrec, ==, 100);
+    pcache_close(c, true);
+    /* one more real boot: the cold half, last used in boot 1, is now older
+     * than keep, and the exit of this one rewrites the pack without it */
+    g_setenv("P89_TRIGGER_MB", "0", true);
+    p89_boots(dir, 1, 50);
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->nrec, ==, 50);
+    g_assert_true(find_range(c, 10));
+    g_assert_false(find_range(c, 60));
+    /* last use survives the rewrite */
+    g_assert_cmpuint(c->lastboot[0], ==, 5);
+    pcache_close(c, true);
+    /* a tmp left by a crashed compaction is removed by the next rw open */
+    {
+        char *tmp = g_strdup_printf("%s.tmp", path);
+
+        g_assert_true(g_file_set_contents(tmp, "garbage", 7, NULL));
+        c = open_rw(dir, id_a);
+        g_assert_false(g_file_test(tmp, G_FILE_TEST_EXISTS));
+        g_assert_cmpuint(c->nrec, ==, 50);
+        pcache_close(c, true);
+        g_free(tmp);
+    }
+    g_setenv("P89_PACK", "legacy", true);
+    g_unsetenv("P89_MIN_HITS");
+    g_unsetenv("P89_KEEP");
+    g_unsetenv("P89_TRIGGER_MB");
+    g_unsetenv("P89_TARGET_KB");
+    g_free(path);
+    rm_dir(dir);
+}
+
+/* An old pack with per entry use records is read, and converted by the first
+ * compaction with its ages kept. */
+static void test_p89_migrates_legacy(void)
+{
+    char *dir = make_dir();
+    PCache *c;
+
+    g_setenv("P89_PACK", "legacy", true);
+    c = open_rw(dir, id_a);
+    store_range(c, 0, 100);
+    pcache_close(c, true);
+    for (int boot = 2; boot <= 5; boot++) {
+        c = open_rw(dir, id_a);
+        for (unsigned i = 0; i < 50; i++) {
+            g_assert_true(find_range(c, i));
+        }
+        pcache_close(c, true);
+    }
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->use_v1_bytes, >, 0);
+    g_assert_cmpuint(c->lastboot[0], ==, 5);
+    g_assert_cmpuint(c->lastboot[99], ==, 1);
+    pcache_close(c, true);                  /* boot 6 */
+    g_setenv("P89_PACK", "on", true);
+    g_setenv("P89_MIN_HITS", "1", true);
+    g_setenv("P89_KEEP", "3", true);
+    g_setenv("P89_TRIGGER_MB", "100000", true);
+    g_setenv("P89_TARGET_KB", "100000000", true);
+    c = open_rw(dir, id_a);                 /* boot 7: v1 use bytes trigger */
+    g_assert_cmpuint(c->boot_no, ==, 7);
+    for (unsigned i = 0; i < 50; i++) {
+        g_assert_true(find_range(c, i));
+    }
+    c->use_v1_bytes = 64ull << 20;          /* as if the old records were big */
+    pcache_close(c, true);
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->use_v1_bytes, ==, 0);
+    g_assert_cmpuint(c->nrec, ==, 50);      /* the cold half was 6 boots old */
+    g_assert_cmpuint(c->lastboot[0], ==, 7);
+    pcache_close(c, true);
+    g_setenv("P89_PACK", "legacy", true);
+    g_unsetenv("P89_MIN_HITS");
+    g_unsetenv("P89_KEEP");
+    g_unsetenv("P89_TRIGGER_MB");
+    g_unsetenv("P89_TARGET_KB");
+    rm_dir(dir);
+}
+
+/* Over the target the oldest generation goes first and the newest stays. */
+static void test_p89_target(void)
+{
+    char *dir = make_dir();
+    PCache *c;
+    uint64_t one;
+    char *kb;
+
+    g_setenv("P89_PACK", "on", true);
+    g_setenv("P89_MIN_HITS", "1", true);
+    g_setenv("P89_KEEP", "8", true);
+    g_setenv("P89_TRIGGER_MB", "100000", true);
+    g_setenv("P89_TARGET_KB", "100000000", true);
+    c = open_rw(dir, id_a);
+    store_range(c, 0, 100);
+    pcache_close(c, true);
+    /* last use: 0..9 boot 5, 10..29 boot 4, 30..59 boot 3, 60..99 boot 2 */
+    p89_boots(dir, 1, 100);
+    p89_boots(dir, 1, 60);
+    p89_boots(dir, 1, 30);
+    p89_boots(dir, 1, 10);
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->boot_no, ==, 6);
+    one = pc_rec(c, 0)->total;
+    pcache_close(c, true);
+    /* a target of 40 records, compaction on every exit: boot 6 hits 0..9, so
+     * ages are 0, 2, 3, 4 for 10, 20, 30, 40 records: 30 fit, 60 do not */
+    kb = g_strdup_printf("%" PRIu64, one * 40 / 1024);
+    g_setenv("P89_TARGET_KB", kb, true);
+    g_setenv("P89_TRIGGER_MB", "0", true);
+    p89_boots(dir, 1, 10);
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->nrec, ==, 30);
+    g_assert_true(find_range(c, 5));
+    g_assert_true(find_range(c, 20));
+    g_assert_false(find_range(c, 40));
+    pcache_close(c, true);
+    g_free(kb);
+    g_setenv("P89_PACK", "legacy", true);
+    g_unsetenv("P89_MIN_HITS");
+    g_unsetenv("P89_KEEP");
+    g_unsetenv("P89_TRIGGER_MB");
+    g_unsetenv("P89_TARGET_KB");
+    rm_dir(dir);
+}
+
+/* A record stored a few boots ago and never hit since goes before the keep window ends. */
+static void test_p89_unhit(void)
+{
+    char *dir = make_dir();
+    PCache *c;
+
+    g_setenv("P89_PACK", "on", true);
+    g_setenv("P89_MIN_HITS", "1", true);
+    g_setenv("P89_KEEP", "8", true);
+    g_setenv("P89_UNHIT", "2", true);
+    g_setenv("P89_TRIGGER_MB", "100000", true);
+    g_setenv("P89_TARGET_KB", "100000000", true);
+    c = open_rw(dir, id_a);
+    store_range(c, 0, 100);         /* 0..49 hot, 50..99 never hit again */
+    pcache_close(c, true);
+    p89_boots(dir, 2, 50);          /* boots 2, 3: unhit records are 2 old */
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->nrec, ==, 100);
+    pcache_close(c, true);          /* boot 4 without hits: not a boot */
+    g_setenv("P89_TRIGGER_MB", "0", true);
+    p89_boots(dir, 1, 50);          /* boot 4: 3 boots old and never hit */
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->nrec, ==, 50);
+    g_assert_true(find_range(c, 10));
+    pcache_close(c, true);
+    g_setenv("P89_PACK", "legacy", true);
+    g_unsetenv("P89_MIN_HITS");
+    g_unsetenv("P89_KEEP");
+    g_unsetenv("P89_UNHIT");
+    g_unsetenv("P89_TRIGGER_MB");
+    g_unsetenv("P89_TARGET_KB");
+    rm_dir(dir);
+}
+
+/* P89b: the exit no longer rewrites the pack; qemu-pcache-compact does it
+ * with the pack's lock, hot records first, probation tail last. */
+static void test_p89b_offline(void)
+{
+    char *dir = make_dir();
+    char *path = hex_path(dir, id_a);
+    PCacheCompactOpts o = { .unhit = 1, .min_dead = 1 };
+    PCacheCompactRes res;
+    Error *err = NULL;
+    PCache *c;
+    uint64_t size_before;
+
+    g_unsetenv("P89_COMPACT_AT");
+    g_setenv("P89_PACK", "on", true);
+    g_setenv("P89_MIN_HITS", "1", true);
+    g_setenv("P89_TRIGGER_MB", "0", true);      /* the exit would compact */
+    g_setenv("P89_TARGET_KB", "100000000", true);
+    c = open_rw(dir, id_a);
+    store_range(c, 0, 100);         /* 0..49 hot, 50..99 never hit again */
+    pcache_close(c, true);
+    p89_boots(dir, 2, 50);          /* boots 2 and 3 */
+    c = open_rw(dir, id_a);         /* boot 4: 50 hot, 20 new */
+    for (unsigned i = 0; i < 50; i++) {
+        g_assert_true(find_range(c, i));
+    }
+    store_range(c, 100, 20);
+    pcache_close(c, true);
+    /* the exit of those boots did not rewrite anything */
+    c = open_rw(dir, id_a);         /* boot 5 */
+    g_assert_cmpuint(c->nrec, ==, 120);
+    g_assert_cmpuint(c->boot_no, ==, 5);
+    pcache_close(c, true);          /* a run with no hits: no boot */
+    {
+        struct stat st;
+
+        g_assert_cmpint(stat(path, &st), ==, 0);
+        size_before = st.st_size;
+    }
+    /* a held lock: the compactor leaves the pack alone */
+    c = open_rw(dir, id_a);
+    g_assert_cmpint(pcache_compact_file(path, &o, &res, &err), ==,
+                    PCACHE_COMPACT_BUSY);
+    g_assert_null(err);
+    pcache_close(c, true);
+    g_assert_cmpint(pcache_compact_file(path, &o, &res, &err), ==,
+                    PCACHE_COMPACT_DONE);
+    g_assert_null(err);
+    g_assert_cmpuint(res.rec_before, ==, 120);
+    g_assert_cmpuint(res.rec_after, ==, 70);
+    g_assert_cmpuint(res.after, <, size_before);
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->nrec, ==, 70);
+    g_assert_cmpuint(c->boot_no, ==, 5);        /* the compactor took none */
+    g_assert_cmpuint(c->fh->cold4k, !=, 0);
+    /* hit records first and in their old order, the new ones after */
+    for (uint32_t rid = 0; rid < 50; rid++) {
+        g_assert_cmpuint(pc_rec(c, rid)->pad, ==, 1);
+    }
+    for (uint32_t rid = 50; rid < 70; rid++) {
+        g_assert_cmpuint(pc_rec(c, rid)->pad, ==, 4);
+    }
+    g_assert_true(find_range(c, 10));
+    g_assert_true(find_range(c, 110));
+    g_assert_false(find_range(c, 70));
+    g_assert_cmpuint(c->lastboot[0], ==, 4);
+    pcache_close(c, true);
+    /* nothing left to drop: nothing to do */
+    o.min_dead = 1ull << 30;
+    g_assert_cmpint(pcache_compact_file(path, &o, &res, &err), ==,
+                    PCACHE_COMPACT_NOTHING);
+    /* a file that is not named after its id is refused, not renamed over */
+    {
+        char *bad = g_build_filename(dir, "x.pack", NULL);
+        char *data = NULL;
+        gsize len;
+
+        g_assert_true(g_file_get_contents(path, &data, &len, NULL));
+        g_assert_true(g_file_set_contents(bad, data, len, NULL));
+        g_assert_cmpint(pcache_compact_file(bad, &o, &res, &err), ==,
+                        PCACHE_COMPACT_ERROR);
+        g_assert_nonnull(err);
+        error_free(err);
+        g_free(data);
+        g_free(bad);
+    }
+    g_setenv("P89_PACK", "legacy", true);
+    g_setenv("P89_COMPACT_AT", "exit", true);
+    g_unsetenv("P89_MIN_HITS");
+    g_unsetenv("P89_TRIGGER_MB");
+    g_unsetenv("P89_TARGET_KB");
+    g_free(path);
+    rm_dir(dir);
+}
+
 int main(int argc, char **argv)
 {
+    /* the older tests are about the legacy pack; the p89 ones set their own */
