+        uint32_t age = (uint16_t)(c->boot_no - c->lastboot[rid]);
+
+        if (!pc_p89_dead(c, rid, keep, unhit)) {
+            by_age[age] += pc_rec(c, rid)->total;
+        } else {
+            dead += pc_rec(c, rid)->total;
+        }
+    }
+    limit = keep;
+    for (;;) {
+        kept = 0;
+        for (uint32_t a = 0; a <= limit; a++) {
+            kept += by_age[a];
+        }
+        if (kept <= target || limit == 0) {
+            break;
+        }
+        limit--;
+    }
