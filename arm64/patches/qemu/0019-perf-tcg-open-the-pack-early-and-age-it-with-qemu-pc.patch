 }
 
+/*
+ * P89b P89_COLD=drop: the scan has just read the probation tail (records
+ * stored and not hit yet, which the compactor puts last) to index it. A
+ * boot rarely needs them, so give their pages back to the page cache's
+ * reclaim now instead of letting them compete with the pages it does use.
+ */
+static void pc_cold_drop(PCache *c, uint64_t st_size)
+{
+    const char *e = getenv("P89_COLD");
+    uint64_t at = (uint64_t)c->fh->cold4k << 12;
+
+    if (!e || strcmp(e, "drop") || !at || at >= st_size || c->offline) {
+        return;
+    }
+    madvise(c->map + at, st_size - at, MADV_DONTNEED);
+    posix_fadvise(c->fd, at, st_size - at, POSIX_FADV_DONTNEED);
+}
+
 static bool pc_grow(PCache *c, uint64_t need)
 {
     uint64_t want;
@@ -300,6 +435,9 @@ static void pc_free(PCache *c)
             munmap(arrs[i], (size_t)c->maxrec * sz[i]);
         }
     }
+    if (c->touch) {
+        munmap(c->touch, (size_t)(c->cap >> 12) + 1);
+    }
     g_free(c->tab);
     if (c->old_tabs) {
         g_ptr_array_free(c->old_tabs, true);
@@ -437,9 +575,229 @@ static bool pc_compact(PCache *c)
     return false;
 }
 
+/*
+ * P89: a bitmap use record for @boot over rids [0, n): bit i set when
+ * hit[i] is non zero (or, with @gen, when gen[i] == @boot). Returns a g_malloc
+ * buffer, total bytes in *@total.
+ */
+static PCacheRecHdr *pc_use2_build(uint32_t boot, uint32_t nbits,
+                                   const uint32_t *hit, const uint32_t *gen,
+                                   uint64_t *total)
+{
+    uint64_t nb = ((uint64_t)nbits + 7) / 8;
+    uint64_t t = sizeof(PCacheRecHdr) + 8 + ROUND_UP(nb, 8);
+    PCacheRecHdr *h = g_malloc0(t);
+    uint32_t *p = (uint32_t *)(h + 1);
+    uint8_t *bm = (uint8_t *)(p + 2);
+
+    h->magic = PC_REC_MAGIC;
+    h->total = t;
+    h->kind = PC_KIND_USE2;
+    p[0] = boot;
+    p[1] = nbits;
+    for (uint32_t i = 0; i < nbits; i++) {
+        if (hit ? qatomic_read(&hit[i]) != 0 : gen[i] == boot) {
+            bm[i >> 3] |= 1u << (i & 7);
+        }
+    }
+    h->crc = crc32c(0xffffffff, (const uint8_t *)h + 16, t - 16);
+    *total = t;
+    return h;
+}
+
+#define PC2_MAX_KEEP 32
+
+/*
+ * P89: a record is dead when it was last hit more than @keep boots ago, or
+ * when it was stored more than @unhit boots ago and never hit since: a
+ * translation that was needed once and never again (a one-off program, a
+ * changed binary) says nothing about the next boot.
+ */
+static bool pc_p89_dead(PCache *c, uint32_t rid, uint32_t keep, uint32_t unhit)
+{
+    uint32_t age = (uint16_t)(c->boot_no - c->lastboot[rid]);
+
+    if (age > keep) {
+        return true;
+    }
+    return c->lastboot[rid] == pc_rec(c, rid)->pad &&
+           (uint16_t)(c->boot_no - pc_rec(c, rid)->pad) > unhit;
+}
+
+/*
+ * P89 compaction (run by qemu-pcache-compact with the pack's lock held and
+ * nothing appending, or, with P89_COMPACT_AT=exit, at exit). Keeps the
+ * records hit or born within the last @keep boots (fewer when that is still
+ * over @target bytes: oldest generation goes first, the newest never), plus
+ * one bitmap use record per generation so the ages survive. P89b: the
+ * records that have been hit since they were stored come first, in file
+ * (first use) order, the ones stored and not hit yet (the probation tail)
+ * after them, and the header says where the tail starts. The new pack is
+ * written to <path>.tmp, synced, and renamed over the old one: until the
+ * rename the old pack is the pack, after it the new one is, and a tmp left
+ * by a crash is removed by the next read-write open. Returns true when the
+ * new pack replaced the old one.
+ */
