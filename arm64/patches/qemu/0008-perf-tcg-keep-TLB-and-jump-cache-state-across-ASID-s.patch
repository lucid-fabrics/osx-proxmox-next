-static void tlb_flush_range_locked(CPUState *cpu, int midx,
+/*
+ * Return true if [@addr, @addr + @len) overlaps the region that covers all
+ * the pages larger than a target page that the TLB has seen.  Such a page
+ * is held as one entry per target page, so a flush by the address of one of
