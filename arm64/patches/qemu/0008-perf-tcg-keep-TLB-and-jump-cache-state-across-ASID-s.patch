diff --git a/include/exec/tlb-stats.h b/include/exec/tlb-stats.h
new file mode 100644
index 0000000000..5740b34f4e
--- /dev/null
+++ b/include/exec/tlb-stats.h
@@ -0,0 +1,86 @@
+/*
+ * Optional softmmu TLB counters (lab instrumentation).
+ *
+ * Set TLB_STATS_ENABLED to 1, rebuild, and run with QEMU_TLB_STATS=1 to get
+ * a counter dump on stderr every 15 seconds.  With 0 every hook compiles to
+ * nothing.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef EXEC_TLB_STATS_H
+#define EXEC_TLB_STATS_H
+
+#define TLB_STATS_ENABLED 0
+
+#if TLB_STATS_ENABLED
+
+#include "qemu/timer.h"
+
+enum {
+    TS_ASID_CHANGE,      /* TTBR write that changed the ASID */
+    TS_TTBR_WRITE,       /* all 64-bit TTBR writes */
+    TS_FLUSH_ASID,       /* flush work started by an ASID change */
+    TS_FLUSH_ALL,        /* flush work covering every mmu index */
+    TS_FLUSH_IDX,        /* flush work covering some mmu indexes */
+    TS_FLUSH_PAGE,       /* flush page work */
+    TS_FLUSH_RANGE,      /* flush range work */
+    TS_ENT_WIPED,        /* in-use entries dropped by full/idx flushes */
+    TS_ENT_WIPED_ASID,   /* same, only flushes caused by an ASID change */
+    TS_ENT_KEPT,         /* entries kept by a selective ASID flush */
+    TS_REFILL,           /* tlb_set_page_full calls */
+    TS_REFILL_NEAR,      /* refills within 1 ms (host) of an ASID change */
+    TS_REFILL_GLOBAL,    /* refills of global (nG=0) pages */
+    TS_RESET_DIRTY,      /* tlb_reset_dirty calls */
+    TS_JC_FLUSH,         /* jump cache flushes */
+    TS_MAX
+};
+
+#define TS_NIDX 16
+
+typedef struct TLBStats {
+    uint64_t cnt[TS_MAX];
+    uint64_t refill_idx[TS_NIDX];
+    uint64_t refill_cyc[TS_NIDX];   /* cycles in tlb_fill_align per idx */
+    uint64_t flush_cyc;             /* cycles in flush workers */
+    uint64_t dirty_cyc;             /* cycles in tlb_reset_dirty */
+    uint64_t last_dump_ns;
+} TLBStats;
+
+extern TLBStats tlb_stats;
+extern __thread bool tlb_stats_cause_asid;
+extern __thread uint64_t tlb_stats_asid_ns;
+extern int tlb_stats_on;
+
+static inline uint64_t tlbs_now(void)
+{
+    return tlb_stats_on ? cpu_get_host_ticks() : 0;
+}
+
+#define TLBS_INC(id) do { \
+        if (tlb_stats_on) { qatomic_inc(&tlb_stats.cnt[id]); } \
+    } while (0)
+#define TLBS_ADD(id, n) do { \
+        if (tlb_stats_on) { qatomic_add(&tlb_stats.cnt[id], (n)); } \
+    } while (0)
+#define TLBS_CYC(field, t0) do { \
+        if (tlb_stats_on) { \
+            qatomic_add(&tlb_stats.field, cpu_get_host_ticks() - (t0)); \
+        } \
+    } while (0)
+
+void tlb_stats_init(void);
+void tlb_stats_maybe_dump(void);
+void tlb_stats_asid_change(void);
+static inline void tlb_stats_cause_asid_set(bool v) { tlb_stats_cause_asid = v; }
+
+#else
+
+#define TLBS_INC(id) do { } while (0)
+#define TLBS_ADD(id, n) do { } while (0)
+#define TLBS_CYC(field, t0) do { (void)(t0); } while (0)
+#define tlbs_now() 0
+static inline void tlb_stats_asid_change(void) { }
+static inline void tlb_stats_cause_asid_set(bool v) { }
+
+#endif /* TLB_STATS_ENABLED */
+#endif
