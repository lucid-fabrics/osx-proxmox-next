+/* Called with tlb_c.lock held, or from the owning vCPU for the victim swap. */
+static inline void tlb_note_non_global(CPUTLBDesc *desc, size_t index)
+{
+    if (desc->ng_n < CPU_TLB_NG_LIST) {
+        desc->ng_idx[desc->ng_n++] = index;
+    } else {
+        desc->ng_overflow = true;
+    }
+}
+
+/*
+ * Drop every entry of @mmu_idx except the ones marked global.  Returns true
+ * if any entry may stay.  Called with tlb_c.lock held.
+ */
+static bool tlb_flush_non_global_one_locked(CPUState *cpu, int mmu_idx,
+                                            int64_t now)
+{
+    CPUTLBDesc *desc = &cpu->neg.tlb.d[mmu_idx];
+    CPUTLBDescFast *fast = cpu_tlb_fast(cpu, mmu_idx);
+    uintptr_t old_mask = fast->mask;
+    size_t n, i, j;
+    bool kept = false;
+
+    if (!desc->has_global) {
+        TLBS_INC(TS_FLUSH_ALL);
+        TLBS_ADD(TS_ENT_WIPED, desc->n_used_entries);
+        tlb_flush_one_mmuidx_locked(cpu, mmu_idx, now);
+        return false;
+    }
+
+    tlb_mmu_resize_locked(desc, fast, now);
+    if (fast->mask != old_mask) {
+        /* The table was reallocated, nothing of it survives. */
+        tlb_mmu_flush_locked(desc, fast);
+        return false;
+    }
+
+    if (!desc->ng_overflow) {
+        /* Only the indexes that got a non-global entry can need dropping. */
+        for (j = 0; j < desc->ng_n; j++) {
+            CPUTLBEntry *te;
+
+            i = desc->ng_idx[j];
+            te = &fast->table[i];
+            if (!tlb_entry_is_empty(te) && !desc->fulltlb[i].global) {
+                memset(te, -1, sizeof(*te));
+                desc->n_used_entries--;
+                TLBS_INC(TS_ENT_WIPED_ASID);
+            }
+        }
+        kept = true;
+    } else {
+        n = tlb_n_entries(fast);
+        for (i = 0; i < n; i++) {
+            CPUTLBEntry *te = &fast->table[i];
+
+            if (tlb_entry_is_empty(te)) {
+                continue;
+            }
+            if (desc->fulltlb[i].global) {
+                kept = true;
+                TLBS_INC(TS_ENT_KEPT);
+            } else {
+                memset(te, -1, sizeof(*te));
+                desc->n_used_entries--;
+                TLBS_INC(TS_ENT_WIPED_ASID);
+            }
+        }
+    }
+    desc->ng_n = 0;
+    desc->ng_overflow = false;
+    for (i = 0; i < CPU_VTLB_SIZE; i++) {
+        CPUTLBEntry *tv = &desc->vtable[i];
+
+        if (tlb_entry_is_empty(tv)) {
+            continue;
+        }
+        if (desc->vfulltlb[i].global) {
+            kept = true;
+        } else {
+            memset(tv, -1, sizeof(*tv));
+        }
+    }
+    desc->has_global = kept;
+    return kept;
+}
