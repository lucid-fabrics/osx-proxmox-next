diff --git a/tests/tcg/aarch64/system/asid-retain.c b/tests/tcg/aarch64/system/asid-retain.c
new file mode 100644
index 0000000000..a8e9e168ef
--- /dev/null
+++ b/tests/tcg/aarch64/system/asid-retain.c
@@ -0,0 +1,949 @@
+/*
+ * ASID switch and TLB retention test.
+ *
+ * Two address spaces (ASID 1 and ASID 2, own TTBR0 tables) map the same
+ * virtual addresses to different pages through nG descriptors, and share one
+ * global kernel-like region.  The test switches TTBR0 between them over and
+ * over without any TLBI and checks that
+ *
+ *  - no data or code translation of the other ASID survives the switch, also
+ *    for addresses that collide in the softmmu TLB and end up in its victim
+ *    table,
+ *  - a global page remapped under a TLBI (all, by VA, last level, all ASIDs,
+ *    range) is seen with the new mapping from both ASIDs, also after more
+ *    switches,
+ *  - an nG page remapped under TLBI ASIDE1 / VAE1 is seen new under its ASID,
+ *  - the same holds for TLBI ... IS broadcast from one vCPU while other vCPUs
+ *    keep switching ASIDs,
+ *  - a global code page called through a jump cache entry that an ASID
+ *    switch keeps runs the new code once it is remapped under a TLBI,
+ *  - a TLBI by VA for one 4 KiB slice of a 2 MiB global block drops the
+ *    translations of the other slices too.
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define PSCI_CPU_ON 0xc4000003ull
+#define NCPUS       4
+#define NVA         12                  /* more than the victim TLB holds */
+#define VA_BASE     0x80000000ull       /* L1 index 2 */
+#define VA_STRIDE   (16ull << 20)       /* collide at any TLB size <= 4096 */
+#define CODE_VA     (VA_BASE + NVA * VA_STRIDE)
+#define GLOBAL_VA   0xc0000000ull       /* L1 index 3, shared by both ASIDs */
+#define ROUNDS_A    3000
+#define ROUNDS_B    600
+#define ROUNDS_D    1500
+
+#define PTE_PAGE    0x3ull
+#define PTE_AF      (1ull << 10)
+#define PTE_SH_IS   (3ull << 8)
+#define PTE_NG      (1ull << 11)
+
+#define NPG         (NVA + 1)           /* NVA data pages and one code page */
+#define NSP         16                  /* nG pages on distinct TLB slots */
+#define SPREAD_VA   0xb0000000ull
+#define BIG_VA      0xb4000000ull       /* NBIG nG pages, more than the list */
+#define GBIG_VA     0xc0200000ull       /* NBIG global pages */
+#define NBIG        500
+#define ROUNDS_E    3000
+#define ROUNDS_G    800
+#define ROUNDS_H    1500
+#define FNG_VA      0xb8000000ull       /* nG = 0 pages, made nG by FNG0 */
+#define EL0_VA      0xb8200000ull       /* NEL0 nG pages EL0 can access */
+#define UG_VA       (GLOBAL_VA + 0x400000ull)       /* a global one */
+#define NEL0        16
+#define RO_VA       0xb8400000ull       /* one read-only nG page per ASID */
+#define ROUNDS_I    600
+#define GCODE_VA    (GLOBAL_VA + 0x1000000ull)  /* global code, CODE_VA slot */
+#define ROUNDS_J    600
+#define BLK_VA      (GLOBAL_VA + 0x1400000ull)  /* a 2 MiB global block */
+#define BLK_SIZE    (2ull << 20)
+#define ROUNDS_K    400
+#define PTE_RDONLY  (1ull << 7)
+#define PTE_AP_EL0  (1ull << 6)
+#define MSR_PAN_0   0xd500409fu
+#define MSR_PAN_1   0xd500419fu
+#define TCR2_FNG0   (1ull << 18)
+static uint64_t l1[2][512] __attribute__((aligned(4096)));
+static uint64_t l2[2][512] __attribute__((aligned(4096)));
+static uint64_t l3[2][NPG][512] __attribute__((aligned(4096)));
+static uint64_t l2g[512] __attribute__((aligned(4096)));
+static uint64_t l3g[512] __attribute__((aligned(4096)));
+
+static uint64_t l3s[2][512] __attribute__((aligned(4096)));
+static uint64_t l3e[2][512] __attribute__((aligned(4096)));
+static uint64_t l3gb[512] __attribute__((aligned(4096)));
+static uint8_t bpg[2][4][4096] __attribute__((aligned(4096)));
+static uint8_t gbpg[4][4096] __attribute__((aligned(4096)));
+static uint8_t spg[2][NSP][4096] __attribute__((aligned(4096)));
+static uint8_t pg[2][NPG][4096] __attribute__((aligned(4096)));
+static uint8_t gpg[2][4096] __attribute__((aligned(4096)));
+static uint8_t alt[4096] __attribute__((aligned(4096)));
+
+/* ttbr0, tcr, mair, sctlr, vbar for the secondaries */
+uint64_t mmu_cfg[8] __attribute__((aligned(64)));
+static uint32_t epoch __attribute__((aligned(64)));
+static uint32_t acks __attribute__((aligned(64)));
+static uint32_t fails __attribute__((aligned(64)));
+static uint32_t started_cpus __attribute__((aligned(64)));
+static uint32_t finished __attribute__((aligned(64)));
+static uint32_t go __attribute__((aligned(64)));
+
+static uint64_t rng_state = 0x9e3779b97f4a7c15ull;
+static uint64_t alt_tag;
+static uint64_t l3f[2][512] __attribute__((aligned(4096)));
+static uint64_t l3u[2][512] __attribute__((aligned(4096)));
+static uint64_t l3ug[512] __attribute__((aligned(4096)));
+static uint8_t fpg[2][4096] __attribute__((aligned(4096)));
+static uint8_t upg[2][NEL0][4096] __attribute__((aligned(4096)));
+static uint8_t ugpg[4096] __attribute__((aligned(4096)));
+static uint64_t l3r[2][512] __attribute__((aligned(4096)));
+static uint8_t rpg[2][4096] __attribute__((aligned(4096)));
+volatile uint64_t ro_faults;
+static uint64_t l3gc[512] __attribute__((aligned(4096)));
+static uint8_t gcode[2][4096] __attribute__((aligned(4096)));
+/* two 2 MiB blocks of otherwise unused RAM, inside the identity map */
+#define BLK_PA(v)   (0x50000000ull + (uint64_t)(v) * BLK_SIZE)
+
+static uint32_t rnd(void)
+{
+    uint64_t x = rng_state;
+
+    x ^= x << 13;
+    x ^= x >> 7;
+    x ^= x << 17;
+    rng_state = x;
+    return x >> 32;
+}
+
+static uint64_t ttbr_for(int asid)
+{
+    return ((uint64_t)asid << 48) | (uint64_t)l1[asid - 1];
+}
+
+static void set_ttbr(int asid)
+{
+    asm volatile("msr ttbr0_el1, %0\n\tisb" :: "r" (ttbr_for(asid)) : "memory");
+}
+
+static uint64_t tag_data(int asid, int i)
+{
+    return 0xd47a000000000000ull | ((uint64_t)asid << 32) | i;
+}
+
+static uint64_t tag_global(int version)
+{
+    return 0x610ba10000000000ull | version;
+}
+
+static uint64_t va_of(int i)
+{
+    return VA_BASE + (uint64_t)i * VA_STRIDE;
+}
+
+static uint64_t read64(uint64_t va)
+{
+    /* volatile: every read must reach the TLB, none may be merged */
+    return *(volatile uint64_t *)va;
+}
+
+static uint64_t call_code(void)
+{
+    uint64_t (*fn)(void) = (uint64_t (*)(void))CODE_VA;
+
+    return fn();
+}
+
+static uint64_t pte_ng(const void *page)
+{
+    return (uint64_t)page | PTE_PAGE | PTE_AF | PTE_SH_IS | PTE_NG;
+}
+
+static uint64_t pte_global(const void *page)
+{
+    return (uint64_t)page | PTE_PAGE | PTE_AF | PTE_SH_IS;
+}
+
+static void sync_icache_line(void *p)
+{
+    for (uint8_t *q = p; q < (uint8_t *)p + 16; q += 16) {
+        asm volatile("dc cvau, %0\n\tic ivau, %0" :: "r" (q) : "memory");
+    }
+}
+
+static void setup_tables(void)
+{
+    uint64_t *boot_ttb = (uint64_t *)(mmu_cfg[0] & 0x0000fffffffff000ull);
+
+    for (int a = 0; a < 2; a++) {
+        int asid = a + 1;
+
+        for (int i = 0; i < 512; i++) {
+            l1[a][i] = boot_ttb[i];
+        }
+        /* L1 index 2: nG pages, 16 MiB apart so each has its own L3 table */
+        l1[a][(VA_BASE >> 30) & 0x1ff] = (uint64_t)l2[a] | 3;
+        for (int i = 0; i < NPG; i++) {
+            uint64_t va = VA_BASE + (uint64_t)i * VA_STRIDE;
+
+            l2[a][(va >> 21) & 0x1ff] = (uint64_t)l3[a][i] | 3;
+            if (i < NVA) {
+                *(uint64_t *)pg[a][i] = tag_data(asid, i);
+                l3[a][i][0] = pte_ng(pg[a][i]);
+            }
+        }
+        /* NSP consecutive pages: different TLB slots, so they stay put */
+        l2[a][(SPREAD_VA >> 21) & 0x1ff] = (uint64_t)l3s[a] | 3;
+        for (int i = 0; i < NSP; i++) {
+            *(uint64_t *)spg[a][i] = tag_data(asid, 100 + i);
+            l3s[a][i] = pte_ng(spg[a][i]);
+        }
+        /* page NVA: code, "mov x0, #asid; ret" */
+        ((uint32_t *)pg[a][NVA])[0] = 0xd2800000u | ((uint32_t)asid << 5);
+        ((uint32_t *)pg[a][NVA])[1] = 0xd65f03c0u;
+        sync_icache_line(pg[a][NVA]);
+        l3[a][NVA][0] = pte_ng(pg[a][NVA]);
+        /* L1 index 3: global region, one set of tables for both */
+        l1[a][(GLOBAL_VA >> 30) & 0x1ff] = (uint64_t)l2g | 3;
+    }
+    for (int a = 0; a < 2; a++) {
+        l2[a][(BIG_VA >> 21) & 0x1ff] = (uint64_t)l3e[a] | 3;
+        for (int j = 0; j < 4; j++) {
+            *(uint64_t *)bpg[a][j] = tag_data(a + 1, 200 + j);
+        }
+        for (int i = 0; i < NBIG; i++) {
+            l3e[a][i] = pte_ng(bpg[a][i % 4]);
+        }
+    }
+    l2g[1] = (uint64_t)l3gb | 3;
+    for (int j = 0; j < 4; j++) {
+        *(uint64_t *)gbpg[j] = tag_global(100 + j);
+    }
+    for (int i = 0; i < NBIG; i++) {
+        l3gb[i] = pte_global(gbpg[i % 4]);
+    }
+    for (int a = 0; a < 2; a++) {
+        l2[a][(FNG_VA >> 21) & 0x1ff] = (uint64_t)l3f[a] | 3;
+        *(uint64_t *)fpg[a] = tag_data(a + 1, 400);
+        /* nG = 0, a different page per ASID */
+        l3f[a][0] = pte_global(fpg[a]);
+        l2[a][(EL0_VA >> 21) & 0x1ff] = (uint64_t)l3u[a] | 3;
+        for (int i = 0; i < NEL0; i++) {
+            *(uint64_t *)upg[a][i] = tag_data(a + 1, 300 + i);
+            l3u[a][i] = pte_ng(upg[a][i]) | PTE_AP_EL0;
+        }
+    }
+    for (int a = 0; a < 2; a++) {
+        l2[a][(RO_VA >> 21) & 0x1ff] = (uint64_t)l3r[a] | 3;
+        *(uint64_t *)rpg[a] = tag_data(a + 1, 500);
+        l3r[a][0] = pte_ng(rpg[a]) | PTE_RDONLY;
+    }
+    /* a global code page, "mov x0, #101 + version; ret" */
+    l2g[8] = (uint64_t)l3gc | 3;
+    for (int v = 0; v < 2; v++) {
+        ((uint32_t *)gcode[v])[0] = 0xd2800000u | ((uint32_t)(101 + v) << 5);
+        ((uint32_t *)gcode[v])[1] = 0xd65f03c0u;
+        sync_icache_line(gcode[v]);
+    }
+    l3gc[0] = pte_global(gcode[0]);
+    l2g[10] = BLK_PA(0) | 1 | PTE_AF | PTE_SH_IS;
+    l2g[2] = (uint64_t)l3ug | 3;
+    *(uint64_t *)ugpg = tag_global(300);
+    l3ug[0] = pte_global(ugpg) | PTE_AP_EL0;
+    l2g[0] = (uint64_t)l3g | 3;
+    *(uint64_t *)gpg[0] = tag_global(0);
+    *(uint64_t *)gpg[1] = tag_global(1);
+    alt_tag = tag_data(1, 0) ^ 0x5a5a5a5a;
+    *(uint64_t *)alt = alt_tag;
+    l3g[0] = pte_global(gpg[0]);
+    asm volatile("dsb ish\n\tisb" ::: "memory");
+}
+
+/* Phase A and C check: every nG page and the code page of this ASID. */
+static int check_asid(int asid)
+{
+    int bad = 0;
+    int order[NVA];
+
+    for (int i = 0; i < NVA; i++) {
+        order[i] = i;
+    }
+    for (int i = NVA - 1; i > 0; i--) {
+        int j = rnd() % (i + 1), t = order[i];
+
+        order[i] = order[j];
+        order[j] = t;
+    }
+    for (int k = 0; k < NVA; k++) {
+        int i = order[k];
+
+        if (read64(va_of(i)) != tag_data(asid, i)) {
+            bad++;
+        }
+    }
+    for (int i = 0; i < NSP; i++) {
+        if (read64(SPREAD_VA + (uint64_t)i * 4096) != tag_data(asid, 100 + i)) {
+            bad++;
+        }
+    }
+    if (call_code() != (uint64_t)asid) {
+        bad++;
+    }
+    return bad;
+}
+
+static int phase_a(void)
+{
+    int bad = 0;
+    int asid = 1;
+
+    set_ttbr(1);
+    for (int r = 0; r < ROUNDS_A; r++) {
+        /* mostly alternate, sometimes repeat the same ASID */
+        if (rnd() % 4) {
+            asid = 3 - asid;
+        }
+        set_ttbr(asid);
+        bad += check_asid(asid);
+        if (read64(GLOBAL_VA) != tag_global(0)) {
+            bad++;
+        }
+    }
+    return bad;
+}
+
+/*
+ * More nG and more global pages than the lists and the initial TLB hold:
+ * exercises the overflow walk and the table resize.
+ */
+static int phase_e(void)
+{
+    int bad = 0;
+    int asid = 1;
+
+    for (int r = 0; r < ROUNDS_E; r++) {
+        asid = 3 - asid;
+        set_ttbr(asid);
+        /* both orders, so that the last pages of one round are read first */
+        for (int n = 0; n < NBIG; n++) {
+            int i = (r & 1) ? NBIG - 1 - n : n;
+
+            if (read64(BIG_VA + (uint64_t)i * 4096) !=
+                tag_data(asid, 200 + i % 4)) {
+                bad++;
+            }
+            if (read64(GBIG_VA + (uint64_t)i * 4096) !=
+                tag_global(100 + i % 4)) {
+                bad++;
+            }
+        }
+        bad += check_asid(asid);
+    }
+    return bad;
+}
+
+static void tlbi_form(int form, int asid, uint64_t va)
+{
+    uint64_t page = (va >> 12) | ((uint64_t)asid << 48);
+    /* TG=1 (4KB), SCALE=0, NUM=0 (two pages), TTL=0 */
+    uint64_t range = (1ull << 46) | page;
+
+    asm volatile("dsb ishst" ::: "memory");
+    switch (form % 5) {
+    case 0:
+        asm volatile("tlbi vmalle1" ::: "memory");
+        break;
+    case 1:
+        asm volatile("tlbi vae1, %0" :: "r" (page) : "memory");
+        break;
+    case 2:
+        asm volatile("tlbi vale1, %0" :: "r" (page) : "memory");
+        break;
+    case 3:
+        asm volatile("tlbi vaae1, %0" :: "r" (page) : "memory");
+        break;
+    default:
+        asm volatile("tlbi rvae1, %0" :: "r" (range) : "memory");
+        break;
+    }
+    asm volatile("dsb ish\n\tisb" ::: "memory");
+}
+
+static int phase_b(void)
+{
+    int bad = 0;
+
+    for (int r = 1; r <= ROUNDS_B; r++) {
+        int ver = r & 1;
+        int first = 1 + (rnd() & 1);
+
+        /* warm the global entry in both ASIDs, then remap and flush */
+        set_ttbr(first);
+        (void)read64(GLOBAL_VA);
+        set_ttbr(3 - first);
+        (void)read64(GLOBAL_VA);
+        l3g[0] = pte_global(gpg[ver]);
+        tlbi_form(r, first, GLOBAL_VA);
+        /* the old entry must be gone in the current and the other ASID */
+        if (read64(GLOBAL_VA) != tag_global(ver)) {
+            bad++;
+        }
+        set_ttbr(first);
+        if (read64(GLOBAL_VA) != tag_global(ver)) {
+            bad++;
+        }
+        bad += check_asid(first);
+        set_ttbr(3 - first);
+        if (read64(GLOBAL_VA) != tag_global(ver)) {
+            bad++;
+        }
+        bad += check_asid(3 - first);
+
+        /* nG page of ASID 1 remapped, flushed by ASID or by VA */
+        set_ttbr(1);
+        (void)read64(va_of(0));
+        l3[0][0][0] = (r & 2) ? pte_ng(alt) : pte_ng(pg[0][0]);
+        asm volatile("dsb ishst" ::: "memory");
+        if (r & 4) {
+            asm volatile("tlbi aside1, %0"
+                         :: "r" ((uint64_t)1 << 48) : "memory");
+        } else {
+            tlbi_form(r >> 3, 1, va_of(0));
+        }
+        asm volatile("dsb ish\n\tisb" ::: "memory");
+        if (read64(va_of(0)) !=
+            ((r & 2) ? alt_tag : tag_data(1, 0))) {
+            bad++;
+        }
+        /* going away and coming back must not bring the old one back */
+        set_ttbr(2);
+        (void)read64(va_of(0));
+        set_ttbr(1);
+        if (read64(va_of(0)) !=
+            ((r & 2) ? alt_tag : tag_data(1, 0))) {
+            bad++;
+        }
+        /* put the page back for the next round's checks */
+        l3[0][0][0] = pte_ng(pg[0][0]);
+        tlbi_form(1, 1, va_of(0));
+    }
+    /*
+     * Global entry kept by two switches with no refill in between, then
+     * remapped and flushed with TLBI ALL: the flush must not be skipped.
+     */
+    for (int r = 1; r <= 200; r++) {
+        int ver = r & 1;
+
+        set_ttbr(1);
+        (void)read64(GLOBAL_VA);
+        set_ttbr(2);
+        (void)read64(GLOBAL_VA);
+        set_ttbr(1);
+        (void)read64(GLOBAL_VA);
+        l3g[0] = pte_global(gpg[ver]);
+        asm volatile("dsb ishst\n\ttlbi vmalle1\n\tdsb ish\n\tisb"
+                     ::: "memory");
+        if (read64(GLOBAL_VA) != tag_global(ver)) {
+            bad++;
+        }
+    }
+    /* restore */
+    l3[0][0][0] = pte_ng(pg[0][0]);
+    l3g[0] = pte_global(gpg[0]);
+    asm volatile("dsb ishst\n\ttlbi vmalle1\n\tdsb ish\n\tisb" ::: "memory");
+    return bad;
+}
+
+static uint64_t call_gcode(void)
+{
+    uint64_t (*fn)(void) = (uint64_t (*)(void))GCODE_VA;
+
+    return fn();
+}
+
+/*
+ * A global code page runs from the same jump cache entry across ASID
+ * switches, and a remap under any TLBI form is seen from both ASIDs.
+ */
+static int phase_j(void)
+{
+    int bad = 0;
+
+    for (int r = 1; r <= ROUNDS_J; r++) {
+        int ver = r & 1;
+        int first = 1 + (rnd() & 1);
+
+        /*
+         * CODE_VA and GCODE_VA use the same jump cache slot: the nG block
+         * that takes the slot over from the global one must not inherit its
+         * "keep" mark.
+         */
+        set_ttbr(first);
+        (void)call_gcode();
+        if (call_code() != (uint64_t)first) {
+            bad++;
+        }
+        set_ttbr(3 - first);
+        if (call_code() != (uint64_t)(3 - first)) {
+            bad++;
+        }
+        set_ttbr(first);
+        (void)call_gcode();
+        set_ttbr(3 - first);
+        (void)call_gcode();
+        set_ttbr(first);
+        if (call_gcode() != (uint64_t)(101 + (1 - ver))) {
+            bad++;
+        }
+        set_ttbr(3 - first);
+        (void)call_gcode();
+        l3gc[0] = pte_global(gcode[ver]);
+        tlbi_form(r, first, GCODE_VA);
+        if (call_gcode() != (uint64_t)(101 + ver)) {
+            bad++;
+        }
+        set_ttbr(first);
+        if (call_gcode() != (uint64_t)(101 + ver)) {
+            bad++;
+        }
+        bad += check_asid(first);
+    }
+    l3gc[0] = pte_global(gcode[0]);
+    asm volatile("dsb ishst\n\ttlbi vmalle1\n\tdsb ish\n\tisb" ::: "memory");
+    return bad;
+}
+
+static uint64_t call_blk(int slice)
+{
+    uint64_t (*fn)(void) = (uint64_t (*)(void))(BLK_VA + slice * 4096ull);
+
+    return fn();
+}
+
+/*
+ * The block is remapped and flushed by the address of one slice, so the
+ * translations of the other slices of the block must go as well.
+ */
+static int phase_k(void)
+{
+    int bad = 0;
+
+    /* fill both blocks with code through the mapping: "mov x0, #201 + v" */
+    set_ttbr(1);
+    for (int v = 0; v < 2; v++) {
+        l2g[10] = BLK_PA(v) | 1 | PTE_AF | PTE_SH_IS;
+        asm volatile("dsb ishst\n\ttlbi vmalle1\n\tdsb ish\n\tisb" ::: "memory");
+        for (int sl = 5; sl <= 9; sl += 4) {
+            uint32_t *c = (uint32_t *)(BLK_VA + sl * 4096ull);
+
+            c[0] = 0xd2800000u | ((uint32_t)(201 + v) << 5);
+            c[1] = 0xd65f03c0u;
+            sync_icache_line(c);
+        }
+    }
+    for (int r = 1; r <= ROUNDS_K; r++) {
+        int ver = r & 1;
+        int first = 1 + (rnd() & 1);
+
+        set_ttbr(first);
+        (void)call_blk(5);
+        (void)call_blk(9);
+        set_ttbr(3 - first);
+        (void)call_blk(5);
+        (void)call_blk(9);
+        set_ttbr(first);
+        (void)call_blk(5);
+        (void)call_blk(9);
+        l2g[10] = BLK_PA(ver) | 1 | PTE_AF | PTE_SH_IS;
+        /* forms 1 to 4 are by VA */
+        tlbi_form(1 + r % 4, first, BLK_VA + 0x1000);
+        if (call_blk(5) != (uint64_t)(201 + ver) ||
+            call_blk(9) != (uint64_t)(201 + ver)) {
+            bad++;
+        }
+        set_ttbr(3 - first);
+        if (call_blk(5) != (uint64_t)(201 + ver) ||
+            call_blk(9) != (uint64_t)(201 + ver)) {
+            bad++;
+        }
+    }
+    l2g[10] = BLK_PA(0) | 1 | PTE_AF | PTE_SH_IS;
+    asm volatile("dsb ishst\n\ttlbi vmalle1\n\tdsb ish\n\tisb" ::: "memory");
+    return bad;
+}
+
+/* ---- phase D: broadcast TLBI against vCPUs that keep switching ASID ---- */
+
+static void reader(void)
+{
+    uint32_t seen = 0, chatter = 0;
+    int asid = 1;
+
+    __atomic_fetch_add(&started_cpus, 1, __ATOMIC_ACQ_REL);
+    while (!__atomic_load_n(&go, __ATOMIC_ACQUIRE)) {
+    }
+    while (seen < ROUNDS_D) {
+        uint32_t e = __atomic_load_n(&epoch, __ATOMIC_ACQUIRE);
+
+        if (e != seen) {
+            /* The writer flushed and published: new mapping, both ASIDs. */
+            for (int a = 1; a <= 2; a++) {
+                set_ttbr(a);
+                if (read64(GLOBAL_VA) != tag_global(e & 1)) {
+                    __atomic_fetch_add(&fails, 1, __ATOMIC_RELAXED);
+                }
+            }
+            seen = e;
+            __atomic_fetch_add(&acks, 1, __ATOMIC_ACQ_REL);
+        } else {
+            asid = 3 - asid;
+            set_ttbr(asid);
+            (void)read64(GLOBAL_VA);
+            if (check_asid(asid)) {
+                __atomic_fetch_add(&fails, 1, __ATOMIC_RELAXED);
+            }
+            if (++chatter % 64 == 0) {
+                asm volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb"
+                             ::: "memory");
+            }
+        }
+    }
+    __atomic_fetch_add(&finished, 1, __ATOMIC_RELEASE);
+}
+
+__attribute__((used)) void sec_main(void)
+{
+    set_ttbr(1);
+    reader();
+    for (;;) {
+        asm volatile("wfe");
+    }
+}
+
+char sec_stacks[NCPUS * 4096] __attribute__((aligned(16)));
+
+asm(".text\n"
+    ".global sec_entry\n"
+    "sec_entry:\n"
+    "    adrp x0, mmu_cfg\n"
+    "    add x0, x0, :lo12:mmu_cfg\n"
+    "    ldp x1, x2, [x0]\n"
+    "    msr ttbr0_el1, x1\n"
+    "    msr tcr_el1, x2\n"
+    "    ldp x1, x2, [x0, #16]\n"
+    "    msr mair_el1, x1\n"
+    "    ldr x3, [x0, #32]\n"
+    "    msr vbar_el1, x3\n"
+    "    isb\n"
+    "    msr sctlr_el1, x2\n"
+    "    isb\n"
+    "    mrs x1, mpidr_el1\n"
+    "    and x1, x1, #0xff\n"
+    "    add x1, x1, #1\n"
+    "    lsl x1, x1, #12\n"
+    "    adrp x2, sec_stacks\n"
+    "    add x2, x2, :lo12:sec_stacks\n"
+    "    add x2, x2, x1\n"
+    "    mov sp, x2\n"
+    "    bl sec_main\n"
+    "1:  wfe\n"
+    "    b 1b\n");
+
+void sec_entry(void);
+
+static int64_t psci_cpu_on(uint64_t target, uint64_t entry)
+{
+    register uint64_t x0 asm("x0") = PSCI_CPU_ON;
+    register uint64_t x1 asm("x1") = target;
+    register uint64_t x2 asm("x2") = entry;
+    register uint64_t x3 asm("x3") = 0;
+
+    asm volatile("hvc #0" : "+r" (x0) : "r" (x1), "r" (x2), "r" (x3)
+                 : "memory");
+    return (int64_t)x0;
+}
+
+static void tlbi_is(int form)
+{
+    uint64_t page = GLOBAL_VA >> 12;
+    uint64_t range = (1ull << 46) | page;
+
+    asm volatile("dsb ishst" ::: "memory");
+    switch (form % 5) {
+    case 0:
+        asm volatile("tlbi vmalle1is" ::: "memory");
+        break;
+    case 1:
+        asm volatile("tlbi vae1is, %0" :: "r" (page) : "memory");
+        break;
+    case 2:
+        asm volatile("tlbi vaae1is, %0" :: "r" (page) : "memory");
+        break;
+    case 3:
+        asm volatile("tlbi vale1is, %0" :: "r" (page) : "memory");
+        break;
+    default:
+        asm volatile("tlbi rvaae1is, %0" :: "r" (range) : "memory");
+        break;
+    }
+    asm volatile("dsb ish\n\tisb" ::: "memory");
+}
+
+static void save_mmu_cfg(void)
+{
+    uint64_t v;
+
+    asm volatile("mrs %0, ttbr0_el1" : "=r" (v));
+    mmu_cfg[0] = v;
+    asm volatile("mrs %0, tcr_el1" : "=r" (v));
+    mmu_cfg[1] = v;
+    asm volatile("mrs %0, mair_el1" : "=r" (v));
+    mmu_cfg[2] = v;
+    asm volatile("mrs %0, sctlr_el1" : "=r" (v));
+    mmu_cfg[3] = v;
+    asm volatile("mrs %0, vbar_el1" : "=r" (v));
+    mmu_cfg[4] = v;
+    asm volatile("dsb ish" ::: "memory");
+}
+
+static int phase_d(void)
+{
+    uint32_t nread = 0;
+
+    for (unsigned cpu = 1; cpu < NCPUS; cpu++) {
+        if (psci_cpu_on(cpu, (uint64_t)sec_entry) == 0) {
+            nread++;
+        }
+    }
+    if (nread == 0) {
+        ml_printf("phase D skipped: no secondary vCPUs\n");
+        return 0;
+    }
+    for (unsigned spin = 0;
+         __atomic_load_n(&started_cpus, __ATOMIC_ACQUIRE) < nread &&
+         spin < 2000000000u; spin++) {
+    }
+    if (__atomic_load_n(&started_cpus, __ATOMIC_ACQUIRE) != nread) {
+        ml_printf("FAIL: secondaries did not start\n");
+        return 1;
+    }
+    __atomic_store_n(&go, 1, __ATOMIC_RELEASE);
+    set_ttbr(1);
+    for (uint32_t r = 1; r <= ROUNDS_D; r++) {
+        l3g[0] = pte_global(gpg[r & 1]);
+        tlbi_is(r);
+        if (read64(GLOBAL_VA) != tag_global(r & 1)) {
+            __atomic_fetch_add(&fails, 1, __ATOMIC_RELAXED);
+        }
+        set_ttbr(1 + (r & 1));
+        if (read64(GLOBAL_VA) != tag_global(r & 1)) {
+            __atomic_fetch_add(&fails, 1, __ATOMIC_RELAXED);
+        }
+        __atomic_store_n(&epoch, r, __ATOMIC_RELEASE);
+        for (unsigned spin = 0;
+             __atomic_load_n(&acks, __ATOMIC_ACQUIRE) < r * nread &&
+             spin < 400000000u; spin++) {
+        }
+        if (__atomic_load_n(&acks, __ATOMIC_ACQUIRE) < r * nread) {
+            ml_printf("FAIL: round %d not acknowledged\n", r);
+            return 1;
+        }
+    }
+    for (unsigned spin = 0;
+         __atomic_load_n(&finished, __ATOMIC_ACQUIRE) < nread &&
+         spin < 400000000u; spin++) {
+    }
+    return 0;
+}
+
+/*
+ * Synchronous exceptions from EL1h skip the faulting instruction and are
+ * counted.  The other vectors are never used.
+ */
+asm(".text\n"
+    ".balign 2048\n"
+    "as_vectors:\n"
+    ".skip 0x200\n"
+    "    stp x0, x1, [sp, #-16]!\n"
+    "    adrp x0, ro_faults\n"
+    "    add x0, x0, :lo12:ro_faults\n"
+    "    ldr x1, [x0]\n"
+    "    add x1, x1, #1\n"
+    "    str x1, [x0]\n"
+    "    mrs x0, elr_el1\n"
+    "    add x0, x0, #4\n"
+    "    msr elr_el1, x0\n"
+    "    ldp x0, x1, [sp], #16\n"
+    "    eret\n"
+    ".balign 0x800\n");
+extern char as_vectors[];
+
+/*
+ * A page that was read can be written by no ASID: the walk result kept for
+ * the read must not be used for the store, which has to fault.
+ */
+static int phase_i(void)
+{
+    uint64_t old_vbar;
+    int bad = 0;
+
+    asm volatile("mrs %0, vbar_el1\n\tmsr vbar_el1, %1\n\tisb"
+                 : "=&r" (old_vbar) : "r" (as_vectors));
+    for (int r = 0; r < ROUNDS_I; r++) {
+        int asid = 1 + (rnd() & 1);
+        uint64_t before;
+
+        set_ttbr(asid);
+        if (read64(RO_VA) != tag_data(asid, 500)) {
+            bad++;
+        }
+        set_ttbr(3 - asid);
+        if (read64(RO_VA) != tag_data(3 - asid, 500)) {
+            bad++;
+        }
+        set_ttbr(asid);
+        before = ro_faults;
+        asm volatile("str %1, [%0]" :: "r" (RO_VA), "r" (0x1234ull)
+                     : "memory");
+        if (ro_faults != before + 1) {
+            bad++;
+        }
+        if (read64(RO_VA) != tag_data(asid, 500)) {
+            bad++;
+        }
+    }
+    asm volatile("msr vbar_el1, %0\n\tisb" :: "r" (old_vbar));
+    return bad;
+}
+
+static uint64_t ldtr64(uint64_t va)
+{
+    uint64_t v;
+
+    /* an unprivileged load: translated with the EL0 mmu index */
+    asm volatile("ldtr %0, [%1]" : "=r" (v) : "r" (va) : "memory");
+    return v;
+}
+
+/*
+ * TCR2_EL1.FNG0 makes the nG = 0 pages of TTBR0 non-global: they have to be
+ * dropped by an ASID change like the others.
+ */
+static int phase_g(void)
+{
+    uint64_t v, mmfr3;
+    int bad = 0;
+
+    asm volatile("mrs %0, s3_0_c0_c7_3" : "=r" (mmfr3));
+    if ((mmfr3 & 0xf) == 0) {
+        ml_printf("phase G skipped: no TCR2\n");
+        return 0;
+    }
+    asm volatile("mrs %0, s3_0_c2_c0_3" : "=r" (v));
+    asm volatile("msr s3_0_c2_c0_3, %0\n\tisb" :: "r" (v | TCR2_FNG0));
+    asm volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" ::: "memory");
+    for (int r = 0; r < ROUNDS_G; r++) {
+        int asid = (r & 1) + 1;
+
+        if (rnd() % 4 == 0) {
+            asid = 3 - asid;
+        }
+        set_ttbr(asid);
+        if (read64(FNG_VA) != tag_data(asid, 400)) {
+            bad++;
+        }
+        if (read64(GLOBAL_VA) != tag_global(0)) {
+            bad++;
+        }
+    }
+    asm volatile("msr s3_0_c2_c0_3, %0\n\tisb" :: "r" (v));
+    asm volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" ::: "memory");
+    return bad;
+}
+
+/*
+ * The EL0 mmu index (unprivileged loads) and, with PSTATE.PAN set, the
+ * EL1 PAN one, each with a global page next to the non-global ones.
+ */
+static int phase_h(int pan)
+{
+    int bad = 0;
+    int asid = 1;
+
+    if (pan) {
+        asm volatile(".inst %0\n\tisb" :: "i" (MSR_PAN_1) : "memory");
+    }
+    for (int r = 0; r < ROUNDS_H; r++) {
+        if (rnd() % 4) {
+            asid = 3 - asid;
+        }
+        set_ttbr(asid);
+        for (int i = 0; i < NEL0; i++) {
+            if (ldtr64(EL0_VA + (uint64_t)i * 4096) !=
+                tag_data(asid, 300 + i)) {
+                bad++;
+            }
+        }
+        if (ldtr64(UG_VA) != tag_global(300)) {
+            bad++;
+        }
+        if (pan) {
+            bad += check_asid(asid);
+            if (read64(GLOBAL_VA) != tag_global(0)) {
+                bad++;
+            }
+        }
+    }
+    if (pan) {
+        asm volatile(".inst %0\n\tisb" :: "i" (MSR_PAN_0) : "memory");
+    }
+    return bad;
+}
+
+int main(void)
+{
+    int bad = 0, n;
+
+    ml_printf("ASID retention test\n");
+    save_mmu_cfg();
+    setup_tables();
+
+    n = phase_a();
+    ml_printf("phase A (switch, no TLBI): %d stale\n", n);
+    bad += n;
+    n = phase_g();
+    ml_printf("phase G (FNG0): %d stale\n", n);
+    bad += n;
+    n = phase_h(0);
+    ml_printf("phase H (EL0 index): %d stale\n", n);
+    bad += n;
+    n = phase_h(1);
+    ml_printf("phase H (EL0 and PAN indexes): %d stale\n", n);
+    bad += n;
+    n = phase_i();
+    ml_printf("phase I (store to a page that was read): %d stale\n", n);
+    bad += n;
+    n = phase_b();
+    ml_printf("phase B (remap + TLBI forms): %d stale\n", n);
+    bad += n;
+    n = phase_j();
+    ml_printf("phase J (global code page): %d stale\n", n);
+    bad += n;
+    n = phase_k();
+    ml_printf("phase K (slice of a 2 MiB block): %d stale\n", n);
+    bad += n;
+    n = phase_e();
+    ml_printf("phase E (more pages than the TLB holds): %d stale\n", n);
+    bad += n;
+    n = phase_d();
+    bad += n;
+    n = __atomic_load_n(&fails, __ATOMIC_ACQUIRE);
+    ml_printf("phase D (TLBI IS vs switching vCPUs): %d stale\n", n);
+    bad += n;
+    ml_printf(bad ? "FAILED\n" : "OK\n");
+    return bad != 0;
+}
diff --git a/tests/tcg/aarch64/system/bti-guarded.c b/tests/tcg/aarch64/system/bti-guarded.c
new file mode 100644
index 0000000000..793e29b6bd
--- /dev/null
+++ b/tests/tcg/aarch64/system/bti-guarded.c
@@ -0,0 +1,247 @@
+/*
+ * BTYPE of BR depends on the guarded attribute of the branch's own page.
+ *
+ * "br x1" sets BTYPE to 3 when the page it runs from is guarded and to 1
+ * when it is not.  The landing pad "bti c" accepts BTYPE 1 and rejects 3,
+ * so whether a Branch Target exception is taken tells which attribute the
+ * branch saw.  The attribute is flipped by rewriting the page descriptor
+ * and invalidating the page by VA, over and over, while the same
+ * translation blocks keep running: the decision must follow the page table
+ * and cannot be frozen in a translation block or survive the TLBI.
+ *
+ * Also covers a "br" that sits on the first insn of the page after a
+ * fall through from the previous page, with either page guarded, and
+ * "br x16", whose BTYPE is 1 whatever the attribute.
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define BASE_VA     0x80000000ull
+#define PTE_PAGE    0x3ull
+#define PTE_AF      (1ull << 10)
+#define PTE_SH_IS   (3ull << 8)
+#define PTE_GP      (1ull << 50)
+#define SCTLR_BT1   (1ull << 36)
+#define ESR_EC_BTI  0x0dull
+
+#define INSN_BTI_C  0xd503245fu
+#define INSN_BTI_JC 0xd50324dfu
+#define INSN_NOP    0xd503201fu
+#define INSN_RET    0xd65f03c0u
+#define INSN_BR_X1  0xd61f0020u
+#define INSN_BR_X16 0xd61f0200u
+
+enum { P_SPAN_A, P_SPAN_B, P_LAND, P_BR_X1, P_BR_X16, NPAGES };
+
+static uint64_t l2_table[512] __attribute__((aligned(4096)));
+static uint64_t l3_table[512] __attribute__((aligned(4096)));
+static uint32_t code_pg[NPAGES][1024] __attribute__((aligned(4096)));
+static int guarded[NPAGES];
+
+volatile uint64_t last_esr;
+volatile uint64_t trapped;
+volatile uint64_t resume_pc;
+
+/*
+ * Synchronous exceptions from EL1h: remember ESR_EL1, clear the BTYPE of the
+ * saved state and resume at resume_pc.  The other vectors are never used.
+ */
+asm(".text\n"
+    ".balign 2048\n"
+    "bti_vectors:\n"
+    ".skip 0x200\n"
+    "    mrs x16, esr_el1\n"
+    "    adrp x17, last_esr\n"
+    "    add x17, x17, :lo12:last_esr\n"
+    "    str x16, [x17]\n"
+    "    adrp x17, trapped\n"
+    "    add x17, x17, :lo12:trapped\n"
+    "    mov x16, #1\n"
+    "    str x16, [x17]\n"
+    "    adrp x17, resume_pc\n"
+    "    add x17, x17, :lo12:resume_pc\n"
+    "    ldr x16, [x17]\n"
+    "    msr elr_el1, x16\n"
+    "    mrs x16, spsr_el1\n"
+    "    bic x16, x16, #0xc00\n"
+    "    msr spsr_el1, x16\n"
+    "    eret\n"
+    ".balign 0x800\n");
+extern char bti_vectors[];
+
+static uint64_t va_of(int k)
+{
+    return BASE_VA + ((uint64_t)k << 12);
+}
+
+static void map_page(int k, int guard)
+{
+    uint64_t pte = (uint64_t)code_pg[k] | PTE_PAGE | PTE_AF | PTE_SH_IS;
+
+    if (guard) {
+        pte |= PTE_GP;
+    }
+    guarded[k] = guard;
+    __atomic_store_n(&l3_table[(va_of(k) >> 12) & 0x1ff], pte,
+                     __ATOMIC_RELEASE);
+}
+
+/* Change the attribute, then invalidate the page by VA as a kernel would. */
+static void set_guard(int k, int guard)
+{
+    uint64_t page = va_of(k) >> 12;
+
+    map_page(k, guard);
+    asm volatile("dsb ishst\n\ttlbi vae1is, %0\n\tdsb ish\n\tisb"
+                 :: "r" (page) : "memory");
+}
+
+static void sync_code(void *page)
+{
+    asm volatile("dc cvau, %0\n\tdsb ish\n\tic ivau, %0\n\tdsb ish\n\tisb"
+                 :: "r" (page) : "memory");
+}
+
+static void setup(void)
+{
+    uint64_t ttbr, v;
+    uint64_t *ttb;
+
+    asm volatile("mrs %0, ttbr0_el1" : "=r" (ttbr));
+    ttb = (uint64_t *)(ttbr & 0x0000fffffffff000ull);
+
+    /* The landing pad: bti c; ret.  Always guarded. */
+    code_pg[P_LAND][0] = INSN_BTI_C;
+    code_pg[P_LAND][1] = INSN_RET;
+    /* Entry with a landing pad of its own, then the branch under test. */
+    code_pg[P_BR_X1][0] = INSN_BTI_JC;
+    code_pg[P_BR_X1][1] = INSN_BR_X1;
+    code_pg[P_BR_X16][0] = INSN_BTI_JC;
+    code_pg[P_BR_X16][1] = INSN_BR_X16;
+    /*
+     * Last two insns of page A, then the branch on the first insn of the
+     * next page.  Entered at A + 0xff8 with BLR, so it begins with a pad.
+     */
+    code_pg[P_SPAN_A][0x3fe] = INSN_BTI_JC;
+    code_pg[P_SPAN_A][0x3ff] = INSN_NOP;
+    code_pg[P_SPAN_B][0] = INSN_BR_X1;
+    for (int k = 0; k < NPAGES; k++) {
+        sync_code(code_pg[k]);
+    }
+    ttb[(BASE_VA >> 30) & 0x1ff] = (uint64_t)l2_table | 3;
+    l2_table[0] = (uint64_t)l3_table | 3;
+    for (int k = 0; k < NPAGES; k++) {
+        map_page(k, k == P_LAND);
+    }
+    asm volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" ::: "memory");
+
+    asm volatile("msr vbar_el1, %0\n\tisb" :: "r" (bti_vectors));
+    asm volatile("mrs %0, sctlr_el1" : "=r" (v));
+    asm volatile("msr sctlr_el1, %0\n\tisb" :: "r" (v | SCTLR_BT1));
+}
+
+/*
+ * Call code at @entry that ends in "br" to @target (through x1, and x16).
+ * The landing pad returns to the label after the call.  Returns 1 when a
+ * Branch Target exception was taken instead.
+ */
+static int call_entry(uint64_t entry, uint64_t target, int via_blr)
+{
+    register uint64_t x1 asm("x1") = target;
+    register uint64_t x16 asm("x16") = target;
+    volatile uint64_t *rp = &resume_pc;
+
+    trapped = 0;
+    if (via_blr) {
+        asm volatile("adr x2, 1f\n\t"
+                     "str x2, [%[rp]]\n\t"
+                     "blr %[e]\n"
+                     "1:"
+                     : "+r" (x1), "+r" (x16)
+                     : [rp] "r" (rp), [e] "r" (entry)
+                     : "x2", "x30", "memory", "cc");
+    } else {
+        asm volatile("adr x2, 1f\n\t"
+                     "str x2, [%[rp]]\n\t"
+                     "adr x30, 1f\n\t"
+                     "br %[e]\n"
+                     "1:"
+                     : "+r" (x1), "+r" (x16)
+                     : [rp] "r" (rp), [e] "r" (entry)
+                     : "x2", "x30", "memory", "cc");
+    }
+    return trapped;
+}
+
+static int bad;
+
+static void expect(const char *what, int k, int got, int want)
+{
+    if (got != want) {
+        if (bad < 8) {
+            ml_printf("FAIL: %s page %d guarded %d: trap %d, want %d "
+                      "(esr %lx)\n", what, k, guarded[k], got, want,
+                      (unsigned long)last_esr);
+        }
+        bad++;
+    } else if (got && (last_esr >> 26) != ESR_EC_BTI) {
+        ml_printf("FAIL: %s: exception class %lx is not a BTI exception\n",
+                  what, (unsigned long)(last_esr >> 26));
+        bad++;
+    }
+}
+
+int main(void)
+{
+    ml_printf("BTI guarded attribute test\n");
+    setup();
+
+    /* 1: br x1 from a page whose attribute alternates, both call forms */
+    for (int i = 0; i < 400; i++) {
+        int guard = i & 1;
+
+        set_guard(P_BR_X1, guard);
+        for (int r = 0; r < 3; r++) {
+            expect("br x1", P_BR_X1,
+                   call_entry(va_of(P_BR_X1), va_of(P_LAND), r & 1), guard);
+        }
+    }
+
+    /* 2: the br is on the page after the one the entry is on */
+    set_guard(P_SPAN_A, 0);
+    for (int i = 0; i < 400; i++) {
+        int guard = i & 1;
+
+        set_guard(P_SPAN_B, guard);
+        for (int r = 0; r < 3; r++) {
+            expect("span", P_SPAN_B,
+                   call_entry(va_of(P_SPAN_A) + 0xff8, va_of(P_LAND), 1),
+                   guard);
+        }
+    }
+    /* the guarded attribute of the first page does not matter */
+    set_guard(P_SPAN_B, 0);
+    for (int i = 0; i < 100; i++) {
+        set_guard(P_SPAN_A, i & 1);
+        expect("span first page", P_SPAN_A,
+               call_entry(va_of(P_SPAN_A) + 0xff8, va_of(P_LAND), 1), 0);
+    }
+
+    /* 3: br x16 has BTYPE 1 on either kind of page */
+    for (int i = 0; i < 200; i++) {
+        set_guard(P_BR_X16, i & 1);
+        expect("br x16", P_BR_X16,
+               call_entry(va_of(P_BR_X16), va_of(P_LAND), i & 2), 0);
+    }
+
+    if (bad) {
+        ml_printf("FAIL: %d wrong outcomes\n", bad);
+        return 1;
+    }
+    ml_printf("OK\n");
+    return 0;
+}
diff --git a/tests/tcg/aarch64/system/indirect-branch.c b/tests/tcg/aarch64/system/indirect-branch.c
new file mode 100644
index 0000000000..d338b33886
--- /dev/null
+++ b/tests/tcg/aarch64/system/indirect-branch.c
@@ -0,0 +1,511 @@
+/*
+ * Indirect branch and return test for the inline jump cache probe.
+ *
+ * 80 virtual pages hold "mov x0, #n; ret".  The jump cache has 64 page
+ * slots, and the hash mixes the next six bits of the page number into
+ * the slot, so page k and page k + 65 share one.  Every vCPU keeps
+ * calling them with BLR,
+ * and with BR plus RET, so that BR, BLR and RET all take the probe.  The
+ * boot vCPU changes one page per round by writing new code to the idle
+ * physical page of that virtual page, mapping it and issuing a broadcast
+ * TLBI (rotating through the full, by-page, by-last-level, all-ASID and
+ * range forms).  After a round is published, every vCPU must run the new
+ * code in all pages through both call forms, or the test fails.
+ *
+ * Two phases on the boot vCPU run code whose translation depends on state
+ * that is not in the pc: "rdvl x0, #1; ret" while ZCR_EL1.LEN alternates
+ * (the vector length is a constant in the translation), and
+ * "ldr x0, [x1]; ret" from a page EL0 can read while PSTATE.PAN alternates
+ * (the load faults with PAN, and the handler skips it).  A jump cache hit
+ * that ignores the TB flags returns the result of the other setting.
+ *
+ * Rewriting code in place from another vCPU is covered by smc-concurrent.
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define PSCI_CPU_ON 0xc4000003ull
+#define NCPUS       4
+#define NPAGES      80
+#define ROUNDS      2500
+#define BASE_VA     0x80000000ull
+
+#define PTE_PAGE    0x3ull
+#define PTE_AF      (1ull << 10)
+#define PTE_SH_IS   (3ull << 8)
+#define PTE_AP_EL0  (1ull << 6)
+#define MSR_PAN_0   0xd500409fu
+#define MSR_PAN_1   0xd500419fu
+
+static uint64_t l2_table[512] __attribute__((aligned(4096)));
+static uint64_t l3_table[512] __attribute__((aligned(4096)));
+static uint32_t code_pg[NPAGES][2][1024] __attribute__((aligned(4096)));
+static uint32_t active[NPAGES];
+static uint32_t vl_pg[1024] __attribute__((aligned(4096)));
+static uint32_t pan_code[1024] __attribute__((aligned(4096)));
+static uint64_t pan_data[512] __attribute__((aligned(4096)));
+static uint32_t expect[NPAGES] __attribute__((aligned(64)));
+
+/* ttbr0, tcr, mair, sctlr, vbar for the secondaries */
+uint64_t mmu_cfg[8] __attribute__((aligned(64)));
+static uint32_t epoch __attribute__((aligned(64)));
+static uint32_t acks __attribute__((aligned(64)));
+static uint32_t fails __attribute__((aligned(64)));
+static uint32_t started_cpus __attribute__((aligned(64)));
+static uint32_t finished __attribute__((aligned(64)));
+static uint32_t go __attribute__((aligned(64)));
+static uint32_t first_bad_set;
+static uint64_t first_bad[6];
+
+/* Consecutive pages; page k and k + 65 use the same jump cache page slot. */
+static uint64_t va_of(int k)
+{
+    return BASE_VA + ((uint64_t)k << 12);
+}
+
+static uint64_t pte_for(const void *page)
+{
+    return (uint64_t)page | PTE_PAGE | PTE_AF | PTE_SH_IS;
+}
+
+static void write_code(uint32_t *page, uint32_t value)
+{
+    page[0] = 0xd2800000u | (value << 5);   /* movz x0, #value */
+    page[1] = 0xd65f03c0u;                  /* ret */
+}
+
+static void sync_code(void *page)
+{
+    asm volatile("dc cvau, %0\n\tdsb ish\n\tic ivau, %0\n\tdsb ish\n\tisb"
+                 :: "r" (page) : "memory");
+}
+
+static uint64_t call_blr(uint64_t va)
+{
+    register uint64_t x0 asm("x0");
+
+    asm volatile("blr %1"
+                 : "=r" (x0) : "r" (va)
+                 : "x30", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8",
+                   "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16",
+                   "x17", "memory", "cc");
+    return x0;
+}
+
+static uint64_t call_br(uint64_t va)
+{
+    register uint64_t x0 asm("x0");
+
+    /* BR into the page, whose RET comes back to the label in x30 */
+    asm volatile("adr x30, 1f\n\t"
+                 "br %1\n"
+                 "1:"
+                 : "=r" (x0) : "r" (va)
+                 : "x30", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8",
+                   "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16",
+                   "x17", "memory", "cc");
+    return x0;
+}
+
+static uint32_t rnd_state[NCPUS] = { 1, 2, 3, 4 };
+
+static uint32_t rnd(int cpu)
+{
+    uint32_t x = rnd_state[cpu];
+
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    rnd_state[cpu] = x;
+    return x;
+}
+
+static void note_bad(int k, uint32_t want, uint64_t g1, uint64_t g2)
+{
+    if (!first_bad_set) {
+        first_bad_set = 1;
+        first_bad[0] = k;
+        first_bad[1] = want;
+        first_bad[2] = g1;
+        first_bad[3] = g2;
+        first_bad[4] = __atomic_load_n(&epoch, __ATOMIC_RELAXED);
+        asm volatile("mrs %0, mpidr_el1" : "=r" (first_bad[5]));
+    }
+}
+
+/*
+ * One pass per call form: the jump cache entry of a page is then still
+ * there, with the BTYPE the next call uses, when a page that shares its
+ * slot is called, and only the pc tells them apart.
+ */
+static int check_all(void)
+{
+    int bad = 0;
+
+    for (int k = 0; k < NPAGES; k++) {
+        uint32_t want = __atomic_load_n(&expect[k], __ATOMIC_ACQUIRE);
+        uint64_t g = call_blr(va_of(k));
+
+        if (g != want) {
+            note_bad(k, want, g, want);
+            bad++;
+        }
+    }
+    for (int k = 0; k < NPAGES; k++) {
+        uint32_t want = __atomic_load_n(&expect[k], __ATOMIC_ACQUIRE);
+        uint64_t g = call_br(va_of(k));
+
+        if (g != want) {
+            note_bad(k, want, want, g);
+            bad++;
+        }
+    }
+    return bad;
+}
+
+static void churn(int cpu)
+{
+    /* keep the jump cache and the TB cache hot with all of the pages */
+    for (int i = 0; i < 8; i++) {
+        uint64_t va = va_of(rnd(cpu) % NPAGES);
+
+        (void)call_blr(va);
+        (void)call_br(va);
+    }
+}
+
+static void reader(int cpu)
+{
+    uint32_t seen = 0, chatter = 0;
+
+    __atomic_fetch_add(&started_cpus, 1, __ATOMIC_ACQ_REL);
+    while (!__atomic_load_n(&go, __ATOMIC_ACQUIRE)) {
+    }
+    while (seen < ROUNDS) {
+        uint32_t e = __atomic_load_n(&epoch, __ATOMIC_ACQUIRE);
+
+        if (e != seen) {
+            asm volatile("isb" ::: "memory");
+            if (check_all()) {
+                __atomic_fetch_add(&fails, 1, __ATOMIC_RELAXED);
+            }
+            seen = e;
+            __atomic_fetch_add(&acks, 1, __ATOMIC_ACQ_REL);
+        } else {
+            churn(cpu);
+            if (++chatter % 64 == 0) {
+                asm volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb"
+                             ::: "memory");
+            }
+        }
+    }
+    __atomic_fetch_add(&finished, 1, __ATOMIC_RELEASE);
+}
+
+__attribute__((used)) void sec_main(void)
+{
+    uint64_t id;
+
+    asm volatile("mrs %0, mpidr_el1" : "=r" (id));
+    reader((int)(id & 0xff) % NCPUS);
+    for (;;) {
+        asm volatile("wfe");
+    }
+}
+
+char sec_stacks[NCPUS * 4096] __attribute__((aligned(16)));
+
+asm(".text\n"
+    ".global sec_entry\n"
+    "sec_entry:\n"
+    "    adrp x0, mmu_cfg\n"
+    "    add x0, x0, :lo12:mmu_cfg\n"
+    "    ldp x1, x2, [x0]\n"
+    "    msr ttbr0_el1, x1\n"
+    "    msr tcr_el1, x2\n"
+    "    ldp x1, x2, [x0, #16]\n"
+    "    msr mair_el1, x1\n"
+    "    ldr x3, [x0, #32]\n"
+    "    msr vbar_el1, x3\n"
+    "    isb\n"
+    "    msr sctlr_el1, x2\n"
+    "    isb\n"
+    "    mrs x1, mpidr_el1\n"
+    "    and x1, x1, #0xff\n"
+    "    add x1, x1, #1\n"
+    "    lsl x1, x1, #12\n"
+    "    adrp x2, sec_stacks\n"
+    "    add x2, x2, :lo12:sec_stacks\n"
+    "    add x2, x2, x1\n"
+    "    mov sp, x2\n"
+    "    bl sec_main\n"
+    "1:  wfe\n"
+    "    b 1b\n");
+
+void sec_entry(void);
+
+static int64_t psci_cpu_on(uint64_t target, uint64_t entry)
+{
+    register uint64_t x0 asm("x0") = PSCI_CPU_ON;
+    register uint64_t x1 asm("x1") = target;
+    register uint64_t x2 asm("x2") = entry;
+    register uint64_t x3 asm("x3") = 0;
+
+    asm volatile("hvc #0" : "+r" (x0) : "r" (x1), "r" (x2), "r" (x3)
+                 : "memory");
+    return (int64_t)x0;
+}
+
+static void tlbi_page(int form, uint64_t va)
+{
+    uint64_t page = va >> 12;
+    /* TG=1 (4KB), SCALE=0, NUM=0 (two pages), TTL=0 */
+    uint64_t range = (1ull << 46) | page;
+
+    asm volatile("dsb ishst" ::: "memory");
+    switch (form % 5) {
+    case 0:
+        asm volatile("tlbi vmalle1is" ::: "memory");
+        break;
+    case 1:
+        asm volatile("tlbi vae1is, %0" :: "r" (page) : "memory");
+        break;
+    case 2:
+        asm volatile("tlbi vale1is, %0" :: "r" (page) : "memory");
+        break;
+    case 3:
+        asm volatile("tlbi vaae1is, %0" :: "r" (page) : "memory");
+        break;
+    default:
+        asm volatile("tlbi rvae1is, %0" :: "r" (range) : "memory");
+        break;
+    }
+    asm volatile("dsb ish\n\tisb" ::: "memory");
+}
+
+static void setup_pages(void)
+{
+    uint64_t *ttb = (uint64_t *)(mmu_cfg[0] & 0x0000fffffffff000ull);
+
+    for (int k = 0; k < NPAGES; k++) {
+        active[k] = 0;
+        expect[k] = 0x100 + k;
+        write_code(code_pg[k][0], expect[k]);
+        write_code(code_pg[k][1], 0);
+        sync_code(code_pg[k][0]);
+        sync_code(code_pg[k][1]);
+        l3_table[(va_of(k) >> 12) & 0x1ff] = pte_for(code_pg[k][0]);
+    }
+    /* VA 0x80000000: L1 index 2 -> l2_table[0] -> l3_table */
+    ttb[(BASE_VA >> 30) & 0x1ff] = (uint64_t)l2_table | 3;
+    l2_table[0] = (uint64_t)l3_table | 3;
+    asm volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" ::: "memory");
+}
+
+static void save_mmu_cfg(void)
+{
+    uint64_t v;
+
+    asm volatile("mrs %0, ttbr0_el1" : "=r" (v));
+    mmu_cfg[0] = v;
+    asm volatile("mrs %0, tcr_el1" : "=r" (v));
+    mmu_cfg[1] = v;
+    asm volatile("mrs %0, mair_el1" : "=r" (v));
+    mmu_cfg[2] = v;
+    asm volatile("mrs %0, sctlr_el1" : "=r" (v));
+    mmu_cfg[3] = v;
+    asm volatile("mrs %0, vbar_el1" : "=r" (v));
+    mmu_cfg[4] = v;
+    asm volatile("dsb ish" ::: "memory");
+}
+
+/*
+ * Synchronous exceptions from EL1h skip the faulting instruction.  The
+ * other vectors are never used.
+ */
+asm(".text\n"
+    ".balign 2048\n"
+    "ib_vectors:\n"
+    ".skip 0x200\n"
+    "    mrs x16, elr_el1\n"
+    "    add x16, x16, #4\n"
+    "    msr elr_el1, x16\n"
+    "    eret\n"
+    ".balign 0x800\n");
+extern char ib_vectors[];
+
+#define PAN_MAGIC 0x5a5a1234ull
+
+static uint64_t call_ldr(uint64_t va, int use_br)
+{
+    register uint64_t x0 asm("x0") = 0xdead;
+    register uint64_t x1 asm("x1") = va_of(NPAGES + 2);
+
+    if (use_br) {
+        asm volatile("adr x30, 1f\n\tbr %2\n1:"
+                     : "+r" (x0) : "r" (x1), "r" (va) : "x16", "x30", "memory");
+    } else {
+        asm volatile("blr %2"
+                     : "+r" (x0) : "r" (x1), "r" (va) : "x16", "x30", "memory");
+    }
+    return x0;
+}
+
+static int pan_phase(void)
+{
+    uint64_t va = va_of(NPAGES + 1);
+    uint64_t old_vbar;
+    int bad = 0;
+
+    pan_data[0] = PAN_MAGIC;
+    pan_code[0] = 0xf9400020u;              /* ldr x0, [x1] */
+    pan_code[1] = 0xd65f03c0u;              /* ret */
+    sync_code(pan_code);
+    __atomic_store_n(&l3_table[(va >> 12) & 0x1ff], pte_for(pan_code),
+                     __ATOMIC_RELEASE);
+    /* the data page can be read from EL0, so PAN makes the load fault */
+    __atomic_store_n(&l3_table[((va + 0x1000) >> 12) & 0x1ff],
+                     pte_for(pan_data) | PTE_AP_EL0, __ATOMIC_RELEASE);
+    asm volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" ::: "memory");
+    asm volatile("mrs %0, vbar_el1\n\tmsr vbar_el1, %1\n\tisb"
+                 : "=&r" (old_vbar) : "r" (ib_vectors));
+
+    /*
+     * One call form per pass, so the entry left by the previous setting
+     * has the BTYPE of this call and only the flags tell them apart.
+     */
+    for (int i = 0; i < 8000; i++) {
+        int pan = i & 1;
+        int use_br = i >= 4000;
+        uint64_t want = pan ? 0xdead : PAN_MAGIC;
+
+        if (pan) {
+            asm volatile(".inst %0\n\tisb" :: "i" (MSR_PAN_1) : "memory");
+        } else {
+            asm volatile(".inst %0\n\tisb" :: "i" (MSR_PAN_0) : "memory");
+        }
+        if (call_ldr(va, use_br) != want) {
+            bad++;
+        }
+    }
+    asm volatile(".inst %0\n\tisb" :: "i" (MSR_PAN_0) : "memory");
+    asm volatile("msr vbar_el1, %0\n\tisb" :: "r" (old_vbar));
+    return bad;
+}
+
+/* RDVL x0, #1 */
+#define RDVL_X0_1 0x04bf5020u
+
+static int vl_phase(void)
+{
+    uint64_t va = va_of(NPAGES);
+    uint64_t cpacr;
+    int bad = 0;
+
+    vl_pg[0] = RDVL_X0_1;
+    vl_pg[1] = 0xd65f03c0u;                 /* ret */
+    sync_code(vl_pg);
+    __atomic_store_n(&l3_table[(va >> 12) & 0x1ff], pte_for(vl_pg),
+                     __ATOMIC_RELEASE);
+    asm volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb"
+                 ::: "memory");
+    asm volatile("mrs %0, cpacr_el1" : "=r" (cpacr));
+    asm volatile("msr cpacr_el1, %0\n\tisb" :: "r" (cpacr | (3ull << 16)));
+
+    for (int i = 0; i < 4000; i++) {
+        uint64_t len = i & 1;
+        uint64_t want = (len + 1) * 16;
+
+        asm volatile("msr s3_0_c1_c2_0, %0\n\tisb" :: "r" (len));
+        if (call_blr(va) != want || call_br(va) != want) {
+            bad++;
+        }
+    }
+    return bad;
+}
+
+int main(void)
+{
+    uint32_t nread = 0;
+    uint32_t rs = 12345;
+
+    ml_printf("Indirect branch test\n");
+    save_mmu_cfg();
+    setup_pages();
+    for (unsigned cpu = 1; cpu < NCPUS; cpu++) {
+        if (psci_cpu_on(cpu, (uint64_t)sec_entry) == 0) {
+            nread++;
+        }
+    }
+    for (unsigned spin = 0;
+         __atomic_load_n(&started_cpus, __ATOMIC_ACQUIRE) < nread &&
+         spin < 2000000000u; spin++) {
+    }
+    if (__atomic_load_n(&started_cpus, __ATOMIC_ACQUIRE) != nread) {
+        ml_printf("FAIL: secondaries did not start\n");
+        return 1;
+    }
+    ml_printf("%d reader vCPUs\n", nread);
+    if (vl_phase()) {
+        ml_printf("FAIL: stale vector length in the jump cache\n");
+        return 1;
+    }
+    if (pan_phase()) {
+        ml_printf("FAIL: stale PAN state in the jump cache\n");
+        return 1;
+    }
+    __atomic_store_n(&go, 1, __ATOMIC_RELEASE);
+
+    for (uint32_t r = 1; r <= ROUNDS; r++) {
+        int k;
+        uint32_t value;
+
+        rs ^= rs << 13;
+        rs ^= rs >> 17;
+        rs ^= rs << 5;
+        k = rs % NPAGES;
+        value = ((r * 7 + k) & 0xfff) + 1;
+
+        /* write the idle page, then map it */
+        uint32_t other = active[k] ^ 1;
+
+        write_code(code_pg[k][other], value);
+        sync_code(code_pg[k][other]);
+        __atomic_store_n(&l3_table[(va_of(k) >> 12) & 0x1ff],
+                         pte_for(code_pg[k][other]), __ATOMIC_RELEASE);
+        active[k] = other;
+        tlbi_page(r, va_of(k));
+        asm volatile("isb" ::: "memory");
+        __atomic_store_n(&expect[k], value, __ATOMIC_RELEASE);
+        if (check_all()) {
+            __atomic_fetch_add(&fails, 1, __ATOMIC_RELAXED);
+        }
+        __atomic_store_n(&epoch, r, __ATOMIC_RELEASE);
+        for (unsigned spin = 0;
+             __atomic_load_n(&acks, __ATOMIC_ACQUIRE) < r * nread &&
+             spin < 400000000u; spin++) {
+        }
+        if (__atomic_load_n(&acks, __ATOMIC_ACQUIRE) < r * nread) {
+            ml_printf("FAIL: round %d not acknowledged\n", r);
+            return 1;
+        }
+    }
+    for (unsigned spin = 0;
+         __atomic_load_n(&finished, __ATOMIC_ACQUIRE) < nread &&
+         spin < 400000000u; spin++) {
+    }
+    if (fails) {
+        ml_printf("FAIL: %d stale or wrong calls observed\n", fails);
+        ml_printf("first: page %d want %x blr %x br %x epoch %d cpu %d\n",
+                  (int)first_bad[0], (int)first_bad[1], (int)first_bad[2],
+                  (int)first_bad[3], (int)first_bad[4],
+                  (int)(first_bad[5] & 0xff));
+        return 1;
+    }
+    ml_printf("OK\n");
+    return 0;
+}
