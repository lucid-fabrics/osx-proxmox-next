 }
+
+bool translator_can_probe_jmp_cache(DisasContextBase *db)
+{
+#ifdef CONFIG_USER_ONLY
+    return false;
+#else
+    uint32_t cflags = tb_cflags(db->tb);
+
+    if (TCG_TARGET_REG_BITS != 64) {
+        return false;
+    }
+    /* Same reasons as for not using goto_ptr, plus logging and counting. */
+    if (cflags & (CF_NO_GOTO_PTR | CF_NO_GOTO_TB | CF_SINGLE_STEP |
+                  CF_USE_ICOUNT | CF_BP_PAGE | CF_COUNT_MASK)) {
+        return false;
+    }
+    return !qemu_loglevel_mask(CPU_LOG_EXEC | CPU_LOG_TB_CPU |
+                               CPU_LOG_TB_NOCHAIN);
+#endif
+}
+
+void translator_gen_jmp_cache_probe(DisasContextBase *db, TCGv_i64 pc,
+                                    TCGv_i32 flags, TCGv_i64 cs_base,
+                                    TCGLabel *miss)
+{
+#ifndef CONFIG_USER_ONLY
+    /* The cache is indexed as tb_jmp_cache_hash_func() does. */
+    const unsigned shift = qemu_target_page_bits() - TB_JMP_PAGE_BITS;
+    const intptr_t cpu_off = -(intptr_t)sizeof(CPUState);
+    TCGv_ptr jc = tcg_temp_new_ptr();
+    TCGv_ptr ent = tcg_temp_new_ptr();
+    TCGv_ptr tb = tcg_temp_new_ptr();
+    TCGv_i64 idx = tcg_temp_new_i64();
+    TCGv_i64 tmp = tcg_temp_new_i64();
+    TCGv_i32 t32 = tcg_temp_new_i32();
+    TCGv_i32 cf = tcg_temp_new_i32();
+
+    QEMU_BUILD_BUG_ON(sizeof_field(CPUJumpCache, array[0]) != 16);
+    QEMU_BUILD_BUG_ON(sizeof_field(CPUState, singlestep_flags) != 4);
+    QEMU_BUILD_BUG_ON(sizeof_field(CPUState, tcg_cflags) != 4);
+
+    /* A breakpoint or a gdb single step needs the full tb_lookup path. */
+    tcg_gen_ld_ptr(tb, tcg_env,
+                   offsetof(CPUState, breakpoints.tqh_first) + cpu_off);
+    tcg_gen_brcondi_ptr(TCG_COND_NE, tb, 0, miss);
+    tcg_gen_ld_i32(t32, tcg_env,
+                   offsetof(CPUState, singlestep_flags) + cpu_off);
+    tcg_gen_brcondi_i32(TCG_COND_NE, t32, 0, miss);
+
+    tcg_gen_ld_ptr(jc, tcg_env, offsetof(CPUState, tb_jmp_cache) + cpu_off);
+    tcg_gen_brcondi_ptr(TCG_COND_EQ, jc, 0, miss);
+
+    /* idx = tb_jmp_cache_hash_func(pc) */
+    tcg_gen_shri_i64(tmp, pc, shift);
+    tcg_gen_xor_i64(tmp, tmp, pc);
+    tcg_gen_shri_i64(idx, tmp, shift);
+    tcg_gen_andi_i64(idx, idx, TB_JMP_PAGE_MASK);
+    tcg_gen_andi_i64(tmp, tmp, TB_JMP_ADDR_MASK);
+    tcg_gen_or_i64(idx, idx, tmp);
+    tcg_gen_shli_i64(idx, idx, 4);
+    tcg_gen_trunc_i64_ptr(ent, idx);
+    tcg_gen_add_ptr(ent, ent, jc);
+
+    /* tb_lookup() jump cache hit conditions */
+    tcg_gen_ld_ptr(tb, ent, offsetof(CPUJumpCache, array[0].tb));
+    tcg_gen_brcondi_ptr(TCG_COND_EQ, tb, 0, miss);
+    tcg_gen_ld_i64(tmp, ent, offsetof(CPUJumpCache, array[0].pc));
+    tcg_gen_brcond_i64(TCG_COND_NE, tmp, pc, miss);
+    tcg_gen_ld_i64(tmp, tb, offsetof(TranslationBlock, cs_base));
+    tcg_gen_brcond_i64(TCG_COND_NE, tmp, cs_base, miss);
+    tcg_gen_ld_i32(t32, tb, offsetof(TranslationBlock, flags));
+    tcg_gen_brcond_i32(TCG_COND_NE, t32, flags, miss);
+    tcg_gen_ld_i32(t32, tb, offsetof(TranslationBlock, cflags));
+    tcg_gen_ld_i32(cf, tcg_env, offsetof(CPUState, tcg_cflags) + cpu_off);
+    tcg_gen_brcond_i32(TCG_COND_NE, t32, cf, miss);
+
+    /* Hit: run the block. */
+    tcg_gen_ld_ptr(tb, tb, offsetof(TranslationBlock, tc.ptr));
+    tcg_gen_goto_ptr(tb);
+
+#endif
+}
