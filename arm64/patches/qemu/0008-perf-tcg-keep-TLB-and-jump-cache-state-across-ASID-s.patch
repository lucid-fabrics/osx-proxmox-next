+static void tlb_stats_dump(bool force)
+{
+    static TLBStats prev;
+    int64_t now = get_clock_realtime();
+    uint64_t last = qatomic_read(&tlb_stats.last_dump_ns);
+    TLBStats cur;
+    int i;
+
+    if (!force &&
+        (now - last < 15 * NANOSECONDS_PER_SECOND ||
+         qatomic_cmpxchg(&tlb_stats.last_dump_ns, last, now) != last)) {
+        return;
+    }
+    memcpy(&cur, &tlb_stats, sizeof(cur));
+    fprintf(stderr, "TLBSTAT dt_ms=%" PRId64, (now - (int64_t)last) / 1000000);
