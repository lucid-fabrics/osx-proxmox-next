+void tlb_flush_non_global_by_mmuidx(CPUState *cpu, MMUIdxMap global_idxmap)
+{
+    int64_t now = get_clock_realtime();
+    MMUIdxMap work, dirty, keep = 0;
+    uint64_t ts_t0 G_GNUC_UNUSED = tlbs_now();
+    assert_cpu_is_self(cpu);
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    dirty = cpu->neg.tlb.c.dirty;
+    for (work = dirty; work != 0; work &= work - 1) {
+        int mmu_idx = ctz32(work);
+
+        if ((global_idxmap >> mmu_idx) & 1) {
+            if (tlb_flush_non_global_one_locked(cpu, mmu_idx, now)) {
+                keep |= 1 << mmu_idx;
+            }
+        } else {
+            tlb_flush_one_mmuidx_locked(cpu, mmu_idx, now);
+        }
+    }
+    cpu->neg.tlb.c.dirty = keep;
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+
+    tcg_flush_jmp_cache(cpu);
+    TLBS_INC(TS_JC_FLUSH);
+    TLBS_INC(TS_FLUSH_ASID);
+    TLBS_CYC(flush_cyc, ts_t0);
+    if (keep == 0) {
+        qatomic_set(&cpu->neg.tlb.c.full_flush_count,
+                    cpu->neg.tlb.c.full_flush_count + 1);
+    } else {
+        qatomic_set(&cpu->neg.tlb.c.part_flush_count,
+                    cpu->neg.tlb.c.part_flush_count + ctpop16(dirty & ~keep));
+    }
