+static bool tlb_range_hits_large_page(CPUTLBDesc *d, vaddr addr, vaddr len)
+{
+    vaddr lp_addr = d->large_page_addr;
+    vaddr lp_end;
+
+    if (lp_addr == (vaddr)-1) {
+        return false;
+    }
+    /* large_page_mask has all 1's from the msb down to the region size */
+    lp_end = lp_addr | ~d->large_page_mask;
+    return addr <= lp_end && addr + len - 1 >= lp_addr;
+}
