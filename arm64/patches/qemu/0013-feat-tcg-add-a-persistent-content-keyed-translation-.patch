diff --git a/tests/tcg/aarch64/system/pcache-bytes.c b/tests/tcg/aarch64/system/pcache-bytes.c
new file mode 100644
index 0000000000..05fae5d627
--- /dev/null
+++ b/tests/tcg/aarch64/system/pcache-bytes.c
@@ -0,0 +1,49 @@
+/*
+ * Persistent translation cache: the guest bytes are part of the key.
+ *
+ * pcb_fn sits at the start of a page of its own and does "mov w0, #VARIANT;
+ * ret". The kernel is built twice, VARIANT 1 and VARIANT 2, so that the two
+ * images differ in one byte of one instruction and are otherwise laid out
+ * the same: the page offset, the TB flags and the cs_base of pcb_fn are the
+ * same in both boots. Run the first image to fill a pack and then the
+ * second against that pack: a translation found by anything but the bytes
+ * would make it return 1.
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#ifndef VARIANT
+#define VARIANT 1
+#endif
+#define STR_(x) #x
+#define STR(x) STR_(x)
+
+asm(".text\n"
+    ".balign 16384\n"
+    "pcb_fn:\n"
+    "    nop\n"
+    "    nop\n"
+    "    mov w0, #" STR(VARIANT) "\n"
+    "    ret\n"
+    ".balign 16384\n");
+
+int main(void)
+{
+    uint64_t (*fn)(void);
+    uint64_t r;
+
+    asm("adr %0, pcb_fn" : "=r"(fn));
+
+    ml_printf("Persistent cache bytes test, variant %d\n", VARIANT);
+    r = fn();
+    if (r != VARIANT) {
+        ml_printf("FAIL: pcb_fn returned %d, expected %d\n", (int)r, VARIANT);
+        return 1;
+    }
+    ml_printf("OK\n");
+    return 0;
+}
diff --git a/tests/tcg/aarch64/system/pcache-ptr.c b/tests/tcg/aarch64/system/pcache-ptr.c
new file mode 100644
index 0000000000..fa4120aec3
--- /dev/null
+++ b/tests/tcg/aarch64/system/pcache-ptr.c
@@ -0,0 +1,46 @@
+/*
+ * Persistent translation cache: a 64 bit constant that looks like a host
+ * pointer is not stored.
+ *
+ * The code of a stored block is copied to another process, where a host
+ * address inside it would be wrong. The relocations the backend knows (rel32
+ * to the epilogue, helper addresses) are recorded; anything else in a movabs
+ * or constant pool slot that falls in the range of user space addresses of
+ * the host is taken for a pointer and the block is not stored. This kernel
+ * runs blocks with such constants, and the harness checks that the cache
+ * rejected them (rej_ptr) while the results stay right across two boots.
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define K1 0x00006a5a5a5a5a5aull
+#define K2 0x00007f1234567890ull
+
+static uint64_t __attribute__((noinline)) mix(uint64_t x)
+{
+    uint64_t a = K1, b = K2;
+
+    asm volatile("" : "+r"(a), "+r"(b));
+    return (x ^ K1) + (x & K2) + (a ^ b);
+}
+
+int main(void)
+{
+    uint64_t v = 1, w = 1;
+
+    ml_printf("Persistent cache pointer-like constant test\n");
+    for (int i = 0; i < 100; i++) {
+        v = mix(v);
+        w = (w ^ K1) + (w & K2) + (K1 ^ K2);
+    }
+    if (v != w) {
+        ml_printf("FAIL: %lx != %lx\n", v, w);
+        return 1;
+    }
+    ml_printf("OK\n");
+    return 0;
+}
diff --git a/tests/tcg/aarch64/system/pcache-run.sh b/tests/tcg/aarch64/system/pcache-run.sh
new file mode 100755
index 0000000000..193ab9eb82
--- /dev/null
+++ b/tests/tcg/aarch64/system/pcache-run.sh
@@ -0,0 +1,127 @@
+#!/bin/bash
+# pcache-run.sh QEMU QEMU_HOOKS OUT.csv [BUILD_DIR]
+#
+# End to end tests of the persistent translation cache on aarch64 system
+# kernels, and the mutants that each must break:
+#
+#   bytes   one changed byte of a function between two boots of one pack
+#   ptr     blocks holding a host pointer like constant are not stored
+#   pan     TB flags change while a pack fills (tests/.../ret-stack)
+#   reloc   a stored block runs again at another address (ret-stack, warm)
+#
+# QEMU is the normal build; QEMU_HOOKS is the same source built with
+# -DPCACHE_TEST_HOOKS, which honours PCACHE_MUTANT=n:
+#   1 ignore TB flags in the key        2 skip the guest byte compare
+#   7 store blocks with host pointers   8 do not relocate on load
+#   9 do not look for relocations when proving
+#   10 sort the constant pool by raw address (needs PCACHE_VERIFY=1 to show)
+#   11 the second emission of the proof reads the guest page, not the
+#      snapshot (shows under PCACHE_ABA=1, which changes the first word of
+#      every block while its snapshot is taken and back after)
+set -u
+Q=$1; QH=$2; OUT=$3
+S=${QEMU_SRC:-/home/snap/s1/qemu}
+B=${4:-/home/snap/s1/matrix/t}
+T=$S/tests/tcg/aarch64/system
+W=$(mktemp -d /tmp/pcache-run.XXXXXX)
+CF="--target=aarch64-none-elf -ffreestanding -nostdlib -fno-stack-protector -fno-builtin -ggdb -O0 -isystem $S/tests/tcg/minilib -march=armv8.5-a+memtag"
+RUN="-L $S/pc-bios -display none -m 512M -M virt -cpu max -smp 2 -monitor none -serial none -chardev stdio,id=output -semihosting-config enable=on,target=native,chardev=output"
+
+build() { # name variant
+  clang $CF -DVARIANT=${2:-1} -c $T/$1.c -o $W/$1-$2.o || exit 1
+  ld.lld -static -nostdlib -T $T/kernel.ld $B/boot.o $W/$1-$2.o $B/printf.o -o $W/$1-$2 || exit 1
+}
+build pcache-bytes 1
+build pcache-bytes 2
+build pcache-ptr 0
+
+# boot BIN KERNEL PACKDIR [ENV...]: prints "rc status stats"
+boot() {
+  local bin=$1 k=$2 dir=$3; shift 3
+  local o=$W/out.$$.$RANDOM
+  env "$@" timeout 120 $bin $RUN -accel tcg,pcache=$dir -kernel $k </dev/null >$o 2>&1
+  local rc=$?
+  local ok=0; grep -q '^OK' $o && ok=1
+  local st; st=$(grep -o 'hits=[0-9]* \|stores=[0-9]* \|rej_ptr=[0-9]*\|rej_size=[0-9]*\|verify_ok=[0-9]*\|verify_bad=[0-9]*' $o | tr -d '\n')
+  # NEED=regex: the stats must show it, else the boot counts as failed
+  if [ -n "${NEED:-}" ] && ! echo "$st" | grep -q "$NEED"; then ok=0; fi
+  echo "$rc $ok $st"
+  rm -f $o
+}
+
+echo "mutant,test,expect,rc,ok,stats,verdict" > $OUT
+row() { # mutant test expect(pass|fail) result...
+  local m=$1 t=$2 e=$3; shift 3
+  local rc=$1 ok=$2; shift 2
+  local v
+  if [ "$e" = pass ]; then [ "$rc" = 0 ] && [ "$ok" = 1 ] && v=ok || v=WRONG
+  else { [ "$rc" != 0 ] || [ "$ok" != 1 ]; } && v=ok || v=WRONG; fi
+  echo "$m,$t,$e,$rc,$ok,\"$*\",$v" >> $OUT
+}
+
+# no mutant: both boots of the bytes test pass, the second one used the pack
+P=$W/p1
+row none bytes-boot1 pass $(boot $Q $W/pcache-bytes-1 $P)
+r=$(boot $Q $W/pcache-bytes-2 $P)
+row none bytes-boot2 pass $r
+# and the pack really was used by it
+case "$r" in *hits=[1-9]*) row none bytes-boot2-used-pack pass 0 1;;
+             *) row none bytes-boot2-used-pack pass 1 0;; esac
+# ptr test: pass, and the blocks with pointer like constants were rejected
+P=$W/p2
+row none ptr-boot1 pass $(NEED='rej_ptr=[1-9]' boot $Q $W/pcache-ptr-0 $P)
+row none ptr-boot2 pass $(boot $Q $W/pcache-ptr-0 $P)
+# ret-stack changes PAN and ZCR in one boot, then again against its pack
+P=$W/p3
+row none retstack-fill pass $(boot $Q $B/ret-stack $P)
+row none retstack-warm pass $(boot $Q $B/ret-stack $P)
+
+# mutants
+P=$W/m2; boot $QH $W/pcache-bytes-1 $P >/dev/null
+row 2 bytes-boot2 fail $(boot $QH $W/pcache-bytes-2 $P PCACHE_MUTANT=2)
+P=$W/m7
+row 7 ptr-boot1 fail $(NEED='rej_ptr=[1-9]' boot $QH $W/pcache-ptr-0 $P PCACHE_MUTANT=7)
+P=$W/m1
+row 1 retstack-fill fail $(boot $QH $B/ret-stack $P PCACHE_MUTANT=1)
+P=$W/m8; boot $QH $B/ret-stack $P >/dev/null
+row 8 retstack-warm fail $(boot $QH $B/ret-stack $P PCACHE_MUTANT=8)
+P=$W/m9; boot $QH $B/ret-stack $P PCACHE_MUTANT=9 >/dev/null
+row 9 retstack-warm fail $(boot $QH $B/ret-stack $P PCACHE_MUTANT=9)
+# verify mode (test hooks): every block loaded equals a fresh translation
+P=$W/v1
+row none verify-fill pass $(NEED='verify_bad=0' boot $QH $B/ret-stack $P PCACHE_VERIFY=1)
+row none verify-warm pass $(NEED='verify_ok=[1-9][0-9]*verify_bad=0' boot $QH $B/ret-stack $P PCACHE_VERIFY=1)
+# 10: sort the constant pool by raw address: the order moves with ASLR, but
+# only where two values tie in their low bytes, so one boot may not show it:
+# up to 12 boots with fresh packs, each one a fill then a verified warm boot
+bad10=0
+for i in $(seq 12); do
+  P=$W/m10; rm -rf $P
+  boot $QH $B/ret-stack $P PCACHE_MUTANT=10 >/dev/null
+  r=$(boot $QH $B/ret-stack $P PCACHE_MUTANT=10 PCACHE_VERIFY=1)
+  case "$r" in *verify_bad=0*) ;; *) bad10=1; break;; esac
+done
+row 10 verify-warm fail $([ $bad10 = 1 ] && echo "1 0 tries=$i" || echo "0 1 tries=12")
+# the bytes of a block change while it is recorded and change back (ABA): the
+# proof must reject every block whose code depends on the changed word, and the
+# mutant that reads the live page stores them
+P=$W/aba
+row none aba-fill pass $(NEED='rej_size=[1-9]' boot $QH $B/ret-stack $P PCACHE_ABA=1)
+P=$W/m11
+row 11 aba-fill fail $(NEED='rej_size=[1-9]' boot $QH $B/ret-stack $P PCACHE_ABA=1 PCACHE_MUTANT=11)
+# a plugin sees no translation of a block loaded from the pack: with -plugin
+# the pack must stay off (no hits, no stores) and the guest still passes
+PL=${PLUGIN_SO:-$(dirname $Q)/contrib/plugins/libbbv.so}
+if [ -f $PL ]; then
+  P=$W/plug2
+  o=$W/plug.out
+  timeout 120 $Q $RUN -accel tcg,pcache=$P -plugin $PL,interval=100,outfile=$W/bbv -kernel $B/ret-stack </dev/null >$o 2>&1
+  rc=$?
+  if grep -q '^OK' $o && grep -q 'pcache: disabled' $o && ! ls $P/*.pack >/dev/null 2>&1; then
+    row none plugin-disables-pack pass $rc 1
+  else
+    row none plugin-disables-pack pass 1 0
+  fi
+fi
+rm -rf $W
+! grep -q ',WRONG$' $OUT
