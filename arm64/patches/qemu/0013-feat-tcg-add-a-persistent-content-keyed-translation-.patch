+         * the caller does not know about: release it, drop the block.
+         */
+        tb_unlock_page1(phys_pc, tb_page_addr1(tb2));
+        len_b = -1;
+    }
+    if (len_b >= 0 && tb_smc_gen_changed()) {
+        len_b = -1;
+    }
+    if (len_b < 0) {
+        qatomic_set(&tcg_ctx->code_gen_ptr, save);
+        tb_pcache_note_noproof(PCACHE_NOPROOF_TWIN);
+        return;
+    }
+    search_b = encode_search(tb2, (uint8_t *)tcg_splitwx_to_rw(
+                                 (void *)tb2->tc.ptr) + len_b);
+    if (search_b < 0) {
+        qatomic_set(&tcg_ctx->code_gen_ptr, save);
+        tb_pcache_note_noproof(PCACHE_NOPROOF_TWIN);
+        return;
+    }
+    t.cpu = cpu;
+    t.s = s;
+    t.guest = gsnap;
+    t.tb_a = tb;
+    t.tb_b = tb2;
+    t.code_a = code_a;
+    t.code_b = tcg_splitwx_to_rw((void *)tb2->tc.ptr);
+    t.code_len_a = len_a;
+    t.code_len_b = len_b;
+    t.search_len_a = search_a;
