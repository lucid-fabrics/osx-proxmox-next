+#ifndef CONFIG_USER_ONLY
+/*
+ * Persistent cache: emit the block just translated into @tb once more, in
+ * scratch space behind it, so that tb_pcache_commit() can tell which bytes of
+ * the code depend on where it sits. Called with the first emission complete
+ * and the buffer pointer not yet advanced past it.
+ */
+static void tb_pcache_record(CPUState *cpu, CPUArchState *env,
+                             TranslationBlock *tb, const TCGTBCPUState *s,
+                             tb_page_addr_t phys_pc, void *host_pc,
+                             uint8_t *code_a, int len_a, int search_a,
+                             uint64_t cycles, bool verify)
+{
+    PCacheTwin t;
+    uint8_t gsnap[2048 + 64];
+    TranslationBlock *tb2;
+    void *save = tcg_ctx->code_gen_ptr;
+    void *data_a = tcg_ctx->data_gen_ptr;
+    uintptr_t end_a, t2;
+    int len_b, search_b, max_insns = tb->icount;
+    int64_t ti;
+
+    if (tb_page_addr1(tb) != -1 || tb->size > sizeof(gsnap)) {
+        tb_pcache_note_noproof(PCACHE_NOPROOF_SPAN);
+        return;
+    }
+    /*
+     * The bytes that are stored are copied before the second emission, which
+     * reads them again: a write in between makes the two emissions differ
+     * and the proof fail, so the code stored always belongs to the bytes.
+     */
+    memset(gsnap, 0, sizeof(gsnap));
+    if (tb_pcache_test_aba()) {
+        /* test hook: the first word is another one while it is copied */
+        ((uint32_t *)host_pc)[0] ^= 0x80000000u;
+    }
+    memcpy(gsnap, host_pc, tb->size);
+    if (tb_pcache_test_aba()) {
+        ((uint32_t *)host_pc)[0] ^= 0x80000000u;
+    }
+    memset(&t, 0, sizeof(t));
+    t.nptrs_a = tcg_ctx->pcache_nptrs;
+    memcpy(t.ptrs_a, tcg_ctx->pcache_ptrs, sizeof(t.ptrs_a));
+    t.ptr_ovf = tcg_ctx->pcache_ptr_ovf;
+    t.pool_off_a = tcg_ctx->data_gen_ptr ?
+                   (uint8_t *)tcg_ctx->data_gen_ptr - code_a : -1;
+
+    /*
+     * The second TB struct goes at an address that differs from the first
+     * by 64 modulo 256, so that the low byte of every address field changes.
+     */
+    end_a = ROUND_UP((uintptr_t)code_a + len_a + search_a, 256);
+    t2 = end_a + ((((uintptr_t)tb + 64) - end_a) & 255);
+    if ((uint8_t *)t2 + 2 * len_a + 2 * search_a + 8192 >
+        (uint8_t *)tcg_ctx->code_gen_highwater) {
+        tb_pcache_note_noproof(PCACHE_NOPROOF_SPACE);
+        return;
+    }
+    qatomic_set(&tcg_ctx->code_gen_ptr, (void *)t2);
+    tb2 = tcg_tb_alloc(tcg_ctx);
+    if (!tb2 || (uintptr_t)tb2 != t2) {
+        qatomic_set(&tcg_ctx->code_gen_ptr, save);
+        tb_pcache_note_noproof(PCACHE_NOPROOF_SPACE);
+        return;
+    }
+    *tb2 = *tb;
+    tb2->tc.ptr = tcg_splitwx_to_rx(tcg_ctx->code_gen_ptr);
+    tb_set_page_addr0(tb2, phys_pc);
+    tb_set_page_addr1(tb2, -1);
+    tcg_ctx->gen_tb = tb2;
+    /*
+     * The second emission reads the snapshot, not the guest page: bytes that
+     * changed and changed back between the two emissions cannot make them
+     * agree on code that does not belong to the bytes stored.
+     */
+    len_b = setjmp_gen_code(env, tb2, s->pc,
+                            tb_pcache_test_live_twin() ? host_pc : gsnap,
+                            &max_insns, &ti);
+    tcg_ctx->gen_tb = NULL;
+    if (tb_page_addr1(tb2) != -1) {
