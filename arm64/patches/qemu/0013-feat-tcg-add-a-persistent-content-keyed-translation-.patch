+
+static void arm_pcache_hash_cpu(CPUState *cs,
+                                void (*add)(void *, const void *, size_t),
+                                void *opaque)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    uint32_t misc[8] = {
+        cpu->sve_max_vq, cpu->sme_max_vq, cpu->pauth_impdef_compat,
+        cpu->pauth_inline_ok, cpu->gm_blocksize, get_dczid_bs(cpu),
+        cpu->x_page_bits, cpu->prop_pauth_original,
+    };
+
+    /* what aarch64_tr_init_disas_context() and the translator read */
+    guint nkeys;
+    gpointer *keys = g_hash_table_get_keys_as_array(cpu->cp_regs, &nkeys);
+
+    qsort(keys, nkeys, sizeof(*keys), arm_pcache_cmp_key);
+    for (guint i = 0; i < nkeys; i++) {
+        const ARMCPRegInfo *ri = g_hash_table_lookup(cpu->cp_regs, keys[i]);
+        uint64_t d[8] = {
+            GPOINTER_TO_UINT(keys[i]), ri->type, ri->state, ri->access,
+            ri->fieldoffset, ri->resetvalue,
+            (ri->accessfn != NULL) | (ri->readfn != NULL) << 1 |
+            (ri->writefn != NULL) << 2 | (uint64_t)ri->secure << 8,
+            (uint64_t)ri->crn << 32 | ri->crm << 16 | ri->opc0 << 8 |
+            ri->opc1 << 4 | ri->opc2,
+        };
+        add(opaque, d, sizeof(d));
+    }
+    g_free(keys);
+    add(opaque, &cpu->isar, sizeof(cpu->isar));
+    add(opaque, &cpu->env.features, sizeof(cpu->env.features));
+    add(opaque, misc, sizeof(misc));
+}
+#endif
