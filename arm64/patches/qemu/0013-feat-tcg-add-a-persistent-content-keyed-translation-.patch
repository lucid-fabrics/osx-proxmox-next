index 0000000000..44c5649875
--- /dev/null
+++ b/accel/tcg/pcache-tcg.c
@@ -0,0 +1,888 @@
+/*
+ * Persistent translation cache: the glue between the pack (pcache.c) and
+ * tb_gen_code().
+ *
+ * What a stored translation is. The guest bytes of a block, the host code
+ * emitted for it, its unwind data, and the list of fields of that code that
+ * depend on where it was emitted. A translation is only stored when it is
+ * proven relocatable: tb_gen_code() emits the block a second time at another
+ * address, and every byte that differs must be a rel32 field to a fixed
+ * address (the epilogue, the executable image) or an absolute pointer into
+ * the TB's own struct. Absolute pointers into the executable (helper
+ * addresses in the constant pool) cannot differ between two emissions in one
+ * process, so the backend notes each helper address it emits
+ * (tcg_pcache_note_ptr) and those are recorded as image relative. Anything
+ * else that looks like a host pointer (heap pointers such as ARMCPRegInfo
+ * constants) fails the scan and the block is simply not stored.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qemu/error-report.h"
+#include "qemu/target-info.h"
+#include "qemu/cacheinfo.h"
+#include "qapi/error.h"
+#include "exec/cpu-common.h"
+#include "exec/target_page.h"
+#include "exec/icount.h"
+#include "accel/tcg/cpu-ops.h"
+#include "semihosting/semihost.h"
+#include "host/cpuinfo.h"
+#include "qemu/plugin.h"
+#include "qemu/config-file.h"
+#include "qemu/option.h"
+#include "pcache.h"
+#include "pcache-tcg.h"
+#include "internal-common.h"
+
+#if defined(HOST_X86_64) && defined(CONFIG_LINUX)
+#include <link.h>
+
+bool tb_pcache_on;
+
+#define PT_MAX_RELOCS 1024
+#define PT_PTR_LO 0x400000000000ull
+#define PT_PTR_HI 0x800000000000ull
+#define PT_NO_FLAGS (CF_COUNT_MASK | CF_SINGLE_STEP | CF_MEMI_ONLY | \
+                     CF_USE_ICOUNT | CF_INVALID | CF_NOIRQ | CF_BP_PAGE | \
+                     CF_NO_GOTO_TB | CF_NO_GOTO_PTR)
+
+enum {
+    R_NOPROOF_SPAN,
+    R_NOPROOF_SPACE,
+    R_NOPROOF_TWIN,
+    R_SIZE,
+    R_FIELDS,
+    R_SEARCH,
+    R_PTRSET,
+    R_DIFF,
+    R_TARGET,
+    R_PTR,
+    R_TOOMANY,
+    R_STORE_FAIL,
+    R_COUNT
+};
+
+static const char *const reason_names[R_COUNT] = {
+    "noproof_span", "noproof_space", "noproof_twin", "size", "fields",
+    "search", "ptrset", "diff", "target", "ptr", "toomany", "storefail",
+};
+
+static struct {
+    char *dir;
+    bool rw;
+    uint64_t cap;
+    int state;                  /* 0 not opened, 1 open, 2 unusable */
+    QemuMutex lock;
+    PCache *c;
+    uintptr_t img_lo, img_hi;   /* the executable's image */
+    int64_t t0_ns;
+    int64_t t0_ticks;
+    uint64_t lookups, hits, misses;
+    uint64_t load_ticks, miss_ticks, translate_ticks, proof_ticks;
+    uint64_t hit_cycles;        /* what the hits would have cost to translate */
+    uint64_t hit_bytes;         /* guest bytes of the hits */
+    uint64_t stored_bytes;
+    uint64_t reloc_fail;
+    uint64_t reject[R_COUNT];
+    uint64_t relocs;
+    uint64_t ineligible;
+    uint64_t verify_ok, verify_bad;
+    unsigned interval_ms;
+} pt;
+
+#ifdef PCACHE_TEST_HOOKS
+static int pt_mutant(void)
+{
+    static int m = -1;
+    if (m < 0) {
+        const char *e = getenv("PCACHE_MUTANT");
+        m = e ? atoi(e) : 0;
+    }
+    return m;
+}
+#else
+#define pt_mutant() 0
+#endif
+
+enum {
+    MUT_NO_PTR_SCAN = 7,
+    MUT_NO_RELOC = 8,
+    MUT_NO_DIFF = 9,
+    MUT_POOL_ORDER = 10,
+    MUT_LIVE_TWIN = 11,
+};
+
+#ifdef PCACHE_TEST_HOOKS
+/* PCACHE_ABA=1: the guest bytes change while a block is recorded and back */
+bool tb_pcache_test_aba(void)
+{
+    static int a = -1;
+    if (a < 0) {
+        a = getenv("PCACHE_ABA") != NULL;
+    }
+    return a;
+}
+/* mutant 11: the second emission reads the guest page, not the snapshot */
+bool tb_pcache_test_live_twin(void)
+{
+    return pt_mutant() == MUT_LIVE_TWIN;
+}
+#endif
+
+uint64_t tb_pcache_ticks(void)
+{
+    return cpu_get_host_ticks();
+}
+
+void tb_pcache_add_translate_ticks(uint64_t t)
+{
+    qatomic_add(&pt.translate_ticks, t);
+}
+
+void tb_pcache_add_record_ticks(uint64_t t)
+{
+    qatomic_add(&pt.proof_ticks, t);
+}
+
+void tb_pcache_note_noproof(int why)
+{
+    qatomic_inc(&pt.reject[why == PCACHE_NOPROOF_SPAN ? R_NOPROOF_SPAN :
+                           why == PCACHE_NOPROOF_SPACE ? R_NOPROOF_SPACE :
+                           R_NOPROOF_TWIN]);
+}
+
+static void pt_add(void *opaque, const void *data, size_t len)
+{
+    g_checksum_update(opaque, data, len);
+}
+
+static int pt_cmp_str(gconstpointer a, gconstpointer b)
+{
+    return strcmp(*(char *const *)a, *(char *const *)b);
+}
+
+/*
+ * The executable's identity: its read-only loaded segments (code and rodata;
+ * the segments that are writable at load time hold relocated pointers and
+ * would differ between runs). Hashing the loaded image rather than the file
+ * keeps debug info out of it.
+ */
+static int pt_phdr_cb(struct dl_phdr_info *info, size_t size, void *data)
+{
+    for (int i = 0; i < info->dlpi_phnum; i++) {
+        const ElfW(Phdr) *ph = &info->dlpi_phdr[i];
+
+        if (ph->p_type == PT_LOAD && !(ph->p_flags & PF_W)) {
+            g_checksum_update(data, (const guchar *)(info->dlpi_addr +
+                                                     ph->p_vaddr),
+                              ph->p_filesz);
+        }
+    }
+    return 1;   /* the main program only */
+}
+
+static void pt_feed_exe(GChecksum *ck)
+{
+    dl_iterate_phdr(pt_phdr_cb, ck);
+}
+
+/* The extent of the executable's mappings, for what is image relative. */
+static int pt_extent_cb(struct dl_phdr_info *info, size_t size, void *data)
+{
+    uintptr_t *ext = data;
+
+    ext[0] = UINTPTR_MAX;
+    for (int i = 0; i < info->dlpi_phnum; i++) {
+        const ElfW(Phdr) *ph = &info->dlpi_phdr[i];
+
+        if (ph->p_type == PT_LOAD) {
+            ext[0] = MIN(ext[0], info->dlpi_addr + ph->p_vaddr);
+            ext[1] = MAX(ext[1], info->dlpi_addr + ph->p_vaddr + ph->p_memsz);
+        }
+    }
+    return 1;
+}
+
+/*
+ * The translator id: everything that changes the code or the unwind data the
+ * translator emits for the same guest bytes and the same TB flags.
+ */
+static void pt_compute_id(CPUState *cpu, uint8_t id[PCACHE_ID_LEN])
+{
+    GChecksum *ck = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize len = PCACHE_ID_LEN;
+    GPtrArray *envs = g_ptr_array_new();
+    unsigned ci = cpuinfo;
+    int pb = qemu_target_page_bits();
+    size_t cl = qemu_icache_linesize;
+    size_t tbsz = sizeof(TranslationBlock);
+    int oi = qatomic_read(&one_insn_per_tb);
+
+    g_checksum_update(ck, (const guchar *)"snapintosh-pcache-1", 19);
+#ifdef PCACHE_TEST_HOOKS
+    if (getenv("PCACHE_BUILD_ID")) {
+        g_checksum_update(ck, (const guchar *)getenv("PCACHE_BUILD_ID"),
+                          strlen(getenv("PCACHE_BUILD_ID")));
+    } else
+#endif
+    {
+        pt_feed_exe(ck);
+    }
+    pt_add(ck, &ci, sizeof(ci));
+    pt_add(ck, &pb, sizeof(pb));
+    pt_add(ck, &cl, sizeof(cl));
+    pt_add(ck, &tbsz, sizeof(tbsz));
+    pt_add(ck, &oi, sizeof(oi));
+    pt_add(ck, target_name(), strlen(target_name()));
+    for (char **e = environ; e && *e; e++) {
+        if (g_str_has_prefix(*e, "P26_") || g_str_has_prefix(*e, "P35_") ||
+            g_str_has_prefix(*e, "P43_") || g_str_has_prefix(*e, "P46_") ||
+            g_str_has_prefix(*e, "P47_")) {
+            g_ptr_array_add(envs, *e);
+        }
+    }
+    g_ptr_array_sort(envs, pt_cmp_str);
+    for (guint i = 0; i < envs->len; i++) {
+        const char *e = g_ptr_array_index(envs, i);
+        g_checksum_update(ck, (const guchar *)e, strlen(e) + 1);
+    }
+    g_ptr_array_free(envs, true);
+    {
+        /* the translators ask these while translating */
+        bool sh[2] = { semihosting_enabled(false), semihosting_enabled(true) };
+
+        pt_add(ck, sh, sizeof(sh));
+    }
+    cpu->cc->tcg_ops->pcache_hash_cpu(cpu, pt_add, ck);
+    g_checksum_get_digest(ck, id, &len);
+    g_checksum_free(ck);
+}
+
+static void pt_exit(void);
+static void *pt_stats_thread(void *opaque);
+
+void tb_pcache_configure(const char *dir, const char *mode, uint64_t cap,
+                         unsigned interval_s, Error **errp)
+{
+    if (!dir || !*dir) {
+        return;
+    }
+    if (mode && strcmp(mode, "rw") && strcmp(mode, "ro")) {
+        error_setg(errp, "pcache-mode must be rw or ro");
+        return;
+    }
+    qemu_mutex_init(&pt.lock);
+    pt.dir = g_strdup(dir);
+    {
+        uintptr_t ext[2] = { 0, 0 };
+
+        dl_iterate_phdr(pt_extent_cb, ext);
+        pt.img_lo = ext[0];
+        pt.img_hi = ext[1];
+        /* mutant 10: sort the pool by raw value, as upstream does */
+        tcg_pcache_img_base = pt_mutant() == MUT_POOL_ORDER ? 0 : ext[0];
+    }
+    pt.rw = !mode || !strcmp(mode, "rw");
+    pt.cap = cap ? cap : 8ull << 30;
+    pt.t0_ns = get_clock();
+    pt.t0_ticks = cpu_get_host_ticks();
+    tb_pcache_on = true;
+    atexit(pt_exit);
+    pt.interval_ms = interval_s * 1000;
+    if (pt.interval_ms) {
+        static QemuThread th;
+
+        qemu_thread_create(&th, "pcache-stats", pt_stats_thread, NULL,
+                           QEMU_THREAD_DETACHED);
+    }
+}
+
+/*
+ * A hit skips plugin_gen_tb_start(), so a plugin that watches translation or
+ * instruments blocks would see nothing of them: no pack with plugins.
+ */
+static bool pt_plugins_active(CPUState *cpu)
+{
+#ifdef CONFIG_PLUGIN
+    /* -plugin on the command line, or a plugin that has events set */
+    return !QTAILQ_EMPTY(&qemu_find_opts("plugin")->head) ||
+           (cpu->plugin_state &&
+            !bitmap_empty(cpu->plugin_state->event_mask, QEMU_PLUGIN_EV_MAX));
+#else
+    return false;
+#endif
+}
+
+/*
+ * The pointer scan of the proof looks for values at or above PT_PTR_LO: a
+ * host mapping below it (a legacy mmap layout, ulimit -s unlimited) would
+ * go unseen, so such a process does not use the pack.
+ */
+static bool pt_layout_ok(void)
+{
+    void *m = mmap(NULL, 1 << 20, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    bool ok;
+
+    if (m == MAP_FAILED) {
+        return false;
+    }
+    ok = (uintptr_t)m >= PT_PTR_LO;
+    munmap(m, 1 << 20);
+    return ok;
+}
+
+static PCache *pt_get(CPUState *cpu)
+{
+    int st = qatomic_load_acquire(&pt.state);
+
+    if (st == 1) {
+        return pt.c;
+    }
+    if (st == 2) {
+        return NULL;
+    }
+    qemu_mutex_lock(&pt.lock);
+    if (pt.state == 0) {
+        uint8_t id[PCACHE_ID_LEN];
+        Error *err = NULL;
+        PCache *c = NULL;
+        int64_t t0 = get_clock();
+
+        if (icount_enabled() || tcg_splitwx_diff != 0 ||
+            qatomic_read(&one_insn_per_tb) ||
+            !cpu->cc->tcg_ops->pcache_hash_cpu || pt.img_lo < PT_PTR_LO ||
+            pt_plugins_active(cpu) || !pt_layout_ok()) {
+            warn_report("pcache: disabled (icount, split-wx, "
+                        "one-insn-per-tb, plugins, a target without a cpu "
+                        "hash, a non-PIE executable or a low mmap layout)");
+        } else {
+            pt_compute_id(cpu, id);
+            c = pcache_open(pt.dir, id, pt.rw, pt.cap, &err);
+        }
+        if (c) {
+            PCacheStats cs;
+
+            pcache_stats(c, &cs);
+            info_report("pcache: %s, %s, boot %u, %" PRIu64
+                        " records, %" PRIu64 " MiB, opened in %" PRId64
+                        " ms", pcache_path(c), cs.rw ? "rw" : "ro",
+                        cs.boot_no, cs.records, cs.end >> 20,
+                        (get_clock() - t0) / SCALE_MS);
+        } else if (err) {
+            warn_report_err(err);
+        }
+        pt.c = c;
+        qatomic_store_release(&pt.state, c ? 1 : 2);
+    }
+    qemu_mutex_unlock(&pt.lock);
+    return pt.c;
+}
+
+bool tb_pcache_recording(void)
+{
+    PCache *c = pt.c;
+
+    return c && pcache_is_rw(c);
+}
+
+bool tb_pcache_eligible(const TCGTBCPUState *s, tb_page_addr_t phys_pc)
+{
+    return phys_pc != (tb_page_addr_t)-1 && (s->cflags & CF_PCREL) &&
+           !(s->cflags & PT_NO_FLAGS);
+}
+
+static inline uint64_t ld64(const uint8_t *p)
+{
+    uint64_t v;
+    memcpy(&v, p, 8);
+    return v;
+}
+
+static inline uint32_t ld32(const uint8_t *p)
+{
+    uint32_t v;
+    memcpy(&v, p, 4);
+    return v;
+}
+
+static inline void st64(uint8_t *p, uint64_t v)
+{
+    memcpy(p, &v, 8);
+}
+
+static inline void st32(uint8_t *p, uint32_t v)
+{
+    memcpy(p, &v, 4);
+}
+
+static bool pt_apply(uint8_t *rw, uintptr_t rx, uintptr_t tb,
+                     const PCacheReloc *r, uint32_t n, uint32_t code_len)
+{
+    uintptr_t img = pt.img_lo;
+    uintptr_t epi = (uintptr_t)tcg_code_gen_epilogue;
+
+    if (pt_mutant() == MUT_NO_RELOC) {
+        return true;
+    }
+    for (uint32_t i = 0; i < n; i++) {
+        uint32_t off = r[i].off;
+        uintptr_t t;
+        intptr_t d;
+
+        switch (r[i].kind) {
+        case PCACHE_RELOC_ABS_IMG:
+            if (off + 8 > code_len) {
+                return false;
+            }
+            st64(rw + off, img + r[i].addend);
+            break;
+        case PCACHE_RELOC_ABS_TB:
+            if (off + 8 > code_len) {
+                return false;
+            }
+            st64(rw + off, tb + r[i].addend);
+            break;
+        case PCACHE_RELOC_PCREL_BUF:
+        case PCACHE_RELOC_PCREL_IMG:
+            if (off + 4 > code_len) {
+                return false;
+            }
+            t = (r[i].kind == PCACHE_RELOC_PCREL_BUF ? epi : img) +
+                r[i].addend;
+            d = (intptr_t)t - (intptr_t)(rx + off + 4);
+            if (d != (int32_t)d) {
+                return false;
+            }
+            st32(rw + off, (uint32_t)d);
+            break;
+        default:
+            return false;
+        }
+    }
+    return true;
+}
+
+static __thread PCacheView pt_last;
+static __thread bool pt_last_ok;
+
+bool tb_pcache_verify_on(void)
+{
+#ifdef PCACHE_TEST_HOOKS
+    static int on = -1;
+
+    if (on < 0) {
+        on = getenv("PCACHE_VERIFY") != NULL;
+    }
+    return on && pt_last_ok;
+#else
+    return false;
+#endif
+}
+
+bool tb_pcache_load(CPUState *cpu, TranslationBlock *tb,
+                    const TCGTBCPUState *s, void *host_pc,
+                    int *code_size, int *search_size)
+{
+    PCache *c = pt_get(cpu);
+    PCacheKey key;
+    PCacheView v;
+    uint64_t t0, t1;
+    uint8_t *rw;
+    uint32_t avail0;
+
+    pt_last_ok = false;
+    if (!c) {
+        return false;
+    }
+    t0 = cpu_get_host_ticks();
+    qatomic_inc(&pt.lookups);
+    key.pc = s->pc;
+    key.cs_base = s->cs_base;
+    key.flags = s->flags;
+    key.cflags = s->cflags;
+    key.entry_off = s->pc & ~TARGET_PAGE_MASK;
+    avail0 = TARGET_PAGE_SIZE - key.entry_off;
+    if (!pcache_lookup(c, &key, host_pc, avail0, &v)) {
+        qatomic_inc(&pt.misses);
+        qatomic_add(&pt.miss_ticks, cpu_get_host_ticks() - t0);
+        return false;
+    }
+    rw = (uint8_t *)tcg_splitwx_to_rw((void *)tb->tc.ptr);
+    if (rw + v.hdr->code_len + v.hdr->search_len >
+        (uint8_t *)tcg_ctx->code_gen_highwater) {
+        qatomic_inc(&pt.misses);
+        return false;
+    }
+    memcpy(rw, v.code, v.hdr->code_len);
+    if (!pt_apply(rw, (uintptr_t)tb->tc.ptr, (uintptr_t)tb, v.relocs,
+                  v.hdr->nreloc, v.hdr->code_len)) {
+        qatomic_inc(&pt.reloc_fail);
+        return false;
+    }
+    memcpy(rw + v.hdr->code_len, v.search, v.hdr->search_len);
+    tb->size = v.hdr->guest_len;
+    tb->icount = v.hdr->icount;
+    tb->jmp_reset_offset[0] = v.hdr->jmp_reset[0];
+    tb->jmp_reset_offset[1] = v.hdr->jmp_reset[1];
+    tb->jmp_insn_offset[0] = v.hdr->jmp_insn[0];
+    tb->jmp_insn_offset[1] = v.hdr->jmp_insn[1];
+    *code_size = v.hdr->code_len;
+    *search_size = v.hdr->search_len;
+    pt_last = v;
+    pt_last_ok = true;
+    t1 = cpu_get_host_ticks();
+    qatomic_inc(&pt.hits);
+    qatomic_add(&pt.hit_cycles, v.hdr->cycles);
+    qatomic_add(&pt.hit_bytes, v.hdr->guest_len);
+    qatomic_add(&pt.load_ticks, t1 - t0);
+    return true;
+}
+
+/* The scan for a host pointer in the code of a block. */
+static inline bool pt_ptr_like(uint64_t v)
+{
+    return v >= PT_PTR_LO && v < PT_PTR_HI;
+}
+
+static bool pt_in_image(uintptr_t v)
+{
+    return v >= pt.img_lo && v < pt.img_hi;
+}
+
+static inline uint32_t pt_rsz(uint32_t kind)
+{
+    return kind == PCACHE_RELOC_PCREL_BUF || kind == PCACHE_RELOC_PCREL_IMG ?
+           4 : 8;
+}
+
+static int pt_prove(const PCacheTwin *t, PCacheReloc *rel, uint32_t *nrel)
+{
+    const uint8_t *a = t->code_a, *b = t->code_b;
+    uint32_t n = t->code_len_a, i = 0, nr = 0;
+    uintptr_t rx_a = (uintptr_t)t->tb_a->tc.ptr;
+    uintptr_t rx_b = (uintptr_t)t->tb_b->tc.ptr;
+    uint64_t delta = rx_b - rx_a;
+    uint64_t tb_delta = (uintptr_t)t->tb_b - (uintptr_t)t->tb_a;
+    uintptr_t img = pt.img_lo;
+    uintptr_t epi = (uintptr_t)tcg_code_gen_epilogue;
+
+    while (i < n) {
+        if (a[i] == b[i]) {
+            i++;
+            continue;
+        }
+        if (nr + 1 >= PT_MAX_RELOCS) {
+            return R_TOOMANY;
+        }
+        if (pt_mutant() == MUT_NO_DIFF) {
+            i++;
+            continue;
+        }
+        if (i + 8 <= n && ld64(b + i) - ld64(a + i) == tb_delta) {
+            int64_t k = (int64_t)(ld64(a + i) - (uintptr_t)t->tb_a);
+
+            if (k > -(1 << 20) && k < (1 << 20)) {
+                rel[nr++] = (PCacheReloc){ i, PCACHE_RELOC_ABS_TB, k };
+                i += 8;
+                continue;
+            }
+        }
+        /* only a branch has a rel32 to a fixed address; a lea of a guest
+         * constant that happens to be near the code is not one */
+        if (i + 4 <= n &&
+            (uint32_t)(ld32(b + i) - ld32(a + i)) == (uint32_t)(-delta) &&
+            i >= 1 && (a[i - 1] == 0xe8 || a[i - 1] == 0xe9 ||
+                       (i >= 2 && a[i - 2] == 0x0f &&
+                        (a[i - 1] & 0xf0) == 0x80))) {
+            uintptr_t tgt = rx_a + i + 4 + (int32_t)ld32(a + i);
+
+            if (in_code_gen_buffer((void *)tgt)) {
+                rel[nr++] = (PCacheReloc){ i, PCACHE_RELOC_PCREL_BUF,
+                                           (intptr_t)tgt - (intptr_t)epi };
+            } else if (pt_in_image(tgt)) {
+                rel[nr++] = (PCacheReloc){ i, PCACHE_RELOC_PCREL_IMG,
+                                           (intptr_t)tgt - (intptr_t)img };
+            } else {
+                return R_TARGET;
+            }
+            i += 4;
+            continue;
+        }
+        return R_DIFF;
+    }
+
+    if (n >= 8) {
+        uint32_t k = 0;     /* first diff reloc that may still cover @off */
+        uint32_t ndiff = nr;
+
+        for (uint32_t off = 0; off + 8 <= n; off++) {
+            uint64_t v = ld64(a + off);
+            bool noted = false;
+            bool cand;
+
+            /* an imm64 of a movabs, or an entry of the constant pool */
+            cand = (off >= 2 && (a[off - 2] == 0x48 || a[off - 2] == 0x49) &&
+                    (a[off - 1] & 0xf8) == 0xb8) ||
+                   (t->pool_off_a >= 0 && off >= (uint32_t)t->pool_off_a &&
+                    !((off - t->pool_off_a) & 7));
+            if (!cand) {
+                continue;
+            }
+            while (k < ndiff && rel[k].off + pt_rsz(rel[k].kind) <= off) {
+                k++;
+            }
+            if (k < ndiff && off >= rel[k].off) {
+                continue;
+            }
+            if (!pt_ptr_like(v)) {
+                continue;
+            }
+            for (unsigned p = 0; p < t->nptrs_a; p++) {
+                if (t->ptrs_a[p] == v) {
+                    noted = true;
+                    break;
+                }
+            }
+            if (noted) {
+                if (!pt_in_image(v)) {
+                    return R_TARGET;
+                }
+                if (nr + 1 >= PT_MAX_RELOCS) {
+                    return R_TOOMANY;
+                }
+                rel[nr++] = (PCacheReloc){ off, PCACHE_RELOC_ABS_IMG,
+                                           (intptr_t)(v - img) };
+                off += 7;
+            } else if (pt_mutant() != MUT_NO_PTR_SCAN) {
+                return R_PTR;
+            }
+        }
+    }
+    *nrel = nr;
+    return -1;
+}
+
+/*
+ * Verify mode: the block that was loaded, relocated to where the fresh
+ * emission sits, must equal that emission byte for byte.
+ */
+void tb_pcache_verify(const PCacheTwin *t)
+{
+    const PCacheView *v = &pt_last;
+    uint32_t n = v->hdr->code_len;
+    uint8_t *tmp = g_malloc(n + 8);
+    uint32_t bad = 0, first = 0;
+
+    memcpy(tmp, v->code, n);
+    if (!pt_apply(tmp, (uintptr_t)t->tb_b->tc.ptr, (uintptr_t)t->tb_b,
+                  v->relocs, v->hdr->nreloc, n) ||
+        t->code_len_b != (int)n || t->search_len_b != v->hdr->search_len ||
+        t->tb_b->size != v->hdr->guest_len ||
+        t->tb_b->icount != v->hdr->icount) {
+        bad = 1;
+    } else {
+        for (uint32_t i = 0; i < n; i++) {
+            if (tmp[i] != t->code_b[i]) {
+                if (!bad) {
+                    first = i;
+                }
+                bad++;
+            }
+        }
+        if (memcmp(v->search, t->code_b + n, v->hdr->search_len)) {
+            bad++;
+        }
+    }
+    if (bad) {
+        qatomic_inc(&pt.verify_bad);
+        if (qatomic_read(&pt.verify_bad) <= 20) {
+            fprintf(stderr, "PCACHE-VERIFY-BAD pc=%#" PRIx64 " flags=%#x "
+                    "cs_base=%#" PRIx64 " len=%u/%d diffs=%u first=%u "
+                    "stored=%02x fresh=%02x\n", (uint64_t)t->s->pc,
+                    t->s->flags, t->s->cs_base, n, t->code_len_b, bad, first,
+                    tmp[first], t->code_b[first]);
+            for (uint32_t r = 0; r < v->hdr->nreloc; r++) {
+                if (v->relocs[r].off + 8 > first &&
+                    v->relocs[r].off <= first) {
+                    fprintf(stderr, "  reloc off=%u kind=%u addend=%" PRId64
+                            "\n", v->relocs[r].off, v->relocs[r].kind,
+                            v->relocs[r].addend);
+                }
+            }
+            fprintf(stderr, "  stored:");
+            for (uint32_t q = first > 4 ? first - 4 : 0; q < MIN(n, first + 12);
+                 q++) {
+                fprintf(stderr, " %02x", tmp[q]);
+            }
+            fprintf(stderr, "\n  fresh: ");
+            for (uint32_t q = first > 4 ? first - 4 : 0; q < MIN(n, first + 12);
+                 q++) {
+                fprintf(stderr, " %02x", t->code_b[q]);
+            }
+            fprintf(stderr, "\n  tb_b=%p code_b=%p\n", (void *)t->tb_b,
+                    (void *)t->tb_b->tc.ptr);
+        }
+    } else {
+        qatomic_inc(&pt.verify_ok);
+    }
+    g_free(tmp);
+}
+
+void tb_pcache_commit(const PCacheTwin *t)
+{
+    PCacheReloc rel[PT_MAX_RELOCS];
+    uint32_t nrel = 0;
+    PCache *c = pt_get(t->cpu);
+    PCacheNew nw;
+    int why;
+
+    if (!c) {
+        return;
+    }
+    if (t->code_len_a != t->code_len_b || t->search_len_a != t->search_len_b ||
+        t->code_len_a <= 0 || t->code_len_a > UINT16_MAX) {
+        qatomic_inc(&pt.reject[R_SIZE]);
+        return;
+    }
+    if (t->tb_a->size != t->tb_b->size || t->tb_a->icount != t->tb_b->icount ||
+        memcmp(t->tb_a->jmp_reset_offset, t->tb_b->jmp_reset_offset,
+               sizeof(t->tb_a->jmp_reset_offset)) ||
+        memcmp(t->tb_a->jmp_insn_offset, t->tb_b->jmp_insn_offset,
+               sizeof(t->tb_a->jmp_insn_offset))) {
+        qatomic_inc(&pt.reject[R_FIELDS]);
+        return;
+    }
+    if (memcmp(t->code_a + t->code_len_a, t->code_b + t->code_len_b,
+               t->search_len_a)) {
+        qatomic_inc(&pt.reject[R_SEARCH]);
+        return;
+    }
+    if (t->ptr_ovf || t->nptrs_a != t->nptrs_b ||
+        memcmp(t->ptrs_a, t->ptrs_b, t->nptrs_a * sizeof(uintptr_t))) {
+        qatomic_inc(&pt.reject[R_PTRSET]);
+        return;
+    }
+    why = pt_prove(t, rel, &nrel);
+    if (why >= 0) {
+        qatomic_inc(&pt.reject[why]);
+        return;
+    }
+    memset(&nw, 0, sizeof(nw));
+    nw.key.pc = t->s->pc;
+    nw.key.cs_base = t->s->cs_base;
+    nw.key.flags = t->s->flags;
+    nw.key.cflags = t->s->cflags;
+    nw.key.entry_off = t->s->pc & ~TARGET_PAGE_MASK;
+    nw.guest = t->guest;
+    nw.guest_len = t->tb_a->size;
+    nw.code = t->code_a;
+    nw.code_len = t->code_len_a;
+    nw.search = t->code_a + t->code_len_a;
+    nw.search_len = t->search_len_a;
+    nw.relocs = rel;
+    nw.nreloc = nrel;
+    nw.icount = t->tb_a->icount;
+    memcpy(nw.jmp_reset, t->tb_a->jmp_reset_offset, sizeof(nw.jmp_reset));
+    memcpy(nw.jmp_insn, t->tb_a->jmp_insn_offset, sizeof(nw.jmp_insn));
+    nw.cycles = MIN(t->cycles, (uint64_t)UINT32_MAX);
+    if (pcache_store(c, &nw)) {
+        qatomic_add(&pt.stored_bytes, nw.code_len + nw.guest_len);
+        qatomic_add(&pt.relocs, nrel);
+    } else {
+        qatomic_inc(&pt.reject[R_STORE_FAIL]);
+    }
+}
+
+static void pt_print(const char *tag)
+{
+    PCache *c = pt.c;
+    PCacheStats st;
+    double hz;
+    int64_t ns = get_clock() - pt.t0_ns;
+    GString *s = g_string_new(NULL);
+
+    if (!c) {
+        return;
+    }
+    hz = ns > 0 ? (double)(cpu_get_host_ticks() - pt.t0_ticks) * 1e9 / ns : 1;
+    pcache_stats(c, &st);
+    g_string_append_printf(s, "%s t=%.3f rw=%d boot=%u records=%" PRIu64
+        " end_mib=%" PRIu64 " lookups=%" PRIu64 " hits=%" PRIu64
+        " misses=%" PRIu64 " mismatch=%" PRIu64 " crc_bad=%" PRIu64
+        " stores=%" PRIu64 " dups=%" PRIu64 " full=%" PRIu64
+        " reloc_fail=%" PRIu64 " relocs=%" PRIu64
+        " load_s=%.3f miss_s=%.3f translate_s=%.3f proof_s=%.3f"
+        " hit_xlate_s=%.3f hit_guest_mib=%.1f verify_ok=%" PRIu64
+        " verify_bad=%" PRIu64,
+        tag, (double)qemu_clock_get_ns(QEMU_CLOCK_HOST) / 1e9, st.rw,
+        st.boot_no, st.records, st.end >> 20, pt.lookups, pt.hits,
+        pt.misses, st.mismatch, st.crc_bad, st.stores, st.dups, st.full,
+        pt.reloc_fail, pt.relocs,
+        pt.load_ticks / hz, pt.miss_ticks / hz, pt.translate_ticks / hz,
+        pt.proof_ticks / hz, pt.hit_cycles / hz,
+        pt.hit_bytes / 1048576.0, pt.verify_ok, pt.verify_bad);
+    for (int i = 0; i < R_COUNT; i++) {
+        g_string_append_printf(s, " rej_%s=%" PRIu64, reason_names[i],
+                               pt.reject[i]);
+    }
+    fprintf(stderr, "%s\n", s->str);
+    g_string_free(s, true);
+}
+
+static void *pt_stats_thread(void *opaque)
+{
+    for (;;) {
+        g_usleep(pt.interval_ms * 1000);
+        pt_print("PCACHE-TICK");
+    }
+    return NULL;
+}
+
+static void pt_exit(void)
+{
+    PCache *c = pt.c;
+
+    if (!c) {
+        return;
+    }
+    pt_print("PCACHE-STATS");
+    pcache_close(c, false);
+}
+
+#else /* !HOST_X86_64 */
+
+bool tb_pcache_on;
+void tb_pcache_configure(const char *dir, const char *mode, uint64_t cap,
+                         unsigned interval_s, Error **errp)
+{
+    if (dir && *dir) {
+        error_setg(errp, "pcache is only supported on x86_64 hosts");
+    }
+}
+bool tb_pcache_recording(void)
+{
+    return false;
+}
+bool tb_pcache_eligible(const TCGTBCPUState *s, tb_page_addr_t phys_pc)
+{
+    return false;
+}
+bool tb_pcache_load(CPUState *cpu, TranslationBlock *tb,
+                    const TCGTBCPUState *s, void *host_pc,
+                    int *code_size, int *search_size)
+{
+    return false;
+}
+void tb_pcache_commit(const PCacheTwin *t) { }
+bool tb_pcache_verify_on(void) { return false; }
+void tb_pcache_verify(const PCacheTwin *t) { }
+void tb_pcache_note_noproof(int why) { }
+uint64_t tb_pcache_ticks(void) { return 0; }
+void tb_pcache_add_translate_ticks(uint64_t t) { }
+void tb_pcache_add_record_ticks(uint64_t t) { }
+
+#endif
diff --git a/accel/tcg/pcache-tcg.h b/accel/tcg/pcache-tcg.h
new file mode 100644
index 0000000000..570de19aed
--- /dev/null
+++ b/accel/tcg/pcache-tcg.h
@@ -0,0 +1,88 @@
+/*
+ * Persistent translation cache: the glue between the pack (pcache.c) and
+ * tb_gen_code().
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef ACCEL_TCG_PCACHE_TCG_H
+#define ACCEL_TCG_PCACHE_TCG_H
+
+#include "exec/translation-block.h"
+#include "accel/tcg/tb-cpu-state.h"
+#include "tcg/tcg.h"
+
+#ifndef CONFIG_USER_ONLY
+
+/* Set once by the accelerator; nothing else is touched while it is false. */
+extern bool tb_pcache_on;
+
+/*
+ * Configure from -accel tcg,pcache=DIR[,pcache-mode=rw|ro][,pcache-max=N].
+ * The pack itself is opened on the first translation, when the CPU, and so
+ * the translator id, is known.
+ */
+void tb_pcache_configure(const char *dir, const char *mode, uint64_t cap,
+                         unsigned interval_s, Error **errp);
+
+/* Can a translation of this block be loaded from or stored in the pack? */
+bool tb_pcache_eligible(const TCGTBCPUState *s, tb_page_addr_t phys_pc);
+
+/* Is the pack open for appending? Only then is a translation worth proving. */
+bool tb_pcache_recording(void);
+
+/*
+ * Replace the translation: copy a stored one to @tb's code buffer and relocate
+ * it. On success @tb is complete except for what tb_gen_code() sets after
+ * translating.
+ */
+bool tb_pcache_load(CPUState *cpu, TranslationBlock *tb,
+                    const TCGTBCPUState *s, void *host_pc,
+                    int *code_size, int *search_size);
+
+/* One translation emitted twice, at two addresses. */
+typedef struct PCacheTwin {
+    CPUState *cpu;
+    const TCGTBCPUState *s;
+    const uint8_t *guest;           /* the guest bytes, tb->size of them */
+    const TranslationBlock *tb_a, *tb_b;
+    const uint8_t *code_a, *code_b; /* rw addresses of the emitted code */
+    int code_len_a, code_len_b;
+    int search_len_a, search_len_b; /* unwind data right behind the code */
+    uintptr_t ptrs_a[TCG_PCACHE_MAX_PTRS], ptrs_b[TCG_PCACHE_MAX_PTRS];
+    unsigned nptrs_a, nptrs_b;
+    bool ptr_ovf;
+    int pool_off_a;                 /* constant pool offset in code_a, or -1 */
+    uint64_t cycles;                /* ticks of the first translation */
+} PCacheTwin;
+
+/* Prove @t relocatable and store it. Counts why it did not, when it did not. */
+void tb_pcache_commit(const PCacheTwin *t);
+
+/* Test hook: compare the block just loaded with a fresh translation. */
+bool tb_pcache_verify_on(void);
+#ifdef PCACHE_TEST_HOOKS
+bool tb_pcache_test_aba(void);
+bool tb_pcache_test_live_twin(void);
+#else
+#define tb_pcache_test_aba() false
+#define tb_pcache_test_live_twin() false
+#endif
+void tb_pcache_verify(const PCacheTwin *t);
+
+/* Counters for the failure paths of the caller. */
+void tb_pcache_note_noproof(int why);
+enum { PCACHE_NOPROOF_SPAN = 1, PCACHE_NOPROOF_SPACE, PCACHE_NOPROOF_TWIN };
+
+uint64_t tb_pcache_ticks(void);
+void tb_pcache_add_translate_ticks(uint64_t t);
+void tb_pcache_add_record_ticks(uint64_t t);
+
+#else
+#define tb_pcache_on false
+#define tb_pcache_verify_on() false
+#define tb_pcache_test_aba() false
+#define tb_pcache_test_live_twin() false
+#endif
+
+#endif
diff --git a/accel/tcg/pcache.c b/accel/tcg/pcache.c
new file mode 100644
index 0000000000..d15af6b956
--- /dev/null
+++ b/accel/tcg/pcache.c
@@ -0,0 +1,865 @@
+/*
+ * Persistent, content keyed store of translated code (the pack).
+ * See pcache.h for the design.
+ *
+ * File layout: a 4 KiB header (magic, version, translator id, boot counter),
+ * then records, each 8 byte aligned, until the first slot whose magic is not
+ * valid. The file is mapped shared at its cap size and records are appended
+ * through the mapping, so a killed process loses nothing the kernel has not
+ * dropped, and a torn tail is found by the scan at the next open. Every
+ * record has its own crc32c, checked on first use.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#ifdef CONFIG_LINUX
+#include "qemu/crc32c.h"
+#include "qemu/thread.h"
+#include "qemu/atomic.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "pcache.h"
+#include <sys/file.h>
+
+#define PC_FILE_MAGIC   "SNAPPC01"
+#define PC_VERSION      1
+#define PC_HDR_SIZE     4096
+#define PC_REC_MAGIC    0x31524350u     /* "PCR1" */
+#define PC_KIND_TB      1
+#define PC_KIND_USE     2
+#define PC_GROW         (64ull << 20)
+#define PC_KEEP_BOOTS   5
+
+typedef struct PCacheFileHdr {
+    char magic[8];
+    uint32_t version;
+    uint32_t hdr_size;
+    uint8_t id[PCACHE_ID_LEN];
+    uint32_t boot_no;
+    uint32_t pad;
+} PCacheFileHdr;
+
+/* The hash table: readers load the pointer and never take the lock. */
+typedef struct PCTab {
+    uint32_t n;             /* buckets, a power of two */
+    uint32_t b[];           /* rid + 1; 0 is empty */
+} PCTab;
+
+struct PCache {
+    QemuMutex lock;
+    char *path;
+    char *dir;
+    uint8_t id[PCACHE_ID_LEN];
+    int fd;
+    bool rw;
+    bool full;
+    uint8_t *map;
+    uint64_t cap;
+    uint64_t file_size;     /* bytes of the file that are allocated */
+    uint64_t end;           /* next append offset */
+    PCacheFileHdr *fh;
+    uint32_t boot_no;
+    uint32_t maxrec;
+    uint32_t nrec;
+    PCTab *tab;             /* bucket heads, read without the lock */
+    GPtrArray *old_tabs;    /* superseded tables, freed with the pack */
+    uint32_t *hash32;       /* the index hash of each record */
+    uint32_t *off8;         /* record offset in 8 byte units */
+    uint32_t *next;         /* chain, rid + 1 */
+    uint32_t *lastboot;
+    uint32_t *uses;
+    uint8_t *state;         /* 0 unchecked, 1 crc ok, 2 bad */
+    uint64_t *mut_pc;       /* test mutant 3 only */
+    PCacheStats st;
+};
+
+#ifdef PCACHE_TEST_HOOKS
+static int pc_mutant(void)
+{
+    static int m = -1;
+    if (m < 0) {
+        const char *e = getenv("PCACHE_MUTANT");
+        m = e ? atoi(e) : 0;
+    }
+    return m;
+}
+#else
+#define pc_mutant() 0
+#endif
+
+enum {
+    MUT_IGNORE_FLAGS = 1,
+    MUT_SKIP_COMPARE = 2,
+    MUT_VA_IN_KEY = 3,
+    MUT_IGNORE_ID = 4,
+    MUT_TRUST_LENGTHS = 5,
+    MUT_SKIP_CRC = 6,
+    MUT_COMPACT_FORGETS = 12,
+    MUT_DUP_BAD = 13,
+    MUT_NO_REPAIR = 14,
+};
+
+static inline uint32_t pc_align8(uint32_t v)
+{
+    return (v + 7u) & ~7u;
+}
+
+static uint32_t pc_e4(const uint8_t *p, uint32_t avail)
+{
+    uint32_t v = 0;
+    memcpy(&v, p, MIN(4u, avail));
+    return v;
+}
+
+static uint32_t pc_hash(uint64_t cs_base, uint32_t flags, uint32_t cflags,
+                        uint32_t entry_off, uint32_t e4, uint32_t e8)
+{
+    uint64_t h = cs_base * 0x9E3779B97F4A7C15ull;
+
+    if (pc_mutant() == MUT_IGNORE_FLAGS) {
+        flags = 0;
+    }
+    h ^= (((uint64_t)flags << 32) | cflags) * 0xC2B2AE3D27D4EB4Full;
+    h ^= (((uint64_t)entry_off << 32) | e4) * 0x165667B19E3779F9ull;
+    h ^= (uint64_t)e8 * 0xD6E8FEB86659FD93ull;
+    h ^= h >> 29;
+    h *= 0xBF58476D1CE4E5B9ull;
+    h ^= h >> 32;
+    return (uint32_t)h;
+}
+
+static void *pc_anon(size_t n)
+{
+    void *p = mmap(NULL, n, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    return p == MAP_FAILED ? NULL : p;
+}
+
+static const PCacheRecHdr *pc_rec(PCache *c, uint32_t rid)
+{
+    return (const PCacheRecHdr *)(c->map + ((uint64_t)c->off8[rid] << 3));
+}
+
+static PCTab *pc_tab_new(uint32_t n)
+{
+    PCTab *t = g_malloc0(sizeof(*t) + (size_t)n * sizeof(uint32_t));
+
+    t->n = n;
+    return t;
+}
+
+/*
+ * Called with the lock held or before the cache is shared. Readers walking
+ * the chains of the old table while next[] is rewritten may skip records,
+ * which is a miss, never a wrong hit: every rid they reach is valid.
+ */
+static void pc_rehash(PCache *c, uint32_t n)
+{
+    PCTab *nt = pc_tab_new(n);
+    PCTab *old = c->tab;
+
+    for (uint32_t rid = 0; rid < c->nrec; rid++) {
+        uint32_t b = c->hash32[rid] & (n - 1);
+
+        qatomic_set(&c->next[rid], nt->b[b]);
+        nt->b[b] = rid + 1;
+    }
+    qatomic_store_release(&c->tab, nt);
+    g_ptr_array_add(c->old_tabs, old);
+}
+
+static void pc_index_add(PCache *c, uint64_t off, uint32_t boot)
+{
+    const PCacheRecHdr *h = (const PCacheRecHdr *)(c->map + off);
+    uint32_t rid = c->nrec++;
+    uint32_t hv = pc_hash(h->cs_base, h->flags, h->cflags, h->entry_off,
+                          h->e4, h->e8);
+
+    c->off8[rid] = off >> 3;
+    c->hash32[rid] = hv;
+    c->lastboot[rid] = boot & 0xffff;
+    if (c->nrec * 2 > c->tab->n) {
+        /* the rehash covers rid too, as nrec counts it */
+        pc_rehash(c, c->tab->n * 2);
+    } else {
+        uint32_t b = hv & (c->tab->n - 1);
+
+        qatomic_set(&c->next[rid], c->tab->b[b]);
+        qatomic_store_release(&c->tab->b[b], rid + 1);
+    }
+}
+
+static uint32_t pc_find_rid(PCache *c, uint32_t off8)
+{
+    uint32_t lo = 0, hi = c->nrec;
+
+    while (lo < hi) {
+        uint32_t mid = (lo + hi) / 2;
+        if (c->off8[mid] < off8) {
+            lo = mid + 1;
+        } else {
+            hi = mid;
+        }
+    }
+    return lo < c->nrec && c->off8[lo] == off8 ? lo : UINT32_MAX;
+}
+
+static void pc_scan(PCache *c, uint64_t st_size)
+{
+    uint64_t pos = PC_HDR_SIZE;
+
+    madvise(c->map, MIN(st_size, c->cap), MADV_SEQUENTIAL);
+    while (pos + sizeof(PCacheRecHdr) <= st_size) {
+        const PCacheRecHdr *h = (const PCacheRecHdr *)(c->map + pos);
+        uint32_t total = h->total;
+
+        if (h->magic != PC_REC_MAGIC) {
+            break;
+        }
+        if (pc_mutant() != MUT_TRUST_LENGTHS &&
+            (total < sizeof(PCacheRecHdr) || (total & 7) ||
+             pos + total > st_size)) {
+            break;
+        }
+        if (h->kind == PC_KIND_TB) {
+            if (c->nrec >= c->maxrec) {
+                break;
+            }
+            if (pc_mutant() != MUT_TRUST_LENGTHS &&
+                sizeof(*h) + pc_align8(h->guest_len) +
+                pc_align8(h->code_len) + pc_align8(h->search_len) +
+                (uint64_t)h->nreloc * sizeof(PCacheReloc) != total) {
+                break;
+            }
+            pc_index_add(c, pos, h->pad);
+        } else if (h->kind == PC_KIND_USE) {
+            const uint32_t *p = (const uint32_t *)(h + 1);
+            uint32_t n = p[1];
+
+            if (crc32c(0xffffffff, (const uint8_t *)h + 16, total - 16) !=
+                h->crc) {
+                /* a bad use record says nothing: skip it, keep scanning */
+            } else if ((uint64_t)n * 8 + 8 + sizeof(*h) <= total) {
+                for (uint32_t i = 0; i < n; i++) {
+                    uint32_t rid = pc_find_rid(c, p[2 + 2 * i]);
+                    /* stamps are 16 bit and wrap: newer is a small step on */
+                    if (rid != UINT32_MAX &&
+                        (uint16_t)(p[0] - c->lastboot[rid]) - 1u < 0x7fffu) {
+                        c->lastboot[rid] = p[0] & 0xffff;
+                    }
+                }
+            }
+        } else {
+            break;
+        }
+        pos += total;
+    }
+    /*
+     * The records are read in an order nobody knows: ask for no read ahead,
+     * a multi GiB pack must not push the guest RAM out of the page cache.
+     */
+    madvise(c->map, MIN(st_size, c->cap), MADV_RANDOM);
+    c->end = pos;
+    c->st.scanned_bytes = pos;
+}
+
+static bool pc_grow(PCache *c, uint64_t need)
+{
+    uint64_t want;
+    int r;
+
+    if (need <= c->file_size) {
+        return true;
+    }
+    want = MIN(c->cap, ROUND_UP(need, PC_GROW));
+    if (want < need) {
+        return false;
+    }
+    r = posix_fallocate(c->fd, c->file_size, want - c->file_size);
+    if (r) {
+        return false;
+    }
+    c->file_size = want;
+    return true;
+}
+
+static void pc_free(PCache *c)
+{
+    if (c->map) {
+        munmap(c->map, c->cap);
+    }
+    if (c->fd >= 0) {
+        close(c->fd);
+    }
+    for (int i = 0; i < 7; i++) {
+        void *arrs[7] = { c->off8, c->next, c->lastboot, c->uses, c->state,
+                          c->mut_pc, c->hash32 };
+        size_t sz[7] = { 4, 4, 4, 4, 1, 8, 4 };
+        if (arrs[i]) {
+            munmap(arrs[i], (size_t)c->maxrec * sz[i]);
+        }
+    }
+    g_free(c->tab);
+    if (c->old_tabs) {
+        g_ptr_array_free(c->old_tabs, true);
+    }
+    g_free(c->path);
+    g_free(c->dir);
+    qemu_mutex_destroy(&c->lock);
+    g_free(c);
+}
+
+/*
+ * Rewrite the pack without the records unused for PC_KEEP_BOOTS boots, and
+ * further, oldest first, until it is at most half the cap. The last use of
+ * each record that is kept is written back as use records so that it is not
+ * taken for new. A pack with little to drop is left alone.
+ * Returns true when the new pack replaced the old one.
+ */
+#define PC_AGES 64
+static bool pc_compact(PCache *c)
+{
+    char *tmp = g_strdup_printf("%s.tmp", c->path);
+    int fd = -1;
+    uint8_t *buf = g_malloc(1 << 20);
+    size_t fill = 0;
+    bool ok;
+    uint64_t kept, by_age[PC_AGES] = { 0 };
+    uint32_t *koff, *kboot, nk = 0, limit = PC_KEEP_BOOTS;
+
+    for (uint32_t rid = 0; rid < c->nrec; rid++) {
+        uint32_t age = (uint16_t)(c->boot_no - c->lastboot[rid]);
+        if (age < PC_AGES) {
+            by_age[age] += pc_rec(c, rid)->total;
+        }
+    }
+    for (;;) {
+        kept = 0;
+        for (uint32_t a = 0; a <= limit; a++) {
+            kept += by_age[a];
+        }
+        if (kept <= c->cap / 2 || limit == 0) {
+            break;
+        }
+        limit--;
+    }
+    if (kept + (c->end - PC_HDR_SIZE) / 8 > c->end - PC_HDR_SIZE) {
+        /* under an eighth would go: not worth rewriting the pack */
+        g_free(buf);
+        g_free(tmp);
+        return false;
+    }
+    fd = open(tmp, O_RDWR | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    koff = g_new(uint32_t, c->nrec + 1);
+    kboot = g_new(uint32_t, c->nrec + 1);
+    ok = fd >= 0;
+    kept = 0;
+    if (ok) {
+        memcpy(buf, c->map, PC_HDR_SIZE);
+        ok = write(fd, buf, PC_HDR_SIZE) == PC_HDR_SIZE;
+    }
+    for (uint32_t rid = 0; ok && rid < c->nrec; rid++) {
+        const PCacheRecHdr *h = pc_rec(c, rid);
+        if ((uint16_t)(c->boot_no - c->lastboot[rid]) > limit) {
+            continue;
+        }
+        koff[nk] = (PC_HDR_SIZE + kept) >> 3;
+        kboot[nk++] = c->lastboot[rid];
+        if (fill + h->total > (1 << 20)) {
+            ok = write(fd, buf, fill) == (ssize_t)fill;
+            fill = 0;
+        }
+        if (h->total > (1 << 20)) {
+            ok = ok && write(fd, h, h->total) == (ssize_t)h->total;
+        } else {
+            memcpy(buf + fill, h, h->total);
+            fill += h->total;
+        }
+        kept += h->total;
+    }
+    /* one use record per distinct last use */
+    for (uint32_t a = 1; ok && a <= limit && pc_mutant() != MUT_COMPACT_FORGETS;
+         a++) {
+        uint16_t boot = c->boot_no - a;
+        uint32_t n = 0;
+        uint64_t total;
+        PCacheRecHdr *h;
+        uint32_t *p;
+
+        for (uint32_t k = 0; k < nk; k++) {
+            n += kboot[k] == boot;
+        }
+        if (!n) {
+            continue;
+        }
+        total = sizeof(PCacheRecHdr) + 8 + (uint64_t)n * 8;
+        h = g_malloc0(total);
+        p = (uint32_t *)(h + 1);
+        h->magic = PC_REC_MAGIC;
+        h->total = total;
+        h->kind = PC_KIND_USE;
+        p[0] = boot;
+        p[1] = n;
+        p += 2;
+        for (uint32_t k = 0; k < nk; k++) {
+            if (kboot[k] == boot) {
+                *p++ = koff[k];
+                *p++ = 1;
+            }
+        }
+        h->crc = crc32c(0xffffffff, (const uint8_t *)h + 16, total - 16);
+        if (fill) {
+            ok = write(fd, buf, fill) == (ssize_t)fill;
+            fill = 0;
+        }
+        ok = ok && write(fd, h, total) == (ssize_t)total;
+        kept += total;
+        g_free(h);
+    }
+    if (ok && fill) {
+        ok = write(fd, buf, fill) == (ssize_t)fill;
+    }
+    g_free(buf);
+    g_free(koff);
+    g_free(kboot);
+    if (fd >= 0) {
+        close(fd);
+    }
+    if (ok && rename(tmp, c->path) == 0) {
+        info_report("pcache: compacted %s, %" PRIu64 " of %" PRIu64
+                    " bytes kept", c->path, kept, c->end);
+        g_free(tmp);
+        return true;
+    }
+    unlink(tmp);
+    g_free(tmp);
+    return false;
+}
+
+static PCache *pc_open_file(const char *dir, const uint8_t id[PCACHE_ID_LEN],
+                            bool want_rw, uint64_t cap, bool may_compact,
+                            Error **errp)
+{
+    PCache *c = g_new0(PCache, 1);
+    struct stat sb;
+    char hex[PCACHE_ID_LEN * 2 + 1];
+    PCacheFileHdr fh;
+    bool created = false;
+
+    c->fd = -1;
+    c->cap = ROUND_UP(MIN(cap, 32ull << 30), 1 << 20);
+    c->maxrec = MIN(c->cap / 96, (uint64_t)UINT32_MAX / 2);
+    memcpy(c->id, id, PCACHE_ID_LEN);
+    qemu_mutex_init(&c->lock);
+    for (int i = 0; i < PCACHE_ID_LEN; i++) {
+        snprintf(hex + 2 * i, 3, "%02x", id[i]);
+    }
+    c->dir = g_strdup(dir);
+    c->path = g_strdup_printf("%s/%s.pack", dir, hex);
+
+    if (want_rw) {
+        if (g_mkdir_with_parents(dir, 0755) < 0) {
+            error_setg_errno(errp, errno, "pcache: cannot create %s", dir);
+            goto fail;
+        }
+        c->fd = open(c->path, O_RDWR | O_CREAT | O_CLOEXEC, 0644);
+        if (c->fd >= 0 && flock(c->fd, LOCK_EX | LOCK_NB) == 0) {
+            c->rw = true;
+        } else if (c->fd >= 0) {
+            /* another process appends to it: read it, never write */
+            close(c->fd);
+            c->fd = open(c->path, O_RDONLY | O_CLOEXEC);
+        }
+    } else {
+        c->fd = open(c->path, O_RDONLY | O_CLOEXEC);
+    }
+    if (c->fd < 0) {
+        error_setg_errno(errp, errno, "pcache: cannot open %s", c->path);
+        goto fail;
+    }
+    if (fstat(c->fd, &sb) < 0) {
+        error_setg_errno(errp, errno, "pcache: cannot stat %s", c->path);
+        goto fail;
+    }
+    /*
+     * A new pack, or one whose creator died between the allocation and the
+     * header: with the lock held nobody else writes, and a header with no
+     * magic cannot have records behind it.
+     */
+    if (c->rw && (sb.st_size == 0 || (pc_mutant() != MUT_NO_REPAIR &&
+                  (pread(c->fd, &fh, sizeof(fh), 0) == sizeof(fh) &&
+                   !memcmp(fh.magic, "\0\0\0\0\0\0\0\0", 8))))) {
+        memset(&fh, 0, sizeof(fh));
+        memcpy(fh.magic, PC_FILE_MAGIC, 8);
+        fh.version = PC_VERSION;
+        fh.hdr_size = PC_HDR_SIZE;
+        memcpy(fh.id, id, PCACHE_ID_LEN);
+        if (posix_fallocate(c->fd, 0, PC_GROW) ||
+            pwrite(c->fd, &fh, sizeof(fh), 0) != sizeof(fh)) {
+            error_setg(errp, "pcache: cannot initialise %s", c->path);
+            goto fail;
+        }
+        if (fstat(c->fd, &sb) < 0) {
+            goto fail;
+        }
+        created = true;
+    }
+    if (sb.st_size < PC_HDR_SIZE) {
+        error_setg(errp, "pcache: %s is truncated inside its header, ignored",
+                   c->path);
+        goto fail;
+    }
+    c->map = mmap(NULL, c->cap, c->rw ? PROT_READ | PROT_WRITE : PROT_READ,
+                  MAP_SHARED, c->fd, 0);
+    if (c->map == MAP_FAILED) {
+        c->map = NULL;
+        error_setg_errno(errp, errno, "pcache: cannot map %s", c->path);
+        goto fail;
+    }
+    c->fh = (PCacheFileHdr *)c->map;
+    if (memcmp(c->fh->magic, PC_FILE_MAGIC, 8) ||
+        c->fh->version != PC_VERSION || c->fh->hdr_size != PC_HDR_SIZE) {
+        error_setg(errp, "pcache: %s is not a pack of this version, ignored",
+                   c->path);
+        goto fail;
+    }
+    if (pc_mutant() != MUT_IGNORE_ID &&
+        memcmp(c->fh->id, id, PCACHE_ID_LEN)) {
+        error_setg(errp, "pcache: %s belongs to another translator, ignored",
+                   c->path);
+        goto fail;
+    }
+    if ((uint64_t)sb.st_size > c->cap) {
+        error_setg(errp, "pcache: %s is larger than pcache-max, ignored",
+                   c->path);
+        goto fail;
+    }
+    c->file_size = sb.st_size;
+    c->off8 = pc_anon((size_t)c->maxrec * 4);
+    c->next = pc_anon((size_t)c->maxrec * 4);
+    c->lastboot = pc_anon((size_t)c->maxrec * 4);
+    c->uses = pc_anon((size_t)c->maxrec * 4);
+    c->state = pc_anon((size_t)c->maxrec);
+    c->hash32 = pc_anon((size_t)c->maxrec * 4);
+    if (pc_mutant() == MUT_VA_IN_KEY) {
+        c->mut_pc = pc_anon((size_t)c->maxrec * 8);
+    }
+    if (!c->off8 || !c->next || !c->lastboot || !c->uses || !c->state ||
+        !c->hash32) {
+        error_setg(errp, "pcache: out of address space for the index");
+        goto fail;
+    }
+    c->tab = pc_tab_new(1 << 16);
+    c->old_tabs = g_ptr_array_new_with_free_func(g_free);
+    c->boot_no = c->fh->boot_no;
+    pc_scan(c, sb.st_size);
+    c->st.records = c->nrec;
+    if (c->rw) {
+        c->boot_no++;
+        c->fh->boot_no = c->boot_no;
+        if (may_compact && !created && c->end > c->cap / 4 * 3 &&
+            pc_compact(c)) {
+            pc_free(c);
+            return pc_open_file(dir, id, want_rw, cap, false, errp);
+        }
+        if (c->file_size < c->end) {
+            c->file_size = c->end;
+        }
+        /* cut off whatever torn tail the scan stopped at */
+        if (c->end + 8 <= c->file_size) {
+            memset(c->map + c->end, 0, 8);
+        }
+    }
+    c->st.rw = c->rw;
+    c->st.boot_no = c->boot_no;
+    return c;
+
+fail:
+    pc_free(c);
+    return NULL;
+}
+
+PCache *pcache_open(const char *dir, const uint8_t id[PCACHE_ID_LEN],
+                    bool want_rw, uint64_t cap, Error **errp)
+{
+    return pc_open_file(dir, id, want_rw, cap, true, errp);
+}
+
+const char *pcache_path(PCache *c)
+{
+    return c->path;
+}
+
+static bool pc_key_match(PCache *c, uint32_t rid, const PCacheKey *k,
+                         uint32_t e4, uint32_t e8)
+{
+    const PCacheRecHdr *h = pc_rec(c, rid);
+
+    if (h->entry_off != k->entry_off || h->e4 != e4 || h->e8 != e8 ||
+        h->cs_base != k->cs_base || h->cflags != k->cflags) {
+        return false;
+    }
+    if (pc_mutant() != MUT_IGNORE_FLAGS && h->flags != k->flags) {
+        return false;
+    }
+    if (pc_mutant() == MUT_VA_IN_KEY && c->mut_pc[rid] != k->pc) {
+        return false;
+    }
+    return true;
+}
+
+static void pc_view(PCache *c, uint32_t rid, PCacheView *v)
+{
+    const PCacheRecHdr *h = pc_rec(c, rid);
+    const uint8_t *p = (const uint8_t *)(h + 1);
+
+    v->hdr = h;
+    v->rid = rid;
+    v->guest = p;
+    p += pc_align8(h->guest_len);
+    v->code = p;
+    p += pc_align8(h->code_len);
+    v->search = p;
+    p += pc_align8(h->search_len);
+    v->relocs = (const PCacheReloc *)p;
+}
+
+bool pcache_lookup(PCache *c, const PCacheKey *key, const uint8_t *p0,
+                   uint32_t avail0, PCacheView *out)
+{
+    uint32_t e4, e8;
+
+    if (avail0 < 4) {
+        return false;
+    }
+    e4 = pc_e4(p0, avail0);
+    /* a block of more than one word is indexed by its second word too */
+    e8 = avail0 >= 8 ? pc_e4(p0 + 4, avail0 - 4) : 0;
+    qatomic_inc(&c->st.lookups);
+
+    for (;;) {
+        uint32_t found = UINT32_MAX;
+
+        /* no lock: the table and the chains only ever gain valid rids */
+        PCTab *tab = qatomic_load_acquire(&c->tab);
+
+        for (int probe = 0; probe < 2 && found == UINT32_MAX; probe++) {
+            /* second probe: blocks of one word, which have no second word */
+            uint32_t w = probe ? 0 : e8;
+
+            if (probe && !e8) {
+                break;
+            }
+            for (uint32_t r = qatomic_load_acquire(&tab->b[
+                     pc_hash(key->cs_base, key->flags, key->cflags,
+                             key->entry_off, e4, w) & (tab->n - 1)]);
+                 r; r = qatomic_read(&c->next[r - 1])) {
+                const PCacheRecHdr *h = pc_rec(c, r - 1);
+                PCacheView v;
+
+                if (!pc_key_match(c, r - 1, key, e4, w) ||
+                    qatomic_read(&c->state[r - 1]) == 2) {
+                    continue;
+                }
+                qatomic_inc(&c->st.cands);
+                if (pc_mutant() != MUT_SKIP_COMPARE) {
+                    pc_view(c, r - 1, &v);
+                    /* a block that runs into the next page is not found here */
+                    if (h->guest_len > avail0 ||
+                        memcmp(p0, v.guest, h->guest_len)) {
+                        qatomic_inc(&c->st.mismatch);
+                        continue;
+                    }
+                }
+                found = r - 1;
+                break;
+            }
+        }
+        if (found == UINT32_MAX) {
+            return false;
+        }
+        if (qatomic_read(&c->state[found]) == 0) {
+            const PCacheRecHdr *h = pc_rec(c, found);
+            bool ok = pc_mutant() == MUT_SKIP_CRC ||
+                      crc32c(0xffffffff, (const uint8_t *)h + 16,
+                             h->total - 16) == h->crc;
+
+            qatomic_set(&c->state[found], ok ? 1 : 2);
+            if (!ok) {
+                /* skip it, and look at the rest of the chain again */
+                qatomic_inc(&c->st.crc_bad);
+                continue;
+            }
+        }
+        pc_view(c, found, out);
+        qatomic_inc(&c->uses[found]);
+        qatomic_inc(&c->st.hits);
+        return true;
+    }
+}
+
+bool pcache_store(PCache *c, const PCacheNew *n)
+{
+    uint32_t glen = pc_align8(n->guest_len);
+    uint32_t clen = pc_align8(n->code_len);
+    uint32_t slen = pc_align8(n->search_len);
+    uint64_t total = sizeof(PCacheRecHdr) + glen + clen + slen +
+                     (uint64_t)n->nreloc * sizeof(PCacheReloc);
+    uint32_t e4, e8;
+    PCacheRecHdr *h;
+    uint8_t *p;
+    bool ret = false;
+
+    if (!c->rw || n->guest_len < 4 || n->guest_len > UINT16_MAX ||
+        n->code_len > UINT16_MAX || n->search_len > UINT16_MAX ||
+        n->nreloc > UINT16_MAX || total > UINT32_MAX / 2) {
+        return false;
+    }
+    e4 = pc_e4(n->guest, n->guest_len);
+    e8 = n->guest_len >= 8 ? pc_e4(n->guest + 4, n->guest_len - 4) : 0;
+
+    qemu_mutex_lock(&c->lock);
+    if (c->full || c->nrec >= c->maxrec || c->end + total + 8 > c->cap) {
+        if (!c->full) {
+            c->full = true;
+        }
+        qatomic_inc(&c->st.full);
+        goto out;
+    }
+    /* the same block again, translated by two vCPUs at once or after a flush */
+    for (uint32_t r = c->tab->b[pc_hash(n->key.cs_base, n->key.flags,
+                                        n->key.cflags, n->key.entry_off, e4,
+                                        e8) & (c->tab->n - 1)];
+         r; r = c->next[r - 1]) {
+        const PCacheRecHdr *o = pc_rec(c, r - 1);
+        PCacheView v;
+
+        if ((c->state[r - 1] == 2 && pc_mutant() != MUT_DUP_BAD) ||
+            !pc_key_match(c, r - 1, &n->key, e4, e8) ||
+            o->guest_len != n->guest_len) {
+            continue;
+        }
+        pc_view(c, r - 1, &v);
+        if (!memcmp(v.guest, n->guest, n->guest_len)) {
+            qatomic_inc(&c->st.dups);
+            ret = true;
+            goto out;
+        }
+    }
+    if (!pc_grow(c, c->end + total + 8)) {
+        c->full = true;
+        c->rw = false;
+        qatomic_inc(&c->st.full);
+        goto out;
+    }
+    h = (PCacheRecHdr *)(c->map + c->end);
+    memset(h, 0, total);
+    h->total = total;
+    h->kind = PC_KIND_TB;
+    h->cs_base = n->key.cs_base;
+    h->flags = n->key.flags;
+    h->cflags = n->key.cflags;
+    h->entry_off = n->key.entry_off;
+    h->e4 = e4;
+    h->e8 = e8;
+    h->guest_len = n->guest_len;
+    h->icount = n->icount;
+    h->code_len = n->code_len;
+    h->search_len = n->search_len;
+    memcpy(h->jmp_reset, n->jmp_reset, sizeof(h->jmp_reset));
+    memcpy(h->jmp_insn, n->jmp_insn, sizeof(h->jmp_insn));
+    h->nreloc = n->nreloc;
+    h->pad = c->boot_no;
+    h->cycles = n->cycles;
+    p = (uint8_t *)(h + 1);
+    memcpy(p, n->guest, n->guest_len);
+    p += glen;
+    memcpy(p, n->code, n->code_len);
+    p += clen;
+    memcpy(p, n->search, n->search_len);
+    p += slen;
+    if (n->nreloc) {
+        memcpy(p, n->relocs, (size_t)n->nreloc * sizeof(PCacheReloc));
+    }
+    h->crc = crc32c(0xffffffff, (const uint8_t *)h + 16, total - 16);
+    if (c->mut_pc) {
+        c->mut_pc[c->nrec] = n->key.pc;
+    }
+    pc_index_add(c, c->end, c->boot_no);
+    c->state[c->nrec - 1] = 1;
+    c->end += total;
+    memset(c->map + c->end, 0, 8);
+    /* the magic last: a reader of the file never sees half a record */
+    qatomic_store_release(&h->magic, PC_REC_MAGIC);
+    qatomic_inc(&c->st.stores);
+    ret = true;
+out:
+    qemu_mutex_unlock(&c->lock);
+    return ret;
+}
+
+bool pcache_is_rw(PCache *c)
+{
+    /* a full pack takes no more records: do not prove blocks for it */
+    return qatomic_read(&c->rw) && !qatomic_read(&c->full);
+}
+
+void pcache_stats(PCache *c, PCacheStats *st)
+{
+    *st = c->st;
+    st->records = c->nrec;
+    st->end = c->end;
+}
+
+void pcache_close(PCache *c, bool unmap)
+{
+    if (!c) {
+        return;
+    }
+    qemu_mutex_lock(&c->lock);
+    if (c->rw) {
+        uint32_t n = 0;
+
+        for (uint32_t rid = 0; rid < c->nrec; rid++) {
+            n += c->uses[rid] != 0;
+        }
+        if (n) {
+            uint64_t total = sizeof(PCacheRecHdr) + 8 + (uint64_t)n * 8;
+
+            if (c->end + total + 8 <= c->cap &&
+                pc_grow(c, c->end + total + 8)) {
+                PCacheRecHdr *h = (PCacheRecHdr *)(c->map + c->end);
+                uint32_t *p = (uint32_t *)(h + 1);
+
+                memset(h, 0, total);
+                h->total = total;
+                h->kind = PC_KIND_USE;
+                p[0] = c->boot_no;
+                p[1] = n;
+                p += 2;
+                for (uint32_t rid = 0; rid < c->nrec; rid++) {
+                    if (c->uses[rid]) {
+                        *p++ = c->off8[rid];
+                        *p++ = c->uses[rid];
+                    }
+                }
+                h->crc = crc32c(0xffffffff, (const uint8_t *)h + 16,
+                                total - 16);
+                c->end += total;
+                memset(c->map + c->end, 0, 8);
+                qatomic_store_release(&h->magic, PC_REC_MAGIC);
+            }
+        }
+        msync(c->map, c->end, MS_ASYNC);
+        if (unmap && ftruncate(c->fd, c->end) < 0) {
+            /* a padded file is fine, the scan stops at the zero magic */
+        }
+        c->rw = false;
+    }
+    qemu_mutex_unlock(&c->lock);
+    if (unmap) {
+        pc_free(c);
+    }
+}
+#endif /* CONFIG_LINUX */
diff --git a/accel/tcg/pcache.h b/accel/tcg/pcache.h
new file mode 100644
index 0000000000..48c9b29399
--- /dev/null
+++ b/accel/tcg/pcache.h
@@ -0,0 +1,140 @@
+/*
+ * Persistent, content keyed store of translated code (the pack).
+ *
+ * One pack file per translator id, mmap'd, append-only. A record holds the
+ * guest bytes a translation was made from, the host code (with the list of
+ * fields that must be fixed up when it is placed at another address) and the
+ * unwind data. Lookup is by (entry offset in its page, TB flags, cs_base,
+ * cflags, first guest word) and is always confirmed by comparing the whole
+ * guest byte range, so the physical or virtual address of the code is never
+ * part of the key.
+ *
+ * This file knows nothing about TCG; accel/tcg/pcache-tcg.c does the glue.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef ACCEL_TCG_PCACHE_H
+#define ACCEL_TCG_PCACHE_H
+
+#define PCACHE_ID_LEN 32
+
+typedef struct PCache PCache;
+
+typedef enum PCacheRelocKind {
+    /* rel32 to a fixed address in the code buffer; addend from the epilogue */
+    PCACHE_RELOC_PCREL_BUF = 1,
+    /* rel32 to a fixed address in the executable image; addend from anchor */
+    PCACHE_RELOC_PCREL_IMG = 2,
+    /* 64 bit absolute address in the executable image; addend from anchor */
+    PCACHE_RELOC_ABS_IMG = 3,
+    /* 64 bit absolute address inside the TB's own struct; addend from TB */
+    PCACHE_RELOC_ABS_TB = 4,
+} PCacheRelocKind;
+
+typedef struct PCacheReloc {
+    uint32_t off;       /* byte offset in the code */
+    uint32_t kind;
+    int64_t addend;
+} PCacheReloc;
+
+typedef struct PCacheKey {
+    uint64_t pc;        /* virtual pc; diagnostics, not part of the key */
+    uint64_t cs_base;
+    uint32_t flags;
+    uint32_t cflags;
+    uint32_t entry_off; /* pc & (page_size - 1) */
+} PCacheKey;
+
+typedef struct PCacheNew {
+    PCacheKey key;
+    const uint8_t *guest;
+    uint32_t guest_len;
+    const uint8_t *code;
+    uint32_t code_len;
+    const uint8_t *search;
+    uint32_t search_len;
+    const PCacheReloc *relocs;
+    uint32_t nreloc;
+    uint16_t icount;
+    uint16_t jmp_reset[2];
+    uint16_t jmp_insn[2];
+    uint32_t cycles;    /* host cycles the translation took, saturated */
+} PCacheNew;
+
+/* On-disk record header, 72 bytes, followed by the payload. */
+typedef struct PCacheRecHdr {
+    uint32_t magic;
+    uint32_t total;     /* header and payload, a multiple of 8 */
+    uint32_t crc;       /* crc32c of bytes [16, total) */
+    uint32_t kind;
+    uint64_t cs_base;
+    uint32_t flags;
+    uint32_t cflags;
+    uint32_t entry_off;
+    uint32_t e4;        /* first four guest bytes */
+    uint16_t guest_len;
+    uint16_t icount;
+    uint16_t code_len;
+    uint16_t search_len;
+    uint16_t jmp_reset[2];
+    uint16_t jmp_insn[2];
+    uint16_t nreloc;
+    uint16_t pad;
+    uint32_t cycles;
+    uint32_t e8;        /* the second guest word, 0 for a one word block */
+    uint32_t spare;
+} PCacheRecHdr;
+
+typedef struct PCacheView {
+    const PCacheRecHdr *hdr;
+    const uint8_t *guest;
+    const uint8_t *code;
+    const uint8_t *search;
+    const PCacheReloc *relocs;
+    uint32_t rid;
+} PCacheView;
+
+typedef struct PCacheStats {
+    uint64_t records;       /* records in the index */
+    uint64_t scanned_bytes;
+    uint64_t lookups;
+    uint64_t cands;         /* key matches inspected */
+    uint64_t hits;
+    uint64_t mismatch;      /* key matched, guest bytes did not */
+    uint64_t crc_bad;
+    uint64_t stores;
+    uint64_t dups;
+    uint64_t full;
+    uint64_t end;           /* append offset */
+    uint32_t boot_no;
+    bool rw;
+} PCacheStats;
+
+/*
+ * Open (creating it when @want_rw) the pack for @id in @dir. Returns NULL,
+ * with @errp set, when the pack must not be used: a file with a bad header or
+ * another translator id is never trusted and never modified. @cap bounds the
+ * pack size in bytes. Read-only when the pack is locked by another process.
+ */
+PCache *pcache_open(const char *dir, const uint8_t id[PCACHE_ID_LEN],
+                    bool want_rw, uint64_t cap, Error **errp);
+/* @unmap false: at exit, threads may still look things up */
+void pcache_close(PCache *c, bool unmap);
+const char *pcache_path(PCache *c);
+
+/*
+ * Find the record for @key whose guest bytes equal the code at @p0, of which
+ * @avail0 bytes are readable, up to the end of the page. A record that runs
+ * into the next page is never found.
+ */
+bool pcache_lookup(PCache *c, const PCacheKey *key, const uint8_t *p0,
+                   uint32_t avail0, PCacheView *out);
+
+/* Append a record. False when the pack is read-only, full, or has it. */
+bool pcache_store(PCache *c, const PCacheNew *n);
+
+void pcache_stats(PCache *c, PCacheStats *st);
+bool pcache_is_rw(PCache *c);
+
+#endif
