diff --git a/tests/unit/test-pcache.c b/tests/unit/test-pcache.c
new file mode 100644
index 0000000000..66c8e67acd
--- /dev/null
+++ b/tests/unit/test-pcache.c
@@ -0,0 +1,559 @@
+/*
+ * Tests of the persistent translation cache pack (accel/tcg/pcache.c): the
+ * key (entry offset, TB flags, cs_base, cflags, guest bytes, never the
+ * address), the translator id, and what happens to a truncated, corrupt or
+ * foreign pack.
+ *
+ * pcache.c is compiled into this test with PCACHE_TEST_HOOKS, so that
+ * PCACHE_MUTANT=n breaks one rule on purpose. Every test below must fail
+ * under the mutant that breaks the rule it checks (tests/unit/meson.build runs
+ * the mutants with should_fail).
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "../../accel/tcg/pcache.c"
+
+#define CAP (64ull << 20)
+
+static uint8_t id_a[PCACHE_ID_LEN];
+static uint8_t id_b[PCACHE_ID_LEN];
+
+static char *make_dir(void)
+{
+    GError *err = NULL;
+    char *d = g_dir_make_tmp("pcache-XXXXXX", &err);
+
+    g_assert_no_error(err);
+    return d;
+}
+
+static void rm_dir(char *d)
+{
+    char *cmd = g_strdup_printf("rm -rf %s", d);
+
+    g_assert(system(cmd) == 0);
+    g_free(cmd);
+    g_free(d);
+}
+
+static char *hex_path(const char *dir, const uint8_t id[PCACHE_ID_LEN])
+{
+    GString *s = g_string_new(dir);
+
+    g_string_append(s, "/");
+    for (int i = 0; i < PCACHE_ID_LEN; i++) {
+        g_string_append_printf(s, "%02x", id[i]);
+    }
+    g_string_append(s, ".pack");
+    return g_string_free(s, false);
+}
+
+#define ENTRY_OFF 0x120u
+#define PAGE      0x4000u
+
+/* a record of @n guest bytes derived from @seed, at ENTRY_OFF in its page */
+static void fill_guest(uint8_t *g, unsigned n, unsigned seed)
+{
+    for (unsigned i = 0; i < n; i++) {
+        g[i] = (uint8_t)(seed * 31 + i * 7 + 1);
+    }
+}
+
+static bool store_one(PCache *c, uint64_t pc, uint32_t flags, uint64_t cs_base,
+                      const uint8_t *guest, unsigned glen, unsigned seed)
+{
+    uint8_t code[80], search[8];
+    PCacheReloc rel[2] = {
+        { 4, PCACHE_RELOC_PCREL_BUF, -0x40 },
+        { 24, PCACHE_RELOC_ABS_IMG, 0x1234 },
+    };
+    PCacheNew n = {
+        .key = { .pc = pc, .cs_base = cs_base, .flags = flags,
+                 .cflags = 0x20000, .entry_off = pc & (PAGE - 1) },
+        .guest = guest, .guest_len = glen,
+        .code = code, .code_len = sizeof(code),
+        .search = search, .search_len = sizeof(search),
+        .relocs = rel, .nreloc = 2,
+        .icount = glen / 4,
+        .jmp_reset = { 12, 0xffff }, .jmp_insn = { 8, 0xffff },
+        .cycles = 1000,
+    };
+
+    memset(code, seed, sizeof(code));
+    memset(search, seed + 1, sizeof(search));
+    return pcache_store(c, &n);
+}
+
+static bool find_one(PCache *c, uint64_t pc, uint32_t flags, uint64_t cs_base,
+                     const uint8_t *guest, PCacheView *v)
+{
+    /* the guest page: guest bytes at ENTRY_OFF, room to the page end */
+    PCacheKey k = { .pc = pc, .cs_base = cs_base, .flags = flags,
+                    .cflags = 0x20000, .entry_off = pc & (PAGE - 1) };
+
+    return pcache_lookup(c, &k, guest, PAGE - k.entry_off, v);
+}
+
+static PCache *open_rw(const char *dir, const uint8_t *id)
+{
+    Error *err = NULL;
+    PCache *c = pcache_open(dir, id, true, CAP, &err);
+
+    g_assert_null(err);
+    g_assert_nonnull(c);
+    return c;
+}
+
+static void test_roundtrip(void)
+{
+    char *dir = make_dir();
+    uint8_t g[64];
+    PCacheView v;
+    PCache *c;
+
+    fill_guest(g, sizeof(g), 1);
+    c = open_rw(dir, id_a);
+    g_assert_true(store_one(c, 0x180000000ull + ENTRY_OFF, 0x1234, 0x77, g,
+                            sizeof(g), 5));
+    g_assert_true(find_one(c, 0x180000000ull + ENTRY_OFF, 0x1234, 0x77, g, &v));
+    g_assert_cmpuint(v.hdr->code_len, ==, 80);
+    g_assert_cmpuint(v.code[0], ==, 5);
+    g_assert_cmpuint(v.hdr->nreloc, ==, 2);
+    g_assert_cmpint(v.relocs[1].addend, ==, 0x1234);
+    g_assert_cmpuint(v.hdr->jmp_reset[0], ==, 12);
+    pcache_close(c, true);
+
+    /* and again from the file */
+    c = open_rw(dir, id_a);
+    g_assert_true(find_one(c, 0x180000000ull + ENTRY_OFF, 0x1234, 0x77, g, &v));
+    g_assert_cmpuint(v.hdr->icount, ==, 16);
+    pcache_close(c, true);
+    rm_dir(dir);
+}
+
+/* The same bytes at another virtual address are the same block. */
+static void test_other_va(void)
+{
+    char *dir = make_dir();
+    uint8_t g[64];
+    PCacheView v;
+    PCache *c;
+
+    fill_guest(g, sizeof(g), 2);
+    c = open_rw(dir, id_a);
+    g_assert_true(store_one(c, 0x180000000ull + ENTRY_OFF, 0x40, 0, g,
+                            sizeof(g), 6));
+    g_assert_true(find_one(c, 0xfffffe0012340000ull + ENTRY_OFF, 0x40, 0, g,
+                           &v));
+    g_assert_cmpuint(v.code[0], ==, 6);
+    pcache_close(c, true);
+    rm_dir(dir);
+}
+
+/* One changed byte, anywhere in the block, is another block. */
+static void test_changed_byte(void)
+{
+    char *dir = make_dir();
+    uint8_t g[64], h[64];
+    PCacheView v;
+    PCache *c;
+
+    fill_guest(g, sizeof(g), 3);
+    c = open_rw(dir, id_a);
+    g_assert_true(store_one(c, ENTRY_OFF, 0x40, 0, g, sizeof(g), 7));
+    for (unsigned i = 0; i < sizeof(g); i++) {
+        memcpy(h, g, sizeof(g));
+        h[i] ^= 1;
+        /* the first word is part of the index, the rest of the compare */
+        g_assert_false(find_one(c, ENTRY_OFF, 0x40, 0, h, &v));
+    }
+    g_assert_true(find_one(c, ENTRY_OFF, 0x40, 0, g, &v));
+    pcache_close(c, true);
+    rm_dir(dir);
+}
+
+/* TB flags, cs_base and cflags are part of the key. */
+static void test_changed_flags(void)
+{
+    char *dir = make_dir();
+    uint8_t g[64];
+    PCacheView v;
+    PCache *c;
+
+    fill_guest(g, sizeof(g), 4);
+    c = open_rw(dir, id_a);
+    g_assert_true(store_one(c, ENTRY_OFF, 0x1000, 0x5, g, sizeof(g), 8));
+    g_assert_false(find_one(c, ENTRY_OFF, 0x1001, 0x5, g, &v));
+    g_assert_false(find_one(c, ENTRY_OFF, 0x1000 | (1u << 31), 0x5, g, &v));
+    g_assert_false(find_one(c, ENTRY_OFF, 0x1000, 0x6, g, &v));
+    g_assert_true(find_one(c, ENTRY_OFF, 0x1000, 0x5, g, &v));
+    /* another flag word keeps its own translation next to the first */
+    g_assert_true(store_one(c, ENTRY_OFF, 0x1001, 0x5, g, sizeof(g), 9));
+    g_assert_true(find_one(c, ENTRY_OFF, 0x1001, 0x5, g, &v));
+    g_assert_cmpuint(v.code[0], ==, 9);
+    g_assert_true(find_one(c, ENTRY_OFF, 0x1000, 0x5, g, &v));
+    g_assert_cmpuint(v.code[0], ==, 8);
+    pcache_close(c, true);
+    rm_dir(dir);
+}
+
+/*
+ * Blocks that share the entry offset, the flags and the first word, and those
+ * of one word, are told apart by their bytes, and each is found.
+ */
+static void test_shared_prefix(void)
+{
+    char *dir = make_dir();
+    uint8_t g[40][64], one[8];
+    PCacheView v;
+    PCache *c;
+
+    c = open_rw(dir, id_a);
+    for (int i = 0; i < 40; i++) {
+        fill_guest(g[i], 64, 1);
+        g[i][8 + i % 50] ^= i + 1;      /* the same two words, then another */
+        g_assert_true(store_one(c, ENTRY_OFF, 0x40, 0, g[i], 64, 100 + i));
+    }
+    memset(one, 0, sizeof(one));
+    memcpy(one, g[0], 4);
+    g_assert_true(store_one(c, ENTRY_OFF, 0x40, 0, one, 4, 200));
+    for (int i = 0; i < 40; i++) {
+        g_assert_true(find_one(c, ENTRY_OFF, 0x40, 0, g[i], &v));
+        g_assert_cmpuint(v.code[0], ==, 100 + i);
+    }
+    /* the one word block is found when the bytes after it are the first
+     * block's, and its own bytes are what is compared */
+    g_assert_true(find_one(c, ENTRY_OFF, 0x40, 0, one, &v));
+    pcache_close(c, true);
+    rm_dir(dir);
+}
+
+/* A pack of another translator (another build id) is never used. */
+static void test_build_id(void)
+{
+    char *dir = make_dir();
+    uint8_t g[64];
+    PCacheView v;
+    PCache *c;
+    Error *err = NULL;
+    char *pa = hex_path(dir, id_a);
+    char *pb = hex_path(dir, id_b);
+
+    fill_guest(g, sizeof(g), 5);
+    c = open_rw(dir, id_a);
+    g_assert_true(store_one(c, ENTRY_OFF, 0x40, 0, g, sizeof(g), 10));
+    pcache_close(c, true);
+
+    /* the same file under the name of another translator */
+    g_assert_cmpint(rename(pa, pb), ==, 0);
+    c = pcache_open(dir, id_b, true, CAP, &err);
+    g_assert_null(c);
+    g_assert_nonnull(err);
+    error_free(err);
+    err = NULL;
+    c = pcache_open(dir, id_b, false, CAP, &err);
+    g_assert_null(c);
+    error_free(err);
+
+    /* the pack was not touched by the refusals */
+    g_assert_cmpint(rename(pb, pa), ==, 0);
+    c = open_rw(dir, id_a);
+    g_assert_true(find_one(c, ENTRY_OFF, 0x40, 0, g, &v));
+    pcache_close(c, true);
+    g_free(pa);
+    g_free(pb);
+    rm_dir(dir);
+}
+
+/* A pack cut in the middle of a record loses that record, not the rest. */
+static void test_truncated(void)
+{
+    char *dir = make_dir();
+    uint8_t g[3][64];
+    PCacheView v;
+    PCache *c;
+    char *p = hex_path(dir, id_a);
+    struct stat sb;
+    PCacheStats st;
+
+    c = open_rw(dir, id_a);
+    for (int i = 0; i < 3; i++) {
+        fill_guest(g[i], 64, 20 + i);
+        g_assert_true(store_one(c, ENTRY_OFF + 0x100 * i, 0x40, 0, g[i], 64,
+                                30 + i));
+    }
+    pcache_close(c, true);
+    g_assert_cmpint(stat(p, &sb), ==, 0);
+    g_assert_cmpint(truncate(p, sb.st_size - 40), ==, 0);
+
+    c = open_rw(dir, id_a);
+    pcache_stats(c, &st);
+    g_assert_cmpuint(st.records, ==, 2);
+    g_assert_true(find_one(c, ENTRY_OFF, 0x40, 0, g[0], &v));
+    g_assert_true(find_one(c, ENTRY_OFF + 0x100, 0x40, 0, g[1], &v));
+    g_assert_false(find_one(c, ENTRY_OFF + 0x200, 0x40, 0, g[2], &v));
+    /* and it can append again over the torn tail */
+    g_assert_true(store_one(c, ENTRY_OFF + 0x300, 0x40, 0, g[2], 64, 40));
+    pcache_close(c, true);
+    c = open_rw(dir, id_a);
+    g_assert_true(find_one(c, ENTRY_OFF + 0x300, 0x40, 0, g[2], &v));
+    g_assert_cmpuint(v.code[0], ==, 40);
+    pcache_close(c, true);
+
+    /* cut inside the header of the pack: ignored, not trusted */
+    g_assert_cmpint(truncate(p, 100), ==, 0);
+    {
+        Error *err = NULL;
+
+        c = pcache_open(dir, id_a, false, CAP, &err);
+        g_assert_null(c);
+        error_free(err);
+    }
+    g_free(p);
+    rm_dir(dir);
+}
+
+/* A record whose bytes changed on disk is skipped, the others are not. */
+static void test_corrupt(void)
+{
+    char *dir = make_dir();
+    uint8_t g[3][64];
+    PCacheView v;
+    PCache *c;
+    char *p = hex_path(dir, id_a);
+    PCacheStats st;
+    int fd;
+    uint8_t x;
+
+    c = open_rw(dir, id_a);
+    for (int i = 0; i < 3; i++) {
+        fill_guest(g[i], 64, 50 + i);
+        g_assert_true(store_one(c, ENTRY_OFF + 0x100 * i, 0x40, 0, g[i], 64,
+                                60 + i));
+    }
+    pcache_close(c, true);
+
+    /* flip a byte of the host code of the second record */
+    fd = open(p, O_RDWR);
+    g_assert_cmpint(fd, >=, 0);
+    {
+        /* record = header + guest(64) + code(80) + search(8) + relocs(32) */
+        off_t hdr = sizeof(PCacheRecHdr);
+        off_t rec = 4096 + hdr + 64 + 80 + 8 + 32;
+        off_t at = rec + hdr + 64 + 10;
+
+        g_assert_cmpint(pread(fd, &x, 1, at), ==, 1);
+        x ^= 0x40;
+        g_assert_cmpint(pwrite(fd, &x, 1, at), ==, 1);
+    }
+    close(fd);
+
+    c = open_rw(dir, id_a);
+    g_assert_true(find_one(c, ENTRY_OFF, 0x40, 0, g[0], &v));
+    g_assert_false(find_one(c, ENTRY_OFF + 0x100, 0x40, 0, g[1], &v));
+    g_assert_true(find_one(c, ENTRY_OFF + 0x200, 0x40, 0, g[2], &v));
+    pcache_stats(c, &st);
+    g_assert_cmpuint(st.crc_bad, ==, 1);
+    pcache_close(c, true);
+    g_free(p);
+    rm_dir(dir);
+}
+
+/* A file that is not a pack is neither used nor overwritten. */
+static void test_foreign_file(void)
+{
+    char *dir = make_dir();
+    char *p = hex_path(dir, id_a);
+    Error *err = NULL;
+    char junk[8192];
+    char back[8192];
+    PCache *c;
+    FILE *f;
+
+    memset(junk, 0x5a, sizeof(junk));
+    f = fopen(p, "wb");
+    g_assert_nonnull(f);
+    g_assert_cmpuint(fwrite(junk, 1, sizeof(junk), f), ==, sizeof(junk));
+    fclose(f);
+    c = pcache_open(dir, id_a, true, CAP, &err);
+    g_assert_null(c);
+    g_assert_nonnull(err);
+    error_free(err);
+    f = fopen(p, "rb");
+    g_assert_cmpuint(fread(back, 1, sizeof(back), f), ==, sizeof(back));
+    fclose(f);
+    g_assert_cmpint(memcmp(junk, back, sizeof(junk)), ==, 0);
+    g_free(p);
+    rm_dir(dir);
+}
+
+/* The same block twice is stored once; a read-only open does not append. */
+static void test_dups_and_ro(void)
+{
+    char *dir = make_dir();
+    uint8_t g[64];
+    PCacheView v;
+    PCache *c;
+    Error *err = NULL;
+    PCacheStats st;
+
+    fill_guest(g, sizeof(g), 6);
+    c = open_rw(dir, id_a);
+    g_assert_true(store_one(c, ENTRY_OFF, 0x40, 0, g, sizeof(g), 11));
+    g_assert_true(store_one(c, ENTRY_OFF, 0x40, 0, g, sizeof(g), 11));
+    pcache_stats(c, &st);
+    g_assert_cmpuint(st.stores, ==, 1);
+    g_assert_cmpuint(st.dups, ==, 1);
+    pcache_close(c, true);
+
+    c = pcache_open(dir, id_a, false, CAP, &err);
+    g_assert_null(err);
+    g_assert_nonnull(c);
+    g_assert_true(find_one(c, ENTRY_OFF, 0x40, 0, g, &v));
+    g_assert_false(store_one(c, ENTRY_OFF + 0x40, 0x40, 0, g, sizeof(g), 12));
+    pcache_close(c, true);
+    rm_dir(dir);
+}
+
+/* A pack bigger than pcache-max is ignored, not read past the mapping. */
+static void test_oversize(void)
+{
+    char *dir = make_dir();
+    uint8_t g[64];
+    PCache *c;
+    Error *err = NULL;
+
+    fill_guest(g, sizeof(g), 7);
+    c = open_rw(dir, id_a);
+    g_assert_true(store_one(c, ENTRY_OFF, 0x40, 0, g, sizeof(g), 13));
+    /* closed without trimming the file: it stays at its allocated 64 MiB */
+    pcache_close(c, false);
+    /* 64 MiB were allocated for the first record: the cap is below that */
+    c = pcache_open(dir, id_a, true, 1ull << 20, &err);
+    g_assert_null(c);
+    g_assert_nonnull(err);
+    error_free(err);
+    rm_dir(dir);
+}
+
+/* Store @n records "seed0 .. seed0 + n" at distinct entry offsets. */
+static void store_range(PCache *c, unsigned seed0, unsigned n)
+{
+    uint8_t g[64];
+
+    for (unsigned i = 0; i < n; i++) {
+        fill_guest(g, sizeof(g), seed0 + i);
+        g_assert_true(store_one(c, 0x180000000ull + 4 * (seed0 + i), 0x40, 0, g,
+                                sizeof(g), seed0 + i));
+    }
+}
+static bool find_range(PCache *c, unsigned seed)
+{
+    uint8_t g[64];
+    PCacheView v;
+
+    fill_guest(g, sizeof(g), seed);
+    return find_one(c, 0x180000000ull + 4 * seed, 0x40, 0, g, &v);
+}
+/*
+ * Compaction drops the records that nobody used for a while and keeps the
+ * others with the boot of their last use, so that the next compaction does
+ * not take them for records of the boot that stored them (mutant 12).
+ */
+static void test_compact_keeps_use(void)
+{
+    char *dir = make_dir();
+    PCache *c;
+
+    c = open_rw(dir, id_a);
+    store_range(c, 0, 100);         /* 0..49 hot, 50..99 cold */
+    pcache_close(c, true);
+    for (int boot = 2; boot <= 6; boot++) {
+        c = open_rw(dir, id_a);
+        for (unsigned i = 0; i < 50; i++) {
+            g_assert_true(find_range(c, i));
+        }
+        pcache_close(c, true);
+    }
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->boot_no, ==, 7);
+    g_assert_true(pc_compact(c));
+    pcache_close(c, true);
+    c = open_rw(dir, id_a);
+    g_assert_cmpuint(c->nrec, ==, 50);
+    g_assert_true(find_range(c, 10));
+    g_assert_false(find_range(c, 60));
+    /* the hot records were last used in boot 6, not stored in boot 1 */
+    g_assert_cmpuint(c->lastboot[0], ==, 6);
+    /* nothing to drop: no rewrite of the pack */
+    g_assert_false(pc_compact(c));
+    pcache_close(c, true);
+    rm_dir(dir);
+}
+/* A record that failed its crc does not keep a good copy from being stored. */
+static void test_bad_crc_restore(void)
+{
+    char *dir = make_dir();
+    uint8_t g[64];
+    PCacheView v;
+    PCache *c;
+
+    fill_guest(g, sizeof(g), 3);
+    c = open_rw(dir, id_a);
+    g_assert_true(store_one(c, ENTRY_OFF, 0x40, 0, g, sizeof(g), 21));
+    pcache_close(c, true);
+    /* a record is checked at its first use, so after a reopen */
+    c = open_rw(dir, id_a);
+    c->map[((uint64_t)c->off8[0] << 3) + 150] ^= 0xff;    /* the host code */
+    g_assert_false(find_one(c, ENTRY_OFF, 0x40, 0, g, &v));
+    g_assert_true(store_one(c, ENTRY_OFF, 0x40, 0, g, sizeof(g), 21));
+    g_assert_true(find_one(c, ENTRY_OFF, 0x40, 0, g, &v));
+    pcache_close(c, true);
+    rm_dir(dir);
+}
+/* A pack whose creator died before the header was written is rebuilt. */
+static void test_half_created(void)
+{
+    char *dir = make_dir();
+    char *path = hex_path(dir, id_a);
+    uint8_t g[64];
+    PCacheView v;
+    PCache *c;
+    int fd = open(path, O_RDWR | O_CREAT, 0644);
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(posix_fallocate(fd, 0, PC_GROW), ==, 0);
+    close(fd);
+    fill_guest(g, sizeof(g), 4);
+    c = open_rw(dir, id_a);
+    g_assert_true(store_one(c, ENTRY_OFF, 0x40, 0, g, sizeof(g), 22));
+    g_assert_true(find_one(c, ENTRY_OFF, 0x40, 0, g, &v));
+    pcache_close(c, true);
+    g_free(path);
+    rm_dir(dir);
+}
+int main(int argc, char **argv)
+{
+    memset(id_a, 0xa1, sizeof(id_a));
+    memset(id_b, 0xb2, sizeof(id_b));
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/pcache/roundtrip", test_roundtrip);
+    g_test_add_func("/pcache/key/other-va", test_other_va);
+    g_test_add_func("/pcache/key/changed-byte", test_changed_byte);
+    g_test_add_func("/pcache/key/shared-prefix", test_shared_prefix);
+    g_test_add_func("/pcache/key/changed-flags", test_changed_flags);
+    g_test_add_func("/pcache/id/changed-build-id", test_build_id);
+    g_test_add_func("/pcache/file/truncated", test_truncated);
+    g_test_add_func("/pcache/file/corrupt", test_corrupt);
+    g_test_add_func("/pcache/file/foreign", test_foreign_file);
+    g_test_add_func("/pcache/file/oversize", test_oversize);
+    g_test_add_func("/pcache/dups-and-ro", test_dups_and_ro);
+    g_test_add_func("/pcache/compact/keeps-use", test_compact_keeps_use);
+    g_test_add_func("/pcache/file/bad-crc-restore", test_bad_crc_restore);
+    g_test_add_func("/pcache/file/half-created", test_half_created);
+    return g_test_run();
+}
