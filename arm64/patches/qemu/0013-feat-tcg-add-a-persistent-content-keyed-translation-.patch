+static int arm_pcache_cmp_key(const void *a, const void *b)
+{
+    uint32_t x = GPOINTER_TO_UINT(*(gpointer const *)a);
+    uint32_t y = GPOINTER_TO_UINT(*(gpointer const *)b);
+
+    return x < y ? -1 : x > y;
