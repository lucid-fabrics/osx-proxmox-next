 static inline bool cpu_handle_interrupt(CPUState *cpu,
                                         TranslationBlock **last_tb)
 {
@@ -820,7 +941,19 @@ static inline bool cpu_handle_interrupt(CPUState *cpu,
 #ifdef CONFIG_USER_ONLY
     assert(!cpu_test_interrupt(cpu, ~0));
 #else
-    if (unlikely(cpu_test_interrupt(cpu, ~0))) {
+    /*
+     * EXITTB only asks that no TB be chained to the one that ran, which
+     * arm_cpu_do_interrupt requests after every exception.  Handle it here
+     * without the BQL: the clear is atomic.
+     */
+    if (unlikely(cpu_test_interrupt(cpu, CPU_INTERRUPT_EXITTB)) &&
+        replay_mode == REPLAY_MODE_NONE) {
+        cpu_reset_interrupt(cpu, CPU_INTERRUPT_EXITTB);
+        *last_tb = NULL;
+    }
+    if (unlikely(cpu_test_interrupt(cpu, ~0)) &&
+        !cpu_interrupt_is_inert(cpu)) {
+        p35_inc(P35_BQL_INT_TAKE);
         bql_lock();
         if (cpu_test_interrupt(cpu, CPU_INTERRUPT_DEBUG)) {
             cpu_reset_interrupt(cpu, CPU_INTERRUPT_DEBUG);
@@ -876,6 +1009,8 @@ static inline bool cpu_handle_interrupt(CPUState *cpu,
                 }
                 cpu->exception_index = -1;
                 *last_tb = NULL;
+            } else {
+                p35_inc(P35_BQL_INT_NOOP);
             }
         }
         if (cpu_test_interrupt(cpu, CPU_INTERRUPT_EXITTB)) {
