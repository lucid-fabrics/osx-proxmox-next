+/*
+ * Pointer authentication in the vmapple compat mode, inline.
+ *
+ * With pauth_impdef_compat a signature is a three multiply mix of the
+ * extended pointer and the modifier, and authentication only strips the
+ * code, so both are a handful of TCG ops instead of a helper call. This
+ * is used only where it is exactly what the helpers do: EL0 and EL1 with
+ * no EL2 or EL3 (no trap checks, the regime is EL1&0), and FEAT_PAuth or
+ * FEAT_PAuth2 and later (not EPAC). The masks
+ * that depend on TCR_EL1 live in env->pac_cache and are refilled by
+ * helper_pauth_refill() whenever TCR_EL1 differs from the value they were
+ * computed for. Everything else calls the helpers.
+ */
+typedef void PauthOpFn(DisasContext *s, TCGv_i64 d, TCGv_ptr e,
+                       TCGv_i64 x, TCGv_i64 y);
+typedef void PauthXpacFn(DisasContext *s, TCGv_i64 d, TCGv_ptr e, TCGv_i64 x);
+
+#define PAC_K1 0x9E3779B97F4A7C15ULL
+#define PAC_K2 0xC2B2AE3D27D4EB4FULL
+#define PAC_K3 0x165667B19E3779F9ULL
+
+/*
+ * The cipher of the compat mode, as pauth_computepac_compat() computes it
+ * (pauth_helper.c): three multiplies, deterministic and spread over the
+ * pointer and the modifier, which is all that is needed as authentication
+ * never checks the code.  The inline and the helper code must agree.
+ */
+static void gen_pauth_hash(TCGv_i64 ret, TCGv_i64 a, TCGv_i64 b)
+{
+    TCGv_i64 h = tcg_temp_new_i64(), t = tcg_temp_new_i64();
+
+    tcg_gen_muli_i64(h, a, PAC_K1);
+    tcg_gen_muli_i64(t, b, PAC_K2);
+    tcg_gen_add_i64(h, h, t);
+    tcg_gen_shri_i64(t, h, 32);
+    tcg_gen_xor_i64(h, h, t);
+    tcg_gen_muli_i64(h, h, PAC_K3);
+    tcg_gen_shri_i64(t, h, 29);
+    tcg_gen_xor_i64(ret, h, t);
+}
+
+/* Refill the cache unless it is for the current TCR_EL1. */
+static void gen_pauth_cache_check(void)
+{
+    TCGLabel *ok = gen_new_label();
+    TCGv_i64 tcr = tcg_temp_new_i64(), key = tcg_temp_new_i64();
+
+    tcg_gen_ld_i64(tcr, tcg_env, offsetof(CPUARMState, cp15.tcr_el[1]));
+    tcg_gen_shli_i64(tcr, tcr, 1);
+    tcg_gen_ori_i64(tcr, tcr, 1);
+    tcg_gen_ld_i64(key, tcg_env, offsetof(CPUARMState, pac_cache.key));
+    tcg_gen_brcond_i64(TCG_COND_EQ, tcr, key, ok);
+    gen_helper_pauth_refill(tcg_env);
+    gen_set_label(ok);
+}
