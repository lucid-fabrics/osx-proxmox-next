+/* Load env->pac_cache.e[data][bit 55 of x].field */
+static void gen_pauth_ld(TCGv_i64 ret, TCGv_i64 x, bool data, int field_ofs)
+{
+    TCGv_i64 idx = tcg_temp_new_i64();
+    TCGv_ptr p = tcg_temp_new_ptr();
+    const int stride = sizeof(((CPUARMState *)0)->pac_cache.e[0][0]);
+
+    tcg_gen_extract_i64(idx, x, 55, 1);
+    tcg_gen_muli_i64(idx, idx, stride);
+    tcg_gen_trunc_i64_ptr(p, idx);
+    tcg_gen_add_ptr(p, p, tcg_env);
+    tcg_gen_ld_i64(ret, p, field_ofs + offsetof(CPUARMState, pac_cache.e[data][0]));
+}
