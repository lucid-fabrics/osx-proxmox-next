+/* p35 phase 0: ASID of a refill, TLBI decode for the shadow-tree model */
+static uint32_t p35_arm_asid(void *cs, int mmu_idx, uint64_t addr, bool global)
+{
+    CPUARMState *env = &ARM_CPU(cs)->env;
+    uint64_t tcr, ttbr;
+
+    if (!((ARMMMUIdxBit_E10_0 | ARMMMUIdxBit_E10_1 | ARMMMUIdxBit_E10_1_PAN |
+           ARMMMUIdxBit_E10_0_GCS | ARMMMUIdxBit_E10_1_GCS) &
+          (1u << mmu_idx))) {
+        return P35_ASID_OTHER;
+    }
+    if (global) {
+        return P35_ASID_GLOBAL;
+    }
+    tcr = env->cp15.tcr_el[1];
+    ttbr = (tcr & (1u << 22)) ? env->cp15.ttbr1_el[1] : env->cp15.ttbr0_el[1];
+    return (tcr & (1ull << 36)) ? extract64(ttbr, 48, 16)
+                                : extract64(ttbr, 48, 8);
+}
+
+void p35_arm_tlbi(CPUARMState *env, const char *name, uint64_t value)
+{
+    const char *p = name;
+    bool range, is, all_asids;
+    int asid_bits = (env->cp15.tcr_el[1] & (1ull << 36)) ? 16 : 8;
+    uint32_t asid = extract64(value, 48, asid_bits);
+    uint64_t base, npages, i;
+    size_t n = strlen(name);
+
+    if (strncmp(p, "TLBI_", 5) != 0) {
+        return;
+    }
+    p += 5;
+    is = n > 2 && (!strcmp(name + n - 2, "IS") || !strcmp(name + n - 2, "OS"));
+    range = *p == 'R';
+    if (range) {
+        p++;
+    }
+    if (!strncmp(p, "VMALLE1", 7) || !strncmp(p, "ALLE1", 5) ||
+        !strncmp(p, "VMALLS12E1", 10)) {
+        p35_inc(is ? P35_TLBI_IS : P35_TLBI_LOCAL);
+        p35_inc(P35_TLBI_ALL);
+        p35_tlbi_all();
+        return;
+    }
+    if (!strncmp(p, "ASIDE1", 6)) {
+        p35_inc(is ? P35_TLBI_IS : P35_TLBI_LOCAL);
+        p35_inc(P35_TLBI_ASID);
+        p35_tlbi_asid(extract64(value, 48, asid_bits));
+        return;
+    }
+    if (strncmp(p, "VA", 2) != 0 || !strstr(p, "E1")) {
+        return;
+    }
+    all_asids = p[2] == 'A';
+    p35_inc(is ? P35_TLBI_IS : P35_TLBI_LOCAL);
+    if (!range) {
+        p35_inc(all_asids ? P35_TLBI_VAA : P35_TLBI_VA);
+        p35_tlbi_va(asid, (uint64_t)sextract64(value << 12, 0, 56) >>
+                    TARGET_PAGE_BITS, all_asids);
+        return;
+    }
+    {
+        int tg = extract64(value, 46, 2);
+        int shift = tg == 1 ? 12 : tg == 2 ? 14 : 16;
+        int num = extract64(value, 39, 5);
+        int scale = extract64(value, 44, 2);
+        uint64_t len = (uint64_t)(num + 1) << (5 * scale + 1 + shift);
+
+        base = (uint64_t)sextract64(value, 0, 37) << shift;
+        npages = len >> TARGET_PAGE_BITS;
+    }
+    p35_inc(P35_TLBI_RANGE);
+    if (npages > 4096) {
+        p35_inc(P35_TLBI_BIGRANGE);
+    }
+    if (npages > 65536) {
+        p35_tlbi_all();
+        return;
+    }
+    p35_add(all_asids ? P35_TLBI_VAA : P35_TLBI_VA, npages);
+    for (i = 0; i < npages; i++) {
+        p35_tlbi_va(asid, (base >> TARGET_PAGE_BITS) + i, all_asids);
+    }
+}
+
+static void p35_arm_extra(int slot, uint64_t out[8])
+{
+    CPUState *cs;
+
+    CPU_FOREACH(cs) {
+        if (cs->cpu_index == slot) {
+            memcpy(out, ARM_CPU(cs)->env.p35_ls, 8 * sizeof(uint64_t));
+            return;
+        }
+    }
+}
+
+static void __attribute__((constructor)) p35_arm_init(void)
+{
+    p35_asid_hook = p35_arm_asid;
+    p35_extra_hook = p35_arm_extra;
+}
