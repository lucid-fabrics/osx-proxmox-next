diff --git a/tests/tcg/aarch64/system/dc-zva.c b/tests/tcg/aarch64/system/dc-zva.c
new file mode 100644
index 0000000000..42b1b8ce7b
--- /dev/null
+++ b/tests/tcg/aarch64/system/dc-zva.c
@@ -0,0 +1,210 @@
+/*
+ * DC ZVA zeroes exactly the aligned block its operand points into.
+ *
+ * Checks, for every operand offset in two blocks of a page filled with a
+ * pattern: the aligned block is zero and nothing else changed; an operand
+ * on an unmapped page and on a read-only page raise a data abort with the
+ * operand (not the aligned address) in FAR_EL1, WnR set, and change
+ * nothing; and zeroing a page of code that was already translated is seen
+ * by the next execution of it.
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define BASE_VA     0x80000000ull
+#define PTE_PAGE    0x3ull
+#define PTE_AF      (1ull << 10)
+#define PTE_SH_IS   (3ull << 8)
+#define PTE_AP_RO   (1ull << 7)
+#define RW_VA       (BASE_VA + 0x1000)
+#define RO_VA       (BASE_VA + 0x2000)
+#define BAD_VA      (BASE_VA + 0x3000)      /* never mapped */
+#define CODE_VA     (BASE_VA + 0x4000)
+
+#define read_sysreg(r) ({ uint64_t __v; asm volatile("mrs %0, " #r : "=r" (__v)); __v; })
+
+static uint64_t l2_table[512] __attribute__((aligned(4096)));
+static uint64_t l3_table[512] __attribute__((aligned(4096)));
+static uint8_t rw_page[4096] __attribute__((aligned(4096)));
+static uint8_t ro_page[4096] __attribute__((aligned(4096)));
+static uint32_t code_page[1024] __attribute__((aligned(4096)));
+
+volatile uint64_t exc[4];       /* count, esr, far, elr */
+
+/*
+ * Synchronous exceptions from EL1h: record them. A data abort (the DC ZVA
+ * under test) is skipped; an undefined instruction (zeroed code) returns to
+ * the caller through x30 with x0 = 0xdead.
+ */
+asm(".text\n"
+    ".balign 2048\n"
+    "zv_vectors:\n"
+    ".skip 0x200\n"
+    "    stp x0, x1, [sp, #-16]!\n"
+    "    adrp x0, exc\n"
+    "    add x0, x0, :lo12:exc\n"
+    "    ldr x1, [x0]\n"
+    "    add x1, x1, #1\n"
+    "    str x1, [x0]\n"
+    "    mrs x1, esr_el1\n"
+    "    str x1, [x0, #8]\n"
+    "    mrs x1, far_el1\n"
+    "    str x1, [x0, #16]\n"
+    "    mrs x1, elr_el1\n"
+    "    str x1, [x0, #24]\n"
+    "    mrs x1, esr_el1\n"
+    "    lsr x1, x1, #26\n"
+    "    cbz x1, 1f\n"
+    "    mrs x1, elr_el1\n"
+    "    add x1, x1, #4\n"
+    "    msr elr_el1, x1\n"
+    "    ldp x0, x1, [sp], #16\n"
+    "    eret\n"
+    "1:  msr elr_el1, x30\n"
+    "    add sp, sp, #16\n"
+    "    mov x0, #0xdead\n"
+    "    eret\n"
+    ".balign 0x800\n");
+extern char zv_vectors[];
+
+static int fails;
+#define CHECK(cond, ...) do {                                       \
+    if (!(cond)) {                                                  \
+        if (fails < 20) {                                           \
+            ml_printf("FAIL line %d: ", __LINE__);                  \
+            ml_printf(__VA_ARGS__);                                 \
+            ml_printf("\n");                                        \
+        }                                                           \
+        fails++;                                                    \
+    }                                                               \
+} while (0)
+
+static uint64_t pte_for(const void *page, uint64_t extra)
+{
+    return (uint64_t)page | PTE_PAGE | PTE_AF | PTE_SH_IS | extra;
+}
+
+static void tlbi_all(void)
+{
+    asm volatile("dsb ishst\n\ttlbi vmalle1\n\tdsb ish\n\tisb" ::: "memory");
+}
+
+static void zva(uint64_t va)
+{
+    asm volatile("dc zva, %0" :: "r" (va) : "memory");
+}
+
+static uint64_t call_code(void)
+{
+    register uint64_t x0 asm("x0") = 0;
+
+    asm volatile("blr %1" : "+r" (x0) : "r" (CODE_VA)
+                 : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9",
+                   "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17",
+                   "x30", "memory", "cc");
+    return x0;
+}
+
+int main(void)
+{
+    uint64_t *ttb = (uint64_t *)(read_sysreg(ttbr0_el1) & 0x0000fffffffff000ull);
+    uint64_t dczid = read_sysreg(dczid_el0);
+    unsigned blk = 4u << (dczid & 15);
+
+    ml_printf("DC ZVA test\n");
+    if (dczid & 16) {
+        ml_printf("SKIP: DC ZVA prohibited\n");
+        return 0;
+    }
+    ttb[(BASE_VA >> 30) & 0x1ff] = (uint64_t)l2_table | 3;
+    l2_table[0] = (uint64_t)l3_table | 3;
+    l3_table[(RW_VA >> 12) & 0x1ff] = pte_for(rw_page, 0);
+    l3_table[(RO_VA >> 12) & 0x1ff] = pte_for(ro_page, PTE_AP_RO);
+    l3_table[(CODE_VA >> 12) & 0x1ff] = pte_for(code_page, 0);
+    asm volatile("msr vbar_el1, %0\n\tisb" :: "r" (zv_vectors));
+    tlbi_all();
+
+    /* every operand offset in the first two blocks, and the last block */
+    for (unsigned base_blk = 0; base_blk < 3; base_blk++) {
+        unsigned first = base_blk == 2 ? 4096 - blk : base_blk * blk;
+
+        for (unsigned off = 0; off < blk; off++) {
+            unsigned lo = first & ~(blk - 1);
+
+            for (unsigned i = 0; i < 4096; i++) {
+                rw_page[i] = 0xa5;
+            }
+            zva(RW_VA + first + off);
+            for (unsigned i = 0; i < 4096; i++) {
+                uint8_t want = (i >= lo && i < lo + blk) ? 0 : 0xa5;
+
+                if (rw_page[i] != want) {
+                    CHECK(0, "operand +%u: byte %u is %x, want %x",
+                          first + off, i, rw_page[i], want);
+                    break;
+                }
+            }
+        }
+    }
+
+    /* faults report the operand */
+    for (unsigned off = 0; off < blk; off += 13) {
+        uint64_t va = BAD_VA + off + 3;
+
+        exc[0] = 0;
+        zva(va);
+        CHECK(exc[0] == 1, "unmapped: %lu exceptions", (unsigned long)exc[0]);
+        CHECK((exc[1] >> 26) == 0x25, "unmapped: EC %lx", (unsigned long)(exc[1] >> 26));
+        CHECK(exc[1] & (1 << 6), "unmapped: WnR not set (%lx)", (unsigned long)exc[1]);
+        CHECK(exc[2] == va, "unmapped: FAR %lx, want %lx", (unsigned long)exc[2],
+              (unsigned long)va);
+    }
+    for (unsigned i = 0; i < 4096; i++) {
+        ro_page[i] = 0x5a;
+    }
+    for (unsigned off = 0; off < blk; off += 11) {
+        uint64_t va = RO_VA + blk + off + 1;
+        int changed = 0;
+
+        exc[0] = 0;
+        zva(va);
+        CHECK(exc[0] == 1, "read-only: %lu exceptions", (unsigned long)exc[0]);
+        CHECK((exc[1] >> 26) == 0x25, "read-only: EC %lx", (unsigned long)(exc[1] >> 26));
+        CHECK(exc[1] & (1 << 6), "read-only: WnR not set (%lx)", (unsigned long)exc[1]);
+        CHECK((exc[1] & 0x3c) == 0xc, "read-only: not a permission fault (%lx)",
+              (unsigned long)exc[1]);
+        CHECK(exc[2] == va, "read-only: FAR %lx, want %lx", (unsigned long)exc[2],
+              (unsigned long)va);
+        for (unsigned i = 0; i < 4096; i++) {
+            changed |= ro_page[i] != 0x5a;
+        }
+        CHECK(!changed, "read-only page changed");
+    }
+
+    /* code that is zeroed must not run from an old translation */
+    for (int i = 0; i < 100; i++) {
+        uint64_t v;
+
+        code_page[0] = 0xd2800020u;         /* mov x0, #1 */
+        code_page[1] = 0xd65f03c0u;         /* ret */
+        asm volatile("dc cvau, %0\n\tdsb ish\n\tic ivau, %0\n\tdsb ish\n\tisb"
+                     :: "r" (code_page) : "memory");
+        v = call_code();
+        CHECK(v == 1, "code: first call returned %lx", (unsigned long)v);
+        v = call_code();
+        CHECK(v == 1, "code: second call returned %lx", (unsigned long)v);
+        zva(CODE_VA);
+        asm volatile("ic ivau, %0\n\tdsb ish\n\tisb" :: "r" (CODE_VA) : "memory");
+        exc[0] = 0;
+        v = call_code();
+        CHECK(v == 0xdead && exc[0] == 1,
+              "code: zeroed code returned %lx (%lu exceptions)",
+              (unsigned long)v, (unsigned long)exc[0]);
+    }
+    ml_printf(fails ? "FAILED\n" : "OK\n");
+    return fails != 0;
+}
diff --git a/tests/tcg/aarch64/system/eret-storm.c b/tests/tcg/aarch64/system/eret-storm.c
new file mode 100644
index 0000000000..f853abb28a
--- /dev/null
+++ b/tests/tcg/aarch64/system/eret-storm.c
@@ -0,0 +1,418 @@
+/*
+ * ERET storm from several vCPUs, with timer interrupts and the PMU.
+ *
+ * Every vCPU runs EL0 code that does nothing but SVC.  The EL1 handler
+ * counts the call and returns with ERET, so each round trip is one
+ * exception entry and one ERET, which run the EL change hooks (the GIC CPU
+ * interface and the PMU).  A virtual timer re-arms itself from its interrupt
+ * handler, so interrupts arrive in EL0 in between.  Three phases:
+ *   1. PMU idle.
+ *   2. The cycle counter counts at EL0 and EL1: it must advance.
+ *   3. The cycle counter counts nothing at EL0 and EL1 (PMCCFILTR P and U
+ *      set): it must not move.
+ *   4. The cycle counter counts EL0 only: it must advance.
+ * Each phase must see every SVC and timer interrupts.
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define PSCI_CPU_ON 0xc4000003ull
+#define NCPUS       4
+#define STORM       20000
+#define TIMER_PPI   27
+#define TIMER_TICKS 400
+
+#define BASE_VA     0x80000000ull
+#define PTE_PAGE    0x3ull
+#define PTE_AF      (1ull << 10)
+#define PTE_SH_IS   (3ull << 8)
+#define PTE_AP_EL0  (1ull << 6)
+
+#define GICD_BASE   0x08000000ull
+#define GICC_BASE   0x08010000ull
+#define GICD_CTLR   (GICD_BASE + 0x000)
+#define GICD_ISENABLER0 (GICD_BASE + 0x100)
+#define GICC_CTLR   (GICC_BASE + 0x00)
+#define GICC_PMR    (GICC_BASE + 0x04)
+#define GICC_IAR    (GICC_BASE + 0x0c)
+#define GICC_EOIR   (GICC_BASE + 0x10)
+
+#define PMCR_E      (1u << 0)
+#define PMCCFILTR_U (1u << 30)
+#define PMCCFILTR_P (1u << 31)
+
+#define SYSREG_R(name) ({ uint64_t v_; \
+    asm volatile("mrs %0, " #name : "=r" (v_)); v_; })
+#define SYSREG_W(name, val) \
+    asm volatile("msr " #name ", %0" :: "r" ((uint64_t)(val)))
+
+static uint64_t l2_table[512] __attribute__((aligned(4096)));
+static uint64_t l3_table[512] __attribute__((aligned(4096)));
+static uint32_t el0_code[1024] __attribute__((aligned(4096)));
+
+uint64_t mmu_cfg[8] __attribute__((aligned(64)));
+/* one cache line (8 words) per vCPU */
+uint64_t svc_count[NCPUS][8] __attribute__((aligned(64)));
+uint64_t svc_limit = STORM;
+uint64_t resume_pc[NCPUS][8] __attribute__((aligned(64)));
+static uint32_t irqs[NCPUS][16] __attribute__((aligned(64)));
+static uint32_t spurious[NCPUS][16] __attribute__((aligned(64)));
+static uint32_t storm_on[NCPUS][16] __attribute__((aligned(64)));
+static uint32_t fails[NCPUS][16] __attribute__((aligned(64)));
+static uint32_t started_cpus __attribute__((aligned(64)));
+static uint32_t finished __attribute__((aligned(64)));
+static uint32_t go __attribute__((aligned(64)));
+static const char *first_fail __attribute__((aligned(64)));
+static uint64_t first_fail_arg[2];
+
+static inline int cpu_id(void)
+{
+    return (int)(SYSREG_R(mpidr_el1) & 0xff) % NCPUS;
+}
+
+static inline void mmio_w32(uint64_t addr, uint32_t val)
+{
+    *(volatile uint32_t *)addr = val;
+}
+
+static inline uint32_t mmio_r32(uint64_t addr)
+{
+    return *(volatile uint32_t *)addr;
+}
+
+static void fail(int cpu, const char *what, uint64_t a, uint64_t b)
+{
+    if (__atomic_fetch_add(&fails[cpu][0], 1, __ATOMIC_RELAXED) == 0 &&
+        !__atomic_load_n(&first_fail, __ATOMIC_RELAXED)) {
+        first_fail_arg[0] = a;
+        first_fail_arg[1] = b;
+        __atomic_store_n(&first_fail, what, __ATOMIC_RELEASE);
+    }
+}
+
+__attribute__((used)) void irq_c(void)
+{
+    int cpu = cpu_id();
+    uint32_t iar = mmio_r32(GICC_IAR);
+    uint32_t id = iar & 0x3ff;
+
+    if (id == TIMER_PPI) {
+        if (!(SYSREG_R(cntv_ctl_el0) & 4)) {
+            fail(cpu, "timer irq without ISTATUS", 0, 0);
+        }
+        if (storm_on[cpu][0]) {
+            SYSREG_W(cntv_tval_el0, TIMER_TICKS);   /* re-arm */
+        } else {
+            SYSREG_W(cntv_ctl_el0, 0);
+        }
+        __atomic_fetch_add(&irqs[cpu][0], 1, __ATOMIC_RELAXED);
+    } else if (id < 1020) {
+        __atomic_fetch_add(&spurious[cpu][0], 1, __ATOMIC_RELAXED);
+    }
+    if (id < 1020) {
+        mmio_w32(GICC_EOIR, iar);
+    }
+}
+
+/*
+ * Vector table.  0x280 (IRQ, current EL, SPx) and 0x480 (IRQ, lower EL)
+ * save the caller-saved registers and call irq_c.  0x400 (SVC from a lower
+ * EL) counts the call and returns, or after svc_limit calls goes back to
+ * EL1 at resume_pc[cpu] with SP_EL1 unchanged.
+ */
+asm(".text\n"
+    ".balign 2048\n"
+    ".global es_vectors\n"
+    "es_vectors:\n"
+    ".rept 5\n"
+    "    b .\n"
+    "    .balign 128\n"
+    ".endr\n"
+    "    b es_irq\n"              /* 0x280 */
+    "    .balign 128\n"
+    ".rept 2\n"
+    "    b .\n"
+    "    .balign 128\n"
+    ".endr\n"
+    "    b es_svc\n"              /* 0x400 */
+    "    .balign 128\n"
+    "    b es_irq\n"              /* 0x480 */
+    "    .balign 128\n"
+    ".rept 6\n"
+    "    b .\n"
+    "    .balign 128\n"
+    ".endr\n"
+    "es_svc:\n"
+    "    mrs x9, mpidr_el1\n"
+    "    and x9, x9, #0xff\n"
+    "    and x9, x9, #3\n"
+    "    lsl x9, x9, #6\n"
+    "    adrp x10, svc_count\n"
+    "    add x10, x10, :lo12:svc_count\n"
+    "    add x10, x10, x9\n"
+    "    ldr x11, [x10]\n"
+    "    add x11, x11, #1\n"
+    "    str x11, [x10]\n"
+    "    adrp x12, svc_limit\n"
+    "    ldr x12, [x12, :lo12:svc_limit]\n"
+    "    cmp x11, x12\n"
+    "    b.lo 1f\n"
+    "    adrp x10, resume_pc\n"
+    "    add x10, x10, :lo12:resume_pc\n"
+    "    ldr x13, [x10, x9]\n"
+    "    msr elr_el1, x13\n"
+    "    mov x13, #0x3c5\n"       /* EL1h, DAIF masked */
+    "    msr spsr_el1, x13\n"
+    "1:  eret\n"
+    "es_irq:\n"
+    /* skip the red zone of the interrupted code */
+    "    sub sp, sp, #128\n"
+    "    sub sp, sp, #176\n"
+    "    stp x0, x1, [sp, #0]\n"
+    "    stp x2, x3, [sp, #16]\n"
+    "    stp x4, x5, [sp, #32]\n"
+    "    stp x6, x7, [sp, #48]\n"
+    "    stp x8, x9, [sp, #64]\n"
+    "    stp x10, x11, [sp, #80]\n"
+    "    stp x12, x13, [sp, #96]\n"
+    "    stp x14, x15, [sp, #112]\n"
+    "    stp x16, x17, [sp, #128]\n"
+    "    stp x18, x29, [sp, #144]\n"
+    "    str x30, [sp, #160]\n"
+    "    bl irq_c\n"
+    "    ldp x0, x1, [sp, #0]\n"
+    "    ldp x2, x3, [sp, #16]\n"
+    "    ldp x4, x5, [sp, #32]\n"
+    "    ldp x6, x7, [sp, #48]\n"
+    "    ldp x8, x9, [sp, #64]\n"
+    "    ldp x10, x11, [sp, #80]\n"
+    "    ldp x12, x13, [sp, #96]\n"
+    "    ldp x14, x15, [sp, #112]\n"
+    "    ldp x16, x17, [sp, #128]\n"
+    "    ldp x18, x29, [sp, #144]\n"
+    "    ldr x30, [sp, #160]\n"
+    "    add sp, sp, #176\n"
+    "    add sp, sp, #128\n"
+    "    eret\n");
+
+void es_vectors(void);
+
+/* Run the EL0 loop until svc_limit calls were made; return at EL1. */
+static void run_el0(int cpu)
+{
+    register uint64_t off asm("x0") = (uint64_t)cpu << 6;
+    register uint64_t pc asm("x1") = BASE_VA;
+
+    svc_count[cpu][0] = 0;
+    asm volatile("adr x9, 1f\n\t"
+                 "adrp x10, resume_pc\n\t"
+                 "add x10, x10, :lo12:resume_pc\n\t"
+                 "str x9, [x10, x0]\n\t"
+                 "msr elr_el1, x1\n\t"
+                 "msr spsr_el1, xzr\n\t"
+                 "msr sp_el0, xzr\n\t"
+                 "isb\n\t"
+                 "eret\n"
+                 "1:"
+                 : "+r" (off), "+r" (pc)
+                 :: "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9",
+                    "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17",
+                    "memory", "cc");
+}
+
+static uint64_t pmccntr(void)
+{
+    asm volatile("isb");
+    return SYSREG_R(pmccntr_el0);
+}
+
+static void phase(int cpu, int n, const char *name, uint32_t pmu_filter,
+                  int pmu_mode)
+{
+    uint32_t irq_before = __atomic_load_n(&irqs[cpu][0], __ATOMIC_RELAXED);
+    uint64_t c0, c1;
+
+    if (pmu_mode) {
+        SYSREG_W(pmccfiltr_el0, pmu_filter);
+        SYSREG_W(pmcr_el0, SYSREG_R(pmcr_el0) | PMCR_E);
+        SYSREG_W(pmcntenset_el0, 1u << 31);
+    } else {
+        SYSREG_W(pmcntenclr_el0, 1u << 31);
+    }
+    c0 = pmccntr();
+    storm_on[cpu][0] = 1;
+    SYSREG_W(cntv_tval_el0, TIMER_TICKS);
+    SYSREG_W(cntv_ctl_el0, 1);
+    run_el0(cpu);
+    SYSREG_W(cntv_ctl_el0, 0);
+    storm_on[cpu][0] = 0;
+    c1 = pmccntr();
+    SYSREG_W(pmcntenclr_el0, 1u << 31);
+
+    if (svc_count[cpu][0] != svc_limit) {
+        fail(cpu, "svc count", n, svc_count[cpu][0]);
+    }
+    if (__atomic_load_n(&irqs[cpu][0], __ATOMIC_RELAXED) == irq_before) {
+        fail(cpu, "no timer interrupt in phase", n, 0);
+    }
+    if (pmu_mode == 1 && c1 == c0) {
+        fail(cpu, "PMCCNTR did not advance", n, c1);
+    }
+    if (pmu_mode == 2 && c1 != c0) {
+        fail(cpu, "PMCCNTR moved while filtered out", n, c1 - c0);
+    }
+    (void)name;
+}
+
+static void worker(int cpu)
+{
+    asm volatile("msr daifset, #0xf\n\tisb" ::: "memory");
+    mmio_w32(GICD_ISENABLER0, 1u << TIMER_PPI);
+    mmio_w32(GICC_PMR, 0xff);
+    mmio_w32(GICC_CTLR, 1);
+    SYSREG_W(cntv_ctl_el0, 0);
+    __atomic_fetch_add(&started_cpus, 1, __ATOMIC_ACQ_REL);
+    while (!__atomic_load_n(&go, __ATOMIC_ACQUIRE)) {
+    }
+    phase(cpu, 1, "pmu idle", 0, 0);
+    phase(cpu, 2, "pmu counting all", 0, 1);
+    phase(cpu, 3, "pmu filtered out", PMCCFILTR_P | PMCCFILTR_U, 2);
+    phase(cpu, 4, "pmu counting EL0 only", PMCCFILTR_P, 1);
+    __atomic_fetch_add(&finished, 1, __ATOMIC_RELEASE);
+}
+
+__attribute__((used)) void sec_main(void)
+{
+    worker(cpu_id());
+    for (;;) {
+        asm volatile("wfe");
+    }
+}
+
+char sec_stacks[NCPUS * 4096] __attribute__((aligned(16)));
+asm(".text\n"
+    ".global sec_entry\n"
+    "sec_entry:\n"
+    "    adrp x0, mmu_cfg\n"
+    "    add x0, x0, :lo12:mmu_cfg\n"
+    "    ldp x1, x2, [x0]\n"
+    "    msr ttbr0_el1, x1\n"
+    "    msr tcr_el1, x2\n"
+    "    ldp x1, x2, [x0, #16]\n"
+    "    msr mair_el1, x1\n"
+    "    ldr x3, [x0, #32]\n"
+    "    msr vbar_el1, x3\n"
+    "    isb\n"
+    "    msr sctlr_el1, x2\n"
+    "    isb\n"
+    "    mrs x1, mpidr_el1\n"
+    "    and x1, x1, #0xff\n"
+    "    add x1, x1, #1\n"
+    "    lsl x1, x1, #12\n"
+    "    adrp x2, sec_stacks\n"
+    "    add x2, x2, :lo12:sec_stacks\n"
+    "    add x2, x2, x1\n"
+    "    mov sp, x2\n"
+    "    mrs x1, cpacr_el1\n"
+    "    orr x1, x1, #(3 << 20)\n"
+    "    msr cpacr_el1, x1\n"
+    "    bl sec_main\n"
+    "1:  wfe\n"
+    "    b 1b\n");
+void sec_entry(void);
+
+static int64_t psci_cpu_on(uint64_t target, uint64_t entry)
+{
+    register uint64_t x0 asm("x0") = PSCI_CPU_ON;
+    register uint64_t x1 asm("x1") = target;
+    register uint64_t x2 asm("x2") = entry;
+    register uint64_t x3 asm("x3") = 0;
+
+    asm volatile("hvc #0" : "+r" (x0) : "r" (x1), "r" (x2), "r" (x3)
+                 : "memory");
+    return (int64_t)x0;
+}
+
+/* EL0 code: "svc #0; b .-4", in a page that EL0 may execute */
+static void setup_el0_page(uint64_t *ttb)
+{
+    el0_code[0] = 0xd4000001u;      /* svc #0 */
+    el0_code[1] = 0x17ffffffu;      /* b .-4 */
+    asm volatile("dc cvau, %0\n\tdsb ish\n\tic ivau, %0\n\tdsb ish\n\tisb"
+                 :: "r" (el0_code) : "memory");
+    l3_table[(BASE_VA >> 12) & 0x1ff] =
+        (uint64_t)el0_code | PTE_PAGE | PTE_AF | PTE_SH_IS | PTE_AP_EL0;
+    l2_table[0] = (uint64_t)l3_table | 3;
+    ttb[(BASE_VA >> 30) & 0x1ff] = (uint64_t)l2_table | 3;
+}
+
+static void save_mmu_cfg(void)
+{
+    mmu_cfg[0] = SYSREG_R(ttbr0_el1);
+    mmu_cfg[1] = SYSREG_R(tcr_el1);
+    mmu_cfg[2] = SYSREG_R(mair_el1);
+    mmu_cfg[3] = SYSREG_R(sctlr_el1);
+    mmu_cfg[4] = (uint64_t)es_vectors;
+    asm volatile("dsb ish" ::: "memory");
+}
+
+int main(void)
+{
+    uint64_t *ttb = (uint64_t *)(SYSREG_R(ttbr0_el1) & 0x0000fffffffff000ull);
+    uint32_t nsec = 0;
+    uint32_t bad = 0;
+
+    ml_printf("ERET storm with timer interrupts and the PMU\n");
+    /* the first GiB holds the GIC: map it as device memory (Attr1) */
+    ttb[0] = (3ull << 53) | 0x401 | (1 << 2);
+    setup_el0_page(ttb);
+    asm volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" ::: "memory");
+    save_mmu_cfg();
+    SYSREG_W(vbar_el1, es_vectors);
+    asm volatile("isb");
+    mmio_w32(GICD_CTLR, 1);
+
+    for (unsigned cpu = 1; cpu < NCPUS; cpu++) {
+        if (psci_cpu_on(cpu, (uint64_t)sec_entry) == 0) {
+            nsec++;
+        }
+    }
+    for (unsigned spin = 0;
+         __atomic_load_n(&started_cpus, __ATOMIC_ACQUIRE) < nsec &&
+         spin < 2000000000u; spin++) {
+    }
+    if (__atomic_load_n(&started_cpus, __ATOMIC_ACQUIRE) != nsec) {
+        ml_printf("FAIL: secondaries did not start\n");
+        return 1;
+    }
+    ml_printf("%d vCPUs\n", nsec + 1);
+    __atomic_store_n(&go, 1, __ATOMIC_RELEASE);
+    worker(0);
+    for (unsigned spin = 0;
+         __atomic_load_n(&finished, __ATOMIC_ACQUIRE) < nsec + 1 &&
+         spin < 2000000000u; spin++) {
+    }
+    if (__atomic_load_n(&finished, __ATOMIC_ACQUIRE) != nsec + 1) {
+        ml_printf("FAIL: not all vCPUs finished\n");
+        return 1;
+    }
+    for (int cpu = 0; cpu <= (int)nsec; cpu++) {
+        if (fails[cpu][0] || spurious[cpu][0]) {
+            ml_printf("FAIL: cpu %d fails %d spurious %d\n", cpu,
+                      (int)fails[cpu][0], (int)spurious[cpu][0]);
+            bad = 1;
+        }
+    }
+    if (bad) {
+        ml_printf("first: %s (%lx, %lx)\n",
+                  first_fail ? first_fail : "?",
+                  first_fail_arg[0], first_fail_arg[1]);
+        return 1;
+    }
+    ml_printf("OK\n");
+    return 0;
+}
diff --git a/tests/tcg/aarch64/system/ldst-sync.c b/tests/tcg/aarch64/system/ldst-sync.c
new file mode 100644
index 0000000000..595edc9824
--- /dev/null
+++ b/tests/tcg/aarch64/system/ldst-sync.c
@@ -0,0 +1,288 @@
+/*
+ * Guest state is exact when a load or store faults in the middle of a block.
+ *
+ * Every general register is written (some with constants, some with computed
+ * values, some updated in place), NZCV is set, and then a load, a store, a
+ * load pair or a load that follows a TLB flush faults. The data abort
+ * handler snapshots x0..x30, SPSR, ELR and ESR and the test compares them
+ * with what the instruction stream wrote: the destination of the faulting
+ * access must be unchanged, ELR must point at the access. The case with the
+ * TLB flush also takes the slow path of a load that succeeds, with 30 live
+ * values around it, and checks the loaded value.
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define ROUNDS 300
+
+volatile uint64_t ls_snap[34];  /* x0..x30, spsr, elr, esr, count */
+#define SNAP_SPSR  31
+#define SNAP_ELR   32
+#define SNAP_ESR   33
+
+asm(".text\n"
+    ".balign 2048\n"
+    "ls_vectors:\n"
+    ".rept 4\n"
+    ".balign 128\n"
+    "    b ls_unexpected\n"
+    ".endr\n"
+    ".balign 128\n"
+    "    b ls_sync\n"
+    ".rept 11\n"
+    ".balign 128\n"
+    "    b ls_unexpected\n"
+    ".endr\n"
+    "ls_unexpected:\n"
+    "1:  wfe\n"
+    "    b 1b\n"
+    "ls_sync:\n"
+    "    str x0, [sp, #-16]!\n"
+    "    adrp x0, ls_snap\n"
+    "    add x0, x0, :lo12:ls_snap\n"
+    "    stp x1, x2, [x0, #8]\n"
+    "    stp x3, x4, [x0, #24]\n"
+    "    stp x5, x6, [x0, #40]\n"
+    "    stp x7, x8, [x0, #56]\n"
+    "    stp x9, x10, [x0, #72]\n"
+    "    stp x11, x12, [x0, #88]\n"
+    "    stp x13, x14, [x0, #104]\n"
+    "    stp x15, x16, [x0, #120]\n"
+    "    stp x17, x18, [x0, #136]\n"
+    "    stp x19, x20, [x0, #152]\n"
+    "    stp x21, x22, [x0, #168]\n"
+    "    stp x23, x24, [x0, #184]\n"
+    "    stp x25, x26, [x0, #200]\n"
+    "    stp x27, x28, [x0, #216]\n"
+    "    stp x29, x30, [x0, #232]\n"
+    "    ldr x1, [sp], #16\n"
+    "    str x1, [x0]\n"
+    "    mrs x1, spsr_el1\n"
+    "    str x1, [x0, #248]\n"
+    "    mrs x1, elr_el1\n"
+    "    str x1, [x0, #256]\n"
+    "    add x1, x1, #4\n"
+    "    msr elr_el1, x1\n"
+    "    mrs x1, esr_el1\n"
+    "    str x1, [x0, #264]\n"
+    "    ldr x1, [x0, #8]\n"
+    "    ldr x2, [x0, #16]\n"
+    "    ldr x0, [x0]\n"
+    "    eret\n");
+
+/*
+ * x0 = input block {seed, ...}. Leaves x2..x8 constants, x3 and x4 updated
+ * in place, x5 a copy of the seed, x9 and x11..x30 seed + n, x10 an unmapped
+ * address, x0 = 0x1234, x1 = seed, then NZCV = N (cmp seed, seed + 9).
+ */
+#define PROLOGUE                                                    \
+    "    stp x29, x30, [sp, #-112]!\n"                              \
+    "    stp x19, x20, [sp, #16]\n"                                 \
+    "    stp x21, x22, [sp, #32]\n"                                 \
+    "    stp x23, x24, [sp, #48]\n"                                 \
+    "    stp x25, x26, [sp, #64]\n"                                 \
+    "    stp x27, x28, [sp, #80]\n"                                 \
+    "    mov x15, #0x77\n"                                          \
+    "    str x15, [sp, #104]\n"                                     \
+    "    ldr x1, [x0]\n"                                            \
+    "    mov x0, #0x1234\n"                                         \
+    "    mov x2, #0x1002\n"                                         \
+    "    mov x3, #0x1003\n"                                         \
+    "    mov x4, #0x1004\n"                                         \
+    "    mov x6, #0x1006\n"                                         \
+    "    mov x7, #0x1007\n"                                         \
+    "    mov x8, #0x1008\n"                                         \
+    "    add x9, x1, #9\n"                                          \
+    "    movz x10, #0xdead, lsl #32\n"                              \
+    "    add x11, x1, #11\n"                                        \
+    "    add x12, x1, #12\n"                                        \
+    "    add x13, x1, #13\n"                                        \
+    "    add x14, x1, #14\n"                                        \
+    "    add x15, x1, #15\n"                                        \
+    "    add x16, x1, #16\n"                                        \
+    "    add x17, x1, #17\n"                                        \
+    "    add x18, x1, #18\n"                                        \
+    "    add x19, x1, #19\n"                                        \
+    "    add x20, x1, #20\n"                                        \
+    "    add x21, x1, #21\n"                                        \
+    "    add x22, x1, #22\n"                                        \
+    "    add x23, x1, #23\n"                                        \
+    "    add x24, x1, #24\n"                                        \
+    "    add x25, x1, #25\n"                                        \
+    "    add x26, x1, #26\n"                                        \
+    "    add x27, x1, #27\n"                                        \
+    "    add x28, x1, #28\n"                                        \
+    "    add x29, x1, #29\n"                                        \
+    "    add x30, x1, #30\n"                                        \
+    "    mov x5, x1\n"                                              \
+    "    add x3, x3, #5\n"                                          \
+    "    eor x4, x4, x1\n"                                          \
+    "    cmp x1, x9\n"
+
+#define EPILOGUE                                                    \
+    "    ldp x19, x20, [sp, #16]\n"                                 \
+    "    ldp x21, x22, [sp, #32]\n"                                 \
+    "    ldp x23, x24, [sp, #48]\n"                                 \
+    "    ldp x25, x26, [sp, #64]\n"                                 \
+    "    ldp x27, x28, [sp, #80]\n"                                 \
+    "    ldp x29, x30, [sp], #112\n"                                \
+    "    ret\n"
+
+/*
+ * Redefine every register after the faulting access (the handler returns
+ * to the next instruction), so that the earlier definitions are not the last
+ * ones of the block and nothing forces them to be stored at their definition.
+ */
+#define POST                                                        \
+    "    mov x0, #0x3000\n"          \
+    "    mov x1, #0x3001\n"          \
+    "    mov x2, #0x3002\n"          \
+    "    mov x3, #0x3003\n"          \
+    "    mov x4, #0x3004\n"          \
+    "    mov x5, #0x3005\n"          \
+    "    mov x6, #0x3006\n"          \
+    "    mov x7, #0x3007\n"          \
+    "    mov x8, #0x3008\n"          \
+    "    mov x9, #0x3009\n"          \
+    "    mov x10, #0x300a\n"          \
+    "    mov x11, #0x300b\n"          \
+    "    mov x12, #0x300c\n"          \
+    "    mov x13, #0x300d\n"          \
+    "    mov x14, #0x300e\n"          \
+    "    mov x15, #0x300f\n"          \
+    "    mov x16, #0x3010\n"          \
+    "    mov x17, #0x3011\n"          \
+    "    mov x18, #0x3012\n"          \
+    "    mov x19, #0x3013\n"          \
+    "    mov x20, #0x3014\n"          \
+    "    mov x21, #0x3015\n"          \
+    "    mov x22, #0x3016\n"          \
+    "    mov x23, #0x3017\n"          \
+    "    mov x24, #0x3018\n"          \
+    "    mov x25, #0x3019\n"          \
+    "    mov x26, #0x301a\n"          \
+    "    mov x27, #0x301b\n"          \
+    "    mov x28, #0x301c\n"
+
+#define CASE(name, pre, insn)                                       \
+    ".globl " name "\n"                                             \
+    ".balign 16\n"                                                  \
+    name ":\n"                                                      \
+    PROLOGUE pre                                                    \
+    ".globl " name "_fault\n"                                       \
+    name "_fault:\n"                                                \
+    insn "\n"                                                       \
+    POST EPILOGUE
+
+asm(CASE("ls_case_ld", "", "    ldr x11, [x10]")
+    CASE("ls_case_st", "", "    str x12, [x10]")
+    CASE("ls_case_ldp", "", "    ldp x13, x14, [x10]")
+    CASE("ls_case_ldb", "", "    ldrb w16, [x10]")
+    CASE("ls_case_tlbi",
+         "    adrp x10, ls_pages\n    add x10, x10, :lo12:ls_pages\n"
+         "    ldr x15, [x10]\n    ldr x16, [x10, #4096]\n"
+         "    str x18, [x10, #8192]\n    ldr x17, [x10, #12288]\n"
+         "    ldr x19, [x10, #16384]\n    add x20, x20, #3\n"
+         "    ldr x21, [x10, #20480]\n    movz x10, #0xdead, lsl #32\n",
+         "    ldrb w16, [x10]"));
+
+extern void ls_case_ld(uint64_t *in), ls_case_st(uint64_t *in);
+extern void ls_case_ldp(uint64_t *in), ls_case_ldb(uint64_t *in);
+extern void ls_case_tlbi(uint64_t *in);
+extern char ls_case_ld_fault[], ls_case_st_fault[], ls_case_ldp_fault[];
+extern char ls_case_ldb_fault[], ls_case_tlbi_fault[];
+extern char ls_vectors[];
+
+static int fails;
+#define CHECK(cond, ...) do {                                       \
+    if (!(cond)) {                                                  \
+        if (fails < 20) {                                           \
+            ml_printf("FAIL line %d: ", __LINE__);                  \
+            ml_printf(__VA_ARGS__);                                 \
+            ml_printf("\n");                                        \
+        }                                                           \
+        fails++;                                                    \
+    }                                                               \
+} while (0)
+
+static uint64_t in_block[8] __attribute__((aligned(4096)));
+/* Six pages, each touched by the tlbi case after a TLB flush. */
+uint64_t ls_pages[6 * 512] __attribute__((aligned(4096)));
+
+static void run_case(const char *name, void (*fn)(uint64_t *), char *fault,
+                     uint64_t seed, int tlbi)
+{
+    uint64_t exp[31];
+    uint64_t snap[34];
+
+    for (int n = 0; n < 31; n++) {
+        exp[n] = seed + n;
+    }
+    exp[0] = 0x1234;
+    exp[1] = seed;
+    exp[2] = 0x1002;
+    exp[3] = 0x1003 + 5;
+    exp[4] = 0x1004 ^ seed;
+    exp[5] = seed;
+    exp[6] = 0x1006;
+    exp[7] = 0x1007;
+    exp[8] = 0x1008;
+    exp[10] = 0xdeadull << 32;
+    if (tlbi) {
+        exp[15] = 0xa000;
+        exp[16] = 0xa001;
+        exp[17] = 0xa003;
+        exp[19] = 0xa004;
+        exp[20] = seed + 20 + 3;
+        exp[21] = 0xa005;
+        for (int k = 0; k < 6; k++) {
+            ls_pages[k * 512] = 0xa000 + k;
+        }
+        asm volatile("tlbi vmalle1\n dsb nsh\n isb" ::: "memory");
+    }
+
+    in_block[0] = seed;
+    ls_snap[33] = 0;
+    asm volatile("dsb sy" ::: "memory");
+    fn(in_block);
+    for (int i = 0; i < 34; i++) {
+        snap[i] = ls_snap[i];
+    }
+    if (tlbi) {
+        CHECK(ls_pages[2 * 512] == seed + 18, "tlbi: store lost (%lx)",
+              (unsigned long)ls_pages[2 * 512]);
+    }
+    for (int n = 0; n < 31; n++) {
+        CHECK(snap[n] == exp[n], "%s seed %lx: x%d = %lx, want %lx", name,
+              (unsigned long)seed, n, (unsigned long)snap[n],
+              (unsigned long)exp[n]);
+    }
+    CHECK((snap[SNAP_SPSR] >> 28) == 0x8, "%s: NZCV %lx, want N only", name,
+          (unsigned long)(snap[SNAP_SPSR] >> 28));
+    CHECK(snap[SNAP_ELR] == (uint64_t)fault, "%s: ELR %lx, want %lx", name,
+          (unsigned long)snap[SNAP_ELR], (unsigned long)fault);
+    CHECK((snap[SNAP_ESR] >> 26) == 0x25, "%s: EC %lx, want data abort",
+          name, (unsigned long)(snap[SNAP_ESR] >> 26));
+}
+
+int main(void)
+{
+    ml_printf("Guest state at a fault inside a block\n");
+    asm volatile("msr vbar_el1, %0\n isb" :: "r" (ls_vectors));
+
+    for (unsigned i = 0; i < ROUNDS; i++) {
+        uint64_t seed = 0x10000000ull + i * 0x1111111ull;
+
+        run_case("ld", ls_case_ld, ls_case_ld_fault, seed, 0);
+        run_case("st", ls_case_st, ls_case_st_fault, seed, 0);
+        run_case("ldp", ls_case_ldp, ls_case_ldp_fault, seed, 0);
+        run_case("ldb", ls_case_ldb, ls_case_ldb_fault, seed, 0);
+        run_case("tlbi", ls_case_tlbi, ls_case_tlbi_fault, seed, 1);
+    }
+    ml_printf(fails ? "FAILED\n" : "OK\n");
+    return fails != 0;
+}
diff --git a/tests/tcg/aarch64/system/lpage-xcpu.c b/tests/tcg/aarch64/system/lpage-xcpu.c
index 79fb0ffbdf..3ed60038dc 100644
--- a/tests/tcg/aarch64/system/lpage-xcpu.c
+++ b/tests/tcg/aarch64/system/lpage-xcpu.c
@@ -125,8 +125,17 @@ static void put_code(uint64_t addr, unsigned n)
 {
     uint32_t *c = (uint32_t *)addr;
 
-    c[0] = 0xd2800000u | (n << 5);      /* mov x0, #n */
-    c[1] = 0xd65f03c0u;                 /* ret */
+    /*
+     * mov x0, #n; mov x9, x30; bl 1f; mov x0, #n; br x9; 1: ret
+     * The BL pushes the second "mov x0, #n" on the return address stack, so
+     * a flush that leaves the stack alone returns to the old code.
+     */
+    c[0] = 0xd2800000u | (n << 5);
+    c[1] = 0xaa1e03e9u;
+    c[2] = 0x94000003u;
+    c[3] = 0xd2800000u | (n << 5);
+    c[4] = 0xd61f0120u;
+    c[5] = 0xd65f03c0u;
     asm volatile("dc cvau, %0\n\tdsb ish\n\tic ivau, %0\n\tdsb ish\n\tisb"
                  :: "r" (c) : "memory");
 }
diff --git a/tests/tcg/aarch64/system/pauth-inline.c b/tests/tcg/aarch64/system/pauth-inline.c
new file mode 100644
index 0000000000..1aaf330ad1
--- /dev/null
+++ b/tests/tcg/aarch64/system/pauth-inline.c
@@ -0,0 +1,249 @@
+/*
+ * Pointer authentication in the vmapple compat mode (-cpu max,
+ * x-pauth-impdef-compat=on, optionally x-pauth-original=on).
+ *
+ * In that mode a signature is a three multiply mix of the extended pointer
+ * and the modifier (the helpers and the inline code compute the same), and
+ * authentication only strips the code. The
+ * test executes PAC{I,D}{A,B}, AUT{I,D}{A,B} and XPAC{I,D} on random
+ * pointers and modifiers (canonical, tagged, with bad extension bits, from
+ * both halves of the address space) under every combination of TCR_EL1
+ * TBI0, TBI1, TBID0 and TBID1 and several T1SZ values, and compares each
+ * result with a plain C model of the architecture pseudocode that is
+ * written here, independent of QEMU's helpers. Run with the translated
+ * inline form (default) and with x-pauth-inline=off (the helpers) it
+ * catches a difference between the two as well as a wrong model.
+ * Also checks that a disabled key leaves the pointer alone and that a TCR
+ * change takes effect on the next instruction.
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define M64(start, len) ((len) >= 64 ? ~0ull << (start) : \
+                         (((1ull << (len)) - 1) << (start)))
+#define K1 0x9E3779B97F4A7C15ull
+#define K2 0xC2B2AE3D27D4EB4Full
+#define K3 0x165667B19E3779F9ull
+#define SCTLR_EnIA (1ull << 31)
+#define SCTLR_EnIB (1ull << 30)
+#define SCTLR_EnDA (1ull << 27)
+#define SCTLR_EnDB (1ull << 13)
+#define KEYS (SCTLR_EnIA | SCTLR_EnIB | SCTLR_EnDA | SCTLR_EnDB)
+
+#define read_sysreg(r) ({ uint64_t __v; asm volatile("mrs %0, " #r : "=r" (__v)); __v; })
+#define write_sysreg(r, v) do { uint64_t __v = (v); \
+    asm volatile("msr " #r ", %0" :: "r" (__v)); } while (0)
+
+/* the cipher of the compat mode: three multiplies, key independent */
+static uint64_t cipher(uint64_t a, uint64_t b)
+{
+    uint64_t h = a * K1 + b * K2;
+
+    h ^= h >> 32;
+    h *= K3;
+    return h ^ (h >> 29);
+}
+static int feat1;       /* FEAT_PAuth only: bad extension flips a PAC bit */
+static uint64_t tcr;
+
+static void params(uint64_t ptr, int data, int *bot, int *top, int *tbi)
+{
+    int sel = (ptr >> 55) & 1;
+    int tsz = sel ? (tcr >> 16) & 63 : tcr & 63;
+    int b = sel ? (tcr >> 38) & 1 : (tcr >> 37) & 1;
+    int id = sel ? (tcr >> 52) & 1 : (tcr >> 51) & 1;
+
+    if (!data) {
+        b &= !id;
+    }
+    *tbi = b;
+    *bot = 64 - tsz;
+    *top = 64 - 8 * b;
+}
+
+static uint64_t model_sign(uint64_t ptr, uint64_t mod, int data)
+{
+    int bot, top, tbi;
+    uint64_t ext, ext_ptr, pac, fld, test;
+
+    params(ptr, data, &bot, &top, &tbi);
+    ext = (ptr >> (tbi ? 55 : 63)) & 1 ? ~0ull : 0;
+    fld = M64(bot, top - bot);
+    ext_ptr = (ptr & ~fld) | (ext & fld);
+    pac = cipher(ext_ptr, mod);
+    test = ptr & fld;
+    if (feat1) {
+        if (test != 0 && test != fld) {
+            pac ^= 1ull << (top - 2);
+        }
+    } else {
+        pac ^= ptr;
+    }
+    if (tbi) {
+        ptr &= ~M64(bot, 55 - bot + 1);
+        pac &= M64(bot, 54 - bot + 1);
+    } else {
+        ptr &= M64(0, bot);
+        pac &= ~((1ull << 55) | M64(0, bot));
+    }
+    return pac | (ext & (1ull << 55)) | ptr;
+}
+
+static uint64_t model_strip(uint64_t ptr, int data)
+{
+    int bot, top, tbi;
+    uint64_t mask;
+
+    params(ptr, data, &bot, &top, &tbi);
+    mask = M64(bot, top - bot);
+    return (ptr >> 55) & 1 ? ptr | mask : ptr & ~mask;
+}
+
+#define OP2(name, insn) \
+    static uint64_t name(uint64_t p, uint64_t m) \
+    { asm volatile(insn " %0, %1" : "+r" (p) : "r" (m)); return p; }
+OP2(pacia, "pacia") OP2(pacib, "pacib") OP2(pacda, "pacda") OP2(pacdb, "pacdb")
+OP2(autia, "autia") OP2(autib, "autib") OP2(autda, "autda") OP2(autdb, "autdb")
+static uint64_t xpaci(uint64_t p) { asm volatile("xpaci %0" : "+r" (p)); return p; }
+static uint64_t xpacd(uint64_t p) { asm volatile("xpacd %0" : "+r" (p)); return p; }
+
+static uint64_t seed = 0x9e3779b97f4a7c15ull;
+static uint64_t next(void)
+{
+    seed ^= seed >> 12; seed ^= seed << 25; seed ^= seed >> 27;
+    return seed * 0x2545F4914F6CDD1Dull;
+}
+
+static int fails, checks;
+#define CHECK(got, want, what) do {                                         \
+    checks++;                                                               \
+    if ((got) != (want)) {                                                  \
+        if (fails < 20) {                                                   \
+            ml_printf("FAIL %s: ptr %lx mod %lx tcr %lx got %lx want %lx\n", \
+                      what, (unsigned long)ptr, (unsigned long)mod,         \
+                      (unsigned long)tcr, (unsigned long)(got),             \
+                      (unsigned long)(want));                               \
+        }                                                                   \
+        fails++;                                                            \
+    }                                                                       \
+} while (0)
+
+static uint64_t make_ptr(unsigned kind)
+{
+    uint64_t p = next();
+
+    switch (kind % 6) {
+    case 0: return p;                                      /* anything */
+    case 1: return (uint64_t)((int64_t)(p << 16) >> 16);   /* canonical */
+    case 2: return ((uint64_t)((int64_t)(p << 16) >> 16) & ~(0xffull << 56))
+                   | ((p >> 48) & 0xff) << 56;             /* tagged */
+    case 3: return p & ~(1ull << 55);                      /* lower half */
+    case 4: return p | (1ull << 55);                       /* upper half */
+    default: return (p & 0x00ffffffffffffffull) | (p & 0xff00000000000000ull);
+    }
+}
+
+static void set_tcr(uint64_t v)
+{
+    tcr = v;
+    write_sysreg(tcr_el1, v);
+    asm volatile("isb");
+}
+
+static void run_cfg(uint64_t base, unsigned bits, unsigned t1sz, unsigned n)
+{
+    uint64_t v = (base & ~((1ull << 37) | (1ull << 38) | (1ull << 51) |
+                           (1ull << 52) | (0x3full << 16)))
+        | ((bits & 1ull) << 37) | (((bits >> 1) & 1ull) << 38)
+        | (((bits >> 2) & 1ull) << 51) | (((bits >> 3) & 1ull) << 52)
+        | ((uint64_t)t1sz << 16);
+
+    set_tcr(v);
+    for (unsigned i = 0; i < n; i++) {
+        uint64_t ptr = make_ptr(i), mod = next();
+        uint64_t s;
+
+        s = model_sign(ptr, mod, 0);
+        CHECK(pacia(ptr, mod), s, "pacia");
+        CHECK(pacib(ptr, mod), s, "pacib");
+        s = model_sign(ptr, mod, 1);
+        CHECK(pacda(ptr, mod), s, "pacda");
+        CHECK(pacdb(ptr, mod), s, "pacdb");
+        s = model_strip(ptr, 0);
+        CHECK(autia(ptr, mod), s, "autia");
+        CHECK(autib(ptr, mod), s, "autib");
+        CHECK(xpaci(ptr), s, "xpaci");
+        s = model_strip(ptr, 1);
+        CHECK(autda(ptr, mod), s, "autda");
+        CHECK(autdb(ptr, mod), s, "autdb");
+        CHECK(xpacd(ptr), s, "xpacd");
+        /* a signed pointer authenticates to its own stripped form */
+        s = pacib(ptr, mod);
+        CHECK(autib(s, mod), model_strip(s, 0), "pac+aut");
+    }
+}
+
+static void run_keys(void)
+{
+    static const uint64_t k[4] = {
+        SCTLR_EnIA, SCTLR_EnIB, SCTLR_EnDA, SCTLR_EnDB
+    };
+    uint64_t sctlr = read_sysreg(sctlr_el1);
+
+    for (int i = 0; i < 4; i++) {
+        /* only key i off: its PAC and AUT forms do nothing */
+        write_sysreg(sctlr_el1, (sctlr | KEYS) & ~k[i]);
+        asm volatile("isb");
+        for (unsigned j = 0; j < 50; j++) {
+            uint64_t ptr = make_ptr(j), mod = next();
+            uint64_t a, b;
+
+            switch (i) {
+            case 0: a = pacia(ptr, mod); b = autia(ptr, mod); break;
+            case 1: a = pacib(ptr, mod); b = autib(ptr, mod); break;
+            case 2: a = pacda(ptr, mod); b = autda(ptr, mod); break;
+            default: a = pacdb(ptr, mod); b = autdb(ptr, mod); break;
+            }
+            CHECK(a, ptr, "pac with the key off");
+            CHECK(b, ptr, "aut with the key off");
+            /* and another key still works */
+            CHECK(i == 1 ? pacia(ptr, mod) : pacib(ptr, mod),
+                  model_sign(ptr, mod, 0), "other key");
+        }
+    }
+    write_sysreg(sctlr_el1, sctlr | KEYS);
+    asm volatile("isb");
+}
+
+int main(void)
+{
+    uint64_t isar1 = read_sysreg(id_aa64isar1_el1);
+    uint64_t base = read_sysreg(tcr_el1);
+    unsigned apa = (isar1 >> 4) & 15, api = (isar1 >> 8) & 15;
+    unsigned lvl = apa | api;
+    static const unsigned t1szs[] = { 16, 21, 25, 30 };
+
+    ml_printf("PAC compat test\n");
+    if (lvl == 2) {
+        /* EPAC zeroes the PAC for a bad extension: not modelled here */
+        ml_printf("SKIP\n");
+        return 0;
+    }
+    feat1 = lvl == 1;
+    write_sysreg(sctlr_el1, read_sysreg(sctlr_el1) | KEYS);
+    asm volatile("isb");
+    for (unsigned bits = 0; bits < 16; bits++) {
+        for (unsigned t = 0; t < 4; t++) {
+            run_cfg(base, bits, t1szs[t], 60);
+        }
+    }
+    run_keys();
+    set_tcr(base);
+    ml_printf("%d checks, %d failed\n", checks, fails);
+    ml_printf(fails ? "FAILED\n" : "OK\n");
+    return fails != 0;
+}
diff --git a/tests/tcg/aarch64/system/ret-stack.c b/tests/tcg/aarch64/system/ret-stack.c
new file mode 100644
index 0000000000..d43f349795
--- /dev/null
+++ b/tests/tcg/aarch64/system/ret-stack.c
@@ -0,0 +1,707 @@
+/*
+ * Returns through the return address stack.
+ *
+ * A call (BL, BLR) pushes its return address and the block it ends, and a
+ * RET to that address jumps straight to the block the return went to last
+ * time, if that block still matches. Nothing but what the guest does to
+ * the state behind that block can make it stale, so each case here changes
+ * one thing while a call is in flight and checks what runs after the
+ * return:
+ *
+ *   smc      the callee rewrites the instruction at the return site
+ *   remap    the callee maps the code page to a copy with a different
+ *            instruction at the return site and issues TLBI VAE1
+ *   retarget the callee returns to another address than the caller's
+ *   vl       the callee changes ZCR_EL1.LEN; the return site is RDVL, and
+ *            the block it was translated in has the old length built in
+ *            (part of cs_base)
+ *   pan      the callee flips PSTATE.PAN; the return site loads from a page
+ *            EL0 can read, so the old translation of the return site does
+ *            the wrong thing (part of the TB flags)
+ *   ibc      the target of BLR and BR (a site cache, checked against the
+ *            current flags and cs_base) is translated differently after
+ *            PSTATE.PAN or ZCR_EL1.LEN changed
+ *   xpage    a direct branch at the end of a page lands on the next page,
+ *            which is rewritten or remapped behind a site that cached it
+ *   twopage  the call is at the end of a page and the instructions that
+ *            follow the return site run into the next page, which is
+ *            remapped after the stack recorded the return (A64 blocks end
+ *            at a page boundary, so no TB spans two pages; the stack
+ *            refuses to record one anyway)
+ *   depth    calls nested deeper than the stack, and a longjmp-style exit
+ *            that leaves entries behind
+ *   pac      PACIASP/AUTIASP/RET and PACIASP/RETAA frames
+ *
+ * Each case first returns a few times to a return site so that the block
+ * it lands in is recorded, then does the change and returns once more.
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define ROUNDS      400
+#define BASE_VA     0x80000000ull
+#define CODE_VA     (BASE_VA + 0x1000)
+#define PTE_PAGE    0x3ull
+#define PTE_AF      (1ull << 10)
+#define PTE_SH_IS   (3ull << 8)
+#define RETSITE     0x8             /* offset of the instruction after the BL */
+#define SCTLR_EnIA  (1ull << 31)
+
+#define read_sysreg(r) ({ uint64_t __v; asm volatile("mrs %0, " #r : "=r" (__v)); __v; })
+
+static uint64_t l2_table[512] __attribute__((aligned(4096)));
+static uint64_t l3_table[512] __attribute__((aligned(4096)));
+static uint8_t page_a[4096] __attribute__((aligned(4096)));
+static uint8_t page_b[4096] __attribute__((aligned(4096)));
+static uint64_t pan_data[512] __attribute__((aligned(4096)));
+static uint8_t page_c[8192] __attribute__((aligned(4096)));
+static uint8_t page_d[4096] __attribute__((aligned(4096)));
+static uint64_t g_x8;               /* x8 for call_page() */
+static uint64_t g_entry = BASE_VA + 0x1000; /* what call_page() calls */
+#define CODE2_VA    (BASE_VA + 0x3000)
+#define PAN_MAGIC   0x5a5a1234ull
+#define PAN_VA      (BASE_VA + 0x2000)
+#define PTE_AP_EL0  (1ull << 6)
+
+/*
+ * The code page, assembled position independent. rs_entry saves the link
+ * register, calls rs_callee, which is at 0x800 on the same page, and returns
+ * what the instruction at the return site (patched) leaves in x0. x6 selects
+ * what the callee does.
+ */
+asm(".text\n"
+    ".balign 4096\n"
+    ".globl rs_page\n"
+    "rs_page:\n"
+    "    str x30, [sp, #-16]!\n"
+    "    bl rs_callee\n"
+    "    movz x0, #0x11\n"           /* the return site, patched */
+    "    ldr x30, [sp], #16\n"
+    "    ret\n"
+    ".org rs_page + 0x800\n"
+    "rs_callee:\n"
+    "    cbz x6, 9f\n"
+    "    cmp x6, #1\n"
+    "    b.eq 1f\n"
+    "    cmp x6, #2\n"
+    "    b.eq 2f\n"
+    "    cmp x6, #3\n"
+    "    b.eq 3f\n"
+    "    cmp x6, #4\n"
+    "    b.eq 4f\n"
+    "    cmp x6, #5\n"
+    "    b.eq 5f\n"
+    "9:  ret\n"
+    /* smc: x1 = return site address, x2 = new instruction */
+    "1:  str w2, [x1]\n"
+    "    dc cvau, x1\n"
+    "    dsb ish\n"
+    "    ic ivau, x1\n"
+    "    dsb ish\n"
+    "    isb\n"
+    "    ret\n"
+    /* remap: x3 = &pte, x4 = new pte, x5 = va >> 12 */
+    "2:  str x4, [x3]\n"
+    "    dsb ishst\n"
+    "    tlbi vae1, x5\n"
+    "    dsb ish\n"
+    "    isb\n"
+    "    ret\n"
+    /* retarget: return to rs_alt */
+    "3:  adr x30, rs_alt\n"
+    "    ret\n"
+    /* vl: flip ZCR_EL1.LEN bit 0 */
+    "4:  mrs x7, s3_0_c1_c2_0\n"     /* zcr_el1 */
+    "    eor x7, x7, #1\n"
+    "    msr s3_0_c1_c2_0, x7\n"
+    "    isb\n"
+    "    ret\n"
+    /* pan: flip PSTATE.PAN */
+    "5:  mrs x7, s3_0_c4_c2_3\n"
+    "    eor x7, x7, #(1 << 22)\n"
+    "    msr s3_0_c4_c2_3, x7\n"
+    "    isb\n"
+    "    ret\n"
+    ".org rs_page + 0x900\n"
+    "rs_alt:\n"
+    "    movz x0, #0x77\n"
+    "    ldr x30, [sp], #16\n"
+    "    ret\n"
+    ".org rs_page + 0x1000\n"
+    /* two pages: the block at the return site is movz, ldr and the RET on
+     * the next page */
+    ".balign 4096\n"
+    ".globl rs2_page\n"
+    "rs2_page:\n"
+    ".org rs2_page + 0x800\n"
+    "rs2_callee:\n"
+    "    ret\n"
+    ".org rs2_page + 0xff0\n"
+    "    str x30, [sp, #-16]!\n"
+    "    bl rs2_callee\n"
+    "    movz x0, #0x31\n"
+    "    ldr x30, [sp], #16\n"
+    "    ret\n"
+    ".org rs2_page + 0x2000\n"
+    /* depth: x0 levels of nesting, returns x0 */
+    ".globl rs_deep\n"
+    "rs_deep:\n"
+    "    cbz x0, 1f\n"
+    "    stp x29, x30, [sp, #-16]!\n"
+    "    sub x0, x0, #1\n"
+    "    bl rs_deep\n"
+    "    add x0, x0, #1\n"
+    "    ldp x29, x30, [sp], #16\n"
+    "    ret\n"
+    "1:  mov x0, #0\n"
+    "    ret\n"
+    /* longjmp-style: x0 levels deep, then jump back to the caller's frame
+     * without returning through the levels in between. x9 = sp to restore,
+     * x10 = address to continue at, x30 as saved by the caller. */
+    ".globl rs_jmpdeep\n"
+    "rs_jmpdeep:\n"
+    "    cbz x0, 1f\n"
+    "    stp x29, x30, [sp, #-16]!\n"
+    "    sub x0, x0, #1\n"
+    "    bl rs_jmpdeep\n"
+    "    add x0, x0, #1\n"           /* never reached for x0 > 0 */
+    "    ldp x29, x30, [sp], #16\n"
+    "    ret\n"
+    "1:  mov x0, #5\n"
+    "    mov sp, x9\n"
+    "    br x10\n"
+    /* PAC frames */
+    ".globl rs_pac_a\n"
+    "rs_pac_a:\n"
+    "    paciasp\n"
+    "    stp x29, x30, [sp, #-16]!\n"
+    "    bl rs_pac_inner\n"
+    "    ldp x29, x30, [sp], #16\n"
+    "    autiasp\n"
+    "    ret\n"
+    ".globl rs_pac_b\n"
+    "rs_pac_b:\n"
+    "    paciasp\n"
+    "    stp x29, x30, [sp, #-16]!\n"
+    "    bl rs_pac_inner\n"
+    "    ldp x29, x30, [sp], #16\n"
+    "    retaa\n"
+    "rs_pac_inner:\n"
+    "    add x0, x0, #1\n"
+    "    ret\n");
+
+extern char rs_page[], rs2_page[];
+extern uint64_t rs_deep(uint64_t), rs_pac_a(uint64_t), rs_pac_b(uint64_t);
+
+static int fails;
+#define CHECK(cond, ...) do {                                       \
+    if (!(cond)) {                                                  \
+        if (fails < 20) {                                           \
+            ml_printf("FAIL line %d: ", __LINE__);                  \
+            ml_printf(__VA_ARGS__);                                 \
+            ml_printf("\n");                                        \
+        }                                                           \
+        fails++;                                                    \
+    }                                                               \
+} while (0)
+
+static void sync_code(void *page)
+{
+    asm volatile("dc cvau, %0\n\tdsb ish\n\tic ivau, %0\n\tdsb ish\n\tisb"
+                 :: "r" (page) : "memory");
+}
+
+static void tlbi_all(void)
+{
+    asm volatile("dsb ishst\n\ttlbi vmalle1\n\tdsb ish\n\tisb" ::: "memory");
+}
+
+/* Call the code page with the callee mode and arguments in x1..x6. */
+static uint64_t call_page(uint64_t mode, uint64_t a1, uint64_t a2, uint64_t a3,
+                          uint64_t a4, uint64_t a5)
+{
+    register uint64_t x0 asm("x0") = 0xdead;
+    register uint64_t x1 asm("x1") = a1;
+    register uint64_t x2 asm("x2") = a2;
+    register uint64_t x3 asm("x3") = a3;
+    register uint64_t x4 asm("x4") = a4;
+    register uint64_t x5 asm("x5") = a5;
+    register uint64_t x6 asm("x6") = mode;
+    register uint64_t x8 asm("x8") = g_x8;
+    register uint64_t x16 asm("x16") = g_entry;
+
+    asm volatile("blr x16"
+                 : "+r" (x0)
+                 : "r" (x1), "r" (x2), "r" (x3), "r" (x4), "r" (x5), "r" (x6),
+                   "r" (x8), "r" (x16)
+                 : "x7", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+                   "x17", "x30", "memory", "cc");
+    return x0;
+}
+
+static uint64_t plain(void)
+{
+    return call_page(0, 0, 0, 0, 0, 0);
+}
+
+static void set_retsite(uint8_t *page, uint32_t insn)
+{
+    *(uint32_t *)(page + RETSITE) = insn;
+    sync_code(page);
+}
+
+#define MOVZ_X0(k)  (0xd2800000u | ((uint32_t)(k) << 5))
+#define RDVL_X0_1   0x04bf5020u
+
+static void map_page(void *phys)
+{
+    l3_table[(CODE_VA >> 12) & 0x1ff] =
+        (uint64_t)phys | PTE_PAGE | PTE_AF | PTE_SH_IS;
+    tlbi_all();
+}
+
+static void warm(uint64_t want, const char *what)
+{
+    for (int i = 0; i < 4; i++) {
+        uint64_t v = plain();
+        CHECK(v == want, "%s: warm-up returned %lx, want %lx", what,
+              (unsigned long)v, (unsigned long)want);
+    }
+}
+
+static void case_smc(void)
+{
+    uint32_t k = 0x100;
+
+    map_page(page_a);
+    for (int i = 0; i < ROUNDS; i++) {
+        uint64_t v;
+
+        set_retsite(page_a, MOVZ_X0(k));
+        warm(k, "smc");
+        v = call_page(1, CODE_VA + RETSITE, MOVZ_X0(k + 1), 0, 0, 0);
+        CHECK(v == k + 1, "smc: returned %lx, want %lx", (unsigned long)v,
+              (unsigned long)k + 1);
+        v = plain();
+        CHECK(v == k + 1, "smc: next call returned %lx, want %lx",
+              (unsigned long)v, (unsigned long)k + 1);
+        k = (k + 2) & 0x7fff;
+    }
+}
+
+static void case_remap(void)
+{
+    uint64_t pte_a = (uint64_t)page_a | PTE_PAGE | PTE_AF | PTE_SH_IS;
+    uint64_t pte_b = (uint64_t)page_b | PTE_PAGE | PTE_AF | PTE_SH_IS;
+    uint64_t *pte = &l3_table[(CODE_VA >> 12) & 0x1ff];
+
+    for (unsigned i = 0; i < 4096; i++) {
+        page_b[i] = page_a[i];
+    }
+    set_retsite(page_a, MOVZ_X0(0x11));
+    set_retsite(page_b, MOVZ_X0(0x22));
+    map_page(page_a);
+    for (int i = 0; i < ROUNDS; i++) {
+        int to_b = !(i & 1);
+        uint64_t v;
+
+        warm(to_b ? 0x11 : 0x22, "remap");
+        v = call_page(2, 0, 0, (uint64_t)pte, to_b ? pte_b : pte_a,
+                      CODE_VA >> 12);
+        CHECK(v == (to_b ? 0x22 : 0x11), "remap %d: returned %lx, want %x", i,
+              (unsigned long)v, to_b ? 0x22 : 0x11);
+        v = plain();
+        CHECK(v == (to_b ? 0x22 : 0x11), "remap %d: next call returned %lx", i,
+              (unsigned long)v);
+    }
+    map_page(page_a);
+    set_retsite(page_a, MOVZ_X0(0x11));
+}
+
+static void case_retarget(void)
+{
+    map_page(page_a);
+    set_retsite(page_a, MOVZ_X0(0x11));
+    for (int i = 0; i < ROUNDS; i++) {
+        uint64_t v;
+
+        warm(0x11, "retarget");
+        v = call_page(3, 0, 0, 0, 0, 0);
+        CHECK(v == 0x77, "retarget: returned %lx, want 77", (unsigned long)v);
+        v = plain();
+        CHECK(v == 0x11, "retarget: next call returned %lx", (unsigned long)v);
+    }
+}
+
+static void case_vl(void)
+{
+    uint64_t zcr = read_sysreg(s3_0_c1_c2_0);
+    uint64_t want[2];
+
+    map_page(page_a);
+    set_retsite(page_a, RDVL_X0_1);
+    asm volatile("msr s3_0_c1_c2_0, %0\n isb" :: "r" (zcr & ~1ull));
+    want[0] = plain();
+    asm volatile("msr s3_0_c1_c2_0, %0\n isb" :: "r" (zcr | 1));
+    want[1] = plain();
+    asm volatile("msr s3_0_c1_c2_0, %0\n isb" :: "r" (zcr & ~1ull));
+    if (want[0] == want[1]) {
+        ml_printf("vl: SVE length does not change, skipped\n");
+        return;
+    }
+    for (int i = 0; i < ROUNDS; i++) {
+        uint64_t cur = (read_sysreg(s3_0_c1_c2_0) & 1);
+        uint64_t v;
+
+        warm(want[cur], "vl");
+        v = call_page(4, 0, 0, 0, 0, 0);
+        CHECK(v == want[!cur], "vl: returned %lx, want %lx", (unsigned long)v,
+              (unsigned long)want[!cur]);
+    }
+    asm volatile("msr s3_0_c1_c2_0, %0\n isb" :: "r" (zcr));
+    set_retsite(page_a, MOVZ_X0(0x11));
+}
+
+/* A load at the return site, with PAN faulting it; the handler skips it. */
+asm(".text\n"
+    ".balign 2048\n"
+    "rs_vectors:\n"
+    ".skip 0x200\n"
+    "    mrs x16, elr_el1\n"
+    "    add x16, x16, #4\n"
+    "    msr elr_el1, x16\n"
+    "    eret\n"
+    ".balign 0x800\n");
+extern char rs_vectors[];
+
+static void case_pan(void)
+{
+    uint64_t old_vbar = read_sysreg(vbar_el1);
+
+    asm volatile("msr vbar_el1, %0\n isb" :: "r" (rs_vectors));
+    pan_data[0] = PAN_MAGIC;
+    l3_table[(PAN_VA >> 12) & 0x1ff] = (uint64_t)pan_data | PTE_PAGE | PTE_AF |
+                                       PTE_SH_IS | PTE_AP_EL0;
+    map_page(page_a);
+    set_retsite(page_a, 0xf9400100u);       /* ldr x0, [x8] */
+    g_x8 = PAN_VA;
+    asm volatile("msr s3_0_c4_c2_3, xzr\n isb");
+    for (int i = 0; i < ROUNDS; i++) {
+        uint64_t cur = (read_sysreg(s3_0_c4_c2_3) >> 22) & 1;
+        uint64_t v;
+
+        for (int j = 0; j < 4; j++) {
+            v = plain();
+            CHECK(v == (cur ? 0xdead : PAN_MAGIC), "pan: warm-up returned %lx",
+                  (unsigned long)v);
+        }
+        v = call_page(5, 0, 0, 0, 0, 0);
+        CHECK(v == (cur ? PAN_MAGIC : 0xdead), "pan %d (was %d): returned %lx",
+              i, (int)cur, (unsigned long)v);
+    }
+    asm volatile("msr s3_0_c4_c2_3, xzr\n isb");
+    asm volatile("msr vbar_el1, %0\n isb" :: "r" (old_vbar));
+    set_retsite(page_a, MOVZ_X0(0x11));
+}
+
+static void case_twopage(void)
+{
+    uint8_t *src = (uint8_t *)rs2_page;
+    uint64_t *pte0 = &l3_table[(CODE2_VA >> 12) & 0x1ff];
+    uint64_t pte_c1 = (uint64_t)(page_c + 4096) | PTE_PAGE | PTE_AF | PTE_SH_IS;
+    uint64_t pte_d = (uint64_t)page_d | PTE_PAGE | PTE_AF | PTE_SH_IS;
+
+    for (unsigned i = 0; i < 8192; i++) {
+        page_c[i] = src[i];
+    }
+    ((uint32_t *)page_d)[0] = MOVZ_X0(0x99);
+    ((uint32_t *)page_d)[1] = 0xd65f03c0u;     /* ret */
+    sync_code(page_c);
+    sync_code(page_c + 4096);
+    sync_code(page_d);
+    pte0[0] = (uint64_t)page_c | PTE_PAGE | PTE_AF | PTE_SH_IS;
+    g_entry = CODE2_VA + 0xff0;
+    for (int i = 0; i < ROUNDS; i++) {
+        uint64_t v;
+
+        pte0[1] = pte_c1;
+        tlbi_all();
+        for (int j = 0; j < 4; j++) {
+            v = plain();
+            CHECK(v == 0x31, "twopage: warm-up returned %lx", (unsigned long)v);
+        }
+        pte0[1] = pte_d;
+        tlbi_all();
+        v = plain();
+        CHECK(v == 0x99, "twopage %d: returned %lx, want 99", i,
+              (unsigned long)v);
+    }
+    pte0[0] = 0;
+    pte0[1] = 0;
+    tlbi_all();
+    g_entry = CODE_VA;
+}
+
+/* RDVL x0, #1 or a load that PAN faults, then RET, at the start of a page. */
+static uint32_t ibc_code[1024] __attribute__((aligned(4096)));
+#define IBC_VA  (BASE_VA + 0x5000)
+
+static uint64_t blr_to(uint64_t va, uint64_t x8)
+{
+    register uint64_t x0 asm("x0") = 0xdead;
+    register uint64_t r8 asm("x8") = x8;
+
+    asm volatile("blr %2" : "+r" (x0) : "r" (r8), "r" (va)
+                 : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x9", "x10",
+                   "x11", "x12", "x13", "x14", "x15", "x16", "x17", "x30",
+                   "memory", "cc");
+    return x0;
+}
+
+static uint64_t br_to(uint64_t va, uint64_t x8)
+{
+    register uint64_t x0 asm("x0") = 0xdead;
+    register uint64_t r8 asm("x8") = x8;
+
+    asm volatile("adr x30, 1f\n\tbr %2\n1:" : "+r" (x0) : "r" (r8), "r" (va)
+                 : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x9", "x10",
+                   "x11", "x12", "x13", "x14", "x15", "x16", "x17", "x30",
+                   "memory", "cc");
+    return x0;
+}
+
+static void case_ibc(void)
+{
+    uint64_t old_vbar = read_sysreg(vbar_el1);
+    uint64_t zcr = read_sysreg(s3_0_c1_c2_0);
+
+    asm volatile("msr vbar_el1, %0\n isb" :: "r" (rs_vectors));
+    pan_data[0] = PAN_MAGIC;
+    l3_table[(PAN_VA >> 12) & 0x1ff] = (uint64_t)pan_data | PTE_PAGE | PTE_AF |
+                                       PTE_SH_IS | PTE_AP_EL0;
+    l3_table[(IBC_VA >> 12) & 0x1ff] = (uint64_t)ibc_code | PTE_PAGE | PTE_AF |
+                                       PTE_SH_IS;
+    tlbi_all();
+
+    /* PAN: the load at the target faults or not */
+    ibc_code[0] = 0xf9400100u;      /* ldr x0, [x8] */
+    ibc_code[1] = 0xd65f03c0u;      /* ret */
+    sync_code(ibc_code);
+    asm volatile("msr s3_0_c4_c2_3, xzr\n isb");
+    for (int i = 0; i < 2000; i++) {
+        uint64_t pan = i & 1;
+        uint64_t v;
+
+        if (pan) {
+            asm volatile("msr s3_0_c4_c2_3, %0\n isb" :: "r" (1ull << 22));
+        } else {
+            asm volatile("msr s3_0_c4_c2_3, xzr\n isb");
+        }
+        v = blr_to(IBC_VA, PAN_VA);
+        CHECK(v == (pan ? 0xdead : PAN_MAGIC), "ibc pan %d blr: %lx", i,
+              (unsigned long)v);
+        v = br_to(IBC_VA, PAN_VA);
+        CHECK(v == (pan ? 0xdead : PAN_MAGIC), "ibc pan %d br: %lx", i,
+              (unsigned long)v);
+    }
+    asm volatile("msr s3_0_c4_c2_3, xzr\n isb");
+
+    /* ZCR_EL1.LEN: RDVL has the vector length built in */
+    ibc_code[0] = RDVL_X0_1;
+    sync_code(ibc_code);
+    for (int i = 0; i < 2000; i++) {
+        uint64_t len = i & 1;
+        uint64_t a, b;
+
+        asm volatile("msr s3_0_c1_c2_0, %0\n isb" :: "r" (len));
+        a = blr_to(IBC_VA, 0);
+        b = br_to(IBC_VA, 0);
+        CHECK(a == b && a == 16 * (len + 1), "ibc vl %d: %lx %lx", i,
+              (unsigned long)a, (unsigned long)b);
+    }
+    asm volatile("msr s3_0_c1_c2_0, %0\n isb" :: "r" (zcr));
+
+    /* a monomorphic site: the target is rewritten, and then remapped */
+    for (int i = 0; i < 400; i++) {
+        uint64_t v;
+
+        ibc_code[0] = MOVZ_X0(0x200 + i);
+        ibc_code[1] = 0xd65f03c0u;
+        sync_code(ibc_code);
+        for (int j = 0; j < 3; j++) {
+            v = blr_to(IBC_VA, 0);
+            CHECK(v == 0x200 + i, "ibc smc %d: warm-up %lx", i, (unsigned long)v);
+            v = br_to(IBC_VA, 0);
+            CHECK(v == 0x200 + i, "ibc smc %d: warm-up br %lx", i, (unsigned long)v);
+        }
+        ibc_code[0] = MOVZ_X0(0x300 + i);
+        sync_code(ibc_code);
+        v = blr_to(IBC_VA, 0);
+        CHECK(v == 0x300 + i, "ibc smc %d: rewritten, blr %lx", i, (unsigned long)v);
+        v = br_to(IBC_VA, 0);
+        CHECK(v == 0x300 + i, "ibc smc %d: rewritten, br %lx", i, (unsigned long)v);
+    }
+    for (unsigned i = 0; i < 4096; i++) {
+        page_b[i] = ((uint8_t *)ibc_code)[i];
+    }
+    for (int i = 0; i < 400; i++) {
+        uint64_t pte_a = (uint64_t)ibc_code | PTE_PAGE | PTE_AF | PTE_SH_IS;
+        uint64_t pte_b = (uint64_t)page_b | PTE_PAGE | PTE_AF | PTE_SH_IS;
+        uint64_t *pte = &l3_table[(IBC_VA >> 12) & 0x1ff];
+        uint64_t v;
+
+        ibc_code[0] = MOVZ_X0(0x400);
+        ((uint32_t *)page_b)[0] = MOVZ_X0(0x500);
+        ((uint32_t *)page_b)[1] = 0xd65f03c0u;
+        sync_code(ibc_code);
+        sync_code(page_b);
+        *pte = pte_a;
+        tlbi_all();
+        for (int j = 0; j < 3; j++) {
+            v = blr_to(IBC_VA, 0);
+            CHECK(v == 0x400, "ibc remap %d: warm-up %lx", i, (unsigned long)v);
+        }
+        *pte = pte_b;
+        tlbi_all();
+        v = blr_to(IBC_VA, 0);
+        CHECK(v == 0x500, "ibc remap %d: after remap, blr %lx", i, (unsigned long)v);
+        v = br_to(IBC_VA, 0);
+        CHECK(v == 0x500, "ibc remap %d: after remap, br %lx", i, (unsigned long)v);
+        *pte = pte_a;
+        tlbi_all();
+        v = blr_to(IBC_VA, 0);
+        CHECK(v == 0x400, "ibc remap %d: back, blr %lx", i, (unsigned long)v);
+    }
+    asm volatile("msr vbar_el1, %0\n isb" :: "r" (old_vbar));
+}
+
+static uint32_t xp_p[1024] __attribute__((aligned(4096)));
+static uint32_t xp_q[1024] __attribute__((aligned(4096)));
+static uint32_t xp_q2[1024] __attribute__((aligned(4096)));
+#define XP_VA   (BASE_VA + 0x6000)
+
+static void case_xpage(void)
+{
+    uint64_t *pte = &l3_table[((XP_VA + 0x1000) >> 12) & 0x1ff];
+    uint64_t pte_q = (uint64_t)xp_q | PTE_PAGE | PTE_AF | PTE_SH_IS;
+    uint64_t pte_q2 = (uint64_t)xp_q2 | PTE_PAGE | PTE_AF | PTE_SH_IS;
+
+    l3_table[(XP_VA >> 12) & 0x1ff] = (uint64_t)xp_p | PTE_PAGE | PTE_AF |
+                                      PTE_SH_IS;
+    *pte = pte_q;
+    xp_p[0x3fe] = 0xd503201fu;              /* nop */
+    xp_p[0x3ff] = 0x14000001u;              /* b +4: the first insn of the next page */
+    xp_q[1] = xp_q2[1] = 0xd65f03c0u;       /* ret */
+    sync_code(xp_p);
+    tlbi_all();
+    for (int i = 0; i < 400; i++) {
+        uint64_t v;
+
+        xp_q[0] = MOVZ_X0(0x600 + i);
+        xp_q2[0] = MOVZ_X0(0x700 + i);
+        sync_code(xp_q);
+        sync_code(xp_q2);
+        *pte = pte_q;
+        tlbi_all();
+        for (int j = 0; j < 3; j++) {
+            v = blr_to(XP_VA + 0xff8, 0);
+            CHECK(v == 0x600 + i, "xpage %d: warm-up %lx", i, (unsigned long)v);
+        }
+        xp_q[0] = MOVZ_X0(0x800 + i);
+        sync_code(xp_q);
+        v = blr_to(XP_VA + 0xff8, 0);
+        CHECK(v == 0x800 + i, "xpage %d: rewritten %lx", i, (unsigned long)v);
+        *pte = pte_q2;
+        tlbi_all();
+        v = blr_to(XP_VA + 0xff8, 0);
+        CHECK(v == 0x700 + i, "xpage %d: remapped %lx", i, (unsigned long)v);
+        v = br_to(XP_VA + 0xff8, 0);
+        CHECK(v == 0x700 + i, "xpage %d: remapped, br %lx", i, (unsigned long)v);
+    }
+}
+
+static uint64_t jmpdeep_call(uint64_t levels)
+{
+    register uint64_t x0 asm("x0") = levels;
+
+    /* x9 = sp, x10 = where to continue; the callee leaves through BR */
+    asm volatile("mov x9, sp\n\t"
+                 "adr x10, 1f\n\t"
+                 "bl rs_jmpdeep\n"
+                 "1:"
+                 : "+r" (x0)
+                 :
+                 : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+                   "x11", "x12", "x13", "x14", "x15", "x16", "x17", "x30",
+                   "memory", "cc");
+    return x0;
+}
+
+static void case_depth(void)
+{
+    static const unsigned depths[] = { 1, 5, 15, 16, 17, 40, 200 };
+
+    for (int r = 0; r < 20; r++) {
+        for (unsigned i = 0; i < sizeof(depths) / sizeof(depths[0]); i++) {
+            uint64_t v = rs_deep(depths[i]);
+
+            CHECK(v == depths[i], "depth %u returned %lx", depths[i],
+                  (unsigned long)v);
+            /* the entries a longjmp leaves behind must not matter */
+            v = jmpdeep_call(depths[i]);
+            CHECK(v == 5, "jmpdeep %u returned %lx", depths[i],
+                  (unsigned long)v);
+            v = rs_deep(depths[i] / 2 + 1);
+            CHECK(v == depths[i] / 2 + 1, "depth after jmp %u returned %lx",
+                  depths[i], (unsigned long)v);
+        }
+    }
+}
+
+static void case_pac(void)
+{
+    uint64_t sctlr = read_sysreg(sctlr_el1);
+
+    asm volatile("msr sctlr_el1, %0\n isb" :: "r" (sctlr | SCTLR_EnIA));
+    for (int i = 0; i < 2000; i++) {
+        uint64_t v = rs_pac_a(i);
+
+        CHECK(v == (uint64_t)i + 1, "pac a returned %lx", (unsigned long)v);
+        v = rs_pac_b(i);
+        CHECK(v == (uint64_t)i + 1, "pac b returned %lx", (unsigned long)v);
+    }
+    asm volatile("msr sctlr_el1, %0\n isb" :: "r" (sctlr));
+}
+
+int main(void)
+{
+    uint64_t *ttb = (uint64_t *)(read_sysreg(ttbr0_el1) & 0x0000fffffffff000ull);
+    uint8_t *tmpl = (uint8_t *)rs_page;
+
+    ml_printf("Return address stack test\n");
+    for (unsigned i = 0; i < 4096; i++) {
+        page_a[i] = tmpl[i];
+    }
+    sync_code(page_a);
+    /* VA 0x80000000: L1 index 2 -> l2_table[0] -> l3_table */
+    ttb[(BASE_VA >> 30) & 0x1ff] = (uint64_t)l2_table | 3;
+    l2_table[0] = (uint64_t)l3_table | 3;
+    tlbi_all();
+
+    case_smc();
+    case_remap();
+    case_retarget();
+    case_vl();
+    case_pan();
+    case_twopage();
+    case_ibc();
+    case_xpage();
+    case_depth();
+    case_pac();
+    ml_printf(fails ? "FAILED\n" : "OK\n");
+    return fails != 0;
+}
diff --git a/tests/tcg/aarch64/system/stlr-ldar.c b/tests/tcg/aarch64/system/stlr-ldar.c
new file mode 100644
index 0000000000..799bb2d243
--- /dev/null
+++ b/tests/tcg/aarch64/system/stlr-ldar.c
@@ -0,0 +1,196 @@
+/*
+ * Store-release then load-acquire is ordered (store buffering litmus test).
+ *
+ * Arm orders a release store before a later RCsc acquire load
+ * (STLR x; LDAR y), so two vCPUs running
+ *
+ *     P0: STLR 1, [x]; LDAR r0, [y]      P1: STLR 1, [y]; LDAR r1, [x]
+ *
+ * can never both read 0. x86 hosts let a load pass an earlier store in
+ * the store buffer, so the translation must put a store-to-load fence
+ * between the two. Variants: STLR then LDAR, STLUR then LDAR, STLR then
+ * LDAXR. The test also runs the plain STR;LDR shape, where the outcome is
+ * allowed, to show the harness can see reordering at all (not checked).
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define PSCI_CPU_ON 0xc4000003ull
+#define ITERS       50000
+#define REPEAT      8
+#define VARIANTS    6
+#define ALLOWED     (VARIANTS - 1)   /* the plain shape comes last */
+
+struct slot { uint32_t x, pad0[15]; uint32_t y, pad1[15]; };
+static struct slot slots[2] __attribute__((aligned(256)));
+static uint8_t res0[ITERS], res1[ITERS];
+static uint32_t arrive[2][16] __attribute__((aligned(64)));
+static uint32_t go __attribute__((aligned(64)));
+static uint32_t started __attribute__((aligned(64)));
+static uint32_t finished __attribute__((aligned(64)));
+uint64_t mmu_cfg[8] __attribute__((aligned(64)));
+char sec_stacks[2 * 4096] __attribute__((aligned(16)));
+
+/* The two threads of one variant. */
+#define BODY(name, store, load0, ld)                                     \
+    static __attribute__((noinline)) uint32_t name(uint32_t *a, uint32_t *b) \
+    {                                                                    \
+        uint32_t one = 1, r;                                             \
+        asm volatile(store " %w1, [%2]\n\t" load0 ld " %w0, [%3]"        \
+                     : "=&r" (r) : "r" (one), "r" (a), "r" (b)           \
+                     : "memory");                                        \
+        return r;                                                        \
+    }
+BODY(v0, "stlr", "", "ldar")
+BODY(v1, "stlur", "", "ldar")
+BODY(v2, "stlr", "", "ldaxr")
+/* the barrier of the release store must survive the end of a block ... */
+BODY(v3, "stlr", "b 1f\n1:\n\t", "ldar")
+/* ... and a plain load in between */
+BODY(v4, "stlr", "ldr %w0, [%3]\n\t", "ldar")
+BODY(v5, "str", "", "ldr")
+
+static uint32_t (*const bodies[VARIANTS])(uint32_t *, uint32_t *) = {
+    v0, v1, v2, v3, v4, v5
+};
+
+static void run_thread(int me, int variant)
+{
+    uint32_t (*fn)(uint32_t *, uint32_t *) = bodies[variant];
+    uint8_t *res = me ? res1 : res0;
+
+    for (uint32_t i = 0; i < ITERS; i++) {
+        struct slot *s = &slots[i & 1];
+        uint32_t *mine = me ? &s->y : &s->x;
+        uint32_t *other = me ? &s->x : &s->y;
+
+        /* wait until the other thread has reset this slot (iteration i-2)
+         * and arrived here */
+        __atomic_store_n(&arrive[me][0], i + 1, __ATOMIC_RELEASE);
+        while (__atomic_load_n(&arrive[!me][0], __ATOMIC_ACQUIRE) < i + 1) {
+        }
+        res[i] = fn(mine, other);
+        /* both sides have read: reset the slot for iteration i+2 */
+        __atomic_store_n(&arrive[me][8], i + 1, __ATOMIC_RELEASE);
+        while (__atomic_load_n(&arrive[!me][8], __ATOMIC_ACQUIRE) < i + 1) {
+        }
+        if (me == 0) {
+            __atomic_store_n(&s->x, 0, __ATOMIC_RELAXED);
+            __atomic_store_n(&s->y, 0, __ATOMIC_RELEASE);
+        }
+        /* P0 resets before the next arrive of either thread */
+        __atomic_store_n(&arrive[me][4], i + 1, __ATOMIC_RELEASE);
+        while (__atomic_load_n(&arrive[!me][4], __ATOMIC_ACQUIRE) < i + 1) {
+        }
+    }
+}
+
+__attribute__((used)) void sec_main(void)
+{
+    uint32_t seen = 0;
+
+    __atomic_fetch_add(&started, 1, __ATOMIC_ACQ_REL);
+    for (int v = 0; v < VARIANTS; v++) {
+        for (int rep = 0; rep < REPEAT; rep++) {
+            uint32_t want = 2 * (rep + REPEAT * v) + 1;
+
+            while (__atomic_load_n(&go, __ATOMIC_ACQUIRE) != want) {
+            }
+            seen = want;
+            run_thread(1, v);
+            __atomic_store_n(&finished, 1, __ATOMIC_RELEASE);
+            /* the primary sets go to the next value only after it saw
+             * finished and cleared it */
+        }
+    }
+    (void)seen;
+    for (;;) {
+        asm volatile("wfe");
+    }
+}
+
+asm(".text\n"
+    ".global sec_entry\n"
+    "sec_entry:\n"
+    "    adrp x0, mmu_cfg\n"
+    "    add x0, x0, :lo12:mmu_cfg\n"
+    "    ldp x1, x2, [x0]\n"
+    "    msr ttbr0_el1, x1\n"
+    "    msr tcr_el1, x2\n"
+    "    ldp x1, x2, [x0, #16]\n"
+    "    msr mair_el1, x1\n"
+    "    msr sctlr_el1, x2\n"
+    "    isb\n"
+    "    adrp x2, sec_stacks\n"
+    "    add x2, x2, :lo12:sec_stacks\n"
+    "    add x2, x2, #4096\n"
+    "    mov sp, x2\n"
+    "    bl sec_main\n"
+    "1:  wfe\n"
+    "    b 1b\n");
+void sec_entry(void);
+
+static int64_t psci_cpu_on(uint64_t target, uint64_t entry)
+{
+    register uint64_t x0 asm("x0") = PSCI_CPU_ON;
+    register uint64_t x1 asm("x1") = target;
+    register uint64_t x2 asm("x2") = entry;
+    register uint64_t x3 asm("x3") = 0;
+
+    asm volatile("hvc #0" : "+r" (x0) : "r" (x1), "r" (x2), "r" (x3)
+                 : "memory");
+    return (int64_t)x0;
+}
+
+int main(void)
+{
+    static const char *const names[VARIANTS] = {
+        "stlr;ldar", "stlur;ldar", "stlr;ldaxr", "stlr;b;ldar",
+        "stlr;ldr;ldar", "str;ldr (allowed)"
+    };
+    uint64_t v;
+    int fails = 0;
+
+    ml_printf("STLR;LDAR litmus test\n");
+    asm volatile("mrs %0, ttbr0_el1" : "=r" (v)); mmu_cfg[0] = v;
+    asm volatile("mrs %0, tcr_el1" : "=r" (v)); mmu_cfg[1] = v;
+    asm volatile("mrs %0, mair_el1" : "=r" (v)); mmu_cfg[2] = v;
+    asm volatile("mrs %0, sctlr_el1" : "=r" (v)); mmu_cfg[3] = v;
+    asm volatile("dsb ish" ::: "memory");
+    if (psci_cpu_on(1, (uint64_t)sec_entry) != 0) {
+        ml_printf("SKIP: no second vCPU\n");
+        return 0;
+    }
+    for (unsigned spin = 0; !__atomic_load_n(&started, __ATOMIC_ACQUIRE) &&
+                            spin < 2000000000u; spin++) {
+    }
+    for (int var = 0; var < VARIANTS; var++) {
+        unsigned both0 = 0;
+
+        for (int rep = 0; rep < REPEAT; rep++) {
+            for (int i = 0; i < 16; i++) {
+                arrive[0][i] = arrive[1][i] = 0;
+            }
+            slots[0].x = slots[0].y = slots[1].x = slots[1].y = 0;
+            __atomic_store_n(&finished, 0, __ATOMIC_RELEASE);
+            __atomic_store_n(&go, 2 * (rep + REPEAT * var) + 1, __ATOMIC_RELEASE);
+            run_thread(0, var);
+            while (!__atomic_load_n(&finished, __ATOMIC_ACQUIRE)) {
+            }
+            for (uint32_t i = 0; i < ITERS; i++) {
+                both0 += res0[i] == 0 && res1[i] == 0;
+            }
+        }
+        ml_printf("%s: %u of %u reads both 0\n", names[var], both0,
+                  ITERS * REPEAT);
+        if (var < ALLOWED && both0) {
+            fails++;
+        }
+    }
+    ml_printf(fails ? "FAILED\n" : "OK\n");
+    return fails != 0;
+}
diff --git a/tests/tcg/aarch64/system/timer-xcpu.c b/tests/tcg/aarch64/system/timer-xcpu.c
new file mode 100644
index 0000000000..d9d51738b6
--- /dev/null
+++ b/tests/tcg/aarch64/system/timer-xcpu.c
@@ -0,0 +1,352 @@
+/*
+ * Generic timer from several vCPUs while interrupts fire.
+ *
+ * Every vCPU programs the EL1 virtual timer over and over, reads the
+ * counter and timer registers (these reads take no BQL), and takes the timer
+ * interrupt through the GIC.  Even rounds take the interrupt.  Odd rounds
+ * keep IRQs masked, so the interrupt is pending but not deliverable: the
+ * vCPU must see ISTATUS without taking it, and must not take it later once
+ * the timer is disabled.  Checks that the counter never goes backwards,
+ * that the physical counter is not behind the virtual one, and that every
+ * interrupt that was due was taken exactly once per vCPU.
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define PSCI_CPU_ON 0xc4000003ull
+#define NCPUS       4
+#define ROUNDS      400
+#define TIMER_PPI   27
+
+#define GICD_BASE   0x08000000ull
+#define GICC_BASE   0x08010000ull
+#define GICD_CTLR   (GICD_BASE + 0x000)
+#define GICD_ISENABLER0 (GICD_BASE + 0x100)
+#define GICC_CTLR   (GICC_BASE + 0x00)
+#define GICC_PMR    (GICC_BASE + 0x04)
+#define GICC_IAR    (GICC_BASE + 0x0c)
+#define GICC_EOIR   (GICC_BASE + 0x10)
+
+#define SYSREG_R(name) ({ uint64_t v_; \
+    asm volatile("mrs %0, " #name : "=r" (v_)); v_; })
+#define SYSREG_W(name, val) \
+    asm volatile("msr " #name ", %0" :: "r" ((uint64_t)(val)))
+
+uint64_t mmu_cfg[8] __attribute__((aligned(64)));
+static uint32_t irqs[NCPUS][16] __attribute__((aligned(64)));
+static uint32_t spurious[NCPUS][16] __attribute__((aligned(64)));
+static uint32_t fails[NCPUS][16] __attribute__((aligned(64)));
+static uint32_t timeouts[NCPUS][16] __attribute__((aligned(64)));
+static uint32_t started_cpus __attribute__((aligned(64)));
+static uint32_t finished __attribute__((aligned(64)));
+static uint32_t go __attribute__((aligned(64)));
+
+static inline int cpu_id(void)
+{
+    return (int)(SYSREG_R(mpidr_el1) & 0xff) % NCPUS;
+}
+
+static inline void mmio_w32(uint64_t addr, uint32_t val)
+{
+    *(volatile uint32_t *)addr = val;
+}
+
+static inline uint32_t mmio_r32(uint64_t addr)
+{
+    return *(volatile uint32_t *)addr;
+}
+
+__attribute__((used)) void irq_c(void)
+{
+    int cpu = cpu_id();
+    uint32_t iar = mmio_r32(GICC_IAR);
+    uint32_t id = iar & 0x3ff;
+
+    if (id == TIMER_PPI) {
+        /* The interrupt must be visible as ISTATUS when taken */
+        if (!(SYSREG_R(cntv_ctl_el0) & 4)) {
+            __atomic_fetch_add(&fails[cpu][0], 1, __ATOMIC_RELAXED);
+        }
+        SYSREG_W(cntv_ctl_el0, 0);
+        __atomic_fetch_add(&irqs[cpu][0], 1, __ATOMIC_RELAXED);
+    } else if (id < 1020) {
+        __atomic_fetch_add(&spurious[cpu][0], 1, __ATOMIC_RELAXED);
+    }
+    if (id < 1020) {
+        mmio_w32(GICC_EOIR, iar);
+    }
+}
+
+asm(".text\n"
+    ".balign 2048\n"
+    ".global tx_vectors\n"
+    "tx_vectors:\n"
+    ".rept 5\n"
+    "    b .\n"
+    "    .balign 128\n"
+    ".endr\n"
+    /* 0x280: IRQ from the current EL with SPx */
+    "    b tx_irq\n"
+    "    .balign 128\n"
+    ".rept 10\n"
+    "    b .\n"
+    "    .balign 128\n"
+    ".endr\n"
+    "tx_irq:\n"
+    /* skip the red zone of the interrupted code */
+    "    sub sp, sp, #128\n"
+    "    sub sp, sp, #176\n"
+    "    stp x0, x1, [sp, #0]\n"
+    "    stp x2, x3, [sp, #16]\n"
+    "    stp x4, x5, [sp, #32]\n"
+    "    stp x6, x7, [sp, #48]\n"
+    "    stp x8, x9, [sp, #64]\n"
+    "    stp x10, x11, [sp, #80]\n"
+    "    stp x12, x13, [sp, #96]\n"
+    "    stp x14, x15, [sp, #112]\n"
+    "    stp x16, x17, [sp, #128]\n"
+    "    stp x18, x29, [sp, #144]\n"
+    "    str x30, [sp, #160]\n"
+    "    bl irq_c\n"
+    "    ldp x0, x1, [sp, #0]\n"
+    "    ldp x2, x3, [sp, #16]\n"
+    "    ldp x4, x5, [sp, #32]\n"
+    "    ldp x6, x7, [sp, #48]\n"
+    "    ldp x8, x9, [sp, #64]\n"
+    "    ldp x10, x11, [sp, #80]\n"
+    "    ldp x12, x13, [sp, #96]\n"
+    "    ldp x14, x15, [sp, #112]\n"
+    "    ldp x16, x17, [sp, #128]\n"
+    "    ldp x18, x29, [sp, #144]\n"
+    "    ldr x30, [sp, #160]\n"
+    "    add sp, sp, #176\n"
+    "    add sp, sp, #128\n"
+    "    eret\n");
+
+void tx_vectors(void);
+
+static uint32_t rnd_state[NCPUS] = { 0x1234567, 0x2345678, 0x3456789,
+                                     0x456789a };
+
+static uint32_t rnd(int cpu)
+{
+    uint32_t x = rnd_state[cpu];
+
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+    rnd_state[cpu] = x;
+    return x;
+}
+
+/* One vCPU's view of the counters: never backwards, phys not behind virt */
+static int check_counters(uint64_t *last)
+{
+    uint64_t v = SYSREG_R(cntvct_el0);
+    uint64_t p = SYSREG_R(cntpct_el0);
+    int bad = 0;
+
+    if (v < *last) {
+        bad = 1;
+    }
+    *last = v;
+    /* read the virtual counter first: the physical one is read later */
+    if (p < v) {
+        bad = 1;
+    }
+    return bad;
+}
+
+static void do_round(int cpu, uint32_t round, uint64_t timeout)
+{
+    uint32_t delay = 100 + rnd(cpu) % 2900;
+    uint64_t last = SYSREG_R(cntvct_el0);
+    uint64_t deadline = last + timeout;
+    uint32_t before = __atomic_load_n(&irqs[cpu][0], __ATOMIC_RELAXED);
+
+    if (!(round & 1)) {
+        SYSREG_W(cntv_tval_el0, delay);
+        SYSREG_W(cntv_ctl_el0, 1);
+        asm volatile("msr daifclr, #2\n\tisb" ::: "memory");
+        while (__atomic_load_n(&irqs[cpu][0], __ATOMIC_ACQUIRE) == before) {
+            if (check_counters(&last) ||
+                (int32_t)SYSREG_R(cntv_tval_el0) > (int32_t)delay) {
+                __atomic_fetch_add(&fails[cpu][0], 1, __ATOMIC_RELAXED);
+            }
+            if (last > deadline) {
+                __atomic_fetch_add(&timeouts[cpu][0], 1, __ATOMIC_RELAXED);
+                break;
+            }
+        }
+        asm volatile("msr daifset, #2\n\tisb" ::: "memory");
+        SYSREG_W(cntv_ctl_el0, 0);
+    } else {
+        int reads;
+
+        asm volatile("msr daifset, #2\n\tisb" ::: "memory");
+        SYSREG_W(cntv_cval_el0, last + delay);
+        SYSREG_W(cntv_ctl_el0, 1);
+        while (!(SYSREG_R(cntv_ctl_el0) & 4)) {
+            if (check_counters(&last)) {
+                __atomic_fetch_add(&fails[cpu][0], 1, __ATOMIC_RELAXED);
+            }
+            if (last > deadline) {
+                __atomic_fetch_add(&timeouts[cpu][0], 1, __ATOMIC_RELAXED);
+                break;
+            }
+        }
+        /* The line is asserted, but IRQs are masked: stay on, then drop it */
+        for (reads = 0; reads < 200; reads++) {
+            if (check_counters(&last)) {
+                __atomic_fetch_add(&fails[cpu][0], 1, __ATOMIC_RELAXED);
+            }
+        }
+        if (__atomic_load_n(&irqs[cpu][0], __ATOMIC_RELAXED) != before) {
+            __atomic_fetch_add(&fails[cpu][0], 1, __ATOMIC_RELAXED);
+        }
+        SYSREG_W(cntv_ctl_el0, 0);
+        asm volatile("isb\n\tmsr daifclr, #2\n\tisb\n\tnop\n\tnop\n\t"
+                     "msr daifset, #2\n\tisb" ::: "memory");
+        if (__atomic_load_n(&irqs[cpu][0], __ATOMIC_RELAXED) != before) {
+            __atomic_fetch_add(&fails[cpu][0], 1, __ATOMIC_RELAXED);
+        }
+    }
+}
+
+static void worker(int cpu)
+{
+    uint64_t timeout = SYSREG_R(cntfrq_el0);   /* one second of ticks */
+
+    mmio_w32(GICD_ISENABLER0, 1u << TIMER_PPI);
+    mmio_w32(GICC_PMR, 0xff);
+    mmio_w32(GICC_CTLR, 1);
+    SYSREG_W(cntv_ctl_el0, 0);
+    __atomic_fetch_add(&started_cpus, 1, __ATOMIC_ACQ_REL);
+    while (!__atomic_load_n(&go, __ATOMIC_ACQUIRE)) {
+    }
+    for (uint32_t r = 0; r < ROUNDS; r++) {
+        do_round(cpu, r, timeout);
+    }
+    __atomic_fetch_add(&finished, 1, __ATOMIC_RELEASE);
+}
+
+__attribute__((used)) void sec_main(void)
+{
+    worker(cpu_id());
+    for (;;) {
+        asm volatile("wfe");
+    }
+}
+
+char sec_stacks[NCPUS * 4096] __attribute__((aligned(16)));
+asm(".text\n"
+    ".global sec_entry\n"
+    "sec_entry:\n"
+    "    adrp x0, mmu_cfg\n"
+    "    add x0, x0, :lo12:mmu_cfg\n"
+    "    ldp x1, x2, [x0]\n"
+    "    msr ttbr0_el1, x1\n"
+    "    msr tcr_el1, x2\n"
+    "    ldp x1, x2, [x0, #16]\n"
+    "    msr mair_el1, x1\n"
+    "    ldr x3, [x0, #32]\n"
+    "    msr vbar_el1, x3\n"
+    "    isb\n"
+    "    msr sctlr_el1, x2\n"
+    "    isb\n"
+    "    mrs x1, mpidr_el1\n"
+    "    and x1, x1, #0xff\n"
+    "    add x1, x1, #1\n"
+    "    lsl x1, x1, #12\n"
+    "    adrp x2, sec_stacks\n"
+    "    add x2, x2, :lo12:sec_stacks\n"
+    "    add x2, x2, x1\n"
+    "    mov sp, x2\n"
+    "    mrs x1, cpacr_el1\n"
+    "    orr x1, x1, #(3 << 20)\n"
+    "    msr cpacr_el1, x1\n"
+    "    bl sec_main\n"
+    "1:  wfe\n"
+    "    b 1b\n");
+void sec_entry(void);
+
+static int64_t psci_cpu_on(uint64_t target, uint64_t entry)
+{
+    register uint64_t x0 asm("x0") = PSCI_CPU_ON;
+    register uint64_t x1 asm("x1") = target;
+    register uint64_t x2 asm("x2") = entry;
+    register uint64_t x3 asm("x3") = 0;
+
+    asm volatile("hvc #0" : "+r" (x0) : "r" (x1), "r" (x2), "r" (x3)
+                 : "memory");
+    return (int64_t)x0;
+}
+
+static void save_mmu_cfg(void)
+{
+    mmu_cfg[0] = SYSREG_R(ttbr0_el1);
+    mmu_cfg[1] = SYSREG_R(tcr_el1);
+    mmu_cfg[2] = SYSREG_R(mair_el1);
+    mmu_cfg[3] = SYSREG_R(sctlr_el1);
+    mmu_cfg[4] = (uint64_t)tx_vectors;
+    asm volatile("dsb ish" ::: "memory");
+}
+
+int main(void)
+{
+    uint64_t *ttb = (uint64_t *)(SYSREG_R(ttbr0_el1) & 0x0000fffffffff000ull);
+    uint32_t nsec = 0;
+    uint32_t bad = 0;
+
+    ml_printf("Timer from several vCPUs with interrupts\n");
+    /* the first GiB holds the GIC: map it as device memory (Attr1) */
+    ttb[0] = (3ull << 53) | 0x401 | (1 << 2);
+    asm volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" ::: "memory");
+    save_mmu_cfg();
+    SYSREG_W(vbar_el1, tx_vectors);
+    asm volatile("isb");
+    mmio_w32(GICD_CTLR, 1);
+
+    for (unsigned cpu = 1; cpu < NCPUS; cpu++) {
+        if (psci_cpu_on(cpu, (uint64_t)sec_entry) == 0) {
+            nsec++;
+        }
+    }
+    for (unsigned spin = 0;
+         __atomic_load_n(&started_cpus, __ATOMIC_ACQUIRE) < nsec &&
+         spin < 2000000000u; spin++) {
+    }
+    if (__atomic_load_n(&started_cpus, __ATOMIC_ACQUIRE) != nsec) {
+        ml_printf("FAIL: secondaries did not start\n");
+        return 1;
+    }
+    ml_printf("%d vCPUs\n", nsec + 1);
+    __atomic_store_n(&go, 1, __ATOMIC_RELEASE);
+    worker(0);
+    for (unsigned spin = 0;
+         __atomic_load_n(&finished, __ATOMIC_ACQUIRE) < nsec + 1 &&
+         spin < 2000000000u; spin++) {
+    }
+    if (__atomic_load_n(&finished, __ATOMIC_ACQUIRE) != nsec + 1) {
+        ml_printf("FAIL: not all vCPUs finished\n");
+        return 1;
+    }
+    for (int cpu = 0; cpu <= (int)nsec; cpu++) {
+        if (irqs[cpu][0] != ROUNDS / 2 || spurious[cpu][0] || fails[cpu][0] ||
+            timeouts[cpu][0]) {
+            ml_printf("FAIL: cpu %d irqs %d spurious %d fails %d timeouts %d\n",
+                      cpu, (int)irqs[cpu][0], (int)spurious[cpu][0],
+                      (int)fails[cpu][0], (int)timeouts[cpu][0]);
+            bad = 1;
+        }
+    }
+    if (bad) {
+        return 1;
+    }
+    ml_printf("OK\n");
+    return 0;
+}
