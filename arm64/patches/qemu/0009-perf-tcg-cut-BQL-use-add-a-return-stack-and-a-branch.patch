+#ifndef QEMU_P35_STATS_H
+#define QEMU_P35_STATS_H
+
+#include "qemu/compiler.h"
+
+typedef enum {
+    P35_MMIO_RD,
+    P35_MMIO_WR,
+    P35_TIMER_MOD,
+    P35_TIMER_REARM,
+    P35_TIMER_DEL,
+    P35_EVENTFD,
+    P35_BQL_LOCK,
+    P35_BQL_CONT,
+    P35_BQL_WAIT_NS,
+    P35_EXEC_RET,
+    P35_HALT_WAIT,
+    P35_KICK,
+    P35_TB_GEN,
+    P35_TB_GEN_CYC,
+    P35_CODE_PAGE,
+    P35_IC_IVAU,
+    P35_IC_ALL,
+    P35_REFILL,
+    P35_REFILL_COLD,
+    P35_REFILL_INV,
+    P35_REFILL_WARM,
+    P35_REFILL_OTHER,
+    P35_FILL_N,
+    P35_FILL_CYC,
+    P35_SETPAGE_CYC,
+    P35_TLBI_IS,
+    P35_TLBI_LOCAL,
+    P35_TLBI_VA,
+    P35_TLBI_VAA,
+    P35_TLBI_ASID,
+    P35_TLBI_ALL,
+    P35_TLBI_RANGE,
+    P35_TLBI_BIGRANGE,
+    P35_ASID_SW,
+    P35_BQL_INT_TAKE,   /* cpu_handle_interrupt took the BQL */
+    P35_BQL_INT_NOOP,   /* ... and cpu_exec_interrupt did nothing */
+    P35_BQL_ERET,       /* ERET hook calls that took the BQL */
+    P35_BQL_CPREG,      /* cp_reg helper calls that took the BQL */
+    P35_EXTRA0,         /* arm: loads by EL0..EL3 at P35_EXTRA0 + el */
+    P35_NCOUNTERS = P35_EXTRA0 + 8
+} P35Counter;
+
+#define P35_NSLOTS 17   /* vCPUs 0..15, slot 16: every other thread */
+#define P35_ASID_GLOBAL 0xffffu
+#define P35_ASID_OTHER  0xfffeu
+
+extern bool p35_on;
+extern __thread int p35_slot;
+
+void p35_add(P35Counter c, uint64_t v);
+void p35_add_slot(int slot, P35Counter c, uint64_t v);
+
+static inline void p35_inc(P35Counter c)
+{
+    if (unlikely(p35_on)) {
+        p35_add(c, 1);
+    }
+}
+
+/* Per-region MMIO tally (name, direction). */
+void p35_mmio(const char *name, bool write);
+
+/* Shadow-tree model: what a refill would have cost an hmmu shadow. */
+void p35_refill(uint32_t asid, uint64_t vpn);
+void p35_tlbi_va(uint32_t asid, uint64_t vpn, bool all_asids);
+void p35_tlbi_asid(uint32_t asid);
+void p35_tlbi_all(void);
+
+/* Target hook: fill out[8] with the per-slot target counters. */
+extern void (*p35_extra_hook)(int slot, uint64_t out[8]);
+/* Target hook: ASID (or P35_ASID_GLOBAL / P35_ASID_OTHER) of a refill. */
+extern uint32_t (*p35_asid_hook)(void *cpu, int mmu_idx, uint64_t addr,
+                                 bool global);
