diff --git a/util/p35-stats.c b/util/p35-stats.c
new file mode 100644
index 0000000000..3b9db3374c
--- /dev/null
+++ b/util/p35-stats.c
@@ -0,0 +1,233 @@
+/*
+ * Phase 0 counters for the hmmu study (p35/p36).
+ *
+ * Per-vCPU event counters dumped once a second to the CSV file named by
+ * P35_STATS, plus a model of a per-(ASID, page) shadow table that tells
+ * how many TLB refills would have been first touches for a host-MMU
+ * (hmmu) design.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/atomic.h"
+#include "qemu/thread.h"
+#include "qemu/timer.h"
+#include "qemu/p35-stats.h"
+
+bool p35_on;
+__thread int p35_slot = P35_NSLOTS - 1;
+void (*p35_extra_hook)(int slot, uint64_t out[8]);
+uint32_t (*p35_asid_hook)(void *cpu, int mmu_idx, uint64_t addr, bool global);
+
+static uint64_t counters[P35_NSLOTS][P35_NCOUNTERS];
+static FILE *p35_file;
+
+#define MMIO_MAX 128
+static struct {
+    const char *name;
+    uint64_t rd, wr;
+} mmio_tab[MMIO_MAX];
+static int mmio_n;
+static QemuMutex mmio_lock;
+
+/* shadow model */
+#define SH_BITS 20
+#define SH_MASK ((1u << SH_BITS) - 1)
+#define SH_PROBE 8
+typedef struct {
+    uint64_t key;
+    uint32_t gall, gasid, gva, gvaa;
+} ShEnt;
+static ShEnt *sh_tab[P35_NSLOTS];
+static uint32_t gen_all;
+static uint32_t gen_asid[65536];
+static uint32_t gen_va[1u << SH_BITS];
+static uint32_t gen_vaa[1u << SH_BITS];
+static uint8_t asid_seen[65536];
+
+void p35_add_slot(int slot, P35Counter c, uint64_t v)
+{
+    qatomic_add(&counters[slot][c], v);
+}
+
+void p35_add(P35Counter c, uint64_t v)
+{
+    qatomic_add(&counters[p35_slot][c], v);
+}
+
+void p35_mmio(const char *name, bool write)
+{
+    int i;
+
+    if (!p35_on) {
+        return;
+    }
+    for (;;) {
+        int n = qatomic_read(&mmio_n);
+        for (i = 0; i < n; i++) {
+            if (mmio_tab[i].name == name) {
+                qatomic_inc(write ? &mmio_tab[i].wr : &mmio_tab[i].rd);
+                return;
+            }
+        }
+        qemu_mutex_lock(&mmio_lock);
+        if (qatomic_read(&mmio_n) == n && n < MMIO_MAX) {
+            mmio_tab[n].name = name;
+            qatomic_set(&mmio_n, n + 1);
+        } else if (n >= MMIO_MAX) {
+            qemu_mutex_unlock(&mmio_lock);
+            return;
+        }
+        qemu_mutex_unlock(&mmio_lock);
+    }
+}
+
+static inline uint32_t hash2(uint64_t a, uint64_t b)
+{
+    uint64_t h = (a * 0x9e3779b97f4a7c15ull) ^ (b * 0xc2b2ae3d27d4eb4full);
+    h ^= h >> 29;
+    h *= 0xbf58476d1ce4e5b9ull;
+    h ^= h >> 32;
+    return h & SH_MASK;
+}
+
+void p35_refill(uint32_t asid, uint64_t vpn)
+{
+    int slot = p35_slot;
+    uint64_t key;
+    uint32_t h, i, ga, gs, gv, gp;
+    ShEnt *t = sh_tab[slot], *e, *victim = NULL;
+
+    if (!p35_on || !t) {
+        return;
+    }
+    p35_add(P35_REFILL, 1);
+    if (asid == P35_ASID_OTHER) {
+        p35_add(P35_REFILL_OTHER, 1);
+        return;
+    }
+    key = (1ull << 63) | ((uint64_t)asid << 40) | (vpn & 0xffffffffffull);
+    h = hash2(asid, vpn);
+    ga = qatomic_read(&gen_all);
+    gs = qatomic_read(&gen_asid[asid]);
+    gv = qatomic_read(&gen_va[h]);
+    gp = qatomic_read(&gen_vaa[hash2(0, vpn)]);
+    if (!asid_seen[asid]) {
+        asid_seen[asid] = 1;
+    }
+    for (i = 0; i < SH_PROBE; i++) {
+        e = &t[(h + i) & SH_MASK];
+        if (e->key == key) {
+            if (e->gall == ga && e->gasid == gs && e->gva == gv &&
+                e->gvaa == gp) {
+                p35_add(P35_REFILL_WARM, 1);
+            } else {
+                p35_add(P35_REFILL_INV, 1);
+                e->gall = ga; e->gasid = gs; e->gva = gv; e->gvaa = gp;
+            }
+            return;
+        }
+        if (!e->key) {
+            victim = e;
+            break;
+        }
+        if (!victim) {
+            victim = e;
+        }
+    }
+    victim->key = key;
+    victim->gall = ga;
+    victim->gasid = gs;
+    victim->gva = gv;
+    victim->gvaa = gp;
+    p35_add(P35_REFILL_COLD, 1);
+}
+
+void p35_tlbi_va(uint32_t asid, uint64_t vpn, bool all_asids)
+{
+    if (!p35_on) {
+        return;
+    }
+    if (all_asids) {
+        qatomic_inc(&gen_vaa[hash2(0, vpn)]);
+    } else {
+        qatomic_inc(&gen_va[hash2(asid, vpn)]);
+        qatomic_inc(&gen_va[hash2(P35_ASID_GLOBAL, vpn)]);
+    }
+}
+
+void p35_tlbi_asid(uint32_t asid)
+{
+    if (p35_on) {
+        qatomic_inc(&gen_asid[asid & 0xffff]);
+    }
+}
+
+void p35_tlbi_all(void)
+{
+    if (p35_on) {
+        qatomic_inc(&gen_all);
+    }
+}
+
+static void *p35_dump_thread(void *opaque)
+{
+    uint64_t t0 = get_clock_realtime();
+    int i, c, n;
+
+    fprintf(p35_file, "t_ns,tsc,slot");
+    for (c = 0; c < P35_NCOUNTERS; c++) {
+        fprintf(p35_file, ",c%d", c);
+    }
+    fprintf(p35_file, "\n");
+    for (;;) {
+        g_usleep(1000000);
+        uint64_t now = get_clock_realtime() - t0;
+        uint64_t tsc = cpu_get_host_ticks();
+        for (i = 0; i < P35_NSLOTS; i++) {
+            uint64_t ex[8] = { 0 };
+            if (p35_extra_hook) {
+                p35_extra_hook(i, ex);
+            }
+            fprintf(p35_file, "%" PRIu64 ",%" PRIu64 ",%d", now, tsc, i);
+            for (c = 0; c < P35_EXTRA0; c++) {
+                fprintf(p35_file, ",%" PRIu64, qatomic_read(&counters[i][c]));
+            }
+            for (c = 0; c < 8; c++) {
+                fprintf(p35_file, ",%" PRIu64, ex[c]);
+            }
+            fprintf(p35_file, "\n");
+        }
+        n = qatomic_read(&mmio_n);
+        for (i = 0; i < n; i++) {
+            fprintf(p35_file, "%" PRIu64 ",%" PRIu64 ",mmio:%s,%" PRIu64
+                    ",%" PRIu64 "\n", now, tsc, mmio_tab[i].name,
+                    qatomic_read(&mmio_tab[i].rd),
+                    qatomic_read(&mmio_tab[i].wr));
+        }
+        fflush(p35_file);
+    }
+    return NULL;
+}
+
+static void __attribute__((constructor)) p35_init(void)
+{
+    const char *path = getenv("P35_STATS");
+    QemuThread th;
+    int i;
+
+    if (!path || !*path) {
+        return;
+    }
+    p35_file = fopen(path, "w");
+    if (!p35_file) {
+        return;
+    }
+    qemu_mutex_init(&mmio_lock);
+    for (i = 0; i < P35_NSLOTS; i++) {
+        sh_tab[i] = g_malloc0((size_t)(SH_MASK + 1 + SH_PROBE) * sizeof(ShEnt));
+    }
+    p35_on = true;
+    qemu_thread_create(&th, "p35-stats", p35_dump_thread, NULL,
+                       QEMU_THREAD_DETACHED);
+}
