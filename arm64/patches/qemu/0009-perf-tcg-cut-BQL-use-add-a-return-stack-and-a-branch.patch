 /* Return the current PC from CPU, which may be cached in TB. */
 static vaddr log_pc(CPUState *cpu, const TranslationBlock *tb)
 {
@@ -785,6 +875,37 @@ static inline bool icount_exit_request(CPUState *cpu)
     return cpu->neg.icount_decr.u16.low + cpu->icount_extra == 0;
 }
 
+/*
+ * Return true if the pending interrupt_request bits are all ones that
+ * cpu_exec_interrupt would leave alone (for example an IRQ the guest has
+ * masked), so that cpu_handle_interrupt need not take the BQL for them.  A
+ * newly raised or unmasked interrupt kicks the vCPU or ends the TB, so it
+ * is seen on the next pass.
+ */
+static inline bool cpu_interrupt_is_inert(CPUState *cpu)
+{
+#ifndef CONFIG_USER_ONLY
+    const TCGCPUOps *tcg_ops = cpu->cc->tcg_ops;
+    int interrupt_request;
+
+    if (!tcg_ops->cpu_exec_interrupt_pending ||
+        replay_mode != REPLAY_MODE_NONE) {
+        return false;
+    }
+    interrupt_request = qatomic_load_acquire(&cpu->interrupt_request);
+    if (interrupt_request & (CPU_INTERRUPT_DEBUG | CPU_INTERRUPT_HALT |
+                             CPU_INTERRUPT_RESET)) {
+        return false;
+    }
+    if (unlikely(cpu->singlestep_flags & SSTEP_NOIRQ)) {
+        interrupt_request &= ~CPU_INTERRUPT_SSTEP_MASK;
+    }
+    return !tcg_ops->cpu_exec_interrupt_pending(cpu, interrupt_request);
+#else
+    return false;
+#endif
+}
