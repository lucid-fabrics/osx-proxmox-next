diff --git a/target/arm/tcg/pauth_helper.c b/target/arm/tcg/pauth_helper.c
index 23d47b9adc..0b532095b2 100644
--- a/target/arm/tcg/pauth_helper.c
+++ b/target/arm/tcg/pauth_helper.c
@@ -458,6 +458,58 @@ static uint64_t pauth_addpac(CPUARMState *env, uint64_t ptr, uint64_t modifier,
     return pac | ext | ptr;
 }
 
+/*
+ * Refill env->pac_cache for the current TCR_EL1, with the same expressions
+ * pauth_addpac() and pauth_original_ptr() evaluate per pointer. Only used by
+ * the translated inline form of the vmapple compat PAC, which is restricted
+ * to EL0 and EL1 without EL2 and EL3, so the
+ * regime is EL1&0, and to PauthFeat_1 or PauthFeat_2 and later (EPAC
+ * zeroes the PAC for a bad extension and is left to the C code).
+ */
+void HELPER(pauth_refill)(CPUARMState *env)
+{
+    ARMMMUIdx mmu_idx = arm_stage1_mmu_idx(env);
+
+    for (int data = 0; data < 2; data++) {
+        for (int sel = 0; sel < 2; sel++) {
+            ARMVAParameters param =
+                aa64_va_parameters(env, (uint64_t)sel << 55, mmu_idx, data,
+                                   false);
+            uint64_t mask = pauth_ptr_mask(param);
+            int bot_bit = 64 - param.tsz;
+            int top_bit = 64 - 8 * (param.tbi || param.mtx);
+            uint64_t extm = MAKE_64BIT_MASK(bot_bit, top_bit - bot_bit);
+            uint64_t keepm, pacm;
+            typeof(env->pac_cache.e[0][0]) *e = &env->pac_cache.e[data][sel];
+
+            if (param.mtx && !param.tbi) {
+                extm |= MAKE_64BIT_MASK(60, 4);
+            }
+            if (param.tbi) {
+                keepm = ~MAKE_64BIT_MASK(bot_bit, 55 - bot_bit + 1);
+                pacm = MAKE_64BIT_MASK(bot_bit, 54 - bot_bit + 1);
+            } else if (param.mtx) {
+                keepm = ~(MAKE_64BIT_MASK(60, 4) |
+                          MAKE_64BIT_MASK(bot_bit, 55 - bot_bit + 1));
+                pacm = MAKE_64BIT_MASK(60, 4) |
+                       MAKE_64BIT_MASK(bot_bit, 54 - bot_bit + 1);
+            } else {
+                keepm = MAKE_64BIT_MASK(0, bot_bit);
+                pacm = ~(MAKE_64BIT_MASK(55, 1) | MAKE_64BIT_MASK(0, bot_bit));
+            }
+            e->andm = sel ? ~0ull : ~mask;
+            e->orm = sel ? mask : 0;
+            e->extm = extm;
+            e->keepm = keepm;
