+/* &env->cpu.ras[ras_top & 15], as an offset from env in @ent */
+static void gen_ras_entry(TCGv_ptr ent, TCGv_i32 top)
+{
+    TCGv_i64 idx = tcg_temp_new_i64();
+
+    QEMU_BUILD_BUG_ON(sizeof_field(CPUState, ras[0]) != 16);
+    QEMU_BUILD_BUG_ON(ARRAY_SIZE(((CPUState *)0)->ras) != 16);
+    tcg_gen_extu_i32_i64(idx, top);
+    tcg_gen_andi_i64(idx, idx, 15);
+    tcg_gen_shli_i64(idx, idx, 4);
+    tcg_gen_trunc_i64_ptr(ent, idx);
+    tcg_gen_add_ptr(ent, ent, tcg_env);
+}
+#endif
+
+void translator_gen_ras_push(DisasContextBase *db, TCGv_i64 ret_pc)
+{
+#ifndef CONFIG_USER_ONLY
+    const intptr_t cpu_off = -(intptr_t)sizeof(CPUState);
+    TCGv_i32 top = tcg_temp_new_i32();
+    TCGv_ptr ent = tcg_temp_new_ptr();
+
+    tcg_gen_ld_i32(top, tcg_env, offsetof(CPUState, ras_top) + cpu_off);
+    gen_ras_entry(ent, top);
+    tcg_gen_st_i64(ret_pc, ent, offsetof(CPUState, ras[0].pc) + cpu_off);
+    tcg_gen_st_ptr(tcg_constant_ptr(db->tb), ent,
+                   offsetof(CPUState, ras[0].tb) + cpu_off);
+    tcg_gen_addi_i32(top, top, 1);
+    tcg_gen_st_i32(top, tcg_env, offsetof(CPUState, ras_top) + cpu_off);
+#endif
+}
+
+void translator_gen_ras_ret(DisasContextBase *db, TCGv_i64 pc,
+                            TCGv_i32 flags, TCGv_i64 cs_base, TCGLabel *miss)
+{
+#ifndef CONFIG_USER_ONLY
+    const intptr_t cpu_off = -(intptr_t)sizeof(CPUState);
+    TCGLabel *fill = gen_new_label();
+    TCGv_i32 top = tcg_temp_new_i32();
+    TCGv_i32 t32 = tcg_temp_new_i32();
+    TCGv_i32 cf = tcg_temp_new_i32();
+    TCGv_i64 tmp = tcg_temp_new_i64();
+    TCGv_ptr ent = tcg_temp_new_ptr();
+    TCGv_ptr call = tcg_temp_new_ptr();
+    TCGv_ptr dest = tcg_temp_new_ptr();
+
+    QEMU_BUILD_BUG_ON(sizeof_field(CPUState, tcg_cflags) != 4);
+
+    /* A breakpoint or a gdb single step needs the full tb_lookup path. */
+    tcg_gen_ld_ptr(dest, tcg_env,
+                   offsetof(CPUState, breakpoints.tqh_first) + cpu_off);
+    tcg_gen_brcondi_ptr(TCG_COND_NE, dest, 0, miss);
+    tcg_gen_ld_i32(t32, tcg_env,
+                   offsetof(CPUState, singlestep_flags) + cpu_off);
+    tcg_gen_brcondi_i32(TCG_COND_NE, t32, 0, miss);
+
+    /* Pop. */
+    tcg_gen_ld_i32(top, tcg_env, offsetof(CPUState, ras_top) + cpu_off);
+    tcg_gen_brcondi_i32(TCG_COND_EQ, top, 0, miss);
+    tcg_gen_subi_i32(top, top, 1);
+    tcg_gen_st_i32(top, tcg_env, offsetof(CPUState, ras_top) + cpu_off);
+    gen_ras_entry(ent, top);
+    tcg_gen_ld_i64(tmp, ent, offsetof(CPUState, ras[0].pc) + cpu_off);
+    tcg_gen_brcond_i64(TCG_COND_NE, tmp, pc, miss);
+    tcg_gen_ld_ptr(call, ent, offsetof(CPUState, ras[0].tb) + cpu_off);
+
+    /* The TB this call returned to last time, if it is still the one. */
+    tcg_gen_ld_ptr(dest, call, offsetof(TranslationBlock, ret_dest));
+    tcg_gen_brcondi_ptr(TCG_COND_EQ, dest, 0, fill);
+    tcg_gen_ld_i64(tmp, dest, offsetof(TranslationBlock, cs_base));
+    tcg_gen_brcond_i64(TCG_COND_NE, tmp, cs_base, fill);
+    tcg_gen_ld_i32(t32, dest, offsetof(TranslationBlock, flags));
+    tcg_gen_brcond_i32(TCG_COND_NE, t32, flags, fill);
+    tcg_gen_ld_i32(t32, dest, offsetof(TranslationBlock, cflags));
+    tcg_gen_ld_i32(cf, tcg_env, offsetof(CPUState, tcg_cflags) + cpu_off);
+    tcg_gen_brcond_i32(TCG_COND_NE, t32, cf, fill);
+    tcg_gen_ld_ptr(dest, dest, offsetof(TranslationBlock, tc.ptr));
+    tcg_gen_goto_ptr(dest);
+
+    gen_set_label(fill);
+    tcg_gen_ras_fill_and_goto_ptr(call);
+#endif
+}
+
+void translator_gen_bp_checks(DisasContextBase *db, TCGLabel *miss)
+{
+#ifndef CONFIG_USER_ONLY
+    const intptr_t cpu_off = -(intptr_t)sizeof(CPUState);
+    TCGv_ptr bp = tcg_temp_new_ptr();
+    TCGv_i32 t32 = tcg_temp_new_i32();
+
+    QEMU_BUILD_BUG_ON(sizeof_field(CPUState, singlestep_flags) != 4);
+    tcg_gen_ld_ptr(bp, tcg_env,
+                   offsetof(CPUState, breakpoints.tqh_first) + cpu_off);
+    tcg_gen_brcondi_ptr(TCG_COND_NE, bp, 0, miss);
+    tcg_gen_ld_i32(t32, tcg_env,
+                   offsetof(CPUState, singlestep_flags) + cpu_off);
+    tcg_gen_brcondi_i32(TCG_COND_NE, t32, 0, miss);
+#endif
+}
