+/*
+ * Lab counters, built in only with P26_STATS defined in cpu.h: indirect
+ * block exits by kind (other, BR, BLR, RET, direct branch off the chaining
+ * path) and how many of them missed the inline jump cache probe. Printed on
+ * exit. Never called in a normal build.
+ */
+#ifdef P26_STATS
+static uint64_t lookup_cnt[8][2];
+static int lookup_atexit;
+
+static void lookup_stat_dump(void)
+{
+    static const char *const names[] = {
+        "other", "br", "blr", "ret", "goto"
+    };
+
+    for (int k = 0; k < 5; k++) {
+        fprintf(stderr, "LOOKSTAT %-6s exits %" PRIu64 " jc_miss %" PRIu64 "\n",
+                names[k], qatomic_read(&lookup_cnt[k][0]),
+                qatomic_read(&lookup_cnt[k][1]));
+    }
+}
+#endif
+
+void HELPER(lookup_stat)(uint32_t kind, uint32_t miss)
+{
+#ifdef P26_STATS
+    if (!qatomic_read(&lookup_atexit) &&
+        !qatomic_cmpxchg(&lookup_atexit, 0, 1)) {
+        atexit(lookup_stat_dump);
+    }
+    qatomic_inc(&lookup_cnt[kind & 7][miss & 1]);
+#endif
+}
