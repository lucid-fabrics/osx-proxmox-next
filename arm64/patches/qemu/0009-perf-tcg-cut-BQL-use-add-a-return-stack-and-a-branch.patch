+/*
+ * Acquire and release.
+ *
+ * A release store needs the accesses before it ordered before it, an
+ * acquire load needs the accesses after it ordered after it: with the
+ * barrier masks spelled out, a TSO host (x86) emits nothing for either.
+ * What Arm adds is that a release store is also ordered before a later
+ * RCsc acquire load (STLR; LDAR, LDAXR), which is a store to load order:
+ * QEMU's mapping (a full barrier before the store and after the load)
+ * leaves nothing between the two, and an x86 store buffer lets the load
+ * pass the store (tests/tcg/aarch64/system/stlr-ldar.c sees both loads of a
+ * store buffering pair read 0).  A store-load barrier between the two
+ * closes it.  P26_FENCE selects where it goes:
+ *   0  none: QEMU's original mapping, which lets STLR; LDAR reorder;
+ *   1  after each plain release store;
+ *   2  before each RCsc acquire load;
+ *   3  (default) before an RCsc acquire load, only if a release store ran
+ *      since the last such barrier: a release store sets env->a64_relpend
+ *      (a plain store) and the acquire load that finds it set executes the
+ *      barrier and clears it.  A release store that no acquire load follows
+ *      costs a store to env instead of a locked instruction.
+ * The x86 alternative, XCHG for the store, is the same locked operation as
+ * the barrier already emitted ("lock or" on the stack, cheaper than MFENCE:
+ * 14 ns for MFENCE against 2 ns on a Zen 3), so it gains nothing.
+ *
+ * A store-exclusive is a host atomic, a full barrier on x86 and with LSE;
+ * on a host that builds it from load-linked and store-conditional it is
+ * not, so there the barrier follows it too (only x86 hosts are tested).
+ * Release flavours of the AArch64 atomics, and AArch32 STL and LDA, keep
+ * QEMU's mapping.
+ */
+static int a64_fence_mode(void)
+{
+    static int mode = -1;
+
+    if (unlikely(mode < 0)) {
+        const char *e = getenv("P26_FENCE");
+
+        mode = e && *e ? atoi(e) : 3;
+        if (mode < 0 || mode > 3) {
+            mode = 3;
+        }
+    }
+    return mode;
+}
+
+static void gen_release_before(void)
+{
+    if (a64_fence_mode() == 0) {
+        tcg_gen_mb(TCG_MO_ALL | TCG_BAR_STRL);
+        return;
+    }
+    tcg_gen_mb(TCG_MO_LD_ST | TCG_MO_ST_ST | TCG_BAR_STRL);
+}
+
+static void gen_release_after(void)
+{
+    int mode = a64_fence_mode();
+
+    if (mode == 1) {
+        tcg_gen_mb(TCG_MO_ST_LD | TCG_BAR_SC);
+    } else if (mode == 3) {
+        tcg_gen_st_i32(tcg_constant_i32(1), tcg_env,
+                       offsetof(CPUARMState, a64_relpend));
+    }
+}
+
+static void gen_acquire_before(void)
+{
+    int mode = a64_fence_mode();
+
+    if (mode == 2) {
+        tcg_gen_mb(TCG_MO_ST_LD | TCG_BAR_SC);
+    } else if (mode == 3) {
+        TCGv_i32 pend = tcg_temp_new_i32();
+        TCGLabel *none = gen_new_label();
+
+        tcg_gen_ld_i32(pend, tcg_env, offsetof(CPUARMState, a64_relpend));
+        tcg_gen_brcondi_i32(TCG_COND_EQ, pend, 0, none);
+        tcg_gen_mb(TCG_MO_ST_LD | TCG_BAR_SC);
+        tcg_gen_st_i32(tcg_constant_i32(0), tcg_env,
+                       offsetof(CPUARMState, a64_relpend));
+        gen_set_label(none);
+    }
+}
+
+static void gen_acquire_after(void)
+{
+    if (a64_fence_mode() == 0) {
+        tcg_gen_mb(TCG_MO_ALL | TCG_BAR_LDAQ);
+        return;
+    }
+    tcg_gen_mb(TCG_MO_LD_LD | TCG_MO_LD_ST | TCG_BAR_LDAQ);
+}
