+/*
+ * Make sure the softmmu TLB of @cpu, in its current code MMU index, holds a
+ * plain code entry for @addr's page, as a fetch would have left it (no fault
+ * is raised: a page that cannot be executed is left alone). A TB lookup that
+ * hits the jump cache does not fill it, and the indirect branch cache
+ * (translate-a64.c gen_ibc) checks it.
+ */
+void tlb_fill_code(CPUState *cpu, vaddr addr)
+{
+    int mmu_idx = cpu_mmu_index(cpu, true);
+    CPUTLBEntry *entry = tlb_entry(cpu, mmu_idx, addr);
+    CPUTLBEntryFull *full;
+    void *host;
+
+    if (likely(tlb_read_idx(entry, MMU_INST_FETCH) ==
+               (addr & TARGET_PAGE_MASK))) {
+        return;
+    }
+    (void)probe_access_internal(cpu, addr, 0, MMU_INST_FETCH, mmu_idx, true,
+                                &host, &full, 0, false);
+}
