+/**
+ * helper_ras_fill: lookup_tb_ptr for a return the return address stack
+ * could not resolve by itself
+ * @env: current cpu state
+ * @call: the TB of the call this return matched
+ *
+ * The state is that of a return to the return address of @call. Look the
+ * target up as helper_lookup_tb_ptr() does and, when it is a TB of a single
+ * page (so its validity does not depend on a second mapping that a flush
+ * of the return address stack would not see), remember it in @call.
+ */
+const void *HELPER(ras_fill)(CPUArchState *env, void *call)
+{
+    CPUState *cpu = env_cpu(env);
+    TranslationBlock *tb;
+
+    cpu->neg.can_do_io = true;
+
+    TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+    s.cflags = curr_cflags(cpu);
+
+    if (check_for_breakpoints(cpu, s.pc, &s.cflags)) {
+        cpu_loop_exit(cpu);
+    }
+
+    tb = tb_lookup(cpu, s);
+    if (tb == NULL) {
+        return tcg_code_gen_epilogue;
+    }
+    /*
+     * Single page, on the page of the call, so that the entry stays valid
+     * for every vCPU whatever regime it runs the call in.
+     */
+    if (tb_page_addr1(tb) == -1 && !(tb_cflags(tb) & CF_INVALID) &&
+        !((tb_page_addr0(tb) ^ tb_page_addr0((TranslationBlock *)call))
+          & TARGET_PAGE_MASK)) {
+        qatomic_set(&((TranslationBlock *)call)->ret_dest, tb);
+    }
+
+    if (qemu_loglevel_mask(CPU_LOG_TB_CPU | CPU_LOG_EXEC)) {
+        log_cpu_exec(s.pc, cpu, tb);
+    }
+
+    return tb->tc.ptr;
+}
+
+/**
+ * helper_ibc_miss: lookup_tb_ptr for an indirect branch whose site cache did
+ * not pass the inline check
+ * @env: current cpu state
+ * @slot: the site's cache (TranslationBlock.ibr_tb of the branching TB)
+ *
+ * Look the target up and, when it is a TB of a single page, make it the
+ * site's and leave the target's code entry in the softmmu TLB, which the
+ * inline check reads. The check validates the TB by itself at every use (the
+ * target's code translates to the TB's own host address, the keys are equal,
+ * the TB is not invalid), so a stale or racing slot only misses.
+ */
+const void *HELPER(ibc_miss)(CPUArchState *env, void *slot)
+{
+    CPUState *cpu = env_cpu(env);
+    TranslationBlock *tb;
+
+    cpu->neg.can_do_io = true;
+
+    TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+    s.cflags = curr_cflags(cpu);
+
+    if (check_for_breakpoints(cpu, s.pc, &s.cflags)) {
+        cpu_loop_exit(cpu);
+    }
+
+    tb = tb_lookup(cpu, s);
+    if (tb == NULL) {
+        return tcg_code_gen_epilogue;
+    }
+    if (tb->host && !(tb_cflags(tb) & CF_INVALID)) {
+        tlb_fill_code(cpu, s.pc);
+        qatomic_store_release((TranslationBlock **)slot, tb);
+    }
+
+    if (qemu_loglevel_mask(CPU_LOG_TB_CPU | CPU_LOG_EXEC)) {
+        log_cpu_exec(s.pc, cpu, tb);
+    }
+
+    return tb->tc.ptr;
+}
