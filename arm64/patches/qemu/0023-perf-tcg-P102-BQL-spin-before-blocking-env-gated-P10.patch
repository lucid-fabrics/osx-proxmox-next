From 0b43992505fefd8c4b34e45ca2e46faae4f9268c Mon Sep 17 00:00:00 2001
From: wmehanna <wassimmehanna@gmail.com>
Date: Fri, 20 Nov 2026 08:38:33 -0500
Subject: [PATCH] perf(tcg): P102 BQL spin before blocking, env gated
 (P102_BQLSPIN)

---
 system/cpus.c | 66 ++++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 65 insertions(+), 1 deletion(-)

diff --git a/system/cpus.c b/system/cpus.c
index 18b04b5a2a..d477636836 100644
--- a/system/cpus.c
+++ b/system/cpus.c
@@ -37,6 +37,7 @@
 #include "system/hw_accel.h"
 #include "exec/cpu-common.h"
 #include "qemu/thread.h"
+#include "qemu/processor.h"
 #include "qemu/main-loop.h"
 #include "qemu/plugin.h"
 #include "system/cpus.h"
@@ -574,6 +575,67 @@ void rust_bql_mock_lock(void)
     abort();
 }
 
+/*
+ * P102_BQLSPIN=US: a contended bql_lock polls (look, then trylock) for up to
+ * US microseconds before it blocks in the kernel. Waking a sleeping waiter
+ * through futex inside a nested KVM guest costs about 12 us while the holder
+ * keeps the lock for about 1 us. Off (0) by default.
+ */
+static int64_t p102_bqlspin_ns;
+static uint64_t p102_bql_cont, p102_bql_hit;
+
+static int64_t p102_now_ns(void)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+static void p102_bql_report(void)
+{
+    fprintf(stderr, "P102: bqlspin %" PRId64 " us contended %" PRIu64
+            " spin hits %" PRIu64 "\n", p102_bqlspin_ns / 1000,
+            qatomic_read(&p102_bql_cont), qatomic_read(&p102_bql_hit));
+}
+
+static void __attribute__((constructor)) p102_init(void)
+{
+    const char *q = getenv("P102_BQLSPIN");
+
+    if (q && *q) {
+        p102_bqlspin_ns = MAX(0, atoll(q)) * 1000;
+    }
+    if (p102_bqlspin_ns) {
+        fprintf(stderr, "P102: bqlspin %" PRId64 " us\n",
+                p102_bqlspin_ns / 1000);
+        atexit(p102_bql_report);
+    }
+}
+
+static void p102_bql_lock(QemuMutexLockFunc fn, const char *file, int line)
+{
+    int64_t end;
+
+    if (!qemu_mutex_trylock(&bql)) {
+        return;
+    }
+    end = p102_now_ns() + p102_bqlspin_ns;
+    qatomic_inc(&p102_bql_cont);
+    do {
+        for (int i = 0; i < 8; i++) {
+            cpu_relax();
+        }
+        /* look before trying: no cache line ping-pong while it is held */
+        if (!qatomic_read(&bql.lock.__data.__lock) &&
+            !qemu_mutex_trylock(&bql)) {
+            qatomic_inc(&p102_bql_hit);
+            return;
+        }
+    } while (p102_now_ns() < end);
+    fn(&bql, file, line);
+}
+
 /*
  * The BQL is taken from so many places that it is worth profiling the
  * callers directly, instead of funneling them all through a single function.
@@ -590,7 +652,9 @@ void bql_lock_impl(const char *file, int line)
         p80o = qatomic_read(&p80c->p80_state);
         qatomic_set(&p80c->p80_state, P80_ST_BQL);
     }
-    if (unlikely(p35_on)) {
+    if (unlikely(p102_bqlspin_ns)) {
+        p102_bql_lock(bql_lock_fn, file, line);
+    } else if (unlikely(p35_on)) {
         p35_add(P35_BQL_LOCK, 1);
         if (qemu_mutex_trylock(&bql)) {
             int64_t t0 = get_clock();
