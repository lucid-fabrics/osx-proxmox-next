+#include "migration/vmstate.h"
 #include "target/arm/gtimer.h"
 #include "target/arm/cpu.h"
 #include "target/arm/cpu-features.h"
@@ -97,6 +99,13 @@ struct VMAppleMachineState {
     CPUBreakpoint *handoff_bp;
     bool handoff_stepping;
     VMChangeStateEntry *handoff_vmsh;
+    /* guest clock catch-up after a load, see vmapple_clock_state() */
+    bool sync_clock;
+    bool clock_loaded;
+    int64_t saved_wall_ns;
+    /* host time of the last stop, 0 while running (not migrated) */
+    int64_t stop_wall_ns;
+    VMChangeStateEntry *clock_vmsh;
 };
 
 #define TYPE_VMAPPLE_MACHINE   MACHINE_TYPE_NAME("vmapple")
@@ -624,6 +633,80 @@ static void vmapple_tcg_smp_shift(void *opaque)
     }
 }
 
+/*
+ * The guest keeps its wall time as a base plus the counter, and the counter
+ * stops while the machine is saved. The host wall time at the save goes into
+ * the stream, and the first time the machine runs after a load the VM clock
+ * is moved forward by the time elapsed since, so `date` is right at once.
+ */
+static int vmapple_clock_pre_save(void *opaque)
+{
+    VMAppleMachineState *vms = opaque;
+
+    /*
+     * The guest's clock stopped when the VM did, not when the device state is
+     * written: with a mapped-ram save the RAM goes out first (about 7 s for
+     * 8 GiB), and counting from here left the guest that much behind.
+     */
+    if (!runstate_is_running() && vms->stop_wall_ns > 0) {
+        vms->saved_wall_ns = vms->stop_wall_ns;
+    } else {
+        vms->saved_wall_ns = qemu_clock_get_ns(QEMU_CLOCK_HOST);
+    }
+    return 0;
+}
+
+static int vmapple_clock_post_load(void *opaque, int version_id)
+{
+    VMAppleMachineState *vms = opaque;
+
+    vms->clock_loaded = true;
+    return 0;
+}
+
+static bool vmapple_clock_needed(void *opaque)
+{
+    return true;
+}
+
+static const VMStateDescription vmstate_vmapple_clock = {
+    .name = "vmapple/wallclock",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = vmapple_clock_needed,
+    .pre_save = vmapple_clock_pre_save,
+    .post_load = vmapple_clock_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_INT64(saved_wall_ns, VMAppleMachineState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void vmapple_clock_state(void *opaque, bool running, RunState state)
+{
+    VMAppleMachineState *vms = opaque;
+
+    vms->stop_wall_ns = running ? 0 : qemu_clock_get_ns(QEMU_CLOCK_HOST);
+    if (!running || !vms->clock_loaded) {
+        return;
+    }
+    vms->clock_loaded = false;
+    if (vms->sync_clock && vms->saved_wall_ns > 0 && !icount_enabled()) {
+        cpu_clock_advance(qemu_clock_get_ns(QEMU_CLOCK_HOST) -
+                          vms->saved_wall_ns);
+    }
+}
+
+static bool vmapple_get_sync_clock(Object *obj, Error **errp)
+{
+    return VMAPPLE_MACHINE(obj)->sync_clock;
+}
+
+static void vmapple_set_sync_clock(Object *obj, bool value, Error **errp)
+{
+    VMAPPLE_MACHINE(obj)->sync_clock = value;
+}
+
 static void vmapple_get_tcg_smp_final_shift(Object *obj, Visitor *v,
                                             const char *name, void *opaque,
                                             Error **errp)
@@ -1070,6 +1153,9 @@ static void mach_vmapple_init(MachineState *machine)
         vms->handoff_vmsh = qemu_add_vm_change_state_handler(
             vmapple_handoff_state, vms);
     }
+    vmstate_register_any(NULL, &vmstate_vmapple_clock, vms);
+    vms->clock_vmsh = qemu_add_vm_change_state_handler(vmapple_clock_state,
+                                                       vms);
     arm_load_kernel(ARM_CPU(first_cpu), machine, &vms->bootinfo);
 
     qemu_register_reset(vmapple_reset, vms);
@@ -1198,6 +1284,16 @@ static void vmapple_instance_init(Object *obj)
     object_property_set_description(obj, "run-installer",
                                     "Boot the installer environment");
 
+    vms->sync_clock = false;
+    object_property_add_bool(obj, "sync-clock-on-load",
+                             vmapple_get_sync_clock, vmapple_set_sync_clock);
+    object_property_set_description(obj, "sync-clock-on-load",
+                                    "After a snapshot load, move the guest "
+                                    "clock forward by the host time elapsed "
+                                    "since the save (default off: a jump of "
+                                    "an hour or more makes the guest run its "
+                                    "overdue work and delays ssh by minutes; "
+                                    "not for icount)");
     vms->xnu_handoff_pc = 0xe0a00000;
     object_property_add_bool(obj, "internal-use-only-unit",
                              vmapple_get_internal_use_only_unit,
diff --git a/include/system/cpu-timers.h b/include/system/cpu-timers.h
index a1abed0d7a..0605ad859d 100644
--- a/include/system/cpu-timers.h
+++ b/include/system/cpu-timers.h
@@ -24,6 +24,11 @@ void cpu_enable_ticks(void);
 /* Caller must hold BQL */
 void cpu_disable_ticks(void);
 
+/*
+ * Move the VM clock forward by @ns (ignored when not positive).
+ * Caller must hold BQL. Not for icount.
+ */
+void cpu_clock_advance(int64_t ns);
 /*
  * return the time elapsed in VM between vm_start and vm_stop.
  * cpu_get_ticks() uses units of the host CPU cycle counter.
diff --git a/system/cpu-timers.c b/system/cpu-timers.c
index 9919b46230..a0de483be5 100644
--- a/system/cpu-timers.c
+++ b/system/cpu-timers.c
@@ -100,6 +100,23 @@ int64_t cpu_get_clock(void)
     return ti;
 }
 
+/*
+ * Move the VM clock forward: the guest counter and every timer on
+ * QEMU_CLOCK_VIRTUAL see the jump. Caller must hold BQL.
+ */
+void cpu_clock_advance(int64_t ns)
+{
+    if (ns <= 0) {
+        return;
+    }
+    seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                       &timers_state.vm_clock_lock);
+    timers_state.cpu_clock_offset += ns;
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                         &timers_state.vm_clock_lock);
+    qemu_clock_notify(QEMU_CLOCK_VIRTUAL);
+}
+
 /*
  * enable cpu_get_ticks()
  * Caller must hold BQL which serves as mutex for vm_clock_seqlock.
diff --git a/target/arm/cpu.c b/target/arm/cpu.c
index e2605a3cc9..b56e3359cd 100644
--- a/target/arm/cpu.c
+++ b/target/arm/cpu.c
@@ -1317,6 +1317,9 @@ static void arm_cpu_initfn(Object *obj)
 static const Property arm_cpu_gt_cntfrq_property =
             DEFINE_PROP_UINT64("cntfrq", ARMCPU, gt_cntfrq_hz, 0);
 
+static const Property arm_cpu_gt_exact_property =
+            DEFINE_PROP_BOOL("x-exact-cntfrq", ARMCPU, gt_exact_cntfrq, true);
+
 static const Property arm_cpu_reset_cbar_property =
             DEFINE_PROP_UINT64("reset-cbar", ARMCPU, reset_cbar, 0);
 
@@ -1463,6 +1466,51 @@ unsigned int gt_cntfrq_period_ns(ARMCPU *cpu)
       NANOSECONDS_PER_SECOND / cpu->gt_cntfrq_hz : 1;
 }
 
+/*
+ * True if counting at exactly gt_cntfrq_hz differs from counting with the
+ * truncated gt_cntfrq_period_ns(), i.e. the frequency does not divide 1 GHz.
+ */
+bool gt_exact_matters(ARMCPU *cpu)
+{
+    return cpu->gt_cntfrq_hz &&
+           NANOSECONDS_PER_SECOND % cpu->gt_cntfrq_hz != 0;
+}
+
+/*
+ * Counter value at QEMU_CLOCK_VIRTUAL time @ns. In exact mode this is
+ * floor(ns * CNTFRQ / 1e9), so the guest sees the frequency it is told
+ * (CNTFRQ_EL0), instead of 1e9 / floor(1e9 / CNTFRQ).
+ */
+uint64_t gt_ns_to_ticks(ARMCPU *cpu, int64_t ns)
+{
+    if (cpu->gt_exact) {
+        return muldiv64(ns, cpu->gt_cntfrq_hz, NANOSECONDS_PER_SECOND);
+    }
+    return ns / gt_cntfrq_period_ns(cpu);
+}
+
+/*
+ * Earliest QEMU_CLOCK_VIRTUAL time at which gt_ns_to_ticks() reaches
+ * @ticks, or INT64_MAX if that is out of range. This is the exact inverse
+ * of gt_ns_to_ticks() (a timer set for it never fires before the counter
+ * reaches its compare value, and never later than one ns after), which is
+ * what the integer QEMUTimer scale gave the truncated period.
+ */
+int64_t gt_ticks_to_ns(ARMCPU *cpu, uint64_t ticks)
+{
+    if (!cpu->gt_exact) {
+        uint64_t period = gt_cntfrq_period_ns(cpu);
+
+        return ticks > INT64_MAX / period ? INT64_MAX : ticks * period;
+    }
+    if (ticks > muldiv64(INT64_MAX, cpu->gt_cntfrq_hz,
+                         NANOSECONDS_PER_SECOND)) {
+        return INT64_MAX;
+    }
+    return muldiv64_round_up(ticks, NANOSECONDS_PER_SECOND,
+                             cpu->gt_cntfrq_hz);
+}
+
 static void arm_cpu_propagate_feature_implications(ARMCPU *cpu)
 {
     CPUARMState *env = &cpu->env;
@@ -1704,6 +1752,7 @@ static void arm_cpu_post_init(Object *obj)
 
     if (arm_feature(&cpu->env, ARM_FEATURE_GENERIC_TIMER)) {
         qdev_property_add_static(DEVICE(cpu), &arm_cpu_gt_cntfrq_property);
+        qdev_property_add_static(DEVICE(cpu), &arm_cpu_gt_exact_property);
     }
 
     if (kvm_enabled()) {
@@ -1941,7 +1990,11 @@ static void arm_cpu_realizefn(DeviceState *dev, Error **errp)
     }
 #ifndef CONFIG_USER_ONLY
     {
-        uint64_t scale = gt_cntfrq_period_ns(cpu);
+        /* The timers count ns: gt_ticks_to_ns() converts a compare value */
+        uint64_t scale = SCALE_NS;
+
+        cpu->gt_exact = cpu->gt_exact_cntfrq &&
+                        cpu->gt_cntfrq_hz <= UINT32_MAX;
 
         cpu->gt_timer[GTIMER_PHYS] = timer_new(QEMU_CLOCK_VIRTUAL, scale,
                                                arm_gt_ptimer_cb, cpu);
