+    .name = "cpu/gt-exact",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = gt_exact_needed,
+    .post_load = gt_exact_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(gt_exact, ARMCPU),
