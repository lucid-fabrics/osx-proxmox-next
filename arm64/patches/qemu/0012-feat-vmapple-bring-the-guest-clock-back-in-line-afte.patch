diff --git a/tests/tcg/aarch64/system/cntfrq-exact.c b/tests/tcg/aarch64/system/cntfrq-exact.c
new file mode 100644
index 0000000000..a3b09d3cf1
--- /dev/null
+++ b/tests/tcg/aarch64/system/cntfrq-exact.c
@@ -0,0 +1,116 @@
+/*
+ * Generic timer at a frequency that does not divide 1 GHz.
+ *
+ * Run with -cpu max,cntfrq=24000000 and -icount shift=0 so that one
+ * instruction is one ns of QEMU_CLOCK_VIRTUAL. The counter used to be
+ * ns / floor(1e9 / CNTFRQ), a 41 ns period for 24 MHz, so it ran 1.6 %
+ * fast against the CNTFRQ_EL0 the guest reads (macOS guests drifted by
+ * a minute per hour). Checks that:
+ *  - the counter advances at CNTFRQ: a loop of a known number of
+ *    instructions (ns) moves it by ns * CNTFRQ / 1e9, within 0.1 %;
+ *  - the virtual timer never asserts before CNTVCT reaches CVAL and
+ *    fires within a few ticks after, for short and long compare values
+ *    (a timer set for a rounded-down ns would fire early or re-arm
+ *    at the same time forever).
+ *
+ * Copyright (c) 2026 Snapintosh contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include <stdint.h>
+#include <minilib.h>
+
+#define FREQ        24000000ull
+#define ITERS       25000000ull     /* 2 instructions each: 50 ms */
+
+#define SYSREG_R(name) ({ uint64_t v_; \
+    asm volatile("isb; mrs %0, " #name : "=r" (v_) :: "memory"); v_; })
+#define SYSREG_W(name, val) \
+    asm volatile("msr " #name ", %0; isb" :: "r" ((uint64_t)(val)) : "memory")
+
+uint64_t mmu_cfg[8] __attribute__((aligned(64)));
+
+static uint64_t spin(uint64_t n)
+{
+    asm volatile("1: subs %0, %0, #1\n\tb.ne 1b" : "+r" (n) :: "cc");
+    return n;
+}
+
+static int check_rate(void)
+{
+    uint64_t c0, c1, got, want, err;
+
+    /* warm up the translation so the measured loop is just the loop */
+    spin(1000);
+    c0 = SYSREG_R(cntvct_el0);
+    spin(ITERS);
+    c1 = SYSREG_R(cntvct_el0);
+    got = c1 - c0;
+    want = 2 * ITERS * FREQ / 1000000000ull;
+    err = got > want ? got - want : want - got;
+    ml_printf("counter moved %ld ticks for %ld ns, expected %ld\n",
+              (long)got, (long)(2 * ITERS), (long)want);
+    if (err * 1000 > want) {
+        ml_printf("FAIL: counter rate off by more than 0.1%%\n");
+        return 1;
+    }
+    return 0;
+}
+
+static int check_timer(uint64_t delta)
+{
+    uint64_t cval, now, late;
+    int polls = 0;
+
+    SYSREG_W(cntv_ctl_el0, 0);
+    cval = SYSREG_R(cntvct_el0) + delta;
+    SYSREG_W(cntv_cval_el0, cval);
+    SYSREG_W(cntv_ctl_el0, 1);              /* enabled, IMASK clear */
+    while (!(SYSREG_R(cntv_ctl_el0) & 4)) {
+        if (++polls > 200000000) {
+            ml_printf("FAIL: timer +%ld never fired\n", (long)delta);
+            return 1;
+        }
+    }
+    now = SYSREG_R(cntvct_el0);
+    SYSREG_W(cntv_ctl_el0, 0);
+    if (now < cval) {
+        ml_printf("FAIL: timer +%ld fired early: cnt %ld cval %ld\n",
+                  (long)delta, (long)now, (long)cval);
+        return 1;
+    }
+    late = now - cval;
+    if (late > 64) {
+        ml_printf("FAIL: timer +%ld fired %ld ticks late\n",
+                  (long)delta, (long)late);
+        return 1;
+    }
+    return 0;
+}
+
+int main(void)
+{
+    static const uint64_t deltas[] = { 1, 2, 3, 7, 24, 25, 41, 1000, 23999,
+                                       24000, 240001 };
+    uint64_t frq = SYSREG_R(cntfrq_el0);
+    int fails = 0;
+
+    asm volatile("msr daifset, #2");        /* poll ISTATUS, no IRQs */
+    ml_printf("CNTFRQ_EL0 %ld\n", (long)frq);
+    if (frq != FREQ) {
+        ml_printf("FAIL: run with -cpu max,cntfrq=%ld\n", (long)FREQ);
+        return 1;
+    }
+    fails += check_rate();
+    for (int r = 0; r < 20; r++) {
+        for (unsigned i = 0; i < sizeof(deltas) / sizeof(deltas[0]); i++) {
+            fails += check_timer(deltas[i] + r);
+        }
+    }
+    if (fails) {
+        ml_printf("FAIL: %d checks\n", fails);
+        return 1;
+    }
+    ml_printf("OK\n");
+    return 0;
+}
