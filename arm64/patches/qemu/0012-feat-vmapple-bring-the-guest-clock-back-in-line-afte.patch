 include/system/cpu-timers.h             |   5 +
 system/cpu-timers.c                     |  17 ++++
 target/arm/cpu.c                        |  55 ++++++++++-
 target/arm/cpu.h                        |  14 +++
 target/arm/helper.c                     |  13 +--
 target/arm/machine.c                    |  41 +++++++++
 tests/tcg/aarch64/system/cntfrq-exact.c | 116 ++++++++++++++++++++++++
 8 files changed, 348 insertions(+), 9 deletions(-)
 create mode 100644 tests/tcg/aarch64/system/cntfrq-exact.c

