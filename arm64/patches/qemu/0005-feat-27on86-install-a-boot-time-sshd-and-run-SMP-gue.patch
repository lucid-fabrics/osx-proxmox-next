--- /dev/null
+++ b/scripts/27on86/check-vmapple-mttcg.sh
@@ -0,0 +1,52 @@
+#!/bin/sh
+# Boot test for multi-threaded TCG on vmapple (no icount time contract).
+set -eu
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+source_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
+build_dir=${QEMU_27ON86_BUILD_DIR:-"$source_root/build"}
+qemu=${QEMU_27ON86_QEMU:-"$build_dir/qemu-system-aarch64"}
+fixture_dir=$(mktemp -d "${TMPDIR:-/tmp}/27on86-mttcg.XXXXXX")
+cleanup()
+{
+    rm -f "$fixture_dir"/*
+    rmdir "$fixture_dir"
+}
+trap cleanup EXIT HUP INT TERM
+if ! test -x "$qemu"; then
+    echo "missing emulator; run scripts/27on86/build-aarch64.sh" >&2
+    exit 1
+fi
+clang --target=aarch64-none-elf \
+    -c "$source_root/tests/27on86/vmapple-mttcg.S" \
+    -o "$fixture_dir/firmware.o"
+llvm-objcopy -O binary -j .text.boot "$fixture_dir/firmware.o" \
+    "$fixture_dir/firmware"
+truncate -s 16384 "$fixture_dir/aux"
+truncate -s 16384 "$fixture_dir/root"
+status=0
+timeout --signal=TERM 20s "$qemu" \
+    -machine vmapple,uuid=1 \
+    -cpu max \
+    -smp 4 \
+    -accel tcg,thread=multi \
+    -m 1G \
+    -nodefaults \
+    -display none \
+    -monitor none \
+    -serial stdio \
+    -no-reboot \
+    -bios "$fixture_dir/firmware" \
+    -drive file="$fixture_dir/aux",if=pflash,format=raw \
+    -drive file="$fixture_dir/root",if=pflash,format=raw \
+    >"$fixture_dir/log" 2>&1 || status=$?
+if test "$status" -ne 0 && test "$status" -ne 124; then
+    cat "$fixture_dir/log" >&2
+    echo "VMApple MTTCG test exited unexpectedly: $status" >&2
+    exit 1
+fi
+if ! grep -Fq 'VMAPPLE_MTTCG_OK' "$fixture_dir/log"; then
+    cat "$fixture_dir/log" >&2
+    echo "VMApple MTTCG test failed" >&2
+    exit 1
+fi
+echo "VMApple MTTCG test passed"
diff --git a/scripts/27on86/guest-persist-sshd.sh b/scripts/27on86/guest-persist-sshd.sh
new file mode 100755
index 0000000000..4f895279c9
--- /dev/null
+++ b/scripts/27on86/guest-persist-sshd.sh
@@ -0,0 +1,52 @@
+#!/bin/sh
+# Runs in the VMApple single-user serial shell. Mounts the Data volume, then
+# installs a LaunchDaemon that starts sshd on every normal boot.
+set -eu
+stage=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+boot_util=/System/Library/Filesystems/apfs.fs/Contents/Resources/apfs_boot_util
+echo "starting APFS data-volume setup"
+"$boot_util" 2 >"$stage/apfs-boot.log" 2>&1 &
+boot_pid=$!
+trap 'kill -INT "$boot_pid" 2>/dev/null || true' EXIT HUP INT TERM
+stitched=0
+count=0
+while test "$count" -lt 180; do
+    if test -d /System/Volumes/Data/private/var && test -d /private/var; then
+        data_dev=$(/usr/bin/stat -f %d /System/Volumes/Data/private)
+        private_dev=$(/usr/bin/stat -f %d /private)
+        if test "$data_dev" = "$private_dev"; then
+            stitched=1
+            break
+        fi
+    fi
+    count=$((count + 1))
+    sleep 1
+done
+if test "$stitched" != 1; then
+    echo "APFS firmlink setup did not complete" >&2
+    tail -n 40 "$stage/apfs-boot.log" >&2
+    exit 1
+fi
+echo "APFS firmlinks visible; settling volume-group setup"
+sleep 30
+kill -INT "$boot_pid" 2>/dev/null || true
+wait "$boot_pid" 2>/dev/null || true
+trap - EXIT HUP INT TERM
+echo "APFS firmlinks ready after ${count}s"
+state=/private/var/db/27on86
+mkdir -p "$state" /private/var/root/.ssh /Library/LaunchDaemons
+cp "$stage/authorized_keys" /private/var/root/.ssh/authorized_keys
+cp "$stage/ssh_host_ed25519_key" "$state/ssh_host_ed25519_key"
+cp "$stage/ssh_host_ed25519_key.pub" "$state/ssh_host_ed25519_key.pub"
+cp "$stage/persist-sshd.conf" "$state/sshd_config"
+cp "$stage/persist-sshd.plist" /Library/LaunchDaemons/org.qemu.27on86.sshd.plist
+chown root:wheel /private/var/root/.ssh /private/var/root/.ssh/authorized_keys \
+    "$state" "$state"/* /Library/LaunchDaemons/org.qemu.27on86.sshd.plist
+chmod 700 /private/var/root/.ssh "$state"
+chmod 600 /private/var/root/.ssh/authorized_keys \
+    "$state/ssh_host_ed25519_key" "$state/sshd_config"
+chmod 644 "$state/ssh_host_ed25519_key.pub" \
+    /Library/LaunchDaemons/org.qemu.27on86.sshd.plist
+/usr/bin/plutil -lint /Library/LaunchDaemons/org.qemu.27on86.sshd.plist
+sync
+echo "sshd LaunchDaemon installed"
