diff --git a/tests/27on86/vmapple-mttcg.S b/tests/27on86/vmapple-mttcg.S
new file mode 100644
index 0000000000..a2c548b834
--- /dev/null
+++ b/tests/27on86/vmapple-mttcg.S
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Boot test for multi-threaded TCG on vmapple without the icount time
+ * contract.  CPU 0 starts three secondaries with PSCI CPU_ON, each one
+ * bumps a shared counter, and CPU 0 checks that the architectural counter
+ * runs at 24 MHz and moves in real time.  Prints VMAPPLE_MTTCG_OK, or
+ * VMAPPLE_MTTCG_FAIL <n>.
+ */
+    .section .text.boot, "ax"
+    .global _start
+    .set    COUNTER, 0x70000000
+_start:
+    movz    x20, #0x2001, lsl #16        /* PL011 */
+    mov     w3, #0x301
+    str     w3, [x20, #0x30]
+    ldr     x21, =COUNTER
+    str     wzr, [x21]
+    mov     x22, #1                      /* cpu index (== MPIDR) */
+1:  movz    x0, #0xc400, lsl #16         /* PSCI CPU_ON (64-bit) */
+    movk    x0, #0x0003
+    mov     x1, x22
+    adr     x2, secondary
+    mov     x3, #0
+    hvc     #0
+    cbnz    x0, fail1
+    add     x22, x22, #1
+    cmp     x22, #4
+    b.lo    1b
+    /* the counter frequency is the platform timebase */
+    mrs     x0, cntfrq_el0
+    movz    x9, #0x016e, lsl #16
+    movk    x9, #0x3600
+    cmp     x0, x9
+    b.ne    fail2
+    /* wait up to 5 s of counter time for all secondaries */
+    mrs     x23, cntvct_el0
+    movz    x24, #0x0725, lsl #16        /* 120,000,000 ticks = 5 s */
+    movk    x24, #0x5600
+2:  ldr     w0, [x21]
+    cmp     w0, #3
+    b.eq    3f
+    mrs     x0, cntvct_el0
+    sub     x0, x0, x23
+    cmp     x0, x24
+    b.lo    2b
+    b       fail3
+3:  /* the counter must have moved, and not faster than real time allows */
+    mrs     x0, cntvct_el0
+    cmp     x0, x23
+    b.ls    fail4
+    adr     x1, ok_msg
+    b       print
+fail1:
+    mov     w19, #1
+    b       fail
+fail2:
+    mov     w19, #2
+    b       fail
+fail3:
+    mov     w19, #3
+    b       fail
+fail4:
+    mov     w19, #4
+fail:
+    adr     x1, fail_msg
+    bl      puts
+    add     w19, w19, #'0'
+    mov     w2, w19
+    bl      putc
+    mov     w2, #10
+    bl      putc
+    b       halt
+print:
+    bl      puts
+halt:
+    wfi
+    b       halt
+secondary:
+    ldr     x1, =COUNTER
+4:  ldxr    w2, [x1]
+    add     w2, w2, #1
+    stxr    w3, w2, [x1]
+    cbnz    w3, 4b
+5:  wfe
+    b       5b
+puts:
+    mov     x25, x30
+1:  ldrb    w2, [x1], #1
+    cbz     w2, 2f
+    bl      putc
+    b       1b
+2:  ret     x25
+putc:
+    ldr     w3, [x20, #0x18]
+    tbnz    w3, #5, putc
+    str     w2, [x20]
+    ret
+    .ltorg
+ok_msg:
+    .asciz  "VMAPPLE_MTTCG_OK\n"
+fail_msg:
+    .asciz  "VMAPPLE_MTTCG_FAIL "
