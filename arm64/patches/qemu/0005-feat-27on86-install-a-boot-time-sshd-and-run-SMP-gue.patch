+    *[!0-9xXa-fA-F]*)
+        echo "CSR configuration must be an integer" >&2
+        exit 1
+        ;;
+    *)
+        machine="$machine,csr-config=$csr_config"
+        ;;
+esac
+if test -n "$xnu_boot_args"; then
+    # Commas are escaped for the -machine option parser.
+    machine="$machine,xnu-boot-args=$(printf '%s' "$xnu_boot_args" | sed 's/,/,,/g')"
+fi
 if test -n "$pcap"; then
     set -- "$@" -object "filter-dump,id=netcap,netdev=net0,file=$pcap"
