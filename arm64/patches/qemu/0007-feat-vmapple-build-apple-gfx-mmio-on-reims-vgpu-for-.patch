-
-static void apple_gfx_render_frame_completed_bh(void *opaque)
-{
-    AppleGFXState *s = opaque;
-
-    @autoreleasepool {
-        --s->pending_frames;
-        assert(s->pending_frames >= 0);
-
-        /* Only update display if mode hasn't changed since we started rendering. */
