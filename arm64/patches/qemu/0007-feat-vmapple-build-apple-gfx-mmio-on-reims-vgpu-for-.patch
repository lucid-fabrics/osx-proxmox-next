-    NSArray<id<MTLDevice>> *devs = MTLCopyAllDevices();
-
-    /* Prefer a unified memory GPU. Failing that, pick a non-removable GPU. */
-    for (size_t i = 0; i < devs.count; ++i) {
-        if (devs[i].hasUnifiedMemory) {
-            dev = devs[i];
-            break;
-        }
-        if (!devs[i].removable) {
-            dev = devs[i];
-        }
-    }
-
-    if (dev != nil) {
-        [dev retain];
-    } else {
-        dev = MTLCreateSystemDefaultDevice();
-    }
-    [devs release];
-
-    return dev;
