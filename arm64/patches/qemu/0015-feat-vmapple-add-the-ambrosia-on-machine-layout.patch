 hw/vmapple/Kconfig           |   5 +
 hw/vmapple/meson.build       |   1 +
 hw/vmapple/rtc.c             | 196 +++++++++++++++++++++++++++++++++++
 hw/vmapple/trace-events      |   4 +
 hw/vmapple/vmapple.c         |  69 +++++++++++-
 include/hw/vmapple/vmapple.h |   2 +
 7 files changed, 292 insertions(+), 5 deletions(-)
 create mode 100644 hw/vmapple/rtc.c

