+/* ------ Suspend and resume (savevm, migration) ------ */
+
+void apple_gfx_common_free_suspend_state(AppleGFXState *s)
+{
+    g_free(s->suspend_state);
+    s->suspend_state = NULL;
+    s->suspend_state_len = 0;
+}
+
+bool apple_gfx_common_suspend(AppleGFXState *s, Error **errp)
+{
+    RvgBytes bytes = { NULL, 0 };
+    RvgStatus status;
+
+    assert(bql_locked());
+    apple_gfx_common_free_suspend_state(s);
+
+    /*
+     * The library's display thread calls mode_change, which takes the BQL,
+     * while a suspend pauses the displays.
+     */
+    bql_unlock();
+    rvg_device_will_suspend(s->pgdev);
+    status = rvg_device_finish_suspend(s->pgdev, &bytes);
+    bql_lock();
+
+    if (status != RVG_OK) {
+        error_setg(errp, "apple-gfx: rvg_device_finish_suspend: %s",
+                   rvg_status_message(status));
+        return false;
+    }
+    s->suspend_state = g_memdup2(bytes.data, bytes.length);
+    s->suspend_state_len = bytes.length;
+    rvg_bytes_free(bytes);
+    return true;
+}
+
+bool apple_gfx_common_resume(AppleGFXState *s, Error **errp)
+{
+    static const uint8_t empty[1];
+    RvgResumeError reason = RVG_RESUME_ERROR_NONE;
+    RvgStatus status;
+    uint32_t i;
+
+    assert(bql_locked());
+    bql_unlock();
+    status = rvg_device_will_resume(s->pgdev,
+                                    s->suspend_state ? s->suspend_state : empty,
+                                    s->suspend_state_len, &reason);
+    if (status == RVG_OK) {
+        rvg_device_did_resume(s->pgdev);
+    }
+    bql_lock();
+
+    if (status != RVG_OK) {
+        error_setg(errp, "apple-gfx: rvg_device_will_resume: %s (reason %u)",
+                   rvg_status_message(status), reason);
+        return false;
+    }
+    /* The surfaces were drawn from state the library rebuilt: draw again. */
+    for (i = 0; i < s->num_displays; i++) {
+        s->displays[i].frame_dirty = true;
+    }
+    return true;
+}
