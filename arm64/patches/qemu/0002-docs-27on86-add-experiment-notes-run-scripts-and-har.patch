@@ -0,0 +1,114 @@
+#!/bin/sh
+
+set -eu
+
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+source_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
+build_dir=${QEMU_27ON86_BUILD_DIR:-"$source_root/build"}
+output_dir=${QEMU_27ON86_OUTPUT_DIR:-"$source_root/out"}
+qemu="$build_dir/qemu-system-aarch64"
+fixture_dir=$(mktemp -d "${TMPDIR:-/tmp}/27on86-vmapple.XXXXXX")
+firmware="$fixture_dir/firmware"
+firmware_object="$fixture_dir/firmware.o"
+aux="$fixture_dir/aux"
+root="$fixture_dir/root"
+log="$output_dir/vmapple-tcg-smoke.log"
+mtree_log="$output_dir/vmapple-tcg-mtree.log"
+cfg_log="$output_dir/vmapple-tcg-cfg.log"
+
+cleanup()
+{
+    rm -f "$firmware" "$firmware_object" "$aux" "$root"
+    rmdir "$fixture_dir"
+}
+trap cleanup EXIT HUP INT TERM
+
+if ! test -x "$qemu"; then
+    echo "missing emulator; run scripts/27on86/build-aarch64.sh" >&2
+    exit 1
+fi
+
+clang --target=aarch64-none-elf \
+    -c "$source_root/tests/27on86/vmapple-smoke.S" \
+    -o "$firmware_object"
+llvm-objcopy -O binary -j .text.boot "$firmware_object" "$firmware"
+truncate -s 16384 "$aux"
+truncate -s 16384 "$root"
+mkdir -p "$output_dir"
+
+status=0
+timeout --signal=TERM 5s "$qemu" \
+    -machine vmapple,uuid=1,accel=tcg \
+    -cpu max \
+    -smp 1 \
+    -m 1G \
+    -nodefaults \
+    -display none \
+    -monitor none \
+    -serial stdio \
+    -no-reboot \
+    -bios "$firmware" \
+    -drive file="$aux",if=pflash,format=raw \
+    -drive file="$root",if=pflash,format=raw \
+    >"$log" 2>&1 || status=$?
+
+if test "$status" -ne 0 && test "$status" -ne 124; then
+    cat "$log" >&2
+    echo "VMApple TCG smoke test exited unexpectedly: $status" >&2
+    exit 1
+fi
+
+grep -Fq 'VMAPPLE_TCG_SMOKE_OK' "$log"
+
+if ! "$qemu" -device help 2>&1 | grep -Fq 'apple-gfx-mmio'; then
+    status=0
+    printf 'info mtree -f\nquit\n' | timeout --signal=TERM 5s "$qemu" \
+        -machine vmapple,uuid=1,accel=tcg \
+        -cpu max \
+        -smp 1 \
+        -m 1G \
+        -nodefaults \
+        -display none \
+        -serial none \
+        -monitor stdio \
+        -S \
+        -bios "$firmware" \
+        -drive file="$aux",if=pflash,format=raw \
+        -drive file="$root",if=pflash,format=raw \
+        >"$mtree_log" 2>&1 || status=$?
+
+    if test "$status" -ne 0; then
+        tail -n 40 "$mtree_log" >&2
+        echo "VMApple memory-map check exited unexpectedly: $status" >&2
+        exit 1
+    fi
+
+    grep -Fq 'vmapple.gfx-stub' "$mtree_log"
+    grep -Fq 'vmapple.iosfc-stub' "$mtree_log"
+fi
+
+status=0
+printf 'xp /1wx 0x400034\nquit\n' | "$qemu" \
+    -machine vmapple,uuid=1,accel=tcg,run-installer=on \
+    -cpu max \
+    -smp 1 \
+    -m 1G \
+    -nodefaults \
+    -display none \
+    -serial none \
+    -monitor stdio \
+    -S \
+    -bios "$firmware" \
+    -drive file="$aux",if=pflash,format=raw \
+    -drive file="$root",if=pflash,format=raw \
+    >"$cfg_log" 2>&1 || status=$?
+
+if test "$status" -ne 0; then
+    tail -n 40 "$cfg_log" >&2
+    echo "VMApple configuration check exited unexpectedly: $status" >&2
+    exit 1
+fi
+
+grep -Eq '00400034: 0x00000001' "$cfg_log"
+
+echo "VMApple TCG smoke test: PASS"
diff --git a/scripts/27on86/guest-headless-bootstrap.sh b/scripts/27on86/guest-headless-bootstrap.sh
new file mode 100755
index 0000000000..cd2f400392
--- /dev/null
+++ b/scripts/27on86/guest-headless-bootstrap.sh
@@ -0,0 +1,116 @@
+#!/bin/sh
+
+set -eu
+
+stage=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+boot_util=/System/Library/Filesystems/apfs.fs/Contents/Resources/apfs_boot_util
+
+echo "starting APFS data-volume setup"
+"$boot_util" 2 >"$stage/apfs-boot.log" 2>&1 &
+boot_pid=$!
+trap 'kill -INT "$boot_pid" 2>/dev/null || true' EXIT HUP INT TERM
+
+stitched=0
+count=0
+while test "$count" -lt 180; do
+    if test -d /System/Volumes/Data/private/var && test -d /private/var; then
+        data_dev=$(/usr/bin/stat -f %d /System/Volumes/Data/private)
+        private_dev=$(/usr/bin/stat -f %d /private)
+        if test "$data_dev" = "$private_dev"; then
+            stitched=1
+            break
+        fi
+    fi
+    count=$((count + 1))
+    sleep 1
+done
+
+if test "$stitched" != 1; then
+    echo "APFS firmlink setup did not complete" >&2
+    tail -n 40 "$stage/apfs-boot.log" >&2
+    exit 1
+fi
+
+# Firmlink visibility precedes the remaining volume-group notifications. Keep
+# phase 2 alive long enough for those notifications to settle before configd
+# opens the network stack.
+echo "APFS firmlinks visible; settling volume-group setup"
+sleep 60
+kill -INT "$boot_pid" 2>/dev/null || true
+wait "$boot_pid" 2>/dev/null || true
+trap - EXIT HUP INT TERM
+echo "APFS firmlinks ready after ${count}s"
+
+mkdir -p /private/var/db/27on86 /private/var/root/.ssh /etc/ssh
+cp "$stage/authorized_keys" /private/var/root/.ssh/authorized_keys
+cp "$stage/ssh_host_ed25519_key" /etc/ssh/ssh_host_ed25519_key
+cp "$stage/ssh_host_ed25519_key.pub" /etc/ssh/ssh_host_ed25519_key.pub
+cp "$stage/headless-sshd.conf" /private/var/db/27on86/sshd_config
+chmod 700 /private/var/root/.ssh /private/var/db/27on86
+chmod 600 /private/var/root/.ssh/authorized_keys \
+    /etc/ssh/ssh_host_ed25519_key /private/var/db/27on86/sshd_config
+chmod 644 /etc/ssh/ssh_host_ed25519_key.pub
+
+start_service()
+{
+    label=$1
+    plist=$2
+    if ! /bin/launchctl print "system/$label" >/dev/null 2>&1; then
+        /bin/launchctl bootstrap system "$plist" >"$stage/$label.log" 2>&1
+    fi
+}
+
+start_service com.apple.configd \
+    /System/Library/LaunchDaemons/com.apple.configd.plist
+
+count=0
+address=
+while test "$count" -lt 120; do
+    address=$(/usr/sbin/ipconfig getifaddr en0 2>/dev/null || true)
+    if test -n "$address"; then
+        break
+    fi
+    count=$((count + 1))
+    sleep 1
+done
+if test -z "$address"; then
+    echo "network did not acquire an IPv4 address" >&2
+    exit 1
+fi
+echo "network ready: $address"
+
+start_service com.apple.opendirectoryd \
+    /System/Library/LaunchDaemons/com.apple.opendirectoryd.plist
+
+count=0
+while test "$count" -lt 60; do
+    if /usr/bin/dscl . -read /Users/sshd >/dev/null 2>&1; then
+        break
+    fi
+    count=$((count + 1))
+    sleep 1
+done
+if test "$count" -ge 60; then
+    echo "directory service did not expose the sshd account" >&2
+    exit 1
+fi
+
+/usr/sbin/sshd -t -f /private/var/db/27on86/sshd_config
+/bin/launchctl bootout system/org.qemu.27on86.sshd >/dev/null 2>&1 || true
+/bin/launchctl bootstrap system "$stage/headless-sshd.plist" \
+    >"$stage/org.qemu.27on86.sshd.log" 2>&1
+
+count=0
+while test "$count" -lt 30; do
+    if /bin/launchctl print system/org.qemu.27on86.sshd 2>/dev/null |
+        grep -q 'state = running'; then
+        echo "headless SSH ready"
+        exit 0
+    fi
+    count=$((count + 1))
+    sleep 1
+done
+
+echo "sshd did not remain running" >&2
+tail -n 40 /private/var/db/27on86/sshd.log >&2 || true
+exit 1
diff --git a/scripts/27on86/guest-headless-workload.sh b/scripts/27on86/guest-headless-workload.sh
new file mode 100755
index 0000000000..4fe4739743
--- /dev/null
+++ b/scripts/27on86/guest-headless-workload.sh
@@ -0,0 +1,115 @@
+#!/bin/sh
+
+set -eu
+
+expected_cpus=$1
+network_url=$2
+network_token=$3
+work=/private/tmp/27on86-workload.$$
+mkdir -p "$work"
+
+cleanup()
+{
+    find "$work" -type f -delete 2>/dev/null || true
+    rmdir "$work" 2>/dev/null || true
+}
+trap cleanup EXIT HUP INT TERM
+
+architecture=$(/usr/bin/uname -m)
+online_cpus=$(/usr/sbin/sysctl -n hw.ncpu)
+active_cpus=$(/usr/sbin/sysctl -n hw.activecpu)
+logical_cpus=$(/usr/sbin/sysctl -n hw.logicalcpu)
+test "$architecture" = arm64
+test "$online_cpus" = "$expected_cpus"
+test "$active_cpus" = "$expected_cpus"
+test "$logical_cpus" = "$expected_cpus"
+echo "architecture=$architecture"
+echo "online_cpus=$online_cpus"
+
+/usr/bin/perl - <<'PL'
+use strict;
+use warnings;
+
+my $size = 256 * 1024 * 1024;
+my $page = 4096;
+my $memory = "\0" x $size;
+my $checksum = 0;
+for (my $offset = 0; $offset < $size; $offset += $page) {
+    my $value = ($offset / $page) & 0xff;
+    substr($memory, $offset, 1) = chr($value);
+    $checksum += ord(substr($memory, $offset, 1));
+}
+my $expected = ($size / $page / 256) * 32640;
+die "memory checksum mismatch: $checksum != $expected\n"
+    if $checksum != $expected;
+print "memory_bytes=$size\n";
+print "memory_checksum=$checksum\n";
+PL
+
+pids=
+worker=0
+while test "$worker" -lt "$expected_cpus"; do
+    (
+        /bin/dd if=/dev/zero bs=1048576 count=1 2>/dev/null |
+            /usr/bin/openssl dgst -sha256 >"$work/cpu.$worker"
+    ) &
+    pids="$pids $!"
+    worker=$((worker + 1))
+done
+for pid in $pids; do
+    wait "$pid"
+done
+worker_count=$(find "$work" -name 'cpu.*' -type f | /usr/bin/wc -l | tr -d ' ')
+unique_hashes=$(awk '{print $NF}' "$work"/cpu.* | sort -u | /usr/bin/wc -l | tr -d ' ')
+test "$worker_count" = "$expected_cpus"
+test "$unique_hashes" = 1
+echo "parallel_workers=$worker_count"
+echo "parallel_hash=$(awk 'NR == 1 {print $NF}' "$work"/cpu.0)"
+
+intercpu_counter=$(/usr/bin/perl -Mthreads -Mthreads::shared -e '
+    my $workers = shift;
+    my $rounds = 64;
+    my $turn :shared = 0;
+    my $counter :shared = 0;
+    my @threads;
+    for my $worker (0 .. $workers - 1) {
+        push @threads, threads->create(sub {
+            for (1 .. $rounds) {
+                lock($turn);
+                cond_wait($turn) while $turn != $worker;
+                ++$counter;
+                $turn = ($turn + 1) % $workers;
+                cond_broadcast($turn);
+            }
+        });
+    }
+    $_->join for @threads;
+    die "inter-CPU counter mismatch: $counter\n"
+        if $counter != $workers * $rounds;
+    print $counter;
+' "$expected_cpus")
+test "$intercpu_counter" = "$((expected_cpus * 64))"
+echo "intercpu_counter=$intercpu_counter"
+
+/bin/dd if=/dev/zero of="$work/storage.bin" bs=1048576 count=32 2>/dev/null
+/bin/sync
+storage_hash=$(/usr/bin/cksum "$work/storage.bin" | awk '{print $1 ":" $2}')
+readback_hash=$(/bin/cat "$work/storage.bin" | /usr/bin/cksum | awk '{print $1 ":" $2}')
+test "$storage_hash" = "$readback_hash"
+echo "storage_bytes=33554432"
+echo "storage_hash=$storage_hash"
+
+received=$(/usr/bin/curl -fsS "$network_url")
+test "$received" = "$network_token"
+echo "network_payload=$received"
+
+/usr/bin/perl -MTime::HiRes=clock_gettime,CLOCK_MONOTONIC,sleep -e '
+    my $start = clock_gettime(CLOCK_MONOTONIC);
+    sleep(2);
+    my $elapsed = int((clock_gettime(CLOCK_MONOTONIC) - $start) * 1_000_000_000);
+    die "timer interval outside tolerance: $elapsed\n"
+        if $elapsed < 1_900_000_000 || $elapsed > 10_000_000_000;
+    print "timer_elapsed_ns=$elapsed\n";
+'
+
+echo "workload_status=pass"
