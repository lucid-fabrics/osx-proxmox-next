diff --git a/scripts/27on86/inject-xnu-boot-args.gdb b/scripts/27on86/inject-xnu-boot-args.gdb
new file mode 100644
index 0000000000..0091df5ee9
--- /dev/null
+++ b/scripts/27on86/inject-xnu-boot-args.gdb
@@ -0,0 +1,109 @@
+python
+import gdb
+import os
+import struct
+import sys
+
+
+HANDOFF_PC = 0xACA00000
+BOOT_ARGS_REVISION = 2
+BOOT_ARGS_VERSION = 2
+COMMAND_LINE_OFFSET = 108
+COMMAND_LINE_SIZE = 608
+DEVICE_TREE_POINTER_OFFSET = 96
+DEVICE_TREE_LENGTH_OFFSET = 104
+VIRTUAL_BASE_OFFSET = 8
+PHYSICAL_BASE_OFFSET = 16
+
+
+def required_environment(name):
+    value = os.environ.get(name)
+    if not value:
+        raise gdb.GdbError(f"set {name}")
+    return value
+
+
+port = required_environment("QEMU_27ON86_GDB_PORT")
+command_line = required_environment("QEMU_27ON86_XNU_BOOT_ARGS").encode()
+if b"\0" in command_line:
+    raise gdb.GdbError("XNU boot arguments must not contain a NUL byte")
+if len(command_line) >= COMMAND_LINE_SIZE:
+    raise gdb.GdbError(
+        f"XNU boot arguments must be shorter than {COMMAND_LINE_SIZE} bytes"
+    )
+
+csr_config_text = os.environ.get("QEMU_27ON86_CSR_CONFIG")
+csr_config = None
+if csr_config_text:
+    try:
+        csr_config = int(csr_config_text, 0)
+    except ValueError as error:
+        raise gdb.GdbError("QEMU_27ON86_CSR_CONFIG must be an integer") from error
+    if not 0 <= csr_config <= 0xFFFFFFFF:
+        raise gdb.GdbError("QEMU_27ON86_CSR_CONFIG must fit in 32 bits")
+
+gdb.execute("set architecture aarch64", to_string=True)
+gdb.execute(f"target remote :{port}", to_string=True)
+
+# The reset path uses the handoff trampoline once for the second-stage loader
+# and a second time for XNU. At the second entry, x1 is the public boot_args
+# structure that the trampoline passes to the kernel in x0.
+breakpoint = gdb.Breakpoint(
+    f"*{HANDOFF_PC:#x}", type=gdb.BP_HARDWARE_BREAKPOINT, internal=True
+)
+breakpoint.ignore_count = 1
+gdb.execute("continue", to_string=True)
+
+pc = int(gdb.parse_and_eval("$pc"))
+if pc != HANDOFF_PC:
+    raise gdb.GdbError(f"unexpected stop at {pc:#x}")
+
+boot_args = int(gdb.parse_and_eval("$x1"))
+inferior = gdb.selected_inferior()
+header = bytes(inferior.read_memory(boot_args, 4))
+revision, version = struct.unpack("<HH", header)
+if (revision, version) != (BOOT_ARGS_REVISION, BOOT_ARGS_VERSION):
+    raise gdb.GdbError(
+        f"unexpected boot_args revision/version {revision}/{version}"
+    )
+
+payload = (command_line + b"\0").ljust(COMMAND_LINE_SIZE, b"\0")
+inferior.write_memory(boot_args + COMMAND_LINE_OFFSET, payload)
+readback = bytes(
+    inferior.read_memory(boot_args + COMMAND_LINE_OFFSET, len(command_line) + 1)
+)
+if readback != command_line + b"\0":
+    raise gdb.GdbError("XNU boot-argument write did not verify")
+
+print(f"injected XNU boot arguments: {command_line.decode(errors='replace')}")
+
+if csr_config is not None:
+    # GDB does not expose the command-file path. The wrapper runs from any
+    # directory, so use the repository script path supplied by the wrapper.
+    script_dir = required_environment("QEMU_27ON86_SCRIPT_DIR")
+    sys.path.insert(0, script_dir)
+    import apple_device_tree
+
+    virtual_base, physical_base = struct.unpack(
+        "<QQ", bytes(inferior.read_memory(boot_args + VIRTUAL_BASE_OFFSET, 16))
+    )
+    device_tree_virtual, device_tree_length = struct.unpack(
+        "<QI",
+        bytes(inferior.read_memory(boot_args + DEVICE_TREE_POINTER_OFFSET, 12)),
+    )
+    if device_tree_virtual < virtual_base:
+        raise gdb.GdbError("device tree pointer is below the kernel virtual base")
+    device_tree = device_tree_virtual - virtual_base + physical_base
+    flattened = bytearray(inferior.read_memory(device_tree, device_tree_length))
+    root = apple_device_tree.parse(flattened)
+    chosen = apple_device_tree.child_named(flattened, root, "chosen")
+    asmb = apple_device_tree.child_named(flattened, chosen, "asmb")
+    old_name = "lp-sip0" if "lp-sip0" in asmb["properties"] else "lp-stng"
+    apple_device_tree.replace_property(
+        flattened, asmb, old_name, "lp-sip0", struct.pack("<Q", csr_config)
+    )
+    inferior.write_memory(device_tree, flattened)
+    print(f"injected XNU CSR configuration: {csr_config:#x}")
+breakpoint.delete()
+gdb.execute("detach", to_string=True)
+end
diff --git a/scripts/27on86/inject-xnu-boot-args.sh b/scripts/27on86/inject-xnu-boot-args.sh
new file mode 100755
index 0000000000..9138280aac
--- /dev/null
+++ b/scripts/27on86/inject-xnu-boot-args.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+
+set -eu
+
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+gdb=${QEMU_27ON86_GDB_BIN:-gdb}
+export QEMU_27ON86_SCRIPT_DIR=$script_dir
+
+: "${QEMU_27ON86_GDB_PORT:?set QEMU_27ON86_GDB_PORT}"
+: "${QEMU_27ON86_XNU_BOOT_ARGS:?set QEMU_27ON86_XNU_BOOT_ARGS}"
+
+case "$QEMU_27ON86_GDB_PORT" in
+    *[!0-9]* | '')
+        echo "GDB port must be an unsigned decimal value" >&2
+        exit 1
+        ;;
+esac
+
+exec "$gdb" -nx -q -batch -x "$script_dir/inject-xnu-boot-args.gdb"
diff --git a/scripts/27on86/run-vmapple-tcg.sh b/scripts/27on86/run-vmapple-tcg.sh
new file mode 100755
index 0000000000..9e1a83a6ed
--- /dev/null
+++ b/scripts/27on86/run-vmapple-tcg.sh
@@ -0,0 +1,181 @@
+#!/bin/sh
+
+set -eu
+
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+source_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
+build_dir=${QEMU_27ON86_BUILD_DIR:-"$source_root/build"}
+output_dir=${QEMU_27ON86_OUTPUT_DIR:-"$source_root/out"}
+qemu=${QEMU_27ON86_QEMU:-"$build_dir/qemu-system-aarch64"}
+cpus=${QEMU_27ON86_CPUS:-1}
+memory=${QEMU_27ON86_MEMORY:-8G}
+ssh_port=${QEMU_27ON86_SSH_PORT:-10022}
+mac=${QEMU_27ON86_MAC:-52:54:00:76:61:70}
+pcap=${QEMU_27ON86_PCAP:-}
+tcg_smp_final_shift=${QEMU_27ON86_TCG_SMP_FINAL_SHIFT:--4}
+run_installer=${QEMU_27ON86_RUN_INSTALLER:-off}
+serial=${QEMU_27ON86_SERIAL:-}
+boot_args=${QEMU_27ON86_BOOT_ARGS:-}
+trace_event=${QEMU_27ON86_TRACE_EVENT:-}
+virtio_console_chardev=${QEMU_27ON86_VIRTIO_CONSOLE_CHARDEV:-}
+virtio_console_max_ports=${QEMU_27ON86_VIRTIO_CONSOLE_MAX_PORTS:-31}
+gdb_port=${QEMU_27ON86_GDB_PORT:-}
+pause_at_start=${QEMU_27ON86_PAUSE_AT_START:-off}
+no_reboot=${QEMU_27ON86_NO_REBOOT:-on}
+
+: "${QEMU_27ON86_FIRMWARE:?set QEMU_27ON86_FIRMWARE}"
+: "${QEMU_27ON86_AUX:?set QEMU_27ON86_AUX}"
+: "${QEMU_27ON86_ROOT:?set QEMU_27ON86_ROOT}"
+: "${QEMU_27ON86_ECID:?set QEMU_27ON86_ECID}"
+
+for input in "$QEMU_27ON86_FIRMWARE" "$QEMU_27ON86_AUX" \
+             "$QEMU_27ON86_ROOT"; do
+    if ! test -f "$input"; then
+        echo "missing local input: $input" >&2
+        exit 1
+    fi
+done
+
+if ! test -x "$qemu"; then
+    echo "missing emulator; run scripts/27on86/build-aarch64.sh" >&2
+    exit 1
+fi
+
+"$script_dir/set-aux-boot-args.py" --check-only "$QEMU_27ON86_AUX"
+
+case "$cpus:$ssh_port:$virtio_console_max_ports:$QEMU_27ON86_ECID" in
+    *[!0-9:]* | :* | *::*)
+        echo "CPU count, SSH port, console port count, and ECID must be unsigned decimal values" >&2
+        exit 1
+        ;;
+esac
+
+case "$gdb_port" in
+    '' | *[!0-9]*)
+        if test -n "$gdb_port"; then
+            echo "GDB port must be an unsigned decimal value" >&2
+            exit 1
+        fi
+        ;;
+esac
+
+case "$mac" in
+    [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:\
+[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:\
+[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f])
+        ;;
+    *)
+        echo "MAC address must contain six hexadecimal octets" >&2
+        exit 1
+        ;;
+esac
+
+case "$tcg_smp_final_shift" in
+    -10 | -[0-9] | [0-9] | 10)
+        ;;
+    *)
+        echo "TCG SMP final shift must be between -10 and 10" >&2
+        exit 1
+        ;;
+esac
+
+case "$run_installer" in
+    on | off)
+        ;;
+    *)
+        echo "installer selector must be 'on' or 'off'" >&2
+        exit 1
+        ;;
+esac
+
+case "$pause_at_start" in
+    on | off)
+        ;;
+    *)
+        echo "pause-at-start selector must be 'on' or 'off'" >&2
+        exit 1
+        ;;
+esac
+
+case "$no_reboot" in
+    on | off)
+        ;;
+    *)
+        echo "no-reboot selector must be 'on' or 'off'" >&2
+        exit 1
+        ;;
+esac
+
+mkdir -p "$output_dir"
+run_dir=$(mktemp -d "$output_dir/vmapple-run.XXXXXX")
+aux_work="$run_dir/aux.work"
+root_work="$run_dir/root.work"
+
+cp --reflink=auto -- "$QEMU_27ON86_AUX" "$aux_work"
+cp --reflink=auto -- "$QEMU_27ON86_ROOT" "$root_work"
+
+if test -n "$boot_args"; then
+    "$script_dir/set-aux-boot-args.py" "$aux_work" "$boot_args"
+fi
+
+echo "VMApple run directory: $run_dir"
+
+if test -z "$serial"; then
+    serial="file:$run_dir/serial.log"
+fi
+
+set --
+if test "$cpus" -gt 1; then
+    set -- "$@" -icount shift=0,align=off,sleep=off
+    machine="vmapple,uuid=$QEMU_27ON86_ECID,accel=tcg,run-installer=$run_installer,tcg-smp-final-shift=$tcg_smp_final_shift"
+else
+    machine="vmapple,uuid=$QEMU_27ON86_ECID,accel=tcg,run-installer=$run_installer"
+fi
+
+if test -n "$pcap"; then
+    set -- "$@" -object "filter-dump,id=netcap,netdev=net0,file=$pcap"
+fi
+
+if test -n "$trace_event"; then
+    set -- "$@" -trace "enable=$trace_event,file=$run_dir/trace.log"
+fi
+
+if test -n "$virtio_console_chardev"; then
+    set -- "$@" \
+        -chardev "$virtio_console_chardev,id=vconsole0" \
+        -device "virtio-serial-pci,id=vserial0,max_ports=$virtio_console_max_ports" \
+        -device virtconsole,id=vconsoleport0,chardev=vconsole0
+fi
+
+if test -n "$gdb_port"; then
+    set -- "$@" -gdb "tcp::$gdb_port"
+fi
+
+if test "$pause_at_start" = on; then
+    set -- "$@" -S
+fi
+
+if test "$no_reboot" = on; then
+    set -- "$@" -no-reboot
+fi
+
+exec "$qemu" \
+    -machine "$machine" \
+    -cpu max \
+    -smp "$cpus" \
+    "$@" \
+    -m "$memory" \
+    -display none \
+    -monitor none \
+    -serial "$serial" \
+    -qmp "unix:$run_dir/qmp.sock,server=on,wait=off" \
+    -action panic=pause,shutdown=pause \
+    -bios "$QEMU_27ON86_FIRMWARE" \
+    -drive "if=pflash,format=raw,file.filename=$aux_work,file.locking=off" \
+    -drive "if=pflash,format=raw,file.filename=$root_work,file.locking=off" \
+    -drive "if=none,format=raw,file.filename=$aux_work,file.locking=off,id=aux" \
+    -device vmapple-virtio-blk-pci,variant=aux,drive=aux,share-rw=on \
+    -drive "if=none,format=raw,file.filename=$root_work,file.locking=off,id=root" \
+    -device vmapple-virtio-blk-pci,variant=root,drive=root,share-rw=on \
+    -netdev "user,id=net0,ipv6=off,hostfwd=tcp:127.0.0.1:$ssh_port-:22" \
+    -device "virtio-net-pci,netdev=net0,mac=$mac"
