new file mode 100755
index 0000000000..cbddbdaab8
--- /dev/null
+++ b/scripts/27on86/set-aux-boot-args.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+
+"""Set boot-args in every valid CHRP system partition in an image."""
+
+import argparse
+from pathlib import Path
+import zlib
+
+
+HEADER_SIZE = 16
+SYSTEM_SIGNATURE = 0x70
+NVRAM_SIGNATURE = 0x5A
+NVRAM_BANK_SIZE = 0x80000
+
+
+def header_checksum(header: bytes) -> int:
+    total = header[0]
+    for value in header[2:16]:
+        total += value
+        total = (total + (total >> 8)) & 0xFF
+    return total
+
+
+def system_partitions(image: bytearray, start: int = 0, end: int | None = None):
+    if end is None:
+        end = len(image)
+    for offset in range(start, end - HEADER_SIZE + 1, 16):
+        header = image[offset : offset + HEADER_SIZE]
+        if header[0] != SYSTEM_SIGNATURE or header[4:16].rstrip(b"\0") != b"system":
+            continue
+        if header_checksum(header) != header[1]:
+            continue
+
+        size = int.from_bytes(header[2:4], "little") * 16
+        if size < HEADER_SIZE or offset + size > end:
+            continue
+        yield offset, size
+
+
+def nvram_banks(image: bytearray):
+    for offset in range(0, len(image) - NVRAM_BANK_SIZE + 1, 16):
+        header = image[offset : offset + HEADER_SIZE]
+        if header[0] != NVRAM_SIGNATURE or header[4:16].rstrip(b"\0") != b"nvram":
+            continue
+        if header_checksum(header) != header[1]:
+            continue
+
+        stored = int.from_bytes(image[offset + 16 : offset + 20], "little")
+        actual = zlib.adler32(image[offset + 20 : offset + NVRAM_BANK_SIZE])
+        if stored == actual:
+            yield offset
+
+
+def replace_boot_args(partition: bytearray, boot_args: bytes) -> None:
+    payload = partition[HEADER_SIZE:]
+    end = payload.find(b"\0\0")
+    if end < 0:
+        raise ValueError("system partition has no variable-list terminator")
+
+    entries = payload[:end].split(b"\0") if end else []
+    replacement = b"boot-args=" + boot_args
+    for index, entry in enumerate(entries):
+        if entry.startswith(b"boot-args="):
+            entries[index] = replacement
+            break
+    else:
+        entries.append(replacement)
+
+    encoded = b"\0".join(entries) + b"\0\0"
+    if len(encoded) > len(payload):
+        raise ValueError("boot arguments do not fit in the system partition")
+
+    partition[HEADER_SIZE:] = encoded.ljust(len(payload), b"\0")
+
+
+def validate_nvram_layout(image: bytearray) -> list[int]:
+    banks = list(nvram_banks(image))
+    if not banks:
+        raise ValueError("no valid NVRAM banks found")
+    if any(offset % NVRAM_BANK_SIZE for offset in banks):
+        raise ValueError("NVRAM banks must start at bank-aligned offsets")
+    for bank_offset in banks:
+        bank_end = bank_offset + NVRAM_BANK_SIZE
+        if not list(system_partitions(image, bank_offset, bank_end)):
+            raise ValueError("NVRAM bank has no valid CHRP system partition")
+    return banks
+
+
+def set_boot_args(image: bytearray, boot_args: bytes) -> int:
+    banks = validate_nvram_layout(image)
+
+    count = 0
+    for bank_offset in banks:
+        bank_end = bank_offset + NVRAM_BANK_SIZE
+        matches = list(system_partitions(image, bank_offset, bank_end))
+        for offset, size in matches:
+            partition = image[offset : offset + size]
+            replace_boot_args(partition, boot_args)
+            image[offset : offset + size] = partition
+            count += 1
+
+        checksum = zlib.adler32(image[bank_offset + 20 : bank_end])
+        image[bank_offset + 16 : bank_offset + 20] = checksum.to_bytes(4, "little")
+    return count
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--check-only", action="store_true")
+    parser.add_argument("image", type=Path)
+    parser.add_argument("boot_args", nargs="?")
+    args = parser.parse_args()
+
+    if args.check_only and args.boot_args is not None:
+        parser.error("boot_args cannot be used with --check-only")
+    if not args.check_only and args.boot_args is None:
+        parser.error("boot_args is required unless --check-only is used")
+    if args.boot_args is not None and "\0" in args.boot_args:
+        parser.error("boot arguments must not contain NUL bytes")
+
+    image = bytearray(args.image.read_bytes())
+    try:
+        if args.check_only:
+            validate_nvram_layout(image)
+            return
+        count = set_boot_args(image, args.boot_args.encode())
+    except ValueError as error:
+        parser.error(str(error))
+    args.image.write_bytes(image)
+    print(f"updated {count} CHRP system partition(s)")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/27on86/validate-headless.py b/scripts/27on86/validate-headless.py
new file mode 100755
index 0000000000..fde470ef2a
--- /dev/null
+++ b/scripts/27on86/validate-headless.py
@@ -0,0 +1,378 @@
+#!/usr/bin/env python3
+
+"""Run repeatable VMApple headless validation from fresh disk clones."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import shlex
+import socket
+import subprocess
+import sys
+import time
+
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+SOURCE_ROOT = SCRIPT_DIR.parents[1]
+RUNNER = SCRIPT_DIR / "run-vmapple-tcg.sh"
+INJECTOR = SCRIPT_DIR / "inject-xnu-boot-args.sh"
+BOOTSTRAP = SCRIPT_DIR / "bootstrap-headless.py"
+WORKLOAD = SCRIPT_DIR / "guest-headless-workload.sh"
+
+
+def reserve_tcp_port():
+    with socket.socket() as listener:
+        listener.bind(("127.0.0.1", 0))
+        return listener.getsockname()[1]
+
+
+def wait_for_path(path: Path, process: subprocess.Popen, timeout: float):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if path.exists():
+            return
+        if process.poll() is not None:
+            raise RuntimeError(f"QEMU exited with status {process.returncode}")
+        time.sleep(0.1)
+    raise RuntimeError(f"timed out waiting for {path}")
+
+
+class QMP:
+    def __init__(self, path: Path, timeout: float = 30):
+        self.socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self.socket.settimeout(timeout)
+        self.socket.connect(os.fspath(path))
+        self.stream = self.socket.makefile("rwb", buffering=0)
+        greeting = self.receive()
+        if "QMP" not in greeting:
+            raise RuntimeError("QMP greeting is missing")
+        self.execute("qmp_capabilities")
+
+    def close(self):
+        self.stream.close()
+        self.socket.close()
+
+    def send(self, message):
+        self.stream.write(json.dumps(message).encode() + b"\n")
+
+    def receive(self):
+        line = self.stream.readline()
+        if not line:
+            raise RuntimeError("QMP connection closed")
+        return json.loads(line)
+
+    def execute(self, command, arguments=None):
+        message = {"execute": command}
+        if arguments is not None:
+            message["arguments"] = arguments
+        self.send(message)
+        while True:
+            response = self.receive()
+            if "error" in response:
+                raise RuntimeError(f"QMP {command} failed: {response['error']}")
+            if "return" in response:
+                return response["return"]
+
+    def wait_for_event(self, event: str, timeout: float):
+        self.socket.settimeout(timeout)
+        while True:
+            message = self.receive()
+            if message.get("event") == event:
+                return message.get("data", {})
+
+
+def required_environment():
+    names = (
+        "QEMU_27ON86_FIRMWARE",
+        "QEMU_27ON86_AUX",
+        "QEMU_27ON86_ROOT",
+        "QEMU_27ON86_ECID",
+    )
+    missing = [name for name in names if not os.environ.get(name)]
+    if missing:
+        raise RuntimeError("set " + ", ".join(missing))
+    return {name: os.environ[name] for name in names}
+
+
+def ssh_command(port: int, identity: Path, remote_command: str):
+    return [
+        "ssh",
+        "-i",
+        os.fspath(identity),
+        "-p",
+        str(port),
+        "-o",
+        "BatchMode=yes",
+        "-o",
+        "StrictHostKeyChecking=no",
+        "-o",
+        "UserKnownHostsFile=/dev/null",
+        "-o",
+        "LogLevel=ERROR",
+        "-o",
+        "ConnectTimeout=10",
+        "root@127.0.0.1",
+        remote_command,
+    ]
+
+
+def wait_for_ssh(port: int, identity: Path, timeout: float):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        result = subprocess.run(
+            ssh_command(port, identity, "true"),
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+        )
+        if result.returncode == 0:
+            return
+        time.sleep(2)
+    raise RuntimeError("timed out waiting for SSH")
+
+
+def start_qemu(
+    index: int, cpus: int, output: Path, base_environment, reboot_cycle: bool
+):
+    ssh_port = reserve_tcp_port()
+    gdb_port = reserve_tcp_port()
+    serial_socket = Path(f"/tmp/27on86-{os.getpid()}-{index}.serial")
+    run_output = output / f"run-{index}-{cpus}cpu"
+    run_output.mkdir(parents=True, exist_ok=True)
+    environment = os.environ.copy()
+    environment.update(base_environment)
+    environment.update(
+        {
+            "QEMU_27ON86_OUTPUT_DIR": os.fspath(run_output),
+            "QEMU_27ON86_SERIAL": f"unix:{serial_socket},server=on,wait=off",
+            "QEMU_27ON86_SSH_PORT": str(ssh_port),
+            "QEMU_27ON86_GDB_PORT": str(gdb_port),
+            "QEMU_27ON86_PAUSE_AT_START": "on",
+            "QEMU_27ON86_CPUS": str(cpus),
+            "QEMU_27ON86_NO_REBOOT": "off" if reboot_cycle else "on",
+        }
+    )
+    process = subprocess.Popen(
+        [os.fspath(RUNNER)],
+        cwd=SOURCE_ROOT,
+        env=environment,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+    )
+    first_line = process.stdout.readline().strip()
+    prefix = "VMApple run directory: "
+    if not first_line.startswith(prefix):
+        raise RuntimeError(f"runner did not report its directory: {first_line}")
+    run_directory = Path(first_line.removeprefix(prefix))
+    wait_for_path(serial_socket, process, 30)
+    wait_for_path(run_directory / "qmp.sock", process, 30)
+    return process, run_directory, serial_socket, ssh_port, gdb_port
+
+
+def inject_handoff(gdb_port: int):
+    injector_environment = os.environ.copy()
+    injector_environment.update(
+        {
+            "QEMU_27ON86_GDB_PORT": str(gdb_port),
+            "QEMU_27ON86_XNU_BOOT_ARGS": "-s -v serial=11 debug=0x14c",
+            "QEMU_27ON86_CSR_CONFIG": "0x2",
+        }
+    )
+    subprocess.run([os.fspath(INJECTOR)], env=injector_environment, check=True)
+
+
+def run_validation(
+    index: int, cpus: int, output: Path, base_environment, reboot_cycle: bool = False
+):
+    started = time.monotonic()
+    process = None
+    qmp = None
+    http_process = None
+    serial_socket = None
+    run_directory = None
+    try:
+        process, run_directory, serial_socket, ssh_port, gdb_port = start_qemu(
+            index, cpus, output, base_environment, reboot_cycle
+        )
+        print(f"run {index}: QEMU started in {run_directory}", flush=True)
+
+        inject_handoff(gdb_port)
+        print(f"run {index}: XNU handoff configured", flush=True)
+
+        state_directory = run_directory / "headless-state"
+        subprocess.run(
+            [os.fspath(BOOTSTRAP), os.fspath(serial_socket), os.fspath(state_directory)],
+            check=True,
+        )
+        identity = state_directory / "id_ed25519"
+        wait_for_ssh(ssh_port, identity, 60)
+        print(f"run {index}: SSH ready", flush=True)
+
+        http_port = reserve_tcp_port()
+        network_token = f"27on86-network-run-{index}"
+        network_file = run_directory / "network-token"
+        network_file.write_text(network_token)
+        http_process = subprocess.Popen(
+            [
+                sys.executable,
+                "-m",
+                "http.server",
+                str(http_port),
+                "--bind",
+                "127.0.0.1",
+                "--directory",
+                os.fspath(run_directory),
+            ],
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+        )
+        network_url = f"http://10.0.2.2:{http_port}/{network_file.name}"
+        with WORKLOAD.open("rb") as workload:
+            result = subprocess.run(
+                ssh_command(
+                    ssh_port,
+                    identity,
+                    "sh -s -- "
+                    + " ".join(
+                        shlex.quote(value)
+                        for value in (str(cpus), network_url, network_token)
+                    ),
+                ),
+                stdin=workload,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT,
+                check=True,
+            )
+        workload_output = result.stdout.decode(errors="replace")
+        (run_directory / "workload.log").write_text(workload_output)
+        print(workload_output, end="", flush=True)
+
+        qmp = QMP(run_directory / "qmp.sock")
+        if reboot_cycle:
+            subprocess.run(
+                ssh_command(ssh_port, identity, "/bin/launchctl reboot"),
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                check=False,
+            )
+            reset = qmp.wait_for_event("RESET", 120)
+            print(f"run {index}: guest reset observed ({reset})", flush=True)
+            inject_handoff(gdb_port)
+            print(f"run {index}: reboot handoff configured", flush=True)
+            subprocess.run(
+                [
+                    os.fspath(BOOTSTRAP),
+                    os.fspath(serial_socket),
+                    os.fspath(state_directory),
+                ],
+                check=True,
+            )
+            wait_for_ssh(ssh_port, identity, 60)
+            subprocess.run(
+                ssh_command(
+                    ssh_port,
+                    identity,
+                    f"test $(/usr/sbin/sysctl -n hw.ncpu) = {cpus}",
+                ),
+                check=True,
+            )
+            print(f"run {index}: SSH ready after reboot", flush=True)
+
+        subprocess.run(
+            ssh_command(
+                ssh_port,
+                identity,
+                "/bin/launchctl reboot halt",
+            ),
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            check=False,
+        )
+        shutdown = qmp.wait_for_event("SHUTDOWN", 120)
+        status = qmp.execute("query-status")
+        if not shutdown.get("guest") or status.get("running"):
+            raise RuntimeError(
+                f"unclean shutdown evidence: event={shutdown}, status={status}"
+            )
+        print(
+            f"run {index}: clean shutdown ({shutdown.get('reason')}) after "
+            f"{time.monotonic() - started:.1f}s",
+            flush=True,
+        )
+        qmp.execute("quit")
+        qmp.close()
+        qmp = None
+        process.wait(timeout=30)
+        return run_directory
+    finally:
+        if http_process is not None and http_process.poll() is None:
+            http_process.terminate()
+            http_process.wait(timeout=10)
+        if qmp is not None:
+            try:
+                qmp.execute("quit")
+            except (OSError, RuntimeError):
+                pass
+            qmp.close()
+        if process is not None and process.poll() is None:
+            process.terminate()
+            process.wait(timeout=30)
+        if process is not None and process.stdout is not None:
+            remaining = process.stdout.read()
+            if run_directory is not None and remaining:
+                (run_directory / "qemu.log").write_text(remaining)
+        if serial_socket is not None:
+            try:
+                serial_socket.unlink()
+            except FileNotFoundError:
+                pass
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--runs", type=int, default=2)
+    parser.add_argument("--cpus", type=int, default=8)
+    parser.add_argument(
+        "--output", type=Path, default=SOURCE_ROOT / "out/headless-validation"
+    )
+    parser.add_argument("--skip-one-cpu-regression", action="store_true")
+    parser.add_argument("--reboot-cycle", action="store_true")
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+    if args.runs < 1 or args.cpus < 1:
+        raise RuntimeError("runs and CPUs must be positive")
+    base_environment = required_environment()
+    args.output.mkdir(parents=True, exist_ok=True)
+
+    completed = []
+    for index in range(1, args.runs + 1):
+        completed.append(
+            run_validation(
+                index,
+                args.cpus,
+                args.output,
+                base_environment,
+                reboot_cycle=args.reboot_cycle,
+            )
+        )
+    if not args.skip_one_cpu_regression:
+        completed.append(
+            run_validation(args.runs + 1, 1, args.output, base_environment)
+        )
+
+    print("validated fresh VMApple runs:")
+    for directory in completed:
+        print(f"  {directory}")
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except (RuntimeError, subprocess.CalledProcessError, socket.timeout) as error:
+        print(f"headless validation failed: {error}", file=sys.stderr)
+        sys.exit(1)
diff --git a/scripts/27on86/verify-launchd-ram.py b/scripts/27on86/verify-launchd-ram.py
new file mode 100755
index 0000000000..940d8b60d1
--- /dev/null
+++ b/scripts/27on86/verify-launchd-ram.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+
+import argparse
+import mmap
+import struct
+import sys
+
+
+PROC_COMM_OFFSET = 1464
+PROC_NAME_OFFSET = PROC_COMM_OFFSET + 17
+PROC_PID_OFFSET = 0x60
+PROC_STAT_OFFSET = 0x64
+PROC_STATE_RUNNABLE = 2
+PROCESS_NAME = b"launchd\0"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(
+        description="verify a live PID 1 launchd process in a raw RAM range"
+    )
+    parser.add_argument("dump", help="raw physical-memory range from QEMU")
+    args = parser.parse_args()
+
+    with open(args.dump, "rb") as stream:
+        with mmap.mmap(stream.fileno(), 0, access=mmap.ACCESS_READ) as memory:
+            offset = 0
+            while True:
+                offset = memory.find(PROCESS_NAME, offset)
+                if offset < 0:
+                    break
+
+                proc_offset = offset - PROC_COMM_OFFSET
+                if (proc_offset >= 0 and
+                        memory[offset:offset + len(PROCESS_NAME)] ==
+                        PROCESS_NAME and
+                        memory[proc_offset + PROC_NAME_OFFSET:
+                               proc_offset + PROC_NAME_OFFSET +
+                               len(PROCESS_NAME)] == PROCESS_NAME):
+                    pid = struct.unpack_from(
+                        "<i", memory, proc_offset + PROC_PID_OFFSET)[0]
+                    state = memory[proc_offset + PROC_STAT_OFFSET]
+                    if pid == 1 and state == PROC_STATE_RUNNABLE:
+                        print("live launchd PID 1: PASS")
+                        return 0
+                offset += 1
+
+    print("live launchd PID 1: NOT FOUND", file=sys.stderr)
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/27on86/test_apple_device_tree.py b/tests/27on86/test_apple_device_tree.py
new file mode 100644
index 0000000000..be3dd97001
--- /dev/null
+++ b/tests/27on86/test_apple_device_tree.py
@@ -0,0 +1,63 @@
+import importlib.util
+from pathlib import Path
+import struct
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[2]
+HELPER = ROOT / "scripts/27on86/apple_device_tree.py"
+SPEC = importlib.util.spec_from_file_location("apple_device_tree", HELPER)
+apple_device_tree = importlib.util.module_from_spec(SPEC)
+assert SPEC.loader is not None
+SPEC.loader.exec_module(apple_device_tree)
+
+
+def prop(name, value):
+    header = name.encode().ljust(32, b"\0") + struct.pack("<I", len(value))
+    return header + value.ljust((len(value) + 3) & ~3, b"\0")
+
+
+def node(properties, children=()):
+    return bytearray(
+        struct.pack("<II", len(properties), len(children))
+        + b"".join(prop(name, value) for name, value in properties)
+        + b"".join(children)
+    )
+
+
+class AppleDeviceTreeTests(unittest.TestCase):
+    def test_replaces_equal_sized_property_in_named_child(self):
+        asmb = node((("name", b"asmb\0"), ("lp-stng", struct.pack("<Q", 1))))
+        chosen = node((("name", b"chosen\0"),), (asmb,))
+        tree = node((("name", b"device-tree\0"),), (chosen,))
+
+        root = apple_device_tree.parse(tree)
+        chosen_node = apple_device_tree.child_named(tree, root, "chosen")
+        asmb_node = apple_device_tree.child_named(tree, chosen_node, "asmb")
+        apple_device_tree.replace_property(
+            tree, asmb_node, "lp-stng", "lp-sip0", struct.pack("<Q", 2)
+        )
+
+        reparsed = apple_device_tree.parse(tree)
+        chosen_node = apple_device_tree.child_named(tree, reparsed, "chosen")
+        asmb_node = apple_device_tree.child_named(tree, chosen_node, "asmb")
+        self.assertEqual(
+            apple_device_tree.property_value(tree, asmb_node, "lp-sip0"),
+            struct.pack("<Q", 2),
+        )
+        self.assertNotIn("lp-stng", asmb_node["properties"])
+
+    def test_rejects_a_different_sized_replacement(self):
+        tree = node((("name", b"root\0"), ("old", b"1234")))
+        root = apple_device_tree.parse(tree)
+        with self.assertRaisesRegex(apple_device_tree.DeviceTreeError, "4 bytes"):
+            apple_device_tree.replace_property(tree, root, "old", "new", b"12345678")
+
+    def test_rejects_truncated_property(self):
+        tree = bytearray(struct.pack("<II", 1, 0) + b"short")
+        with self.assertRaisesRegex(apple_device_tree.DeviceTreeError, "truncated"):
+            apple_device_tree.parse(tree)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/27on86/test_aux_boot_args.py b/tests/27on86/test_aux_boot_args.py
new file mode 100755
index 0000000000..43b4aa91a5
--- /dev/null
+++ b/tests/27on86/test_aux_boot_args.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+
+import importlib.util
+from pathlib import Path
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[2]
+HELPER = ROOT / "scripts/27on86/set-aux-boot-args.py"
+SPEC = importlib.util.spec_from_file_location("set_aux_boot_args", HELPER)
+MODULE = importlib.util.module_from_spec(SPEC)
+assert SPEC.loader is not None
+SPEC.loader.exec_module(MODULE)
+
+
+def partition(*entries: bytes) -> bytes:
+    size = 512
+    header = bytearray(size)
+    header[0] = MODULE.SYSTEM_SIGNATURE
+    header[2:4] = (size // 16).to_bytes(2, "little")
+    header[4:10] = b"system"
+    header[1] = MODULE.header_checksum(header[: MODULE.HEADER_SIZE])
+    payload = b"\0".join(entries) + b"\0\0"
+    header[MODULE.HEADER_SIZE : MODULE.HEADER_SIZE + len(payload)] = payload
+    return bytes(header)
+
+
+def bank(*entries: bytes) -> bytes:
+    image = bytearray(MODULE.NVRAM_BANK_SIZE)
+    image[0] = MODULE.NVRAM_SIGNATURE
+    image[2:4] = (2).to_bytes(2, "little")
+    image[4:9] = b"nvram"
+    image[1] = MODULE.header_checksum(image[: MODULE.HEADER_SIZE])
+    part = partition(*entries)
+    image[0x60000 : 0x60000 + len(part)] = part
+    checksum = MODULE.zlib.adler32(image[20:])
+    image[16:20] = checksum.to_bytes(4, "little")
+    return bytes(image)
+
+
+class AuxBootArgsTest(unittest.TestCase):
+    def test_accepts_bank_aligned_layout(self):
+        image = bytearray(bank(b"boot-args="))
+
+        self.assertEqual(MODULE.validate_nvram_layout(image), [0])
+
+    def test_rejects_displaced_bank_layout(self):
+        image = bytearray(b"\0" * 0x4000 + bank(b"boot-args="))
+
+        with self.assertRaisesRegex(ValueError, "bank-aligned"):
+            MODULE.validate_nvram_layout(image)
+
+    def test_updates_every_valid_mirror(self):
+        original = bank(b"binary=\xff\x01", b"boot-args=", b"auto-boot=true")
+        image = bytearray(original + original)
+
+        self.assertEqual(MODULE.set_boot_args(image, b"-s serial=3"), 2)
+        for bank_offset in MODULE.nvram_banks(image):
+            matches = MODULE.system_partitions(
+                image, bank_offset, bank_offset + MODULE.NVRAM_BANK_SIZE
+            )
+            for offset, size in matches:
+                self.assertIn(b"boot-args=-s serial=3\0", image[offset : offset + size])
+
+    def test_rejects_missing_partition(self):
+        with self.assertRaisesRegex(ValueError, "no valid"):
+            MODULE.set_boot_args(bytearray(512), b"-s")
+
+    def test_rejects_oversized_value(self):
+        image = bytearray(bank(b"boot-args="))
+        with self.assertRaisesRegex(ValueError, "do not fit"):
+            MODULE.set_boot_args(image, b"x" * 512)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/27on86/test_serial_command.py b/tests/27on86/test_serial_command.py
new file mode 100644
index 0000000000..a853d98e6c
--- /dev/null
+++ b/tests/27on86/test_serial_command.py
@@ -0,0 +1,89 @@
+import importlib.util
+from pathlib import Path
+import re
+import socket
+import tempfile
+import threading
+import unittest
+
+
+SOURCE_ROOT = Path(__file__).resolve().parents[2]
+SCRIPT = SOURCE_ROOT / "scripts" / "27on86" / "serial-command.py"
+SPEC = importlib.util.spec_from_file_location("serial_command", SCRIPT)
+SERIAL_COMMAND = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(SERIAL_COMMAND)
+
+
+class FakeSerialShell(threading.Thread):
+    def __init__(self, path, output, status):
+        super().__init__(daemon=True)
+        self.path = path
+        self.output = output
+        self.status = status
+        self.error = None
+
+    def run(self):
+        try:
+            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
+                server.bind(self.path)
+                server.listen(1)
+                with server.accept()[0] as client:
+                    client.sendall(SERIAL_COMMAND.BOOT_PROMPT)
+                    self.receive_until(client, b"\n")
+                    setup = self.receive_until(client, b"\n")
+                    self.assert_contains(setup, b"stty -echo")
+                    client.sendall(SERIAL_COMMAND.READY_PROMPT)
+                    request = self.receive_until(client, b"$__27on86_status\"\n")
+                    match = re.search(rb"__27ON86_BEGIN_([0-9a-f]+)__", request)
+                    if not match:
+                        raise AssertionError("missing begin marker")
+                    token = match.group(1)
+                    response = (
+                        request
+                        + b"__27ON86_BEGIN_"
+                        + token
+                        + b"__\r\r\n"
+                        + self.output
+                        + b"\r\n__27ON86_END_"
+                        + token
+                        + b"__:%d\r\r\n" % self.status
+                    )
+                    client.sendall(response)
+        except Exception as error:
+            self.error = error
+
+    @staticmethod
+    def receive_until(client, marker):
+        data = bytearray()
+        while marker not in data:
+            chunk = client.recv(65536)
+            if not chunk:
+                raise AssertionError("client disconnected")
+            data.extend(chunk)
+        return bytes(data)
+
+    @staticmethod
+    def assert_contains(value, expected):
+        if expected not in value:
+            raise AssertionError(f"{expected!r} not in {value!r}")
+
+
+class SerialCommandTests(unittest.TestCase):
+    def test_returns_framed_output_and_guest_status(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = str(Path(directory) / "serial.sock")
+            server = FakeSerialShell(path, b"guest output", 7)
+            server.start()
+            while not Path(path).exists():
+                server.join(0.01)
+
+            status, output = SERIAL_COMMAND.run_command(path, "false", 2)
+            server.join(2)
+
+            self.assertIsNone(server.error)
+            self.assertEqual(status, 7)
+            self.assertEqual(output, b"guest output\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/27on86/vmapple-smoke.S b/tests/27on86/vmapple-smoke.S
