index 0000000000..450ee556a9
--- /dev/null
+++ b/tests/27on86/vmapple-smoke.S
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+    .section .text.boot, "ax"
+    .global _start
+
+_start:
+    movz    x0, #0x2001, lsl #16
+    mov     w3, #0x301
+    str     w3, [x0, #0x30]
+
+    mrs     x4, cntfrq_el0
+    movz    w5, #0x3600
+    movk    w5, #0x016e, lsl #16
+    cmp     w4, w5
+    b.ne    bad_cntfrq
+
+    adr     x1, message
+
+write_message:
+
+1:
+    ldrb    w2, [x1], #1
+    cbz     w2, 3f
+
+2:
+    ldr     w3, [x0, #0x18]
+    tbnz    w3, #5, 2b
+    str     w2, [x0]
+    b       1b
+
+3:
+    wfi
+    b       3b
+
+bad_cntfrq:
+    adr     x1, bad_cntfrq_message
+    b       write_message
+
+message:
+    .asciz  "VMAPPLE_TCG_SMOKE_OK\n"
+
+bad_cntfrq_message:
+    .asciz  "VMAPPLE_TCG_BAD_CNTFRQ\n"
