+#define VMAPPLE_MSI_VECTORS 64
+
+static void create_msi_frame(VMAppleMachineState *vms)
+{
+    DeviceState *dev = qdev_new(TYPE_VMAPPLE_MSI_FRAME);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+    int spi = vms->irqmap[VMAPPLE_MSIF];
+    int i;
+
+    /* Doorbell INTIDs are GIC INTIDs: SPI n is INTID n + 32 */
+    qdev_prop_set_uint32(dev, "base-intid", spi + 32);
+    qdev_prop_set_uint32(dev, "num-vectors", VMAPPLE_MSI_VECTORS);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, vms->memmap[VMAPPLE_MSIF].base);
+    for (i = 0; i < VMAPPLE_MSI_VECTORS; i++) {
+        qdev_connect_gpio_out_named(dev, "spi", i,
+                                    qdev_get_gpio_in(vms->gic, spi + i));
+    }
+}
+
+/*
+ * macOS 27 IOPCIFamily walks the capability list as if it were laid out in
+ * ascending offset order. QEMU links new capabilities at the head of the list,
+ * so devices such as virtio-pci come out in descending order and the guest
+ * loops forever in AppleVirtIO's vendor capability scan. Relink every
+ * function's list in ascending order once all devices exist.
+ */
+static void vmapple_pci_sort_caps(PCIBus *bus, PCIDevice *dev, void *opaque)
+{
+    uint8_t *conf = dev->config;
+    uint8_t offs[64];
+    int n = 0;
+    uint8_t pos;
+    int i, j;
+
+    if (!(conf[PCI_STATUS] & PCI_STATUS_CAP_LIST)) {
+        return;
+    }
+    for (pos = conf[PCI_CAPABILITY_LIST]; pos && n < ARRAY_SIZE(offs);
+         pos = conf[pos + PCI_CAP_LIST_NEXT]) {
+        offs[n++] = pos;
+    }
+    for (i = 1; i < n; i++) {
+        uint8_t v = offs[i];
+        for (j = i - 1; j >= 0 && offs[j] > v; j--) {
+            offs[j + 1] = offs[j];
+        }
+        offs[j + 1] = v;
+    }
+    conf[PCI_CAPABILITY_LIST] = n ? offs[0] : 0;
+    for (i = 0; i < n; i++) {
+        conf[offs[i] + PCI_CAP_LIST_NEXT] = i + 1 < n ? offs[i + 1] : 0;
+    }
+}
