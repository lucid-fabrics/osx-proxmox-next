+/*
+ * QTest testcase for the vmapple virtio-net defaults
+ *
+ * macOS AppleVirtIO tells the device a different device-area address than
+ * the one it polls when a small virtqueue's driver area straddles a 4 KiB
+ * boundary, which hangs the virtio-net control queue in about one boot in
+ * nine. The vmapple machine therefore does not offer the control queue or
+ * the features that depend on it. This checks those defaults and that a
+ * command line can still turn the control queue back on.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qobject/qdict.h"
+
+static const char *const ctrl_props[] = {
+    "ctrl_vq", "ctrl_rx", "ctrl_vlan", "ctrl_rx_extra", "ctrl_mac_addr",
+    "ctrl_guest_offloads", "guest_announce",
+};
+
+static bool get_bool(QTestState *qts, const char *path, const char *prop)
+{
+    QDict *resp = qtest_qmp(qts,
+        "{ 'execute': 'qom-get', 'arguments': "
+        "{ 'path': %s, 'property': %s } }", path, prop);
+    bool val;
+
+    g_assert(qdict_haskey(resp, "return"));
+    val = qdict_get_bool(resp, "return");
+    qobject_unref(resp);
+    return val;
+}
+
+/* Empty firmware, AUX and root images are enough to realize the board */
+static QTestState *start_vmapple(const char *netopts)
+{
+    g_autofree char *dir = g_dir_make_tmp("vmapple-net-test-XXXXXX", NULL);
+    g_autofree char *bios = g_build_filename(dir, "bios.bin", NULL);
+    g_autofree char *aux = g_build_filename(dir, "aux.img", NULL);
+    g_autofree char *root = g_build_filename(dir, "root.img", NULL);
+    QTestState *qts;
+
+    g_assert(dir);
+    g_assert(g_file_set_contents(bios, "", 0, NULL));
+    g_assert(truncate(bios, 64 * 1024) == 0);
+    g_assert(g_file_set_contents(aux, "", 0, NULL));
+    g_assert(truncate(aux, 1024 * 1024) == 0);
+    g_assert(g_file_set_contents(root, "", 0, NULL));
+    g_assert(truncate(root, 1024 * 1024) == 0);
+
+    qts = qtest_initf("-machine vmapple,uuid=1,memory-backend=m0 -cpu max "
+                      "-object memory-backend-memfd,share=on,id=m0,size=1G "
+                      "-m 1G -nodefaults -bios %s "
+                      "-drive if=pflash,format=raw,file=%s "
+                      "-drive if=pflash,format=raw,file=%s "
+                      "-device virtio-net-pci,id=n0%s",
+                      bios, aux, root, netopts);
+
+    unlink(bios);
+    unlink(aux);
+    unlink(root);
+    rmdir(dir);
+    return qts;
+}
+
+static void test_no_ctrl_vq(void)
+{
+    QTestState *qts = start_vmapple("");
+    size_t i;
+
+    for (i = 0; i < G_N_ELEMENTS(ctrl_props); i++) {
+        g_assert_false(get_bool(qts, "/machine/peripheral/n0/virtio-backend",
+                                ctrl_props[i]));
+    }
+    qtest_quit(qts);
+}
+
+static void test_ctrl_vq_override(void)
+{
+    QTestState *qts = start_vmapple(",ctrl_vq=on,ctrl_rx=on");
+
+    g_assert_true(get_bool(qts, "/machine/peripheral/n0/virtio-backend",
+                           "ctrl_vq"));
+    g_assert_true(get_bool(qts, "/machine/peripheral/n0/virtio-backend",
+                           "ctrl_rx"));
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    if (!qtest_has_machine("vmapple") || !qtest_has_accel("tcg")) {
+        g_test_skip("vmapple machine or TCG not available");
+        return g_test_run();
+    }
+    qtest_add_func("/vmapple/virtio-net/no-ctrl-vq", test_no_ctrl_vq);
+    qtest_add_func("/vmapple/virtio-net/ctrl-vq-override",
+                   test_ctrl_vq_override);
+    return g_test_run();
+}
