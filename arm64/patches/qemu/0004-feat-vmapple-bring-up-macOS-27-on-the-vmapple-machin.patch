+/*
+ * ECB or CBC (iv != NULL) over whole blocks, using QEMU's own AES block
+ * code so the device works without a host crypto library.
+ */
+static void aes_crypt(const uint8_t *key, int bits, const uint8_t *iv,
+                      bool encrypt, const uint8_t *in, uint8_t *out,
+                      size_t len)
+{
+    AES_KEY k;
+    uint8_t prev[AES_BLOCK_SIZE];
+    uint8_t blk[AES_BLOCK_SIZE];
+    size_t off;
+    int i;
+
+    if (encrypt) {
+        AES_set_encrypt_key(key, bits, &k);
+    } else {
+        AES_set_decrypt_key(key, bits, &k);
+    }
+    if (iv) {
+        memcpy(prev, iv, AES_BLOCK_SIZE);
+    }
+    for (off = 0; off < len; off += AES_BLOCK_SIZE) {
+        if (encrypt) {
+            for (i = 0; i < AES_BLOCK_SIZE; i++) {
+                blk[i] = in[off + i] ^ (iv ? prev[i] : 0);
+            }
+            AES_encrypt(blk, out + off, &k);
+            if (iv) {
+                memcpy(prev, out + off, AES_BLOCK_SIZE);
+            }
+        } else {
+            AES_decrypt(in + off, blk, &k);
+            for (i = 0; i < AES_BLOCK_SIZE; i++) {
+                blk[i] ^= iv ? prev[i] : 0;
+            }
+            if (iv) {
+                memcpy(prev, in + off, AES_BLOCK_SIZE);
+            }
+            memcpy(out + off, blk, AES_BLOCK_SIZE);
+        }
+    }
+}
