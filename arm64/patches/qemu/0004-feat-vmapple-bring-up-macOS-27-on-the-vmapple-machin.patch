--- /dev/null
+++ b/scripts/27on86/check-vmapple-hvc-msi.sh
@@ -0,0 +1,51 @@
+#!/bin/sh
+# Boot test for the vmapple Apple vendor hypercalls and the MSI frame.
+set -eu
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+source_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
+build_dir=${QEMU_27ON86_BUILD_DIR:-"$source_root/build"}
+qemu="$build_dir/qemu-system-aarch64"
+fixture_dir=$(mktemp -d "${TMPDIR:-/tmp}/27on86-hvc.XXXXXX")
+cleanup()
+{
+    rm -f "$fixture_dir"/*
+    rmdir "$fixture_dir"
+}
+trap cleanup EXIT HUP INT TERM
+if ! test -x "$qemu"; then
+    echo "missing emulator; run scripts/27on86/build-aarch64.sh" >&2
+    exit 1
+fi
+clang --target=aarch64-none-elf \
+    -c "$source_root/tests/27on86/vmapple-hvc-msi.S" \
+    -o "$fixture_dir/firmware.o"
+llvm-objcopy -O binary -j .text.boot "$fixture_dir/firmware.o" \
+    "$fixture_dir/firmware"
+truncate -s 16384 "$fixture_dir/aux"
+truncate -s 16384 "$fixture_dir/root"
+status=0
+timeout --signal=TERM 10s "$qemu" \
+    -machine vmapple,uuid=1,accel=tcg \
+    -cpu max \
+    -smp 1 \
+    -m 1G \
+    -nodefaults \
+    -display none \
+    -monitor none \
+    -serial stdio \
+    -no-reboot \
+    -bios "$fixture_dir/firmware" \
+    -drive file="$fixture_dir/aux",if=pflash,format=raw \
+    -drive file="$fixture_dir/root",if=pflash,format=raw \
+    >"$fixture_dir/log" 2>&1 || status=$?
+if test "$status" -ne 0 && test "$status" -ne 124; then
+    cat "$fixture_dir/log" >&2
+    echo "VMApple hypercall test exited unexpectedly: $status" >&2
+    exit 1
+fi
+if ! grep -Fq 'VMAPPLE_HVC_MSI_OK' "$fixture_dir/log"; then
+    cat "$fixture_dir/log" >&2
+    echo "VMApple hypercall/MSI test failed" >&2
+    exit 1
+fi
+echo "VMApple hypercall/MSI test passed"
