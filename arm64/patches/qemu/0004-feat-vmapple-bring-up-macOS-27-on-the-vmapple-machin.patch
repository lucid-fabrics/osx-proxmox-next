index 0000000000..1f7dbab584
--- /dev/null
+++ b/hw/vmapple/msi-frame.c
@@ -0,0 +1,138 @@
+/*
+ * Apple vmapple MSI frame
+ *
+ * The macOS 27 AppleVirtualPlatformPCIEMSIController reads a capability word
+ * from GIC register frame 2 (0x1fff0000) and then signals MSIs by writing the
+ * interrupt ID to a doorbell register. The layout is GICv2m-like:
+ *
+ *   0x08  RO  bit 31 valid, bits 28:16 base INTID, bits 12:0 vector count
+ *   0x40  WO  doorbell, write an INTID in [base, base + count) to raise it
+ *
+ * Each vector is wired to one GIC SPI by the board.
+ *
+ * Copyright (c) 2026 the 27on86 project
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/sysbus.h"
+#include "hw/vmapple/msi-frame.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "trace.h"
+
+#define MSI_FRAME_TYPER      0x08
+#define MSI_FRAME_SETSPI     0x40
+#define MSI_FRAME_SIZE       0x10000
+#define MSI_TYPER_VALID      (1u << 31)
+#define MSI_TYPER_BASE_SHIFT 16
+#define MSI_TYPER_BASE_MASK  0x1fffu
+#define MSI_TYPER_COUNT_MASK 0x1fffu
+
+struct VMAppleMSIFrameState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq spi[VMAPPLE_MSI_MAX_VECTORS];
+    uint32_t base_intid;
+    uint32_t num_vectors;
+};
+
+static uint64_t msi_frame_read(void *opaque, hwaddr offset, unsigned size)
+{
+    VMAppleMSIFrameState *s = opaque;
+    uint64_t val = 0;
+
+    if (offset == MSI_FRAME_TYPER) {
+        val = MSI_TYPER_VALID |
+              ((uint64_t)(s->base_intid & MSI_TYPER_BASE_MASK)
+               << MSI_TYPER_BASE_SHIFT) |
+              (s->num_vectors & MSI_TYPER_COUNT_MASK);
+    }
+    trace_vmapple_msi_frame_read(offset, val);
+    return val;
+}
+
+static void msi_frame_write(void *opaque, hwaddr offset, uint64_t val,
+                            unsigned size)
+{
+    VMAppleMSIFrameState *s = opaque;
+
+    trace_vmapple_msi_frame_write(offset, val);
+    if (offset != MSI_FRAME_SETSPI) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "vmapple-msi-frame: write to unknown offset 0x%"
+                      HWADDR_PRIx "\n", offset);
+        return;
+    }
+    if (val < s->base_intid || val >= s->base_intid + s->num_vectors) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "vmapple-msi-frame: doorbell INTID %" PRIu64
+                      " out of range\n", val);
+        return;
+    }
+    qemu_irq_pulse(s->spi[val - s->base_intid]);
+}
+
+static const MemoryRegionOps msi_frame_ops = {
+    .read = msi_frame_read,
+    .write = msi_frame_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 4,
+        .max_access_size = 8,
+    },
+};
+
+static void msi_frame_realize(DeviceState *dev, Error **errp)
+{
+    VMAppleMSIFrameState *s = VMAPPLE_MSI_FRAME(dev);
+
+    if (s->num_vectors == 0 || s->num_vectors > VMAPPLE_MSI_MAX_VECTORS) {
+        error_setg(errp, "num-vectors must be between 1 and %d",
+                   VMAPPLE_MSI_MAX_VECTORS);
+        return;
+    }
+    if (s->base_intid > MSI_TYPER_BASE_MASK) {
+        error_setg(errp, "base-intid does not fit in 13 bits");
+        return;
+    }
+    memory_region_init_io(&s->iomem, OBJECT(dev), &msi_frame_ops, s,
+                          "vmapple-msi-frame", MSI_FRAME_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    qdev_init_gpio_out_named(dev, s->spi, "spi", s->num_vectors);
+}
+
+static const Property msi_frame_properties[] = {
+    DEFINE_PROP_UINT32("base-intid", VMAppleMSIFrameState, base_intid, 128),
+    DEFINE_PROP_UINT32("num-vectors", VMAppleMSIFrameState, num_vectors, 64),
+};
+
+static void msi_frame_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = msi_frame_realize;
+    dc->desc = "Apple vmapple MSI frame";
+    device_class_set_props(dc, msi_frame_properties);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static const TypeInfo msi_frame_info = {
+    .name = TYPE_VMAPPLE_MSI_FRAME,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(VMAppleMSIFrameState),
+    .class_init = msi_frame_class_init,
+};
+
+static void msi_frame_register_types(void)
+{
+    type_register_static(&msi_frame_info);
+}
+
+type_init(msi_frame_register_types)
