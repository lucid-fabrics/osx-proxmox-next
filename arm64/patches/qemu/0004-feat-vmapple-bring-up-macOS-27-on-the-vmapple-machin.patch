diff --git a/tests/27on86/vmapple-handoff.S b/tests/27on86/vmapple-handoff.S
new file mode 100644
index 0000000000..361137aa0d
--- /dev/null
+++ b/tests/27on86/vmapple-handoff.S
@@ -0,0 +1,198 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Boot test for the vmapple XNU handoff hook (internal-use-only-unit).
+ * Builds a boot_args structure and a one-node Apple device tree in RAM and
+ * enters a fake iBoot trampoline at 0x101000 three times:
+ *   1. with a boot_args that has the wrong version, the tree must not change;
+ *   2. with a valid boot_args, /chosen/internal-use-only-unit must become 1;
+ *   3. after resetting the property, again with a valid boot_args, to prove
+ *      that the breakpoint is armed again after stepping over the trampoline.
+ * The XNU command line given with xnu-boot-args is checked on the same
+ * entries. Prints VMAPPLE_HANDOFF_OK on the PL011, or VMAPPLE_HANDOFF_FAIL <n>.
+ */
+    .section .text.boot, "ax"
+    .global _start
+    .set    DT_RAM, 0x70200000
+    .set    ARGS_RAM, 0x70100000
+    .set    BAD_ARGS_RAM, 0x70110000
+_start:
+    movz    x20, #0x2001, lsl #16        /* PL011 */
+    mov     w3, #0x301
+    str     w3, [x20, #0x30]
+    /* copy the device tree to RAM */
+    ldr     x0, =DT_RAM
+    adr     x1, dt_start
+    adr     x2, dt_end
+1:  ldr     w3, [x1], #4
+    str     w3, [x0], #4
+    cmp     x1, x2
+    b.lo    1b
+    /* boot_args: revision 3, version 2, virt base 0x80000000, phys base
+     * 0x70000000, device tree at virt 0x80200000 */
+    ldr     x4, =ARGS_RAM
+    movz    w3, #3
+    movk    w3, #2, lsl #16
+    str     w3, [x4]
+    movz    x3, #0x8000, lsl #16
+    str     x3, [x4, #8]
+    movz    x3, #0x7000, lsl #16
+    str     x3, [x4, #16]
+    movz    x3, #0x8020, lsl #16
+    str     x3, [x4, #96]
+    adr     x3, dt_end
+    adr     x5, dt_start
+    sub     w3, w3, w5
+    str     w3, [x4, #104]
+    /* a boot_args with version 0 */
+    ldr     x6, =BAD_ARGS_RAM
+    str     xzr, [x6]
+    ldr     x21, =DT_RAM + (dt_value - dt_start)
+    ldr     x22, =DT_RAM + (dt_asmb - dt_start)
+    ldr     x23, =DT_RAM + (dt_nsih - dt_start)
+    /* 1: wrong version */
+    mov     x1, x6
+    bl      tramp_call
+    ldr     w0, [x21]
+    cbnz    w0, fail1
+    ldr     w0, [x6, #108]
+    ldr     w9, [x6, #112]
+    orr     w0, w0, w9
+    cbnz    w0, fail1
+    ldr     w0, [x22]
+    cmp     w0, #2
+    b.ne    fail1
+    ldr     w0, [x23]
+    ldr     w9, =0x6e2d706c              /* "lp-n" */
+    cmp     w0, w9
+    b.ne    fail1
+    /* 2: valid */
+    ldr     x1, =ARGS_RAM
+    bl      tramp_call
+    ldr     w0, [x21]
+    cmp     w0, #1
+    b.ne    fail2
+    ldr     x4, =ARGS_RAM
+    ldr     w0, [x4, #108]
+    ldr     w9, =0x2d20732d              /* "-s -" */
+    cmp     w0, w9
+    b.ne    fail2
+    ldr     w0, [x4, #112]
+    ldr     w9, =0x65742076              /* "v te" */
+    cmp     w0, w9
+    b.ne    fail2
+    bl      check_csr
+    /* 3: valid again after resetting the properties */
+    str     wzr, [x21]
+    str     wzr, [x23, #36]
+    ldr     x1, =ARGS_RAM
+    bl      tramp_call
+    ldr     w0, [x21]
+    cmp     w0, #1
+    b.ne    fail3
+    bl      check_csr
+    adr     x1, ok_msg
+    b       print
+check_csr:
+    /* lp-nsih became lp-sip0 plus lp-pad, exactly once */
+    mov     x24, x30
+    ldr     w0, [x22]
+    cmp     w0, #3
+    b.ne    fail4
+    ldr     w0, [x23]
+    ldr     w9, =0x732d706c              /* "lp-s" */
+    cmp     w0, w9
+    b.ne    fail4
+    ldr     w0, [x23, #36]
+    cmp     w0, #0x7f
+    b.ne    fail4
+    ldr     w0, [x23, #44]
+    ldr     w9, =0x702d706c              /* "lp-p" */
+    cmp     w0, w9
+    b.ne    fail4
+    ret     x24
+fail4:
+    mov     w19, #4
+    b       fail
+fail1:
+    mov     w19, #1
+    b       fail
+fail2:
+    mov     w19, #2
+    b       fail
+fail3:
+    mov     w19, #3
+fail:
+    adr     x1, fail_msg
+    bl      puts
+    add     w19, w19, #'0'
+    mov     w2, w19
+    bl      putc
+    mov     w2, #10
+    bl      putc
+    b       halt
+print:
+    bl      puts
+halt:
+    wfi
+    b       halt
+tramp_call:
+    mov     x25, x30
+    ldr     x9, =0x101000
+    blr     x9
+    ret     x25
+puts:
+    mov     x24, x30
+1:  ldrb    w2, [x1], #1
+    cbz     w2, 2f
+    bl      putc
+    b       1b
+2:  ret     x24
+putc:
+    ldr     w3, [x20, #0x18]
+    tbnz    w3, #5, putc
+    str     w2, [x20]
+    ret
+    .ltorg
+ok_msg:
+    .asciz  "VMAPPLE_HANDOFF_OK\n"
+fail_msg:
+    .asciz  "VMAPPLE_HANDOFF_FAIL "
+    .balign 4
+dt_start:
+    /* root node: one property (name), one child */
+    .long   1, 1
+    .asciz  "name"
+    .fill   27, 1, 0
+    .long   12
+    .asciz  "device-tree"
+    /* /chosen: two properties, one child (asmb) */
+    .long   2, 1
+    .asciz  "name"
+    .fill   27, 1, 0
+    .long   7
+    .asciz  "chosen"
+    .balign 4
+    .asciz  "internal-use-only-unit"
+    .fill   9, 1, 0
+    .long   4
+dt_value:
+    .long   0
+    /* /chosen/asmb: name and a 48-byte lp-nsih, no children */
+dt_asmb:
+    .long   2, 0
+    .asciz  "name"
+    .fill   27, 1, 0
+    .long   5
+    .asciz  "asmb"
+    .balign 4
+dt_nsih:
+    .asciz  "lp-nsih"
+    .fill   24, 1, 0
+    .long   48
+    .fill   48, 1, 0xa5
+dt_end:
+    /* the fake trampoline, 0x1000 into the firmware image */
+    .org    0x1000
+tramp:
+    msr     daifset, #15
+    ret
diff --git a/tests/27on86/vmapple-hvc-msi.S b/tests/27on86/vmapple-hvc-msi.S
new file mode 100644
index 0000000000..fc9567be0a
--- /dev/null
+++ b/tests/27on86/vmapple-hvc-msi.S
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Boot test for the Apple vendor hypercalls and the vmapple MSI frame.
+ * Prints VMAPPLE_HVC_MSI_OK on the PL011, or VMAPPLE_HVC_MSI_FAIL <n>.
+ */
+    .section .text.boot, "ax"
+    .global _start
+
+    .macro  hvc_call id
+    movz    x0, #((\id) >> 16) & 0xffff, lsl #16
+    movk    x0, #(\id) & 0xffff
+    mov     x1, #0
+    hvc     #0
+    .endm
+
+    .macro  expect_x0 val, n
+    mov     x9, #\val
+    cmp     x0, x9
+    mov     w19, #\n
+    b.ne    fail
+    .endm
+
+_start:
+    movz    x20, #0x2001, lsl #16        /* PL011 */
+    mov     w3, #0x301
+    str     w3, [x20, #0x30]
+
+    hvc_call 0xc1000000
+    expect_x0 0, 1
+
+    hvc_call 0xc1000001
+    expect_x0 0, 2
+    ldr     x9, =0x5250505250505250
+    cmp     x2, x9
+    mov     w19, #3
+    b.ne    fail
+    ldr     x9, =0x4a4f504a4f504a4f
+    cmp     x3, x9
+    mov     w19, #4
+    b.ne    fail
+
+    hvc_call 0xc1000003
+    expect_x0 0, 5
+    hvc_call 0xc1000004
+    expect_x0 0, 6
+    hvc_call 0xc1000005
+    expect_x0 0, 7
+
+    hvc_call 0xc10000f0
+    expect_x0 -1, 8
+    hvc_call 0x8300ff01
+    expect_x0 -1, 9
+    hvc_call 0xc3000003
+    expect_x0 -1, 10
+    hvc_call 0xc6000000
+    expect_x0 -1, 11
+
+    /* MSI frame: valid, base INTID 128, 64 vectors */
+    movz    x21, #0x1fff, lsl #16
+    ldr     w0, [x21, #8]
+    movz    w9, #0x8080, lsl #16
+    movk    w9, #0x0040
+    cmp     w0, w9
+    mov     w19, #12
+    b.ne    fail
+
+    /* Doorbell: SPI 96 (INTID 128) must become pending. Make it edge. */
+    movz    x22, #0x1000, lsl #16        /* GICD */
+    mov     w0, #0x52                    /* ARE_NS | EnableGrp1NS | EnableGrp0 */
+    str     w0, [x22]
+    add     x23, x22, #0xc00
+    mov     w0, #2
+    str     w0, [x23, #0x20]             /* ICFGR8: INTID 128 edge */
+    mov     w0, #0x80
+    str     w0, [x21, #0x40]
+    ldr     w0, [x22, #0x210]            /* ISPENDR4 bit 0 = INTID 128 */
+    tst     w0, #1
+    mov     w19, #13
+    b.eq    fail
+
+    adr     x1, ok_msg
+    b       print
+fail:
+    adr     x1, fail_msg
+    bl      puts
+    add     w19, w19, #'0'
+    mov     w2, w19
+    bl      putc
+    mov     w2, #10
+    bl      putc
+    b       halt
+print:
+    bl      puts
+halt:
+    wfi
+    b       halt
+puts:
+    mov     x24, x30
+1:  ldrb    w2, [x1], #1
+    cbz     w2, 2f
+    bl      putc
+    b       1b
+2:  ret     x24
+putc:
+    ldr     w3, [x20, #0x18]
+    tbnz    w3, #5, putc
+    str     w2, [x20]
+    ret
+    .ltorg
+ok_msg:
+    .asciz  "VMAPPLE_HVC_MSI_OK\n"
+fail_msg:
+    .asciz  "VMAPPLE_HVC_MSI_FAIL "
