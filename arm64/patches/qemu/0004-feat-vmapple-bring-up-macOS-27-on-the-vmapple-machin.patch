+/*
+ * XNU handoff hook.
+ *
+ * iBoot builds the Apple device tree and then enters a small trampoline
+ * (xnu-handoff-pc, 0xe0a00000 for macOS 27) twice per boot: once for its
+ * second stage and once for XNU, with x1 pointing at XNU's boot_args.  XNU
+ * derives csr_config from /chosen/internal-use-only-unit when the local
+ * policy has no lp-sip0, and the unencrypted Data volume of a guest without
+ * a SEP only mounts when CSR_ALLOW_APPLE_INTERNAL is set.  We stop the boot
+ * CPU on the trampoline, set that property in the final device tree, and
+ * resume.  No guest-visible device or register is involved.
+ */
+#define BOOT_ARGS_VERSION_OFF    2
+#define BOOT_ARGS_VIRT_BASE_OFF  8
+#define BOOT_ARGS_PHYS_BASE_OFF  16
+#define BOOT_ARGS_DT_OFF         96
+#define BOOT_ARGS_DT_LEN_OFF     104
+#define BOOT_ARGS_CMDLINE_OFF    108
+#define BOOT_ARGS_CMDLINE_SIZE   608
+#define ADT_NAME_SIZE            32
+#define ADT_LEN_MASK             0x00ffffffu
+#define ADT_MAX_SIZE             (16 * MiB)
+
+/*
+ * Find property @prop of the node reached through @path (child names below
+ * the root node) in a flattened Apple device tree.  Returns the offset and
+ * length of the value.
+ */
+static bool adt_node_find(const uint8_t *t, size_t len, size_t *pos,
+                          const char *const *path, int npath, int depth,
+                          bool parent_match, const char *prop,
+                          size_t *noff, size_t *voff, uint32_t *vlen)
+{
+    uint32_t nprops, nchildren;
+    char own_name[ADT_NAME_SIZE] = "";
+    bool match, found = false;
+    size_t pv_off = 0;
+    uint32_t pv_len = 0;
+    size_t node_start = *pos;
+    uint32_t i;
+
+    if (*pos + 8 > len) {
+        return false;
+    }
+    nprops = ldl_le_p(t + *pos);
+    nchildren = ldl_le_p(t + *pos + 4);
+    *pos += 8;
+
+    for (i = 0; i < nprops; i++) {
+        uint32_t plen;
+
+        if (*pos + ADT_NAME_SIZE + 4 > len) {
+            return false;
+        }
+        plen = ldl_le_p(t + *pos + ADT_NAME_SIZE) & ADT_LEN_MASK;
+        if (*pos + ADT_NAME_SIZE + 4 + plen > len) {
+            return false;
+        }
+        if (!strncmp((const char *)t + *pos, "name", ADT_NAME_SIZE)) {
+            strncpy(own_name, (const char *)t + *pos + ADT_NAME_SIZE + 4,
+                    MIN(plen, ADT_NAME_SIZE - 1));
+        } else if (!strncmp((const char *)t + *pos, prop, ADT_NAME_SIZE)) {
+            found = true;
+            pv_off = *pos + ADT_NAME_SIZE + 4;
+            pv_len = plen;
+        }
+        *pos += ADT_NAME_SIZE + 4 + ((plen + 3) & ~3u);
+    }
+
+    match = depth == 0 ||
+            (parent_match && depth <= npath &&
+             !strcmp(own_name, path[depth - 1]));
+    if (match && depth == npath && found) {
+        *noff = node_start;
+        *voff = pv_off;
+        *vlen = pv_len;
+        return true;
+    }
+    for (i = 0; i < nchildren; i++) {
+        if (adt_node_find(t, len, pos, path, npath, depth + 1, match, prop,
+                          noff, voff, vlen)) {
+            return true;
+        }
+        if (*pos > len) {
+            return false;
+        }
+    }
+    return false;
+}
+
+static bool vmapple_dt_set_internal_use(uint8_t *dt, size_t len)
+{
+    static const char *const path[] = { "chosen" };
+    size_t pos = 0, noff, voff;
+    uint32_t vlen;
+
+    if (!adt_node_find(dt, len, &pos, path, 1, 0, true,
+                       "internal-use-only-unit", &noff, &voff, &vlen) ||
+        vlen != sizeof(uint32_t)) {
+        return false;
+    }
+    stl_le_p(dt + voff, 1);
+    return true;
+}
+
+/*
+ * XNU reads the SIP policy from /chosen/asmb/lp-sip0 (8 bytes).  iBoot does
+ * not emit it for macOS 27 local policies, and the tree cannot grow in
+ * place, so turn the 48-byte lp-nsih (a hash only userspace looks at) into
+ * lp-sip0 followed by a 4-byte padding property.
+ */
+static bool vmapple_dt_set_csr_config(uint8_t *dt, size_t len, uint32_t csr)
+{
+    static const char *const path[] = { "chosen", "asmb" };
+    size_t pos = 0, noff, voff;
+    uint32_t vlen;
+
+    pos = 0;
+    if (adt_node_find(dt, len, &pos, path, 2, 0, true, "lp-sip0",
+                      &noff, &voff, &vlen)) {
+        if (vlen != sizeof(uint64_t)) {
+            return false;
+        }
+        stq_le_p(dt + voff, csr);
+        return true;
+    }
+    pos = 0;
+    if (!adt_node_find(dt, len, &pos, path, 2, 0, true, "lp-nsih",
+                       &noff, &voff, &vlen) ||
+        vlen != 48) {
+        return false;
+    }
+    stl_le_p(dt + noff, ldl_le_p(dt + noff) + 1);
+    memset(dt + voff - ADT_NAME_SIZE - 4, 0, ADT_NAME_SIZE);
+    memcpy(dt + voff - ADT_NAME_SIZE - 4, "lp-sip0", sizeof("lp-sip0"));
+    stl_le_p(dt + voff - 4, sizeof(uint64_t));
+    stq_le_p(dt + voff, csr);
+    memset(dt + voff + 8, 0, ADT_NAME_SIZE);
+    memcpy(dt + voff + 8, "lp-pad", sizeof("lp-pad"));
+    stl_le_p(dt + voff + 8 + ADT_NAME_SIZE, sizeof(uint32_t));
+    stl_le_p(dt + voff + 8 + ADT_NAME_SIZE + 4, 0);
+    return true;
+}
+
+static void vmapple_patch_boot_args(VMAppleMachineState *vms, uint64_t args)
+{
+    uint8_t hdr[BOOT_ARGS_DT_LEN_OFF + 4];
+    uint64_t virt_base, phys_base, dt_virt;
+    uint32_t dt_len;
+    hwaddr dt_pa;
+    uint8_t *dt;
+
+    if (address_space_read(&address_space_memory, args, MEMTXATTRS_UNSPECIFIED,
+                          hdr, sizeof(hdr)) != MEMTX_OK) {
+        return;
+    }
+    /* The first entry (second-stage loader) passes no boot_args. */
+    if (lduw_le_p(hdr + BOOT_ARGS_VERSION_OFF) != 2) {
+        return;
+    }
+    virt_base = ldq_le_p(hdr + BOOT_ARGS_VIRT_BASE_OFF);
+    phys_base = ldq_le_p(hdr + BOOT_ARGS_PHYS_BASE_OFF);
+    dt_virt = ldq_le_p(hdr + BOOT_ARGS_DT_OFF);
+    dt_len = ldl_le_p(hdr + BOOT_ARGS_DT_LEN_OFF);
+    if (dt_virt < virt_base || !dt_len || dt_len > ADT_MAX_SIZE) {
+        warn_report("vmapple: implausible boot_args at 0x%" PRIx64, args);
+        return;
+    }
+    if (vms->xnu_boot_args) {
+        /*
+         * iBoot drops everything but allowed-boot-args from the NVRAM
+         * boot-args under full security. Replace the whole command line.
+         */
+        uint8_t cmdline[BOOT_ARGS_CMDLINE_SIZE] = { 0 };
+
+        pstrcpy((char *)cmdline, sizeof(cmdline), vms->xnu_boot_args);
+        address_space_write(&address_space_memory,
+                            args + BOOT_ARGS_CMDLINE_OFF,
+                            MEMTXATTRS_UNSPECIFIED, cmdline, sizeof(cmdline));
+    }
+    if (!vms->internal_use_only_unit && vms->csr_config < 0) {
+        return;
+    }
+    dt_pa = dt_virt - virt_base + phys_base;
+    dt = g_malloc(dt_len);
+    if (address_space_read(&address_space_memory, dt_pa,
+                           MEMTXATTRS_UNSPECIFIED, dt, dt_len) != MEMTX_OK) {
+        warn_report("vmapple: cannot read the device tree at 0x%" PRIx64,
+                    (uint64_t)dt_pa);
+        g_free(dt);
+        return;
+    }
+    if (vms->internal_use_only_unit &&
+        !vmapple_dt_set_internal_use(dt, dt_len)) {
+        warn_report("vmapple: no /chosen/internal-use-only-unit in the "
+                    "device tree at 0x%" PRIx64, (uint64_t)dt_pa);
+    }
+    if (vms->csr_config >= 0 &&
+        !vmapple_dt_set_csr_config(dt, dt_len, vms->csr_config)) {
+        warn_report("vmapple: cannot set /chosen/asmb/lp-sip0 in the "
+                    "device tree at 0x%" PRIx64, (uint64_t)dt_pa);
+    }
+    address_space_write(&address_space_memory, dt_pa, MEMTXATTRS_UNSPECIFIED,
+                        dt, dt_len);
+    g_free(dt);
+}
+
+static void vmapple_handoff_resume(void *opaque)
+{
+    vm_start();
+}
+
+static void vmapple_handoff_state(void *opaque, bool running, RunState state)
+{
+    VMAppleMachineState *vms = opaque;
+    CPUState *cs = first_cpu;
+    ARMCPU *cpu = ARM_CPU(cs);
+    uint64_t pc = cpu->env.pc;
+
+    if (running || state != RUN_STATE_DEBUG) {
+        return;
+    }
+    if (!vms->handoff_stepping && pc == vms->xnu_handoff_pc) {
+        vmapple_patch_boot_args(vms, cpu->env.xregs[1]);
+        /*
+         * Step over the trampoline's first instruction with a second
+         * breakpoint, then arm the first one again for the next entry.
+         */
+        cpu_breakpoint_remove_by_ref(cs, vms->handoff_bp);
+        cpu_breakpoint_insert(cs, vms->xnu_handoff_pc + 4, BP_GDB,
+                              &vms->handoff_bp);
+        vms->handoff_stepping = true;
+    } else if (vms->handoff_stepping && pc == vms->xnu_handoff_pc + 4) {
+        cpu_breakpoint_remove_by_ref(cs, vms->handoff_bp);
+        cpu_breakpoint_insert(cs, vms->xnu_handoff_pc, BP_GDB,
+                              &vms->handoff_bp);
+        vms->handoff_stepping = false;
+    } else {
+        return;
+    }
+    aio_bh_schedule_oneshot(qemu_get_aio_context(), vmapple_handoff_resume,
+                            NULL);
+}
