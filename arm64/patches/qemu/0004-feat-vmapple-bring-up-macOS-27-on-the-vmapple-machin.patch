diff --git a/scripts/27on86/check-vmapple-handoff.sh b/scripts/27on86/check-vmapple-handoff.sh
new file mode 100755
index 0000000000..7a8ddb1549
--- /dev/null
+++ b/scripts/27on86/check-vmapple-handoff.sh
@@ -0,0 +1,66 @@
+#!/bin/sh
+# Boot test for the vmapple XNU handoff hook (internal-use-only-unit).
+set -eu
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+source_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
+build_dir=${QEMU_27ON86_BUILD_DIR:-"$source_root/build"}
+qemu=${QEMU_27ON86_QEMU:-"$build_dir/qemu-system-aarch64"}
+fixture_dir=$(mktemp -d "${TMPDIR:-/tmp}/27on86-handoff.XXXXXX")
+cleanup()
+{
+    rm -f "$fixture_dir"/*
+    rmdir "$fixture_dir"
+}
+trap cleanup EXIT HUP INT TERM
+if ! test -x "$qemu"; then
+    echo "missing emulator; run scripts/27on86/build-aarch64.sh" >&2
+    exit 1
+fi
+clang --target=aarch64-none-elf \
+    -c "$source_root/tests/27on86/vmapple-handoff.S" \
+    -o "$fixture_dir/firmware.o"
+llvm-objcopy -O binary -j .text.boot "$fixture_dir/firmware.o" \
+    "$fixture_dir/firmware"
+truncate -s 16384 "$fixture_dir/aux"
+truncate -s 16384 "$fixture_dir/root"
+
+run_fixture()
+{
+    machine=$1
+    status=0
+    timeout --signal=TERM 10s "$qemu" \
+        -machine "$machine" \
+        -cpu max \
+        -smp 1 \
+        -m 1G \
+        -nodefaults \
+        -display none \
+        -monitor none \
+        -serial stdio \
+        -no-reboot \
+        -bios "$fixture_dir/firmware" \
+        -drive file="$fixture_dir/aux",if=pflash,format=raw \
+        -drive file="$fixture_dir/root",if=pflash,format=raw \
+        >"$fixture_dir/log" 2>&1 || status=$?
+    if test "$status" -ne 0 && test "$status" -ne 124; then
+        cat "$fixture_dir/log" >&2
+        echo "VMApple handoff test exited unexpectedly: $status" >&2
+        exit 1
+    fi
+}
+
+# With the hook the property must be set on the valid entries only.
+run_fixture "vmapple,uuid=1,accel=tcg,internal-use-only-unit=on,xnu-handoff-pc=0x101000,csr-config=0x7f,xnu-boot-args=-s -v test"
+if ! grep -Fq 'VMAPPLE_HANDOFF_OK' "$fixture_dir/log"; then
+    cat "$fixture_dir/log" >&2
+    echo "VMApple handoff test failed" >&2
+    exit 1
+fi
+# Without the hook the same fixture has to fail, or it proves nothing.
+run_fixture "vmapple,uuid=1,accel=tcg"
+if ! grep -Fq 'VMAPPLE_HANDOFF_FAIL 2' "$fixture_dir/log"; then
+    cat "$fixture_dir/log" >&2
+    echo "VMApple handoff fixture passes without the hook" >&2
+    exit 1
+fi
+echo "VMApple handoff test passed"
