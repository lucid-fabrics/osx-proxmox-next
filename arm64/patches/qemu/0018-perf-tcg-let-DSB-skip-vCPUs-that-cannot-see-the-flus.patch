diff --git a/accel/tcg/p80.c b/accel/tcg/p80.c
new file mode 100644
index 0000000000..0dcb63b184
--- /dev/null
+++ b/accel/tcg/p80.c
@@ -0,0 +1,306 @@
+/*
+ * P80 instrumentation (lab only, branch p80). P80_DIR=dir turns it on:
+ *  - dir/pc.bin: every P80_US microseconds (default 1000) one 24 byte record
+ *    per vCPU: realtime ns, last guest PC looked up, cpu index, halted,
+ *    running, state (see p80.h).
+ *  - dir/bc.txt: once a second, cumulative tlb_bc_sync statistics and the
+ *    host /proc/stat steal and total ticks.
+ */
+#include "qemu/osdep.h"
+#include "qemu/thread.h"
+#include "qemu/atomic.h"
+#include "qemu/rcu.h"
+#include "hw/core/cpu.h"
+#include "qemu/p80.h"
+#include <time.h>
+
+int p80_on;
+bool p80_bc_quiet;
+bool p80_bc_nowait;
+static char *p80_dir;
+static pthread_once_t p80_once = PTHREAD_ONCE_INIT;
+static int p80_us = 1000;
+
+#define P80_MAXCPU 64
+#define P80_NH 24
+typedef struct P80Stat {
+    uint64_t calls, waited, wait_ns;
+    uint64_t hist[P80_NH];          /* waited calls by log2(ns) */
+    uint64_t seg_n[P80_ST_N], seg_ns[P80_ST_N];   /* segments >= 4 us by target state */
+    uint64_t seg_stop_n, seg_stop_ns;             /* segment ended by target leaving the exec loop */
+    char pad[64];
+} P80Stat;
+static P80Stat p80_st[P80_MAXCPU];
+
+typedef struct P80Pc {
+    uint64_t t, pc;
+    uint16_t cpu;
+    uint8_t halted, running;
+    uint32_t state;
+} P80Pc;
+
+int p85_ctx_on;
+bool p85_bc_asid;
+bool p85_bc_bad;
+int (*p85_asid_fn)(CPUState *cpu);
+static uint64_t p85_af[P80_MAXCPU][8], p85_as[P80_MAXCPU][8];
+void p85_asid_count(int src, uint64_t filtered, uint64_t skipped)
+{
+    p85_af[src & (P80_MAXCPU - 1)][0] += filtered;
+    p85_as[src & (P80_MAXCPU - 1)][0] += skipped;
+}
+int p85_gen_on;
+void (*p85_ctx_fn)(CPUState *cpu, uint64_t *ttbr0, uint64_t *tpidr);
+typedef struct P85Pc {
+    uint64_t t, pc, ttbr0, tpidr;
+    uint16_t cpu;
+    uint8_t halted, running;
+    uint32_t state;
+} P85Pc;
+typedef struct P85Gen {
+    uint64_t t, ns, pc, ttbr0, tpidr;
+    uint16_t cpu, kind;
+    uint32_t pad;
+} P85Gen;
+#define P85_RING 65536
+typedef struct P85Ring {
+    P85Gen r[P85_RING];
+    uint64_t head, tail, drop;
+} P85Ring;
+static P85Ring *p85_ring[P80_MAXCPU];
+uint64_t p80_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+void p80_sync_call(int src, bool waited, uint64_t ns)
+{
+    P80Stat *s = &p80_st[src & (P80_MAXCPU - 1)];
+    s->calls++;
+    if (waited) {
+        int b = 63 - __builtin_clzll(ns | 1);
+        s->waited++;
+        s->wait_ns += ns;
+        s->hist[b < P80_NH ? b : P80_NH - 1]++;
+    }
+}
+
+void p80_sync_seg(int src, int st, int ran, uint64_t ns)
+{
+    P80Stat *s = &p80_st[src & (P80_MAXCPU - 1)];
+    if (!ran) {
+        s->seg_stop_n++;
+        s->seg_stop_ns += ns;
+    }
+    s->seg_n[st & (P80_ST_N - 1)]++;
+    s->seg_ns[st & (P80_ST_N - 1)] += ns;
+}
+
+void p85_gen_event(CPUState *cpu, uint64_t t0, uint64_t pc, int kind)
+{
+    P85Ring *g = p85_ring[cpu->cpu_index & (P80_MAXCPU - 1)];
+    uint64_t h;
+    P85Gen *e;
+    if (!g) {
+        return;
+    }
+    h = g->head;
+    if (h - qatomic_load_acquire(&g->tail) >= P85_RING) {
+        g->drop++;
+        return;
+    }
+    e = &g->r[h % P85_RING];
+    e->t = t0;
+    e->ns = p80_ns() - t0;
+    e->pc = pc;
+    e->ttbr0 = e->tpidr = 0;
+    if (p85_ctx_fn) {
+        p85_ctx_fn(cpu, &e->ttbr0, &e->tpidr);
+    }
+    e->cpu = cpu->cpu_index;
+    e->kind = kind;
+    e->pad = 0;
+    qatomic_store_release(&g->head, h + 1);
+}
+static void p85_drain(FILE *f)
+{
+    for (int c = 0; c < P80_MAXCPU; c++) {
+        P85Ring *g = p85_ring[c];
+        uint64_t h, t;
+        if (!g) {
+            continue;
+        }
+        h = qatomic_load_acquire(&g->head);
+        for (t = g->tail; t < h; t++) {
+            fwrite(&g->r[t % P85_RING], sizeof(P85Gen), 1, f);
+        }
+        qatomic_store_release(&g->tail, h);
+    }
+    fflush(f);
+}
+static void p80_dump(FILE *f, uint64_t now)
+{
+    unsigned long long u, n, sy, id, io, irq, sirq, steal = 0;
+    FILE *ps = fopen("/proc/stat", "r");
+    u = n = sy = id = io = irq = sirq = 0;
+    if (ps) {
+        if (fscanf(ps, "cpu %llu %llu %llu %llu %llu %llu %llu %llu",
+                   &u, &n, &sy, &id, &io, &irq, &sirq, &steal) != 8) {
+            steal = 0;
+        }
+        fclose(ps);
+    }
+    fprintf(f, "T %" PRIu64 " steal %llu total %llu\n", now, steal,
+            u + n + sy + id + io + irq + sirq + steal);
+    for (int c = 0; c < P80_MAXCPU; c++) {
+        P80Stat *s = &p80_st[c];
+        if (!s->calls) {
+            continue;
+        }
+        fprintf(f, "S %d %" PRIu64 " %" PRIu64 " %" PRIu64 " stop %" PRIu64 " %" PRIu64,
+                c, s->calls, s->waited, s->wait_ns, s->seg_stop_n, s->seg_stop_ns);
+        fprintf(f, " H");
+        for (int i = 0; i < P80_NH; i++) {
+            fprintf(f, " %" PRIu64, s->hist[i]);
+        }
+        fprintf(f, " G");
+        for (int i = 0; i < P80_ST_N; i++) {
+            fprintf(f, " %" PRIu64 ":%" PRIu64, s->seg_n[i], s->seg_ns[i]);
+        }
+        fprintf(f, "\n");
+    }
+    for (int c = 0; c < P80_MAXCPU; c++) {
+        if (p85_af[c][0]) {
+            fprintf(f, "A %d %" PRIu64 " %" PRIu64 "\n", c, p85_af[c][0], p85_as[c][0]);
+        }
+    }
+    fflush(f);
+}
+
+static void *p80_thread(void *arg)
+{
+    char *p = g_strdup_printf("%s/pc.bin", p80_dir);
+    char *b = g_strdup_printf("%s/bc.txt", p80_dir);
+    char *p2 = g_strdup_printf("%s/pc2.bin", p80_dir);
+    char *g2 = g_strdup_printf("%s/gen.bin", p80_dir);
+    char *on = g_strdup_printf("%s/gen.on", p80_dir);
+    FILE *fp = fopen(p85_ctx_on ? p2 : p, "w"), *fb = fopen(b, "w");
+    FILE *fg = p85_ctx_on ? fopen(g2, "w") : NULL;
+    uint64_t next = p80_ns(), nextd = next, nextg = next;
+    static P80Pc buf[4096];
+    static P85Pc buf2[4096];
+    int nb = 0;
+    g_free(p);
+    g_free(b);
+    g_free(p2);
+    g_free(g2);
+    if (!fp || !fb) {
+        return NULL;
+    }
+    for (;;) {
+        CPUState *cpu;
+        uint64_t now = p80_ns();
+        while (now < next) {
+            struct timespec ts = { 0, next - now };
+            nanosleep(&ts, NULL);
+            now = p80_ns();
+        }
+        next += p80_us * 1000ull;
+        if (now > next + 100000000ull) {
+            next = now;
+        }
+        WITH_RCU_READ_LOCK_GUARD() {
+            CPU_FOREACH(cpu) {
+                if (p85_ctx_on) {
+                    P85Pc *r2 = &buf2[nb++];
+                    r2->t = now;
+                    r2->pc = qatomic_read(&cpu->p80_pc);
+                    r2->ttbr0 = r2->tpidr = 0;
+                    if (p85_ctx_fn) {
+                        p85_ctx_fn(cpu, &r2->ttbr0, &r2->tpidr);
+                    }
+                    r2->cpu = cpu->cpu_index;
+                    r2->halted = qatomic_read(&cpu->halted);
+                    r2->running = qatomic_read(&cpu->running);
+                    r2->state = qatomic_read(&cpu->p80_state);
+                    if (nb == ARRAY_SIZE(buf2)) {
+                        fwrite(buf2, sizeof(buf2[0]), nb, fp);
+                        nb = 0;
+                    }
+                    continue;
+                }
+                P80Pc *r = &buf[nb++];
+                r->t = now;
+                r->pc = qatomic_read(&cpu->p80_pc);
+                r->cpu = cpu->cpu_index;
+                r->halted = qatomic_read(&cpu->halted);
+                r->running = qatomic_read(&cpu->running);
+                r->state = qatomic_read(&cpu->p80_state);
+                if (nb == ARRAY_SIZE(buf)) {
+                    fwrite(buf, sizeof(buf[0]), nb, fp);
+                    nb = 0;
+                }
+            }
+        }
+        if (fg && now >= nextg) {
+            nextg = now + 100000000ull;
+            if (!p85_ring[0]) {
+                for (int c = 0; c < P80_MAXCPU; c++) {
+                    p85_ring[c] = g_new0(P85Ring, 1);
+                }
+                smp_mb();
+            }
+            qatomic_set(&p85_gen_on, access(on, F_OK) == 0);
+            p85_drain(fg);
+        }
+        if (now >= nextd) {
+            nextd = now + 1000000000ull;
+            if (p85_ctx_on) {
+                fwrite(buf2, sizeof(buf2[0]), nb, fp);
+            } else {
+                fwrite(buf, sizeof(buf[0]), nb, fp);
+            }
+            nb = 0;
+            fflush(fp);
+            p80_dump(fb, now);
+        }
+    }
+    return NULL;
+}
+
+static void p80_init_once(void)
+{
+    const char *d = getenv("P80_DIR");
+    const char *u = getenv("P80_US");
+    const char *bc = getenv("P80_BC");
+    QemuThread t;
+    if (bc && strstr(bc, "quiet")) {
+        p80_bc_quiet = true;
+    }
+    if (bc && strstr(bc, "nowait")) {
+        p80_bc_nowait = true;
+    }
+    if (getenv("P85_BC") && strstr(getenv("P85_BC"), "asid")) {
+        p85_bc_asid = true;
+    }
+    if (getenv("P85_BC") && strstr(getenv("P85_BC"), "asidbad")) {
+        p85_bc_bad = true;     /* broken on purpose: a negative control for the tests */
+    }
+    if (!d || !*d) {
+        return;
+    }
+    if (u && atoi(u) > 0) {
+        p80_us = atoi(u);
+    }
+    p80_dir = g_strdup(d);
+    p85_ctx_on = getenv("P85_CTX") && atoi(getenv("P85_CTX")) > 0;
+    p80_on = 1;
+    qemu_thread_create(&t, "p80", p80_thread, NULL, QEMU_THREAD_DETACHED);
+}
+
+void p80_init(void)
+{
+    pthread_once(&p80_once, p80_init_once);
+}
