     }
-
+    qatomic_set(&cpu->p80_pc, s.pc);
     tb = tb_lookup(cpu, s);
     if (tb == NULL) {
         return tcg_code_gen_epilogue;
@@ -436,7 +437,7 @@ const void *HELPER(ras_fill)(CPUArchState *env, void *call)
     if (check_for_breakpoints(cpu, s.pc, &s.cflags)) {
         cpu_loop_exit(cpu);
     }
-
+    qatomic_set(&cpu->p80_pc, s.pc);
     tb = tb_lookup(cpu, s);
     if (tb == NULL) {
         return tcg_code_gen_epilogue;
@@ -483,7 +484,7 @@ const void *HELPER(ibc_miss)(CPUArchState *env, void *slot)
     if (check_for_breakpoints(cpu, s.pc, &s.cflags)) {
         cpu_loop_exit(cpu);
     }
-
+    qatomic_set(&cpu->p80_pc, s.pc);
     tb = tb_lookup(cpu, s);
     if (tb == NULL) {
         return tcg_code_gen_epilogue;
@@ -953,8 +954,13 @@ static inline bool cpu_handle_interrupt(CPUState *cpu,
     }
     if (unlikely(cpu_test_interrupt(cpu, ~0)) &&
         !cpu_interrupt_is_inert(cpu)) {
+        bool quiet;
         p35_inc(P35_BQL_INT_TAKE);
+        quiet = p80_quiet_enter(&cpu->tlb_bc_quiet);
         bql_lock();
+        if (quiet) {
+            p80_quiet_leave(&cpu->tlb_bc_quiet);
