diff --git a/include/qemu/p80.h b/include/qemu/p80.h
new file mode 100644
index 0000000000..4911793e20
--- /dev/null
+++ b/include/qemu/p80.h
@@ -0,0 +1,74 @@
+/*
+ * P80 instrumentation (lab only, branch p80, off unless P80_DIR is set):
+ * a guest PC sampler (last TB looked up per vCPU) and statistics of the
+ * broadcast TLB maintenance wait (tlb_bc_sync).
+ */
+#ifndef QEMU_P80_H
+#define QEMU_P80_H
+
+#include "qemu/atomic.h"
+
+enum {
+    P80_ST_EXEC = 0,    /* executing or in the exec loop */
+    P80_ST_BQL = 1,     /* waiting for the BQL */
+    P80_ST_GEN = 2,     /* translating or loading a TB */
+    P80_ST_SYNC = 3,    /* in tlb_bc_sync (its own DSB wait) */
+    P80_ST_FLUSH = 4,   /* applying its mailbox */
+    P80_ST_FILL = 5,    /* page table walk */
+    P80_ST_N = 8,
+};
+
+extern int p80_on;
+extern bool p80_bc_quiet;
+/* P80_BC=nowait: DSB never waits (broken on purpose, a negative control for the tests) */
+extern bool p80_bc_nowait;
+#define P80_ST_QUIET 6  /* p80_sync_seg: wait ended because the target was quiet */
+
+/* Enter and leave a quiet region (see CPUState.tlb_bc_quiet). */
+static inline bool p80_quiet_enter(uint32_t *q)
+{
+    if (p80_bc_quiet) {
+        qatomic_set(q, 1);
+        return true;
+    }
+    return false;
+}
+static inline void p80_quiet_leave(uint32_t *q)
+{
+    /* Order the clear before the icount_decr read at the next TB start. */
+    qatomic_set(q, 0);
+    smp_mb();
+}
+void p80_init(void);
+/*
+ * P85_BC=asid: a DSB does not wait for a vCPU whose current ASID differs from
+ * the one ASID that every TLBI posted since the last DSB was limited to (VAE1IS
+ * and VALE1IS on a TTBR0 address, ASIDE1IS).  Such a vCPU holds no non-global
+ * entry of that ASID: an ASID switch flushes the non-global EL1&0 entries.
+ */
+#define P85_ASID_MIX 0xffffffffu
+extern bool p85_bc_asid;
+/* P85_BC=asidbad: skip the vCPU even in the same ASID (negative control) */
+extern bool p85_bc_bad;
+extern int (*p85_asid_fn)(CPUState *cpu);
+void p85_asid_count(int src, uint64_t filtered, uint64_t skipped);
+/*
+ * P85 (lab only, with P80_DIR): P85_CTX=1 writes pc2.bin (40 byte records with the guest TTBR0_EL1 and
+ * TPIDR_EL1, i.e. process and thread), and gen.bin: one record per tb_gen_code while the file
+ * P80_DIR/gen.on exists (start ns, ns spent, guest pc, ttbr0, tpidr, cpu, kind 1 pack hit,
+ * 2 translated after a pack miss, 3 translated, not eligible for the pack).
+ */
+extern int p85_ctx_on;
+extern int p85_gen_on;
+extern void (*p85_ctx_fn)(CPUState *cpu, uint64_t *ttbr0, uint64_t *tpidr);
+void p85_gen_event(CPUState *cpu, uint64_t t0, uint64_t pc, int kind);
+uint64_t p80_ns(void);
+void p80_sync_seg(int src, int st, int ran, uint64_t ns);
+void p80_sync_call(int src, bool waited, uint64_t ns);
+
+#define P80_SET(cpu, st) \
+    uint32_t p80_old_ = qatomic_read(&(cpu)->p80_state); \
+    qatomic_set(&(cpu)->p80_state, (st))
+#define P80_RESTORE(cpu) qatomic_set(&(cpu)->p80_state, p80_old_)
+
+#endif
