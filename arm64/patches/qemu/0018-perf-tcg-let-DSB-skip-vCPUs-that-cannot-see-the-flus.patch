diff --git a/accel/tcg/cputlb.c b/accel/tcg/cputlb.c
index 3629b23185..0d07c9fdd4 100644
--- a/accel/tcg/cputlb.c
+++ b/accel/tcg/cputlb.c
@@ -18,6 +18,7 @@
  */
 
 #include "qemu/osdep.h"
+#include "qemu/p80.h"
 #include "qemu/p35-stats.h"
 #include "qemu/main-loop.h"
 #include "qemu/target-info.h"
@@ -1216,6 +1217,13 @@ void tlb_bc_enable(void)
 {
     tlb_bc_on = true;
     tlb_bc_process_fn = tlb_bc_process;
+    p80_init();
+    if (p80_bc_quiet) {
+        info_report("P80: DSB does not wait for vCPUs between TBs");
+    }
+    if (p85_bc_asid) {
+        info_report("P85: DSB does not wait for vCPUs in another ASID");
+    }
 }
 
 static bool tlb_bc_usable(CPUState *src)
@@ -1291,6 +1299,13 @@ static void tlb_bc_broadcast(CPUState *src, TLBBcRec *r)
         src->tlb_bc_wait[dst->cpu_index] = r->ticket;
     }
     src->tlb_bc_nwait = 1;
+    if (!src->p85_tlbi_asid) {
+        src->p85_dsb_asid = P85_ASID_MIX;
+    } else if (src->p85_dsb_asid == 0) {
+        src->p85_dsb_asid = src->p85_tlbi_asid;
+    } else if (src->p85_tlbi_asid != src->p85_dsb_asid) {
+        src->p85_dsb_asid = P85_ASID_MIX;
+    }
     /* Store the records before reading cpu->running. */
     smp_mb();
     CPU_FOREACH(dst) {
@@ -1310,6 +1325,7 @@ bool tlb_bc_process(CPUState *cpu)
     uint64_t last;
 
     assert_cpu_is_self(cpu);
+    P80_SET(cpu, P80_ST_FLUSH);
     qemu_spin_lock(&m->lock);
     n = m->n;
     memcpy(local, m->rec, n * sizeof(local[0]));
@@ -1318,9 +1334,9 @@ bool tlb_bc_process(CPUState *cpu)
     last = m->issued;
     qemu_spin_unlock(&m->lock);
     if (!n) {
+        P80_RESTORE(cpu);
         return false;
     }
-
     /* Whole-index flushes first, then what they did not already cover. */
     for (i = 0; i < n; i++) {
         if (local[i].kind == TLB_BC_IDX) {
@@ -1340,6 +1356,7 @@ bool tlb_bc_process(CPUState *cpu)
         }
     }
     qatomic_store_release(&m->done, last);
+    P80_RESTORE(cpu);
     return true;
 }
 
@@ -1347,14 +1364,23 @@ void tlb_bc_sync(CPUState *src, uintptr_t ra)
 {
     CPUState *dst;
     unsigned spins = 0;
-
+    uint64_t p80_t0 = 0;
+    bool p80_waited = false;
+    uint32_t fa;
+    uint64_t p85_skip = 0;
     if (!src->tlb_bc_nwait) {
         return;
     }
+    fa = p85_bc_asid && p85_asid_fn && src->p85_dsb_asid != P85_ASID_MIX ?
+         src->p85_dsb_asid : 0;
+    if (p80_on) {
+        p80_t0 = p80_ns();
+        qatomic_set(&src->p80_state, P80_ST_SYNC);
+    }
     smp_mb();
     CPU_FOREACH(dst) {
-        uint64_t t;
-
+        uint64_t t, ts = 0;
+        int st = -1;
         if (dst == src) {
             continue;
         }
@@ -1362,8 +1388,43 @@ void tlb_bc_sync(CPUState *src, uintptr_t ra)
         if (!t) {
             continue;
         }
+        if (fa && qatomic_load_acquire(&dst->tlb_bc.done) < t &&
+            qatomic_read(&dst->running)) {
+            /*
+             * After the barrier above: a vCPU that switches to this ASID
+             * now flushes its non-global entries first (vmsa_ttbr_write),
+             * and walks the page tables the poster already updated.
+             */
+            int da = p85_asid_fn(dst);
+            if (da >= 0 && (da != (int)(fa & 0xffff) || p85_bc_bad)) {
+                p85_skip++;
+                src->tlb_bc_wait[dst->cpu_index] = 0;
+                continue;
+            }
+        }
         while (qatomic_load_acquire(&dst->tlb_bc.done) < t &&
                qatomic_read(&dst->running)) {
+            if (unlikely(p80_bc_nowait) ||
+                (p80_bc_quiet && qatomic_read(&dst->tlb_bc_quiet))) {
+                /*
+                 * Between TBs, it reaches a TB start (icount_decr is set)
+                 * and applies the records before any data access.
+                 */
+                if (unlikely(p80_on) && ts) {
+                    p80_sync_seg(src->cpu_index, P80_ST_QUIET, 1,
+                                 p80_ns() - ts);
+                }
+                break;
+            }
+            if (unlikely(p80_on)) {
+                p80_waited = true;
+                if (!ts) {
+                    ts = p80_ns();
+                } else if (st < 0 && (spins & 15) == 0 &&
+                           p80_ns() - ts > 4000) {
+                    st = qatomic_read(&dst->p80_state);
+                }
+            }
             if (qatomic_read(&src->tlb_bc.pending) && tlb_bc_process(src)) {
                 /* leave the chain of TBs at the next TB boundary */
                 qatomic_set(&src->neg.icount_decr.u16.high, -1);
@@ -1371,13 +1432,29 @@ void tlb_bc_sync(CPUState *src, uintptr_t ra)
             if (++spins % 1024 == 0 &&
                 (qatomic_read(&src->exit_request) || src->stop)) {
                 /* Let the stop happen, the DSB runs again afterwards. */
+                if (p80_on) {
+                    qatomic_set(&src->p80_state, P80_ST_EXEC);
+                }
                 cpu_loop_exit_restore(src, ra);
             }
             cpu_relax();
         }
+        if (unlikely(p80_on) && st >= 0) {
+            p80_sync_seg(src->cpu_index, st,
+                         qatomic_load_acquire(&dst->tlb_bc.done) >= t,
+                         p80_ns() - ts);
+        }
         src->tlb_bc_wait[dst->cpu_index] = 0;
     }
     src->tlb_bc_nwait = 0;
+    src->p85_dsb_asid = 0;
+    if (fa && p80_on) {
+        p85_asid_count(src->cpu_index, 1, p85_skip);
+    }
+    if (p80_on) {
+        p80_sync_call(src->cpu_index, p80_waited, p80_ns() - p80_t0);
+        qatomic_set(&src->p80_state, P80_ST_EXEC);
+    }
 }
 
 /* update the TLBs so that writes to code in the virtual page 'addr'
@@ -1809,12 +1886,14 @@ static bool tlb_fill_align(CPUState *cpu, vaddr addr, MMUAccessType type,
 {
     const TCGCPUOps *ops = cpu->cc->tcg_ops;
     CPUTLBEntryFull full = { };
-
+    P80_SET(cpu, P80_ST_FILL);
     if (ops->tlb_fill_align) {
         uint64_t ts_t0 G_GNUC_UNUSED = tlbs_now();
         uint64_t p35_t0 = unlikely(p35_on) ? cpu_get_host_ticks() : 0;
-        if (ops->tlb_fill_align(cpu, &full, addr, type, mmu_idx,
-                                memop, size, probe, ra)) {
+        bool p80_ok = ops->tlb_fill_align(cpu, &full, addr, type, mmu_idx,
+                                          memop, size, probe, ra);
+        P80_RESTORE(cpu);
+        if (p80_ok) {
             if (unlikely(p35_on)) {
                 uint64_t p35_t1 = cpu_get_host_ticks();
                 p35_add(P35_FILL_N, 1);
@@ -1838,6 +1917,7 @@ static bool tlb_fill_align(CPUState *cpu, vaddr addr, MMUAccessType type,
         if (addr & ((1u << memop_alignment_bits(memop)) - 1)) {
             ops->do_unaligned_access(cpu, addr, type, mmu_idx, ra);
         }
+        P80_RESTORE(cpu);
         if (ops->tlb_fill(cpu, addr, size, type, mmu_idx, probe, ra)) {
             return true;
         }
