         if (cpu_test_interrupt(cpu, CPU_INTERRUPT_DEBUG)) {
             cpu_reset_interrupt(cpu, CPU_INTERRUPT_DEBUG);
             cpu->exception_index = EXCP_DEBUG;
@@ -1119,14 +1125,21 @@ cpu_exec_loop(CPUState *cpu, SyncClocks *sc)
                 break;
             }
 
+            qatomic_set(&cpu->p80_pc, s.pc);
             tb = tb_lookup(cpu, s);
             if (tb == NULL) {
                 CPUJumpCache *jc;
                 uint32_t h;
-
+                bool quiet = !(s.cflags & CF_NOIRQ) &&
+                             p80_quiet_enter(&cpu->tlb_bc_quiet);
+                P80_SET(cpu, P80_ST_GEN);
                 mmap_lock();
                 tb = tb_gen_code(cpu, s);
                 mmap_unlock();
+                P80_RESTORE(cpu);
+                if (quiet) {
+                    p80_quiet_leave(&cpu->tlb_bc_quiet);
+                }
 
                 /*
                  * We add the TB in the virtual pc hash table
@@ -1168,6 +1181,10 @@ static int cpu_exec_setjmp(CPUState *cpu, SyncClocks *sc)
 {
