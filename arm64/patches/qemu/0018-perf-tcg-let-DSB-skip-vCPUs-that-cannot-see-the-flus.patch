+
+/* P85 (lab only): process (TTBR0_EL1) and thread (TPIDR_EL1) of a vCPU for the P80 sampler. */
+static void arm_p85_ctx(CPUState *cs, uint64_t *ttbr0, uint64_t *tpidr)
+{
+    CPUARMState *env = cpu_env(cs);
+    *ttbr0 = qatomic_read(&env->cp15.ttbr0_el[1]);
+    *tpidr = qatomic_read(&env->cp15.tpidr_el[1]);
+}
+/*
+ * P85_BC=asid: the ASID a vCPU runs EL1&0 with, -1 when it is not plainly in
+ * EL1&0 (EL2/EL3, E2H).  Read from another thread: the result is only trusted
+ * after tlb_bc_sync's barrier (see there).
+ */
+static int arm_p85_asid(CPUState *cs)
+{
+    CPUARMState *env = cpu_env(cs);
+    uint64_t tcr, ttbr;
+    int asid;
+    if (!qatomic_read(&env->aarch64) || arm_current_el(env) > 1 ||
+        (arm_hcr_el2_eff(env) & HCR_E2H)) {
+        return -1;
+    }
+    tcr = qatomic_read(&env->cp15.tcr_el[1]);
+    ttbr = extract64(tcr, 22, 1) ? qatomic_read(&env->cp15.ttbr1_el[1])
+                                 : qatomic_read(&env->cp15.ttbr0_el[1]);
+    asid = extract64(ttbr, 48, 16);
+    if (!extract64(tcr, 36, 1)) {
+        asid &= 0xff;
+    }
+    return asid;
+}
+static void __attribute__((constructor)) arm_p85_register(void)
+{
+    p85_ctx_fn = arm_p85_ctx;
+    p85_asid_fn = arm_p85_asid;
+}
