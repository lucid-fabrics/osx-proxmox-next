EOF
}

# The clock step after a resume waits for the guest's ssh and then for the clock, inside one budget. A guest resumed from a snapshot
# catches up on its overdue work first: on 6 threads its load average stays near 500 for about 5 minutes, and a 120 s budget
# gave up while the guest was fine. So the default scales with the host the way the golden waits do: 120 s from 12 threads, 300 s from
# 8, 600 s below. SETTIME_TIMEOUT overrides it (seconds). The CLI's own hard limit is 30 s above the budget.
settime_budget() {
  local t
  if [ -n "${SETTIME_TIMEOUT:-}" ]; then
    dec_into t "$SETTIME_TIMEOUT" SETTIME_TIMEOUT seconds
    echo "$t"; return
  fi
  dec_into t "${SNAPINTOSH_CHECK_THREADS:-$(nproc)}" SNAPINTOSH_CHECK_THREADS threads
  if [ "$t" -ge 12 ]; then echo 120; elif [ "$t" -ge 8 ]; then echo 300; else echo 600; fi
}

# ---------------------------------------------------------------- check-host
# dmi_ram_gb: installed RAM in GiB from the SMBIOS memory devices (type 17), or nothing when /sys/firmware/dmi is not readable (it is root only
# on most hosts). SNAPINTOSH_CHECK_DMI_GB overrides it for the tests (an empty value means unreadable).
dmi_ram_gb() {
  if [ -n "${SNAPINTOSH_CHECK_DMI_GB+x}" ]; then echo "$SNAPINTOSH_CHECK_DMI_GB"; return; fi
  python3 -I - <<'PY' 2>/dev/null || true
import glob, struct
mb = 0
for f in glob.glob("/sys/firmware/dmi/entries/17-*/raw"):
    try:
        d = open(f, "rb").read()
    except OSError:
        raise SystemExit(0)
    if len(d) < 0x10:
        continue
    sz = struct.unpack_from("<H", d, 0x0C)[0]
    if sz == 0x7FFF and len(d) >= 0x20:
        mb += struct.unpack_from("<I", d, 0x1C)[0] & 0x7FFFFFFF
    elif sz not in (0, 0xFFFF):
        mb += (sz & 0x7FFF) // 1024 if sz & 0x8000 else sz
if mb:
    print(mb // 1024)
PY
}
cmd_check_host() {
  local mem_kb mem_g cores model free_g
  echo "snapintosh check-host"
  if [ "$(uname -m)" = x86_64 ]; then ok "arch x86_64"; else bad "arch $(uname -m): only x86_64 hosts are built and tested"; fi
  model=$(awk -F: '/model name/ {gsub(/^ +/,"",$2); print $2; exit}' /proc/cpuinfo 2>/dev/null || true)
  dec_into cores "${SNAPINTOSH_CHECK_THREADS:-$(nproc)}" SNAPINTOSH_CHECK_THREADS threads   # the override is for the tests
  info "cpu: ${model:-unknown}, $cores threads"
  if [ "$cores" -ge 16 ]; then ok "$cores threads (lab reference: 16 vCPU Ryzen 9 9950X, guest 12 vCPUs)"
  elif [ "$cores" -ge 8 ]; then
    warn "$cores threads: works, slower. Cores matter: on 6 slow cores the first Safari launch of a boot loops for 2 to 5 minutes (GPU-process 3 s watchdog; a fix is in progress), and drag was 3.2 fps on ANV. Consider --cpus $cores or fewer"
  elif [ "$cores" -ge 6 ]; then
    warn "$cores threads: the smallest tested host (build 557 s, bench about 18 minutes per run). Use --cpus $cores --ram 4G; slow steps (golden, resume clock step) wait longer here"
  else bad "$cores threads: the TCG guest plus renderer threads need 6 or more (8 or more is comfortable)"; fi
  ok "KVM not needed: the guest is arm64 under TCG (QEMU software emulation)"

  # MemTotal of a 16 GiB machine is 15.2 to 15.9 GiB (firmware and kernel take their share), so the limits are a GiB lower than the
  # advertised size: 15 GiB (rounded down) counts as 16, 23 as 24. an iGPU carve-out (1 to 4 GiB of UMA frame buffer on
  # AMD APUs, 1 GiB on some Intel BIOSes) or a large crashkernel takes more: 13 to 14 GiB of MemTotal on a 16 GiB machine. That passes when the
  # installed size (DMI, readable only as root on most hosts) says 16 GiB or more, and warns when it cannot be read; below 13 GiB it fails.
  dec_into mem_kb "${SNAPINTOSH_CHECK_MEM_KB:-$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)}" SNAPINTOSH_CHECK_MEM_KB kB; mem_g=$((mem_kb / 1048576))
  if [ "$mem_g" -ge 23 ]; then ok "RAM ${mem_g} GiB"
  elif [ "$mem_g" -ge 15 ]; then warn "RAM ${mem_g} GiB (a 16 GiB machine shows 15 to 16): enough for one guest (use --ram 4G, or the default 8G with nothing else running). 24 GiB is the lab norm"
  elif [ "$mem_g" -ge 13 ]; then
    local phys; phys=$(dmi_ram_gb)
    if [ -z "$phys" ]; then warn "RAM ${mem_g} GiB visible: a 16 GiB machine with an iGPU carve-out or a crashkernel shows this, so it can work with --ram 4G; the installed size could not be read (run check-host as root, or: sudo dmidecode -t memory). Below 16 GiB installed the build and the guest do not fit"
    elif [ "$phys" -ge 16 ]; then warn "RAM ${mem_g} GiB visible of ${phys} GiB installed (iGPU carve-out or crashkernel): enough for one guest with --ram 4G"
    else bad "RAM ${mem_g} GiB (${phys} GiB installed): need 16 GiB (guest memfd, translation cache, renderer, build)"; fi
  else bad "RAM ${mem_g} GiB: need 16 GiB (guest memfd, translation cache, renderer, build)"; fi

  local probe=$HOME_DIR
  while [ ! -d "$probe" ] && [ "$probe" != / ]; do probe=$(dirname "$probe"); done
  free_g=$(df -Pk "$probe" 2>/dev/null | awk 'NR==2 {print int($4/1048576)}')
  free_g=${free_g:-0}
  # What is still missing decides what is needed (sizes measured on a clean-room install, GiB):
  #   toolchains + sources + build tree + prefix   3.5 + 2.3 + 8.5 + 0.8 = 15 (the build tree can be deleted afterwards)
  #   the Apple IPSW 25 (26.6 GB) and the imported disk plus golden 31 (disk.img 29 on a 64 GiB sparse file, golden 0.7)
  #   translation cache pack 4.5 per QEMU binary (3.7 to 4.0 GiB written by one cold boot)
  #   headroom 10: run overlays and one snapshot (8.6)
  # FAIL: free space is below that sum, the work cannot finish. WARN: less than 20 GiB above it (a second snapshot is 8.6).
  local need_g=10 parts="10 headroom"
  if [ ! -x "$PREFIX/bin/qemu-system-aarch64" ]; then need_g=$((need_g + 15)); parts="$parts + 15 build"; fi
  if [ ! -f "$VM/disk.img" ]; then
    need_g=$((need_g + 31)); parts="$parts + 31 disk"
    if ! ls "$DL"/*.ipsw >/dev/null 2>&1; then need_g=$((need_g + 25)); parts="$parts + 25 IPSW"; fi
  fi
  if ! ls "$PCACHE_DIR"/*.pack >/dev/null 2>&1; then need_g=$((need_g + 5)); parts="$parts + 5 pack"; fi
  if [ "$free_g" -ge $((need_g + 20)) ]; then ok "disk ${free_g} GiB free under $HOME_DIR (this host still needs $need_g: $parts)"
  elif [ "$free_g" -ge "$need_g" ]; then warn "disk ${free_g} GiB free under $HOME_DIR, enough for the $need_g GiB still needed ($parts) but under 20 GiB to spare (each snapshot adds 8.6)"
  else bad "disk ${free_g} GiB free under $HOME_DIR: the steps still to do need $need_g GiB ($parts)"; fi

  HAVE_GPU=0
  check_vulkan
  check_udmabuf
  check_tools
  check_repro_mnt
  echo
  echo "summary: $NFAIL failed, $NWARN warnings"
  [ "$NFAIL" -eq 0 ]
}

check_udmabuf() {
  local dev=${SNAPINTOSH_UDMABUF_DEV:-/dev/udmabuf} pdir=${SNAPINTOSH_UDMABUF_PARAMS:-/sys/module/udmabuf/parameters}
  local lim sz fail=bad grp
  # only the host-GPU path imports guest RAM through udmabuf: with lavapipe alone (no GPU) the lab ran 50 cold boots without it
  if [ "$HAVE_GPU" = 0 ]; then fail=warn; info "no host GPU found: udmabuf is only needed for --gpu 1, problems below are warnings"; fi
  if [ ! -e "$dev" ]; then
    $fail "$dev missing. The GPU path imports guest RAM through it"
    info "fix: sudo modprobe udmabuf   (at every boot: echo udmabuf | sudo tee /etc/modules-load.d/snapintosh-udmabuf.conf)"
    return
  fi
  if [ -r "$dev" ] && [ -w "$dev" ]; then ok "$dev readable and writable by $(id -un) ($(stat -c '%U:%G %a' "$dev"))"
  else
    grp=$(stat -c %G "$dev")
    $fail "$dev not accessible to $(id -un): it is $(stat -c '%U:%G %a' "$dev")"
    info "fix: sudo usermod -aG $grp $(id -un)   then log in again (a running ssh session keeps its old groups)"
    info "     or for every boot: echo 'KERNEL==\"udmabuf\", GROUP=\"$grp\", MODE=\"0660\"' | sudo tee /etc/udev/rules.d/99-snapintosh-udmabuf.rules; sudo udevadm control --reload; sudo udevadm trigger /dev/udmabuf"
  fi
  lim=$(cat "$pdir/list_limit" 2>/dev/null || echo "?")
  sz=$(cat "$pdir/size_limit_mb" 2>/dev/null || echo "?")
  info "udmabuf list_limit=$lim size_limit_mb=$sz (needed: at least 65536 and 4096; the kernel default is 1024 and 64)"
  local low=0
  if [ "$lim" != "?" ] && [ "$lim" -lt 65536 ]; then low=1; fi
  if [ "$sz" != "?" ] && [ "$sz" -lt 4096 ]; then low=1; fi
  if [ "$low" = 1 ]; then
    $fail "udmabuf limits too low (list_limit $lim, size_limit_mb $sz): the first present dies with 'pieces ... do not fit udmabuf's list_limit'"
    info "fix now:   echo 65536 | sudo tee $pdir/list_limit; echo 4096 | sudo tee $pdir/size_limit_mb"
    info "fix for every boot: echo 'options udmabuf list_limit=65536 size_limit_mb=4096' | sudo tee /etc/modprobe.d/snapintosh-udmabuf.conf"
  fi
}

# required extensions of the renderer
REQ_EXT=(VK_EXT_fragment_shader_interlock VK_EXT_external_memory_host)

check_vulkan() {
  local out dev found=0
  if ! command -v vulkaninfo >/dev/null 2>&1; then
    bad "vulkaninfo not installed (apt install vulkan-tools): cannot verify the GPU"
    return
  fi
  out=$(timeout 60 vulkaninfo 2>/dev/null || true)
  if [ -z "$out" ]; then bad "vulkaninfo printed nothing: no working Vulkan driver"; return; fi
  # split into per-device blocks: "GPU0:" ... ; extension lists sit under each device's block
  while IFS=$'\t' read -r idx name type vendor missing; do
    found=1
    [ "$vendor" = 0x10005 ] || HAVE_GPU=1
    local note=""
    case "$vendor" in
      0x10de) note="NVIDIA: lab-tested driver 615.71.10 (open kernel module), RTX 3060 Ti drag 1.6x lavapipe" ;;
      0x1002) note="AMD RADV: lab-tested Mesa 25.0.7 on a 2-CU Granite Ridge iGPU, drag 1.3x lavapipe. Needs /dev/udmabuf" ;;
      0x8086) note="Intel ANV: lab-tested Mesa 25.0.7 on Alder Lake Iris Xe, drag 2.2x lavapipe. Needs /dev/udmabuf" ;;
      0x10005) note="CPU renderer (lavapipe): stock Mesa 25.0.x lacks interlock; needs the patched Mesa 26.3 from 'build --only mesa'" ;;
      *) note="vendor $vendor not tested by the lab" ;;
    esac
    if [ -z "$missing" ]; then ok "Vulkan device $idx: $name ($type), required extensions present"
    else
      if [ "$vendor" = 0x10005 ]; then warn "Vulkan device $idx: $name: missing $missing (stock lavapipe)"
      else bad "Vulkan device $idx: $name: missing $missing"; fi
    fi
    info "$note"
  done < <(printf '%s\n' "$out" | python3 -I "$LIB/vkparse.py" "${REQ_EXT[@]}")
  [ "$found" -eq 1 ] || bad "no Vulkan physical device found in vulkaninfo output"
}

check_tools() {
  local t missing=""
  for t in git python3 curl qemu-img; do command -v "$t" >/dev/null 2>&1 || missing="$missing $t"; done
  if [ -x "$PREFIX/bin/qemu-img" ]; then missing=${missing// qemu-img/}; fi
  if [ -z "$missing" ]; then ok "tools: git python3 curl qemu-img"; else warn "missing tools:$missing (see: snapintosh build --deps)"; fi
  # Ambrosia is cross built: rustup picks rust 1.99.1 and the aarch64-unknown-none target from its rust-toolchain.toml
  missing=""
  for t in cargo rustc rustup make cpio; do command -v "$t" >/dev/null 2>&1 || missing="$missing $t"; done
  if [ -z "$missing" ]; then
    ok "Ambrosia build tools: cargo rustc rustup make cpio"
    if rustup target list --installed 2>/dev/null | grep -q '^aarch64-unknown-none$'; then ok "rust target aarch64-unknown-none installed"
    else info "rust target aarch64-unknown-none not installed for the default toolchain: the build's rust-toolchain.toml (1.99.1) installs it on first make"; fi
  else warn "missing Ambrosia build tools:$missing (rustup from https://rustup.rs, see: snapintosh build --deps)"; fi
}

check_repro_mnt() {
  local hits
  if repro_ns_ok; then ok "build --pgo can run here: unprivileged user namespaces work (unshare -rm)"
  else
    warn "build --pgo cannot run here (the plain build still does, it falls back to building in place and its Rust half then differs from the reference md5):"
    userns_fix | sed 's/^/        /'
  fi
  hits=$(repro_mnt_hits)
  if [ -n "$hits" ] && repro_ns_ok; then
    warn "the build binds $HOME_DIR over $REPRO_MNT and these paths are under $REPRO_MNT, so build will refuse: $(printf '%s' "$hits" | tr '
' ' ')(move them, or SNAPINTOSH_NO_REPRO=1)"
  fi
}

# ---------------------------------------------------------------- build
cmd_build_deps() {
  cat <<'EOF'
# Debian 13 / Ubuntu 26.04 package set. Verified on a minimal
# debootstrap root with only these packages (plus the Mesa block below for `build --only mesa`) builds everything. cmake and the X11
# development packages are there because reims-vgpu's `cargo xtask dist` compiles SDL3 from source (sdl3-sys); libfdt-dev because
# QEMU is configured with the system libfdt, libgnutls28-dev because VNC password authentication needs gnutls' DES. The build passes a fixed feature set to QEMU's configure and to SDL3's
# cmake (see build_qemu and lib/sdl3-features.cmake), so installing more development packages (audio, USB, Wayland, TLS, ...)
# no longer changes the binary: the same sources and toolchain give the same md5 on any package set.
sudo apt install build-essential git curl ca-certificates python3 python3-venv pkg-config ninja-build meson cmake \
  clang lld llvm libglib2.0-dev libpixman-1-dev libslirp-dev libfdt-dev libgnutls28-dev libvulkan-dev \
  vulkan-tools mesa-vulkan-drivers libzstd-dev zlib1g-dev flex bison xz-utils qemu-utils cpio \
  libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxfixes-dev libxi-dev libxss-dev libxtst-dev libxkbcommon-dev
# Rust: the pinned reims-vgpu tree selects nightly-2026-11-03 through rust-toolchain.toml
curl -sSf https://sh.rustup.rs | sh
# Ambrosia is cross compiled (arm64 bare metal firmware built on x86): its rust-toolchain.toml selects rust 1.99.1
# with the aarch64-unknown-none target and the llvm-tools component (objcopy), and rustup installs them on the first
# `make`. Nothing else is needed: no aarch64 gcc, no Apple tools. The build takes seconds. To prefetch:
#   rustup toolchain install 1.99.1 --profile minimal -c llvm-tools -t aarch64-unknown-none
# Optional, lavapipe only (hosts without a Vulkan GPU): Mesa build deps
sudo apt install llvm-dev libclang-dev glslang-tools python3-mako python3-yaml libdrm-dev libx11-dev libxcb1-dev \
  libxext-dev libxfixes-dev libxcb-dri3-dev libxcb-present-dev libxcb-sync-dev libxshmfence-dev libwayland-dev
EOF
}

# clone_pin NAME REPO REF DEST [PATCHDIR]: fetch the pinned commit into DEST and check it out. With PATCHDIR the series in it is applied
# to the working tree (git apply, no commits), so QEMU's version string stays the one of the plain tag and the build is the same
# bytes wherever it runs. A tree that already carries exactly this series is left alone (its mtimes keep make from rebuilding).
clone_pin() {
  local name=$1 repo=$2 ref=$3 dest=$4 pdir=${5:-} f stamp
  [ -n "$repo" ] || die "${name}_REPO is not set: export ${name}_REPO=file:///path/to/clone (or a https or ssh URL) or put it in $CONF"
  # a pin is a full commit id: a tag or branch name can move, an abbreviation can become ambiguous
  [ "${#ref}" -eq 40 ] && [ -z "$(printf '%s' "$ref" | tr -d '0-9a-f')" ] || die "$name: the pin must be a full 40 digit commit id, got '$ref'"
  if [ ! -d "$dest/.git" ]; then
    mkdir -p "$dest"
    git -C "$dest" init --quiet
    git -C "$dest" remote add origin "$repo"
  fi
  # a tree left by an earlier build may point at another repository: fetch from the one asked for now
  git -C "$dest" remote set-url origin "$repo"
  # fetch the pinned commit alone first (small, and tolerates partial clones on the remote), else everything
  git -C "$dest" cat-file -e "$ref^{commit}" 2>/dev/null \
    || git -C "$dest" fetch --quiet --depth 1 origin "$ref" 2>/dev/null \
    || git -C "$dest" fetch --quiet origin 2>/dev/null || true
  git -C "$dest" cat-file -e "$ref^{commit}" 2>/dev/null || die "$name: commit $ref is not in $repo"
  if [ -n "$pdir" ]; then
    stamp="$ref $(cat "$pdir"/*.patch | sha256sum | cut -c1-64)"
    if [ "$(cat "$dest/.git/snapintosh-patched" 2>/dev/null)" != "$stamp" ]; then
      rm -f "$dest/.git/snapintosh-patched"
      git -C "$dest" checkout --quiet --force --detach "$ref" && git -C "$dest" clean -fdxq
      for f in "$pdir"/*.patch; do git -C "$dest" apply --whitespace=nowarn "$f" || die "$name: patch does not apply: $f"; done
      printf '%s\n' "$stamp" > "$dest/.git/snapintosh-patched"
    fi
    [ "$(git -C "$dest" rev-parse HEAD)" = "$ref" ] || die "$name: the checkout is at $(git -C "$dest" rev-parse HEAD), not at the pin $ref"
    set -- "$pdir"/*.patch
    ok "$name at $(git -C "$dest" rev-parse --short=12 HEAD) plus $# patches"
    return 0
  fi
  git -C "$dest" checkout --quiet --detach "$ref"
  [ "$(git -C "$dest" rev-parse HEAD)" = "$ref" ] || die "$name: the checkout is at $(git -C "$dest" rev-parse HEAD), not at the pin $ref"
  ok "$name at $(git -C "$dest" rev-parse --short=12 HEAD)"
}

# renderer_pin NAME REPO REF DEST DIR: the renderer sources. A REPO from the environment or pins.env is cloned like any other pin. With
# no repository the tree comes from the release tarball RENDERER_URL (the pinned commits, no history, one archive for both trees):
# downloaded once into $HOME_DIR/cache, checked against RENDERER_SHA256 before anything is read from it, and unpacked into $SRC.
# A file that does not match the checksum is deleted and the build stops; nothing from it is ever extracted.
renderer_pin() {
  local name=$1 repo=$2 ref=$3 dest=$4 dir=$5 f part got bad
  if [ -n "$repo" ]; then clone_pin "$name" "$repo" "$ref" "$dest"; return; fi
  [ -n "${RENDERER_URL:-}" ] && [ "${#RENDERER_SHA256}" -eq 64 ] || die "$name: ${name}_REPO is not set and pins.env has no RENDERER_URL and RENDERER_SHA256"
  case $RENDERER_SHA256 in *[!0-9a-f]*) die "$name: RENDERER_SHA256 must be 64 lowercase hex digits" ;; esac
  f=$HOME_DIR/cache/renderer-$RENDERER_SHA256.tar.gz
  if [ -f "$f" ] && [ "$(sha256sum "$f" | cut -d' ' -f1)" != "$RENDERER_SHA256" ]; then
    warn "$name: the cached $f does not match RENDERER_SHA256, downloading it again"; rm -f "$f"
  fi
  if [ ! -f "$f" ]; then
    mkdir -p "$HOME_DIR/cache"; part=$f.part.$$
    info "$name: downloading $RENDERER_URL"
    curl -fL -sS --retry 3 -o "$part" "$RENDERER_URL" || { rm -f "$part"; die "$name: download of $RENDERER_URL failed"; }
    got=$(sha256sum "$part" | cut -d' ' -f1)
    if [ "$got" != "$RENDERER_SHA256" ]; then rm -f "$part"; die "$name: checksum mismatch for $RENDERER_URL: got $got, want $RENDERER_SHA256 (nothing was unpacked)"; fi
    mv "$part" "$f"
  fi
  if [ "$(cat "$dest/.renderer-sha256" 2>/dev/null)" = "$RENDERER_SHA256" ]; then ok "$name from the release tarball (already unpacked, pinned commit ${ref:0:12})"; return 0; fi
  # members must stay inside their own tree: no absolute path, no .. and nothing outside $dir
  bad=$(tar -tzf "$f" | grep -Ev '^(reims-vgpu|metal2vulkan)(/|$)' || true)
  [ -z "$bad" ] || die "$name: the tarball holds paths outside reims-vgpu/ and metal2vulkan/: $(printf '%s' "$bad" | head -3 | tr '\n' ' ')"
  bad=$(tar -tzf "$f" | grep -E '(^|/)\.\.(/|$)' || true)
  [ -z "$bad" ] || die "$name: the tarball holds a path with .. in it: $(printf '%s' "$bad" | head -1)"
  mkdir -p "$SRC"
  rm -rf "$dest"
  tar -xzf "$f" -C "$SRC" --no-same-owner "$dir" || die "$name: could not unpack $dir from the tarball"
  printf '%s\n' "$RENDERER_SHA256" > "$dest/.renderer-sha256"
  ok "$name from the release tarball (pinned commit ${ref:0:12})"
}

preflight_build() { # tools...
  local t missing=""
  for t in "$@"; do command -v "$t" >/dev/null 2>&1 || missing="$missing $t"; done
  if [ -n "$missing" ]; then
    printf '%s[FAIL]%s build tools missing:%s\n' "$c_red" "$c_off" "$missing" >&2
    echo "run: snapintosh build --deps" >&2
    return 1
  fi
}

# Reproducible builds: the same pins give the same bytes in any directory and under any HOME. Every build path that would be
# written into the binaries (debug info, __FILE__, panic locations, cargo registry paths) is mapped to a fixed name. The order
# matters: the last matching map wins, so the broad $HOME comes first. SNAPINTOSH_NO_REPRO=1 turns this off.
repro_flags() {
  RP_RUST=""; RP_C=""
  [ "${SNAPINTOSH_NO_REPRO:-0}" = 1 ] && return 0
  local ch=${CARGO_HOME:-$HOME/.cargo} rh=${RUSTUP_HOME:-$HOME/.rustup} pair from to
  local -a pairs=("$HOME=/snapintosh/home" "$HOME_DIR=/snapintosh/data" "$ch=/snapintosh/cargo" "$rh=/snapintosh/rustup"
                  "$SRC=/snapintosh/src" "$BUILD=/snapintosh/build" "$PREFIX=/snapintosh/prefix")
  for pair in "${pairs[@]}"; do
    from=${pair%%=*}; to=${pair#*=}
    RP_RUST="$RP_RUST --remap-path-prefix=$from=$to"
    RP_C="$RP_C -ffile-prefix-map=$from=$to"
  done
}

# The Rust half of the build runs in a private mount namespace with $HOME_DIR bound at /mnt (see build_reims). SNAPINTOSH_REPRO_MNT
# changes the mount point (for the tests).
REPRO_MNT=${SNAPINTOSH_REPRO_MNT:-/mnt}
repro_ns_ok() { [ "${SNAPINTOSH_NO_REPRO:-0}" != 1 ] && [ -d "$REPRO_MNT" ] && unshare -rm true 2>/dev/null; }

# userns_fix: why `unshare -rm` fails on this host and the exact way out, on stdout (nothing is changed here). Ubuntu 23.10 and later (26.04
# included) set kernel.apparmor_restrict_unprivileged_userns=1, which makes the kernel refuse a user namespace to an ordinary program: the plain
# build then falls back to building in place, but build --pgo needs the namespace. SNAPINTOSH_APPARMOR_USERNS is the sysctl file (for the tests).
userns_fix() {
  local f=${SNAPINTOSH_APPARMOR_USERNS:-/proc/sys/kernel/apparmor_restrict_unprivileged_userns}
  if [ "${SNAPINTOSH_NO_REPRO:-0}" = 1 ]; then echo "SNAPINTOSH_NO_REPRO=1 is set: unset it (it turns the private mount namespace off)"
  elif [ ! -d "$REPRO_MNT" ]; then echo "the directory $REPRO_MNT does not exist (the namespace binds the data directory there): create it, or point SNAPINTOSH_REPRO_MNT at an empty directory"
  elif [ "$(cat "$f" 2>/dev/null || true)" = 1 ]; then
    cat <<EOT
AppArmor refuses unprivileged user namespaces here (kernel.apparmor_restrict_unprivileged_userns=1, the Ubuntu default). Either allow them for
this boot (or every boot, with the second line):
  sudo sysctl kernel.apparmor_restrict_unprivileged_userns=0
  echo kernel.apparmor_restrict_unprivileged_userns=0 | sudo tee /etc/sysctl.d/60-snapintosh-userns.conf
or a profile for unshare (the way Ubuntu ships one for bwrap; note unshare runs any program, so this lifts the restriction for everything started through it), then load it:
  printf 'abi <abi/4.0>,\ninclude <tunables/global>\nprofile snapintosh-unshare /usr/bin/unshare flags=(unconfined) {\n  userns,\n}\n' | sudo tee /etc/apparmor.d/snapintosh-unshare
  sudo apparmor_parser -r /etc/apparmor.d/snapintosh-unshare
snapintosh changes nothing on the host by itself.
EOT
  else
    echo "unprivileged user namespaces are off or refused here (check: unshare -rm true; sysctl user.max_user_namespaces kernel.unprivileged_userns_clone)"
  fi
}

# Everything the build reads that sits under the mount point disappears inside the namespace. Prints one line per path that does (the
# path and what it is); the release tree and $HOME_DIR are not listed: the tree's one file is copied, $HOME_DIR is what gets bound.
repro_mnt_hits() {
  local what p r t
  for what in "HOME=$HOME" "CARGO_HOME=${CARGO_HOME:-$HOME/.cargo}" "RUSTUP_HOME=${RUSTUP_HOME:-$HOME/.rustup}" "TMPDIR=${TMPDIR:-/tmp}"; do
    p=${what#*=}; r=$(realpath -m "$p" 2>/dev/null || echo "$p")
    case "$p $r" in "$REPRO_MNT "*|"$REPRO_MNT/"*|*" $REPRO_MNT"|*" $REPRO_MNT/"*) printf '%s\n' "$what" ;; esac
  done
  for t in cargo rustc rustup clang ld.lld cmake make; do
    p=$(command -v "$t" 2>/dev/null) || continue
    r=$(realpath "$p" 2>/dev/null || echo "$p")
    case "$p $r" in "$REPRO_MNT/"*|*" $REPRO_MNT/"*) printf '%s\n' "$t=$p" ;; esac
  done
}

repro_mnt_check() {
  local hits; hits=$(repro_mnt_hits)
  [ -z "$hits" ] || die "the reproducible build binds $HOME_DIR over $REPRO_MNT, which hides these paths from cargo:
$(printf '%s\n' "$hits" | sed 's/^/  /')
move them out of $REPRO_MNT (a home, CARGO_HOME or RUSTUP_HOME under $REPRO_MNT cannot work), or build in place with
SNAPINTOSH_NO_REPRO=1 (the Rust half then depends on the directory, so the binary md5 differs from the reference)"
}

# cargo_jobs: the largest crate (metal2vulkan-runtime) takes up to 3.5 GB in rustc. As many parallel jobs as threads on a host with
# less than about 3 GB per thread gets one of them killed by the kernel (an 8 GB runner with 6 cores did). One job per 2.5 GB of RAM,
# at most one per thread. CARGO_BUILD_JOBS in the environment wins. The result does not depend on the job count.
cargo_jobs() {
  [ -z "${CARGO_BUILD_JOBS:-}" ] || return 0
  local kb jobs
  kb=${SNAPINTOSH_CHECK_MEM_KB:-$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)}
  jobs=$((kb / 2621440)); [ "$jobs" -ge 1 ] || jobs=1
  [ "$jobs" -le "$(nproc)" ] || jobs=$(nproc)
  export CARGO_BUILD_JOBS=$jobs
  info "cargo runs $jobs job(s) at a time (about 2.5 GB of RAM each; CARGO_BUILD_JOBS changes it)"
}

build_reims() {
  if repro_ns_ok; then repro_mnt_check; fi   # first: a hidden path used to fail the build after 53 s
  mkdir -p "$SRC" "$BUILD"
  renderer_pin M2V "$M2V_REPO" "$M2V_REF" "$SRC/metal2vulkan" metal2vulkan
  renderer_pin REIMS "$REIMS_REPO" "$REIMS_REF" "$SRC/reims-vgpu" reims-vgpu
  preflight_build cargo rustc clang ld.lld lld-link make cmake || return 1
  info "building reims-vgpu dist (vulkan) with metal2vulkan; first run downloads nightly-2026-11-03 and crates"
  repro_flags
  cargo_jobs
  # Cargo hashes the absolute path of a path dependency that lies outside the workspace (metal2vulkan beside reims-vgpu) into the
  # crate ids, and so into every Rust symbol name. No flag maps that away, so a build in another directory differs. When
  # unprivileged user namespaces work, run cargo in a private mount namespace where $HOME_DIR is bound at the fixed path /mnt
  # (nothing outside the namespace changes); otherwise build in place and the Rust half is reproducible only from the same directory.
  if repro_ns_ok; then
    info "building in a private mount namespace ($HOME_DIR as $REPRO_MNT) so the result does not depend on the directory"
    # the namespace hides what is under $REPRO_MNT, so a release tree there would lose lib/sdl3-features.cmake: the file is read from a
    # copy inside $HOME_DIR, which is what shows up at $REPRO_MNT (the build died after 53 s with "Could not find toolchain file")
    cp "$LIB/sdl3-features.cmake" "$HOME_DIR/sdl3-features.cmake"
    # shellcheck disable=SC2016  # the script is for the inner bash, which expands it
    unshare -rm env "RP_RUST=$RP_RUST" "RP_C=$RP_C" "HOME_DIR=$HOME_DIR" "MNT=$REPRO_MNT" "CMAKE_TOOLCHAIN_FILE=$REPRO_MNT/sdl3-features.cmake" bash -c '
      mount --bind "$HOME_DIR" "$MNT" && cd "$MNT/src/reims-vgpu" \
      && CARGO_TARGET_DIR=$MNT/build/reims-target RUSTFLAGS="$RP_RUST ${RUSTFLAGS:-}" CFLAGS="$RP_C ${CFLAGS:-}" \
         cargo xtask dist --platform vulkan' || die "reims-vgpu build failed"
  else
    ( cd "$SRC/reims-vgpu" && CMAKE_TOOLCHAIN_FILE="$LIB/sdl3-features.cmake" CARGO_TARGET_DIR="$BUILD/reims-target" RUSTFLAGS="$RP_RUST ${RUSTFLAGS:-}" CFLAGS="$RP_C ${CFLAGS:-}" \
        cargo xtask dist --platform vulkan ) || die "reims-vgpu build failed"
  fi
  [ -f "$BUILD/reims-target/dist-vulkan/lib/pkgconfig/reims-vgpu.pc" ] || die "reims-vgpu dist tree missing after build"
  ok "reims-vgpu dist: $BUILD/reims-target/dist-vulkan"
}

QEMU_FEAT=(--without-default-features --enable-tcg --enable-tools --enable-pvg --enable-slirp --enable-vnc --enable-pixman
           --enable-fdt=system --enable-gnutls --enable-zstd --enable-malloc-trim --enable-stack-protector)

build_qemu() {
  local dist=$BUILD/reims-target/dist-vulkan
  [ -f "$dist/lib/pkgconfig/reims-vgpu.pc" ] || die "build reims-vgpu first (snapintosh build --only reims)"
  clone_pin QEMU "$QEMU_REPO" "$QEMU_REF" "$SRC/qemu" "$ROOT/patches/qemu"
  preflight_build make ninja meson pkg-config cc python3 || return 1
  mkdir -p "$BUILD/qemu"
  repro_flags
  # QEMU bakes its install prefix into the binary (data dir, module dir). Configure it for the fixed prefix /snapintosh,
  # install into a staging DESTDIR and move that into $PREFIX: QEMU finds its data relative to its own location at run time,
  # so the binary no longer depends on where it was built or installed (same md5 in any directory).
  local stage=$BUILD/qemu-stage
  rm -rf "$stage"
  # decodetree.py walks Python sets and dicts of strings: without a fixed hash seed it emits the A32 and A64 decoders in a
  # different order from run to run (different machine code, same behaviour), so even two builds in one directory differ.
  # QEMU's configure turns every optional feature on when its development package is installed, so the binary depended on
  # which packages the host had (three md5s from three package sets). Start from --without-default-features (everything off)
  # and enable exactly what the lab binary uses: TCG, the vmapple machine's devices (default devices), pvg (reims-vgpu), slirp user
  # networking, VNC (-vnc, screendump), pixman (VNC and the display core), gnutls (the only crypto backend with DES, which VNC
  # password authentication needs: without it `-vnc ...,password-secret=` stops QEMU at start), libfdt (the system one: the in-tree
  # fallback is a git clone from the network), zstd (snapshots), qemu-img/qemu-nbd/qemu-pcache-compact (tools), and what a plain configure gives on
  # every host (malloc_trim, stack protector). Audio, USB passthrough, display backends, vhost,
  # block formats other than raw, qcow2 and nbd, plugins and the rest stay off.
  local -a feat=("${QEMU_FEAT[@]}")
  # shellcheck disable=SC2030  # the export is meant for this subshell only
  ( cd "$BUILD/qemu" && export PYTHONHASHSEED=0 && PKG_CONFIG_PATH="$dist/lib/pkgconfig" "$SRC/qemu/configure" \
      --prefix=/snapintosh --target-list=aarch64-softmmu "${feat[@]}" --disable-docs \
      --disable-werror --extra-cflags="-Wno-error $RP_C" \
    && make -j"$JOBS" && make install DESTDIR="$stage" ) || die "qemu build failed"
  mkdir -p "$PREFIX"
  # a snapshot saved by the binary we are about to replace keeps working: if the state format changed, the old binary is kept beside it
  python3 -I "$LIB/snapctl.py" keep "$PREFIX/bin/qemu-system-aarch64" "$SNAPSHOT_STATE_FORMAT" || true
  cp -a "$stage/snapintosh/." "$PREFIX/" && rm -rf "$stage"
  [ -x "$PREFIX/bin/qemu-system-aarch64" ] || die "qemu-system-aarch64 not installed"
  mkdir -p "$PREFIX/share/snapintosh/27on86"
  printf '%s\n' "$SNAPSHOT_STATE_FORMAT" > "$PREFIX/share/snapintosh/state-format"
  rm -f "$PREFIX/share/snapintosh/pgo.txt"   # a plain build replaced a --pgo one
  cp -a "$SRC/qemu/scripts/27on86/." "$PREFIX/share/snapintosh/27on86/" 2>/dev/null || true
  ok "qemu: $PREFIX/bin/qemu-system-aarch64"
}

make_bundle() { # OUT.cpio BOOTARGS : Ambrosia config bundle (config.plist in a newc cpio), our 3 optional keys on
  local out=$1 args=$2 d
  need cpio "apt install cpio"
  d=$(mktemp -d "${out%/*}/bundle-XXXXXX")   # next to the result, never in /tmp: a SIGKILL then leaves it inside the run dir that the next command removes
  cat > "$d/config.plist" <<EOP
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
  <key>BootArgs</key>
  <string>$args</string>
  <key>Graphics</key>
  <dict><key>KeepAppleGfx</key><true/></dict>
  <key>Chosen</key><dict><key>internal-use-only-unit</key><integer>1</integer></dict>
  <key>Asmb</key><dict><key>lp-sip0</key><integer>$AMBROSIA_LP_SIP0</integer></dict>
</dict>
</plist>
EOP
  local rc=0
  ( cd "$d" && echo config.plist | cpio -o -H newc 2>/dev/null ) > "$out" || rc=$?
  rm -rf "$d"
  return "$rc"
}

build_ambrosia() {
  mkdir -p "$SRC" "$BUILD"
  clone_pin AMBROSIA "$AMBROSIA_REPO" "$AMBROSIA_REF" "$SRC/ambrosia"
  # clean tree at the pin, then our 3 patches (KeepAppleGfx, Chosen, Asmb: optional config keys, an unpatched config boots as stock)
  git -C "$SRC/ambrosia" reset --quiet --hard "$AMBROSIA_REF"
  local pf n=0
  for pf in "$ROOT"/patches/ambrosia/*.patch; do
    git -C "$SRC/ambrosia" apply "$pf" || die "ambrosia patch does not apply: $pf"
    n=$((n + 1))
  done
  ok "ambrosia patches applied: $n"
  preflight_build cargo rustc rustup make cpio || return 1
  info "building ambrosia (cross, aarch64-unknown-none); first run lets rustup fetch rust 1.99.1"
  ( cd "$SRC/ambrosia" && make )
  [ -f "$SRC/ambrosia/target/ambrosia.bin" ] || die "ambrosia.bin missing after build"
  mkdir -p "$PREFIX/$AMB_DIR_REL"
  cp "$SRC/ambrosia/target/ambrosia.bin" "$PREFIX/$AMB_DIR_REL/ambrosia.bin"
  make_bundle "$PREFIX/$AMB_DIR_REL/config.cpio" "$AMBROSIA_BOOTARGS"
  if [ "$(sha256sum "$PREFIX/$AMB_DIR_REL/ambrosia.bin" | cut -d' ' -f1)" = "$AMBROSIA_SHA256" ]; then ok "ambrosia.bin is byte-identical to the lab image"
  else warn "ambrosia.bin differs from the lab image $AMBROSIA_SHA256 (other toolchain or pins); fine if it boots"; fi
  ok "ambrosia: $PREFIX/$AMB_DIR_REL/ambrosia.bin ($(sha256sum "$PREFIX/$AMB_DIR_REL/ambrosia.bin" | cut -c1-12)), config.cpio with BootArgs '$AMBROSIA_BOOTARGS'"
}

build_mesa() {
  clone_pin MESA "$MESA_REPO" "$MESA_REF" "$SRC/mesa"
  preflight_build meson ninja llvm-config glslangValidator || return 1
  if git -C "$SRC/mesa" apply --check "$ROOT/patches/mesa-lavapipe-immutable-samplers.patch" 2>/dev/null; then
    git -C "$SRC/mesa" apply "$ROOT/patches/mesa-lavapipe-immutable-samplers.patch"
  else
    info "patch already applied or does not apply cleanly; continuing"
  fi
  meson setup "$BUILD/mesa" "$SRC/mesa" --prefix="$HOME_DIR/mesa" --buildtype=release \
    -Dgallium-drivers=llvmpipe -Dvulkan-drivers=swrast -Dglx=disabled -Dgbm=disabled -Degl=disabled \
    -Dplatforms= -Dllvm=enabled --reconfigure 2>/dev/null || meson setup "$BUILD/mesa" "$SRC/mesa" \
    --prefix="$HOME_DIR/mesa" --buildtype=release -Dgallium-drivers=llvmpipe -Dvulkan-drivers=swrast \
    -Dglx=disabled -Dgbm=disabled -Degl=disabled -Dplatforms= -Dllvm=enabled
  ninja -C "$BUILD/mesa" -j"$JOBS" install
  ok "lavapipe: $HOME_DIR/mesa"
}

# ---------------------------------------------------------------- build --pgo
# Profile-guided optimisation plus full LTO of the QEMU binary, opt-in (Safari open and drag stay within noise, boot to Dock and CPU use
# gain a few percent). gcc's profile is exact only against the same source AT THE SAME ABSOLUTE PATH (it hashes the path of every static
# function) and the same compiler, so the instrumented build G, the training boot and the final build C all run in ONE private mount
# namespace (unshare -rm) that binds $HOME_DIR at $REPRO_MNT, as the reims build does. The profile is never bundled: it is made on this
# host from this source. Everything the build makes lives in $PGO_WORK; the working binary is replaced only after C compiled with no
# profile mismatch and starts, so a failed or killed build leaves nothing behind and changes nothing.
PGO_WORK=$HOME_DIR/pgo-work
PGO_EXPECT="about 50 minutes on 6 cores (49 min measured; up to about 4 h at the bounds)"
pgo_plan() {
  cat <<EOP
snapintosh build --pgo: expected time $PGO_EXPECT (less with more cores):
  1. instrumented QEMU build                      about 2 min
  2. warm the translation pack of that build      2 boots, up to 45 min each (the instrumented binary is about 4x slower)
  3. train: one boot with 2 vCPUs, Safari open to draw, window drag       about 20 min, repeated once if it fails (up to 75 min each)
  4. final build with the profile and full LTO    3 to 5 min, profile mismatches fail the build
  The running build is replaced only when all of it succeeded. Ctrl-C at any point removes everything this made.
EOP
}

# pgo_stop_ns WORKDIR [MARKER]: stop every process of this user that is in the mount namespace the build of WORKDIR recorded (its own namespace:
# nothing else shares it), whoever its parent is. A process is ours only when its environment carries SNAPINTOSH_PGO_WORK=MARKER. WORKDIR is
# how THIS shell names the work dir, MARKER is how the build named it when it started everything: the OUTER path. Outside the namespace the two
# are the same (the default); inside, WORKDIR is under $REPRO_MNT and MARKER is $SNAPINTOSH_PGO_WORK. Never match on a path that differs between
# the two views.
pgo_stop_ns() {
  local ino p marker=${2:-$1}
  ino=$(cat "$1/mntns" 2>/dev/null || true); [ -n "$ino" ] || return 0
  for _ in 1 2 3; do
    for p in /proc/[0-9]*; do
      p=${p#/proc/}
      [ "$p" = "$$" ] || [ "$p" = "${BASHPID:-$$}" ] && continue
      [ "$(readlink "/proc/$p/ns/mnt" 2>/dev/null || true)" = "$ino" ] || continue
      # the namespace may be long gone and its inode reused: only a process that carries this build's marker is ours
      tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -qxF "SNAPINTOSH_PGO_WORK=$marker" && kill -9 "$p" 2>/dev/null || true
    done
    sleep 0.2
  done
}

# pgo_watchdog TARGET: runs in the namespace beside TARGET (the inner shell). When the snapintosh that started the build is gone (SIGKILL: no trap
# ran) it kills TARGET, then everything else of the build in this namespace, and ends. One round only: no second kill, so a reused pid is safe.
# PGO_WD_TICK is the poll interval in seconds (5; the tests use less).
pgo_watchdog() {
  while sleep "${PGO_WD_TICK:-5}"; do
    if [ ! -f "$PGO_WORK/cli.pid" ] || cli_dead "$PGO_WORK"; then
      kill -9 "$1" 2>/dev/null || true
      pgo_stop_ns "$PGO_WORK" "${SNAPINTOSH_PGO_WORK:-$PGO_WORK}"
      exit 0
    fi
  done
}

# pgo_unstage: the copies the install step makes beside the real files (an install that was cut short leaves them; 363 MB for the binary)
pgo_unstage() {
  find "$PREFIX" -name '*.pgo-new' -delete 2>/dev/null || true
  rm -f "$PREFIX/share/snapintosh/pgo.txt.new"
}

# pgo_reap: the work dir of a --pgo build that died without cleaning up (SIGKILL, power loss) goes, and what still runs in its namespace stops.
# Same proof as reap_leftovers: cli.pid names a snapintosh of this pid namespace that is gone. A live build keeps its dir.
pgo_reap() {
  local d
  for d in "$PGO_WORK".new-*; do   # a build killed between making its private dir and taking the lock (its cli.pid is in it from the start)
    [ -d "$d" ] && [ -f "$d/cli.pid" ] && cli_dead "$d" && rm -rf "$d"
  done
  [ -d "$PGO_WORK" ] || return 0
  if [ -f "$PGO_WORK/cli.pid" ]; then
    cli_dead "$PGO_WORK" || return 0
  else
    [ -n "$(find "$PGO_WORK" -maxdepth 0 -mmin +2 2>/dev/null)" ] || return 0   # a dir of an older snapintosh (it made the dir before cli.pid)
  fi
  pgo_stop_ns "$PGO_WORK"
  pgo_unstage
  rm -rf "$PGO_WORK"
  echo "snapintosh: removed the work dir of an earlier build --pgo that died ($PGO_WORK)" >&2
  return 0
}

pgo_preflight() {
  [ -x "$PREFIX/bin/qemu-system-aarch64" ] || die "build --pgo improves a working build: run snapintosh build first (it trains on that setup)"
  [ -f "$VM/golden/root-quiet.qcow2" ] || [ -f "$VM/golden/root-sshd.qcow2" ] \
    || die "build --pgo trains on a boot of your golden image: run snapintosh make-disk golden first"
  [ -f "$BUILD/reims-target/dist-vulkan/lib/pkgconfig/reims-vgpu.pc" ] || die "build --pgo needs the renderer library: snapintosh build --only reims first"
  repro_ns_ok || die "build --pgo needs unprivileged user namespaces (unshare -rm, and the directory $REPRO_MNT): the profile only matches the source at one fixed path, which the private mount namespace gives.
$(userns_fix)"
  repro_mnt_check
  case $ROOT in "$REPRO_MNT"|"$REPRO_MNT"/*) die "build --pgo binds $HOME_DIR over $REPRO_MNT, which would hide this release tree ($ROOT): run it from another directory" ;; esac
  [ "$DRY" = 1 ] || preflight_build gcc make ninja meson pkg-config python3 unshare git || return 1
}

# pgo_compile FLAVOR STAGE LOG (inside the namespace): configure and make the pinned QEMU in $PGO_WORK/b, the same configure line and path maps
# as build_qemu. G = instrumented (-fprofile-generate, counters not atomic, gcda in $PGO_WORK/prof). C = -fprofile-use with full LTO; the two
# profile warnings are switched on in build.ninja after configure (its probes run with -Werror) so the log shows every mismatch.
pgo_compile() {
  local f=$1 stage=$2 log=$3 b=$PGO_WORK/b prof=$PGO_WORK/prof dist=$BUILD/reims-target/dist-vulkan cf lf="" mo=()
  repro_flags
  cf="-Wno-error $RP_C -fprofile-prefix-path=$b -fprofile-dir=$prof"
  if [ "$f" = G ]; then cf="$cf -fprofile-generate -fprofile-update=single"; lf="-fprofile-generate -fprofile-update=single"
  else cf="$cf -fprofile-use -fprofile-correction -Wno-missing-profile -Wno-coverage-mismatch"; lf="-fprofile-use -fprofile-correction"; mo=(-Db_lto=true "-Db_lto_threads=$JOBS"); fi
  rm -rf "$b" "$stage"; mkdir -p "$b" "$prof"
  # shellcheck disable=SC2031  # the export is meant for this subshell only
  ( cd "$b" && export PYTHONHASHSEED=0 PKG_CONFIG_PATH="$dist/lib/pkgconfig" \
    && "$SRC/qemu/configure" --prefix=/snapintosh --target-list=aarch64-softmmu "${QEMU_FEAT[@]}" --disable-docs --disable-werror \
         --extra-cflags="$cf" --extra-ldflags="$lf" "${mo[@]}" \
    && { [ "$f" != C ] || { sed -i 's/ -Wno-missing-profile//g; s/ -Wno-coverage-mismatch//g' build.ninja && ! grep -q -e -Wno-missing-profile build.ninja; }; } \
    && make -j"$JOBS" && make install DESTDIR="$stage" >/dev/null ) > "$log" 2>&1 \
    || { tail -n 25 "$log" >&2; die "build --pgo: the $f build failed (log $log)"; }
  [ -x "$stage/snapintosh/bin/qemu-system-aarch64" ] || die "build --pgo: the $f build made no qemu-system-aarch64"
}

# free_port: a TCP port nothing listens on at this moment (the kernel picks it)
free_port() { python3 -I -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'; }   # callers that need two ask until they differ

# pgo_bench NAME ARGS...: one `snapintosh bench` run of the instrumented build, in the home $PGO_WORK/home (its own pack, runs and snapshots: the
# build is thrown away with the work dir). Bounded: 2.5 h.
pgo_bench() {
  local n=$1 h=$PGO_WORK/home rc=0 sp hp; shift
  mkdir -p "$h/res/$n"
  # ports nobody listens on (a VM the user started keeps 10022 and 18080), and the snapshots dir of this home, never the user's
  sp=$(free_port); hp=$(free_port); while [ "$hp" = "$sp" ]; do hp=$(free_port); done
  SNAPS=$h/snaps SNAPINTOSH_HOME=$h SNAPINTOSH_PREFIX=$h/prefix timeout 9000 bash "$SELF" bench --runs 1 --no-resume --ram 4G --ssh-port "$sp" --http-port "$hp" --out "$h/res/$n" "$@" \
    > "$PGO_WORK/$n.out" 2>&1 &
  track $!
  wait $! || rc=$?
  return "$rc"
}

# pgo_owner_alive: the snapintosh that started this build still runs. If it was SIGKILLed the namespace carries on, and nothing may
# install a binary then (the next snapintosh command reaps the work dir, pgo_reap)
pgo_owner_alive() {
  if [ ! -f "$PGO_WORK/cli.pid" ] || cli_dead "$PGO_WORK"; then die "build --pgo: the snapintosh that started this build is gone; stopping, nothing installed"; fi
}

# pgo_train: the training boot, once and once more when it fails (the instrumented guest can wedge in the renderer). Every boot starts from an
# empty profile directory: libgcov merges into the .gcda files it finds, so the counters of a failed boot (a guest at the Dock that never drew, a
# 75 minute wedge) would weigh on the good one, and a QEMU killed while writing can leave a truncated file that the next boot cannot merge.
pgo_train() {
  local n ok=0
  for n in train train2; do
    rm -rf "$PGO_WORK/prof"; mkdir -p "$PGO_WORK/prof"
    if pgo_bench "$n" --cpus 2 --pcache ro --settle 30 --drag-settle 30 --drag-secs 20 --draw-limit 900 --ssh-limit 2400 --dock-limit 2400 --secs-cold 4500; then ok=1; break; fi
    info "pgo: training boot $n failed: $(grep -v '^[[:space:]]*$' "$PGO_WORK/$n.out" 2>/dev/null | tail -n 1 | cut -c1-200)"
  done
  [ "$ok" = 1 ] || { tail -n 20 "$PGO_WORK/$n.out" >&2; die "build --pgo: the training boot did not reach the Dock, draw Safari and drag cleanly (log $PGO_WORK/$n.out)"; }
}

# cmd_pgo_ns: the part that runs inside the namespace ($HOME_DIR is $REPRO_MNT here, started by build_qemu_pgo)
cmd_pgo_ns() {
  local stageG=$PGO_WORK/stage-G stageC=$PGO_WORK/stage-C h=$PGO_WORK/home f b warmcpus n mh rel
  JOBS=${PGO_JOBS:-$(nproc)}
  readlink /proc/self/ns/mnt > "$PGO_WORK/mntns"
  # if the snapintosh that started this is SIGKILLed nothing else stops us: a watchdog ends the namespace within 5 s (and nothing is installed)
  pgo_watchdog "$$" &
  PGO_WD=$!
  trap 'kill "$PGO_WD" 2>/dev/null || true' EXIT
  pgo_owner_alive
  info "pgo 1/4: instrumented build"
  pgo_compile G "$stageG" "$PGO_WORK/G.log"
  # a home of its own for the instrumented binary: its own translation pack (the pack is keyed by the binary), runs and snapshots; the golden,
  # mesa, ssh host keys and every other file of the real prefix are shared
  mkdir -p "$h/prefix/bin" "$h/pcache" "$h/snaps" "$h/runs"
  ln -s "$VM" "$h/vm"
  [ ! -e "$HOME_DIR/mesa" ] || ln -s "$HOME_DIR/mesa" "$h/mesa"
  [ ! -f "$KNOWN_HOSTS" ] || cp "$KNOWN_HOSTS" "$h/known_hosts"
  for f in "$PREFIX"/*; do b=${f##*/}; [ "$b" = bin ] || ln -s "$f" "$h/prefix/$b"; done
  for f in "$PREFIX"/bin/*; do ln -s "$f" "$h/prefix/bin/${f##*/}"; done
  rm -f "$h/prefix/bin/qemu-system-aarch64"; cp "$stageG/snapintosh/bin/qemu-system-aarch64" "$h/prefix/bin/qemu-system-aarch64"   # the release compactor stays: an instrumented one would keep writing profile
  warmcpus=$JOBS; [ "$warmcpus" -le 6 ] || warmcpus=6
  info "pgo 2/4: warming the translation pack of the instrumented build (2 boots, $warmcpus vCPUs; the page may not draw here, only the pack matters)"
  for n in warm1 warm2; do
    # bounded: an instrumented guest can wedge in the renderer (14 minutes in, QEMU idle), and the pack is written long before that matters
    pgo_bench "$n" --cpus "$warmcpus" --pcache rw --no-drag --settle 20 --draw-limit 600 --ssh-limit 2400 --dock-limit 2400 --secs-cold 2700 || true
    # shellcheck disable=SC2012
    [ -n "$(ls "$h"/pcache/*.pack 2>/dev/null)" ] || { tail -n 20 "$PGO_WORK/$n.out" >&2; die "build --pgo: warm-up boot $n wrote no translation pack (log $PGO_WORK/$n.out)"; }
  done
  pgo_owner_alive
  info "pgo 3/4: training boot (2 vCPUs: with 6 the instrumented guest cannot draw a page)"
  pgo_train
  python3 -I "$LIB/pgoctl.py" check-prof "$PGO_WORK/prof" || die "build --pgo: the training run left no usable profile"
  pgo_owner_alive
  info "pgo 4/4: final build with the profile and full LTO"
  pgo_compile C "$stageC" "$PGO_WORK/C.log"
  python3 -I "$LIB/pgoctl.py" check-log "$PGO_WORK/C.log" || die "build --pgo: the profile does not match the source (log $PGO_WORK/C.log); the working build is untouched"
  mh=$("$stageC/snapintosh/bin/qemu-system-aarch64" -machine help 2>&1 || true)
  case $mh in *vmapple*) ;; *) die "build --pgo: the new qemu-system-aarch64 does not start or lacks the vmapple machine; the working build is untouched" ;; esac
  pgo_owner_alive
  python3 -I "$LIB/snapctl.py" keep "$PREFIX/bin/qemu-system-aarch64" "$SNAPSHOT_STATE_FORMAT" || true
  # file by file: a copy beside the target, then a rename (a kill leaves whole files, never a half-written binary)
  # the QEMU binary goes in last, and pgo.txt right after it: a kill earlier leaves the old binary with its old marker, a kill later leaves the new
  # binary with its marker (pgo_reap removes any .pgo-new copy)
  while IFS= read -r -d '' f; do
    rel=${f#"$stageC/snapintosh/"}
    [ "$rel" != bin/qemu-system-aarch64 ] || continue
    mkdir -p "$PREFIX/${rel%/*}"
    cp -a "$f" "$PREFIX/$rel.pgo-new" || die "build --pgo: installing $rel failed (disk full?); the working build is as it was"
    mv -f "$PREFIX/$rel.pgo-new" "$PREFIX/$rel"
  done < <(find "$stageC/snapintosh" \( -type f -o -type l \) -print0)
  mkdir -p "$PREFIX/share/snapintosh"
  printf 'pgo build\nqemu_ref %s\ngcc %s\ndate %s\n' "$QEMU_REF" "$(gcc -dumpfullversion)" "$(date -u +%FT%TZ)" > "$PREFIX/share/snapintosh/pgo.txt.new"
  cp -a "$stageC/snapintosh/bin/qemu-system-aarch64" "$PREFIX/bin/qemu-system-aarch64.pgo-new" || die "build --pgo: installing qemu-system-aarch64 failed (disk full?); the working binary is as it was"
  mv -f "$PREFIX/bin/qemu-system-aarch64.pgo-new" "$PREFIX/bin/qemu-system-aarch64"
  mv -f "$PREFIX/share/snapintosh/pgo.txt.new" "$PREFIX/share/snapintosh/pgo.txt"
  ok "qemu (PGO + LTO): $PREFIX/bin/qemu-system-aarch64 ($(md5sum "$PREFIX/bin/qemu-system-aarch64" | cut -c1-12)); its translation pack is new, the first boots write it"
}

build_qemu_pgo() {
  local rc=0
  pgo_preflight || return 1
  pgo_plan
  [ "$DRY" = 1 ] && return 0
  pgo_reap
  # The lock is taken only once its owner proof exists: the work dir is made under a private name with cli.pid inside and the trap set, then
  # renamed onto $PGO_WORK (rename fails when a build holds it: its dir is never empty). A die before that (clone_pin: no QEMU_REPO, pin
  # missing) removes the private dir and never blocks the next try; a slow fetch cannot look like a dead owner to pgo_reap.
  local tmpwork=$PGO_WORK.new-$$
  rm -rf "$tmpwork"; mkdir "$tmpwork"
  echo "$$:$(pstart "$$"):$PIDNS" > "$tmpwork/cli.pid"
  CL_RMRUN=$tmpwork
  cl_trap   # whatever ends this (die, Ctrl-C, SIGTERM) removes the work dir and stops the namespace
  # the lock first (clone_pin checks out the pin in the shared $SRC/qemu, which a running build compiles from); a die after it removes the dir
  mv -T "$tmpwork" "$PGO_WORK" 2>/dev/null || die "another build --pgo is running ($PGO_WORK)"
  CL_RMRUN=$PGO_WORK; CL_PGO=$PGO_WORK
  clone_pin QEMU "$QEMU_REPO" "$QEMU_REF" "$SRC/qemu" "$ROOT/patches/qemu"
  # ssh refuses the system config in the namespace (root-owned files show as owned by nobody, and we are uid 0 there: "Bad owner or permissions"):
  # an empty config of our own is bound over it, for this namespace only
  mkdir -p "$PGO_WORK/ssh/config.d"; : > "$PGO_WORK/ssh/config"
  # shellcheck disable=SC2016  # the script is for the inner bash, which expands it
  unshare -rm env "HOME_DIR=$HOME_DIR" "MNT=$REPRO_MNT" "SNAPINTOSH_HOME=$REPRO_MNT" "PGO_JOBS=$JOBS" "SELF=$SELF" "SNAPINTOSH_PGO_WORK=$PGO_WORK" \
    bash -c 'mount --bind "$HOME_DIR" "$MNT" \
      && { [ ! -e /etc/ssh/ssh_config ] || mount --bind "$SNAPINTOSH_PGO_WORK/ssh/config" /etc/ssh/ssh_config; } \
      && { [ ! -d /etc/ssh/ssh_config.d ] || mount --bind "$SNAPINTOSH_PGO_WORK/ssh/config.d" /etc/ssh/ssh_config.d; } \
      && exec bash "$SELF" _pgo-ns' &
  track $!
  wait $! || rc=$?
  if [ "$rc" != 0 ]; then
    cleanup_reset
    rm -rf "$PGO_WORK"
    die "build --pgo failed (status $rc); nothing was installed, the work dir is removed and the working build is untouched"
  fi
  cleanup_reset
  rm -rf "$PGO_WORK"
}

# deps_apt_names: the package names out of the `apt install` blocks of `build --deps`, one per line (for a script that installs them)
deps_apt_names() {
  awk '/^sudo apt install/ { on = 1; sub(/^sudo apt install/, "") }
       on { l = $0; more = (l ~ /\\$/); sub(/\\$/, "", l); print l; if (!more) on = 0 }' | tr -s ' ' '\n' | sed '/^$/d' | sort -u
}

cmd_build() {
  local only=all pgo=0 deps=0 apt_only=0
  JOBS=$(nproc)
  while [ $# -gt 0 ]; do
    case $1 in
      --deps) deps=1 ;;
      --apt) apt_only=1 ;;
      --pgo) pgo=1 ;;
      --only) only=$2; shift ;;
      -j) JOBS=$2; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "build: unknown option $1" ;;
    esac
    shift
  done
  if [ "$deps" = 1 ]; then
    if [ "$apt_only" = 1 ]; then cmd_build_deps | deps_apt_names; else cmd_build_deps; fi
    return 0
  fi
  [ "$apt_only" = 0 ] || die "build: --apt goes with --deps"
  pgo_reap
  if [ "$pgo" = 1 ]; then
    case $only in all|qemu) ;; *) die "build: --pgo is a QEMU build option: use it with --only qemu or with no --only" ;; esac
    if [ "$DRY" = 1 ]; then build_qemu_pgo; return 0; fi
  fi
  case $only in
    all) build_reims; { [ "$pgo" = 0 ] || [ ! -x "$PREFIX/bin/qemu-system-aarch64" ]; } && build_qemu; build_ambrosia; [ "$pgo" = 0 ] || build_qemu_pgo ;;
    reims) build_reims ;;
    qemu) if [ "$pgo" = 1 ]; then build_qemu_pgo; else build_qemu; fi ;;
    ambrosia) build_ambrosia ;;
    mesa) build_mesa ;;
    *) die "build: --only reims|qemu|ambrosia|mesa" ;;
  esac
  echo "note: the build is path independent: the same pins give the same md5 in any directory. The reference md5 is in pins.env. The translation cache pack is keyed by the binary: the first boot writes a new pack (about 4 GiB), the second one uses it."
}

# ---------------------------------------------------------------- fetch
remote_size() { # URL: the Content-Length the server announces for the final (redirected) response, empty if none
  curl -fsIL --connect-timeout 30 --max-time 60 "$1" 2>/dev/null | tr -d '\r' | awk 'tolower($1) == "content-length:" {n = $2} END {if (n != "") print n}'
}

cmd_fetch() {
  local url="" out=$DL build="" sha=""
  while [ $# -gt 0 ]; do
    case $1 in
      --build) build=$2; shift ;;
      --url) url=$2; shift ;;
      --sha256) sha=$2; shift ;;
      --out) out=$2; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "fetch: unknown option $1" ;;
    esac
    shift
  done
  [ -z "$sha" ] || [[ $sha =~ ^[0-9a-fA-F]{64}$ ]] || die "fetch: --sha256 needs 64 hex digits"
  [ -z "$build" ] || ipsw_pick "$build"
  [ -n "$url" ] || url=$IPSW_URL
  [ "$url" != "$IPSW_URL" ] || info "build $IPSW_BUILD (macOS $IPSW_VERSION), $((IPSW_SIZE / 1000000000)) GB"
  if [ "$url" = "$IPSW_URL" ] && [ "$IPSW_BUILD" != 26A428 ]; then
    warn "build $IPSW_BUILD: supported path, but this stack has not booted it. Needs its own Mac install and golden"
  fi
  need curl "apt install curl"
  mkdir -p "$out"
  local f; f=$out/$(basename "${url%%\?*}")
  echo "Apple's restore image, from Apple's CDN, is for use on Apple hardware under the macOS EULA. We do not host or bundle it."
  echo "url:  $url"
  echo "file: $f"
  [ "$DRY" = 1 ] && { echo "(dry run)"; return 0; }
  # what the finished file must be: the pinned size and hash for a pinned build, else what the server announces (and --sha256)
  local want_size="" want_sha=""
  if [ "$url" = "$IPSW_URL" ]; then want_size=$IPSW_SIZE; want_sha=$IPSW_SHA256; else want_size=$(remote_size "$url"); fi
  [ -z "$sha" ] || want_sha=${sha,,}
  # --max-time bounds a single attempt; -C - resumes, the loop retries dropped connections (6 tries, 5 s apart, growing)
  local attempt rc=0 max=${SNAPINTOSH_FETCH_ATTEMPTS:-6} nap PROG=(-sS) have
  [ -t 2 ] && PROG=(--progress-bar)
  for attempt in $(seq 1 "$max"); do
    rc=0
    curl -fL --retry 3 --connect-timeout 30 -C - -o "$f" ${SNAPINTOSH_FETCH_MAXTIME:+--max-time "$SNAPINTOSH_FETCH_MAXTIME"} \
        "${PROG[@]}" "$url" || rc=$?
    [ "$rc" != 0 ] || break
    # 33 or 22 on a resume of a file that is already whole (range not satisfiable): the size decides, not the code
    have=$(stat -c %s "$f" 2>/dev/null || echo 0)
    if [ -n "$want_size" ] && [ "$have" = "$want_size" ]; then rc=0; break; fi
    [ -z "${SNAPINTOSH_FETCH_MAXTIME:-}" ] || { echo "stopped by SNAPINTOSH_FETCH_MAXTIME; run again to resume ($have bytes so far)"; return 0; }
    [ "$attempt" -lt "$max" ] || break
    nap=${SNAPINTOSH_FETCH_SLEEP:-$((attempt < 12 ? attempt * 5 : 60))}
    echo "attempt $attempt of $max failed (curl $rc), resuming in $nap s"
    sleep "$nap"
  done
  [ "$rc" = 0 ] || die "download failed after $max attempts (curl exit $rc); the partial file stays at $f, run again to resume"
  have=$(stat -c %s "$f")
  if [ -n "$want_size" ]; then
    if [ "$have" = "$want_size" ]; then ok "size $have matches the $([ "$url" = "$IPSW_URL" ] && echo "pinned build $IPSW_BUILD" || echo "size the server announced")"
    else bad "size $have, expected $want_size: the file is incomplete (run again to resume) or not the expected image"; return 1; fi
  else
    warn "the server announced no size: the download cannot be checked for completeness without --sha256"
  fi
  if [ -n "$want_sha" ]; then
    echo "verifying sha256 ($((have / 1000000000)) GB, takes a minute)"
    local got; got=$(sha256sum "$f" | awk '{print $1}')
    if [ "$got" = "$want_sha" ]; then ok "sha256 matches$([ "$url" = "$IPSW_URL" ] && echo " the pinned build $IPSW_BUILD")"
    else bad "sha256 $got differs from the expected $want_sha"; return 1; fi
  else
    warn "custom URL: no hash to check against (pass --sha256 H). Only the size was checked; builds $IPSW_BUILDS are pinned"
  fi
}

# ---------------------------------------------------------------- make-disk
mac_steps() {
  local ipsw; ipsw=$(basename "$IPSW_URL")
  cat <<EOF
make-disk: the one step that needs a Mac (Apple Silicon, macOS 13 or newer, Xcode command line tools).
It exists because Apple's Virtualization.framework is the only tool that personalizes a macOS
restore for a vmapple machine (it asks Apple to sign the install for a machine id) and produces
aux.img. There is no Linux replacement yet. See docs/BLOCKERS.md item 1. Everything after it runs on Linux.
Build $IPSW_BUILD (macOS $IPSW_VERSION). Install a build Apple still signs: ipsw.me does not track signing for
VirtualMac, real Mac identifiers show 26A428 and 26B131 signed. Once installed, booting never
asks Apple again. For 26B131 the Mac's own macOS must be able to host a 27.2 guest.

  On the Mac (about 15 minutes plus the download, about 70 GB free):
   1. Copy the IPSW and this repo's mac/ directory to the Mac (or fetch the IPSW there).
   2. swiftc -O mac/vzinstall.swift -o vzinstall -framework Virtualization -framework AppKit
      codesign --force --sign - --entitlements mac/vz.entitlements vzinstall
   3. ./vzinstall install $ipsw ./vmdir 64
         (the install takes 296 s on an M3 Max; writes disk.img aux.img machineid.bin hardwaremodel.bin)
   4. ./vzinstall run ./vmdir     (opens a window: MANUAL Setup Assistant)
         English/US, no transfer, account name snap, password snaplab, no Apple Account, location
         services off, analytics off, then System Settings > Users & Groups > automatic login as
         snap, then Shut Down. About 3 minutes.
   5. Copy vmdir/{disk.img,aux.img,machineid.bin,hardwaremodel.bin} to this Linux host (rsync --sparse), then:
         snapintosh make-disk import ./vmdir

  No AVPBooter is needed: Ambrosia replaces AVPBooter and iBoot (build it with 'snapintosh build').
  Only the legacy path (run --fw avp) wants AVPBooter.vmapple2.bin, from your own Mac:
      /System/Library/Frameworks/Virtualization.framework/Versions/A/Resources/AVPBooter.vmapple2.bin
      (Apple file: never redistribute it)  then: snapintosh make-disk import ./vmdir --avpbooter ./AVPBooter.vmapple2.bin
  Note: the install leaves Apple's LLB/iBoot code in aux.img. Ambrosia does not run it; the lab zeroed that range once
  (first 0x80000 bytes) and the guest still booted. Not done by this CLI.
  KDK: not needed for this path.
EOF
}

cmd_make_disk() {
  local step=${1:-}; shift || true
  case $step in
    "") die "usage: make-disk mac-steps|import DIR|golden|warm|adopt-golden FILE|sshd-interactive|quiet" ;;
    mac-steps) [ "${1:-}" != --build ] || { ipsw_pick "${2:?usage: make-disk mac-steps --build B}"; }; mac_steps ;;
    import) make_disk_import "$@" ;;
    adopt-golden) make_disk_adopt_golden "$@" ;;
    golden) make_disk_golden "$@" ;;
    warm) make_disk_warm "$@" ;;
    sshd-interactive) make_disk_sshd_interactive ;;
    quiet) make_disk_quiet "$@" ;;
    *) die "make-disk: unknown step $step (mac-steps, import, adopt-golden, golden, warm, sshd-interactive, quiet)" ;;
  esac
}

make_disk_import() {
  local dir=${1:-} boot=""
  [ -n "$dir" ] || die "usage: make-disk import DIR [--avpbooter FILE]   (AVPBooter only for the legacy --fw avp path)"
  shift
  while [ $# -gt 0 ]; do case $1 in --avpbooter) boot=$2; shift ;; *) die "import: unknown option $1" ;; esac; shift; done
  local f
  for f in disk.img aux.img machineid.bin hardwaremodel.bin; do [ -f "$dir/$f" ] || die "$dir/$f missing: that file comes from the Mac step (snapintosh make-disk mac-steps)"; done
  [ -z "$boot" ] || [ -f "$boot" ] || die "$boot: no such file (AVPBooter.vmapple2.bin comes from your Mac, legacy path only)"
  python3 -I - "$dir/machineid.bin" <<'PY' >/dev/null || die "machineid.bin is not a plist with an ECID"
import plistlib, sys
assert "ECID" in plistlib.load(open(sys.argv[1], "rb"))
PY
  mkdir -p "$VM"
  cp --sparse=always "$dir/disk.img" "$VM/disk.img"
  # the lab trims the first 16 KiB of aux.img (one dd block of 0x4000) to get the 32 MiB pflash payload
  cp "$dir/aux.img" "$VM/aux.full.img"
  dd if="$VM/aux.full.img" of="$VM/aux.img" bs=$((0x4000)) skip=1 status=none
  cp "$dir/machineid.bin" "$dir/hardwaremodel.bin" "$VM/"
  [ -z "$boot" ] || cp "$boot" "$VM/AVPBooter.vmapple2.bin"
  rm -f "$KNOWN_HOSTS"
  ok "imported into $VM (master disk.img is never booted directly, runs use qcow2 overlays)"
  echo "next: snapintosh make-disk golden (builds the tuned golden, tested) or snapintosh make-disk adopt-golden FILE (you already have one)"
}

ecid() { python3 -I -c 'import plistlib,sys;print(plistlib.load(open(sys.argv[1],"rb"))["ECID"])' "$VM/machineid.bin"; }

# golden_unfinished_phase1 GOLDENDIR: . A snapintosh SIGKILLed during phase 1 leaves QEMU, qemu-nbd and the memfd holder in
# GOLDENDIR/tmp and a half written root-sshd.qcow2. They are stopped like a dead run's, and the overlay is set aside as .failed (it is not a golden).
golden_unfinished_phase1() {
  local g=$1
  [ -f "$g/tmp/phase1.running" ] || { reap_stale "$RUNS" "$g/tmp"; return 0; }
  if ! cli_dead "$g/tmp"; then   # the snapintosh that owns this phase 1 still runs (or its cli.pid is unreadable): never build on its overlay
    die "make-disk golden: phase 1 of another snapintosh is still running (see $g/tmp/cli.pid); wait for it, or if it is gone remove $g/tmp/phase1.running and $g/tmp/cli.pid"
  fi
  reap_stale "$RUNS" "$g/tmp"
  kill_nbd "$g/tmp/nbd.pid" "$g/tmp/nbd.sock"
  rm -f "$g/tmp/phase1.running" "$g/tmp/cli.pid"
  [ -f "$g/root-sshd.qcow2" ] || return 0
  mv -f "$g/root-sshd.qcow2" "$g/root-sshd.failed.qcow2"
  warn "an earlier make-disk golden died during phase 1: its processes are stopped and its overlay is kept as $g/root-sshd.failed.qcow2; run make-disk golden again (without --again)"
}
make_disk_golden() { # [BASE-DISK] [--no-quiet] [--user U] [--password-file F]: installed disk to the tuned golden, no Mac needed
  local base="" quiet=1 user=snap pw=${GUEST_PW:-snaplab} again=0 warm=0
  local -a runopts=()
  while [ $# -gt 0 ]; do
    case $1 in
      --no-quiet) quiet=0 ;;
      --warm) warm=$2; shift ;;   # boots of the finished golden that fill the translation cache (0 = off)
      --again) again=1 ;;   # phase 1 already done (golden/root-sshd.qcow2 exists, for example after a failed phase 2): run phase 2 only
      --cpus|--gpu|--icd|--mesa|--ssh-port|--ram|--secs) runopts+=("$1" "$2"); shift ;;   # phase 2 is a normal boot: same options as run
      --user) user=$2; shift ;;
      --password-file) [ -r "${2:-}" ] || die "golden: --password-file: cannot read ${2:-}"; pw=$(head -n 1 "$2"); shift ;;
      --password) die "golden: --password is gone (a password on the command line shows in ps): use --password-file FILE or the environment variable SNAPINTOSH_GUEST_PASSWORD" ;;
      -*) die "golden: unknown option $1" ;;
      *) base=$1 ;;
    esac; shift
  done
  # the user name is typed into a root shell in the guest (and quoted there as well): a macOS short name only
  [[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "golden: --user must be a short name: lower case letters, digits, _ and -, at most 32, not starting with a digit or dash"
  [ -n "$pw" ] || die "golden: the guest password is empty"
  [ -n "$base" ] || base=$VM/disk.img
  [ -f "$base" ] || die "$base: no such file (usage: make-disk golden [BASE-DISK]; the default is the imported $VM/disk.img)"
  base=$(readlink -f "$base")
  [ -f "$VM/aux.img" ] && [ -f "$VM/machineid.bin" ] || die "aux.img / machineid.bin missing: run make-disk import first (the base disk is only the root disk)"
  local q=$PREFIX/bin/qemu-system-aarch64 qimg=$PREFIX/bin/qemu-img
  local helper=$PREFIX/share/snapintosh/27on86
  [ "$FW" = ambrosia ] || die "golden: only the Ambrosia path is automated (the legacy --fw avp single-user flow is the lab's old manual one)"
  echo "make-disk golden from $base (opened read only: every change goes into qcow2 overlays on top of it)"
  echo " phase 1, offline, single-user boot on a serial socket (Ambrosia BootArgs '-s -v serial=11', the lab policy keys come from the bundle):"
  echo "   ed25519 root key + sshd LaunchDaemon (persist-sshd.py), sshd ProcessType Interactive, timed fix, autologin fallback"
  echo " phase 2, one normal boot, over ssh: quiet profile (apply-quiet.sh), clean shutdown. Result: golden/root-quiet.qcow2 on golden/root-sshd.qcow2 on the base"
  parse_run_opts "${runopts[@]}"
  [[ $warm =~ ^[0-9]+$ ]] || die "golden: --warm needs a number of boots (0 = none)"
  [ "$DRY" = 1 ] && return 0
  [ -x "$q" ] || die "QEMU not built: snapintosh build"
  [ -f "$helper/persist-sshd.py" ] || die "persist-sshd.py missing under $helper (it is installed by 'build' from the QEMU fork's scripts/27on86)"
  [ -f "$PREFIX/$AMB_DIR_REL/ambrosia.bin" ] || die "Ambrosia not built: snapintosh build --only ambrosia"
  need cpio "apt install cpio"
  local g=$VM/golden; mkdir -p "$g/ssh-state" "$g/tmp"
  golden_unfinished_phase1 "$g"
  # the unix sockets of phase 1 (serial.sock, nbd.sock, qmp.sock) must fit sun_path (108 bytes)
  [ "$(path_bytes "$g/tmp/serial.sock")" -lt 108 ] || die "SNAPINTOSH_HOME is too long: the socket $g/tmp/serial.sock would not fit the 107 bytes of a unix socket path; use a shorter SNAPINTOSH_HOME"
  if [ "$again" = 1 ]; then [ -f "$g/root-sshd.qcow2" ] || die "--again: no $g/root-sshd.qcow2 (phase 1 has not run)"
  else
  [ ! -e "$g/root-sshd.qcow2" ] || die "$g/root-sshd.qcow2 exists: move the golden directory away first, or use --again to run phase 2 on it (this step never overwrites a golden)"
  rm -f "$KNOWN_HOSTS"   # a new golden has new ssh host keys; the first ssh pins them again (only after the refusal above: a refused run keeps the pin)
  # from here on every exit path (die, a failing command, Ctrl-C) stops what phase 1 started and sets an unfinished overlay aside.
  # A pid file from an earlier failed phase 1 is stale: gone before the trap exists, and the trap checks the process anyway (kill_nbd)
  rm -f "$g/tmp/nbd.pid"
  CL_PIDS=(); CL_CTLS=(); CL_NBDPID=$g/tmp/nbd.pid; CL_NBDSOCK=$g/tmp/nbd.sock; CL_P1=$g/root-sshd.qcow2; CL_RUN=$g/tmp; CL_COMPACT=""
  cl_trap
  echo "$$:$(pstart "$$"):$PIDNS" > "$g/tmp/cli.pid"; : > "$g/tmp/phase1.running"   # for reap_stale and golden_unfinished_phase1 of a later command
  "$qimg" create -q -f qcow2 -b "$base" -F raw "$g/root-sshd.qcow2"
  cp "$VM/aux.img" "$g/tmp/aux"
  python3 -I "$helper/set-aux-boot-args.py" "$g/tmp/aux" "-s -v serial=11"
  local sock=$g/tmp/serial.sock
  rm -f "$sock" "$g/tmp/nbd.sock" "$g/tmp/qmp.sock"
  "$PREFIX/bin/qemu-nbd" -k "$g/tmp/nbd.sock" -f qcow2 --shared=0 -t "$g/root-sshd.qcow2" --fork --pid-file="$g/tmp/nbd.pid"
  python3 -I "$LIB/memfdhold.py" 8G "$g/tmp/memfd.path" 3600 & local mh=$!
  track "$mh"
  local i=0; until [ -s "$g/tmp/memfd.path" ]; do kill -0 "$mh" 2>/dev/null || die "memfd holder exited"; sleep 0.1; i=$((i + 1)); [ $i -lt 100 ] || die "memfd holder did not start"; done
  make_bundle "$g/tmp/single.cpio" "-s -v serial=11"
  local ep t0; t0=$(date +%s)
  # no pcache here on purpose: the single-user boot makes 0.24 million records (159 MiB), 1.6 percent of its own lookups hit and phase 2 gets
  # about 1 percent fewer misses from them, so they are dead weight for the pack
  timeout -k 10 1800 python3 -I "$LIB/pdeath.py" "$q" -accel tcg,tb-size=2047 \
    -machine "vmapple,uuid=$(ecid),memory-backend=ram0,ambrosia=on" \
    -bios "$PREFIX/$AMB_DIR_REL/ambrosia.bin" -device "loader,file=$g/tmp/single.cpio,addr=0x120000000,force-raw=on" \
    -cpu max -smp 4 -m 8G \
    -object "memory-backend-file,id=ram0,size=8G,mem-path=$(cat "$g/tmp/memfd.path"),share=on,align=2M" \
    -display none -monitor none -parallel none \
    -serial "unix:$sock,server=on,wait=off" -qmp "unix:$g/tmp/qmp.sock,server=on,wait=off" \
    -drive if=pflash,format=raw,file.filename="$g/tmp/aux",file.locking=off \
    -drive if=pflash,format=raw,file.driver=nbd,file.server.type=unix,file.server.path="$g/tmp/nbd.sock" \
    -drive if=none,format=raw,file.filename="$g/tmp/aux",file.locking=off,id=aux \
    -device "vmapple-virtio-blk-pci,variant=aux,drive=aux,share-rw=on" \
    -drive if=none,format=raw,file.driver=nbd,file.server.type=unix,file.server.path="$g/tmp/nbd.sock",id=root \
    -device "vmapple-virtio-blk-pci,variant=root,drive=root,share-rw=on" \
    -netdev user,id=net0,ipv6=off -device virtio-net-pci,netdev=net0,romfile=,mac=52:54:00:76:61:70 >"$g/tmp/qemu.out" 2>&1 &
  ep=$!
  track "$ep"
  local rc=0
  # wait passively for the shell: anything typed while the boot runs makes it stop in its panic loop
  i=0; until [ -S "$sock" ]; do sleep 1; i=$((i + 1)); [ $i -lt 120 ] || break; done
  if python3 -I "$helper/persist-sshd.py" "$sock" "$g/ssh-state" \
     && SNAPINTOSH_GUEST_PASSWORD=$pw python3 -I "$LIB/goldenctl.py" extra "$sock" "$helper" "$LIB/guest" --user "$user"; then :
  else rc=1; warn "phase 1 failed, see $g/tmp/qemu.out"; fi
  # the guest halts itself; give it 120 s, then ask QEMU to quit over QMP, then stop that exact PID
  i=0; while plive "$ep" && [ $i -lt 120 ]; do sleep 1; i=$((i + 1)); done
  if plive "$ep"; then
    python3 -I - "$g/tmp/qmp.sock" <<'PY' || true
import json, socket, sys
s = socket.socket(socket.AF_UNIX); s.settimeout(10); s.connect(sys.argv[1]); f = s.makefile("rw"); f.readline()
for c in ("qmp_capabilities", "quit"):
    f.write(json.dumps({"execute": c}) + "\n"); f.flush(); f.readline()
PY
    sleep 3
    kill "$ep" 2>/dev/null || true
  fi
  wait "$ep" 2>/dev/null || true
  kill_nbd "$g/tmp/nbd.pid" "$g/tmp/nbd.sock"; kill "$mh" 2>/dev/null || true
  [ $rc = 0 ] || { mv "$g/root-sshd.qcow2" "$g/root-sshd.failed.qcow2"; rm -f "$g/tmp/phase1.running" "$g/tmp/cli.pid"; die "golden phase 1 failed: overlay kept as $g/root-sshd.failed.qcow2, log $g/tmp/qemu.out (the base disk was not touched)"; }
  cleanup_reset
  rm -f "$g/tmp/phase1.running" "$g/tmp/cli.pid"
  ok "phase 1: $g/root-sshd.qcow2 ($(( $(date +%s) - t0 )) s), key $g/ssh-state/id_ed25519"
  fi
  if [ "$quiet" = 1 ]; then
    cp "$LIB/guest/apply-quiet.sh" "$g/tmp/apply-quiet.sh"
    MODE=golden; SNAPNAME=golden; SAVESETTLE=0; launch
    [ "$LAUNCH_RC" = 0 ] || die "golden phase 2 failed (see the run dir above, $RUNS/golden-*/golden.json and snapctl.log)"
    [ -f "$g/root-quiet.qcow2" ] || die "phase 2 failed: no root-quiet.qcow2 (see $RUNS/golden-*/golden.json and snapctl.log)"
    ok "golden: $g/root-quiet.qcow2"
    [ "$warm" = 0 ] || warm_boots "$warm"
  else
    ok "golden: $g/root-sshd.qcow2 (quiet profile skipped: make-disk quiet later)"
  fi
  "$qimg" info -U --backing-chain "$g/$([ "$quiet" = 1 ] && echo root-quiet || echo root-sshd).qcow2" | grep -E '^image|backing file:'
  echo "user actions left: none after make-disk import; check with: snapintosh run"
}

# a new user's first `run` has no translation pack, so it translates about 6 million blocks itself (Dock 80.8 s against 65.9 s warm).
# The two golden boots already append to the pack (same QEMU, same key as `run`), but phase 2 is the not yet quiet guest, shut down right
# after the profile is applied, and it never starts Safari. warm_boots boots the finished golden like a run: desktop, Safari open, Safari
# quit, clean shutdown, pcache rw. The overlay is thrown away every time, the golden is not changed.
warm_boots() { # N
  local n i
  dec_into n "$1" "warm-up boots" boots
  [ "$n" -gt 0 ] || return 0
  [ -f "$VM/golden/root-quiet.qcow2" ] || [ -f "$VM/golden/root-sshd.qcow2" ] || die "no golden image: snapintosh make-disk golden"
  [ "$USE_PCACHE" = 1 ] || { warn "warm: --no-pcache set, nothing to warm"; return 0; }
  local t0; t0=$(date +%s)
  for ((i = 1; i <= n; i++)); do
    echo "warm-up boot $i of $n: normal boot to the desktop, Safari opened and quit, shutdown (about 4 to 6 minutes); it only fills the translation cache"
    MODE=warm; SNAPNAME=golden-warm; SAVESETTLE=0
    launch
    [ "$LAUNCH_RC" = 0 ] || { warn "warm-up boot $i failed"; return 1; }
    # the pack of the previous boot is compacted detached after QEMU exits; the next boot reads the pack before that finishes, harmless
  done
  ok "warm-up: $n boot(s), $(( $(date +%s) - t0 )) s, translation cache $(du -ch "$PCACHE_DIR"/*.pack 2>/dev/null | tail -1 | cut -f1) in $PCACHE_DIR"
}

make_disk_warm() { # [N] [run options]
  local n=1
  if [[ ${1:-} =~ ^[0-9]+$ ]]; then n=$1; shift; fi
  parse_run_opts "$@"
  [ "$DRY" = 1 ] && return 0
  [ -x "$PREFIX/bin/qemu-system-aarch64" ] || die "QEMU not built: snapintosh build"
  warm_boots "$n"
}

make_disk_adopt_golden() { # FILE [--ssh-state DIR] [--name quiet|sshd]: copy an existing qcow2 golden chain next to the imported disk
  local top=${1:-} sshdir="" name=quiet
  [ -n "$top" ] || die "usage: make-disk adopt-golden FILE [--ssh-state DIR] [--name quiet|sshd]"
  shift
  while [ $# -gt 0 ]; do case $1 in --ssh-state) sshdir=$2; shift ;; --name) name=$2; shift ;; *) die "adopt-golden: unknown option $1" ;; esac; shift; done
  case $name in quiet|sshd) ;; *) die "adopt-golden: --name quiet|sshd" ;; esac
  [ -f "$top" ] || die "$top: no such file"
  [ -f "$VM/disk.img" ] || die "no imported disk: run make-disk import first (the golden is an overlay on that disk.img)"
  local qimg=qemu-img; [ -x "$PREFIX/bin/qemu-img" ] && qimg=$PREFIX/bin/qemu-img
  need "$qimg" "apt install qemu-utils"
  # the chain, top first: one "path" line per layer, the raw base last
  local -a chain=()
  mapfile -t chain < <("$qimg" info -U --backing-chain --output=json "$top" | python3 -I -c 'import json,sys
for l in json.load(sys.stdin): print(l["filename"] + "\t" + l["format"])')
  [ "${#chain[@]}" -ge 2 ] || die "$top has no backing file: not an overlay chain (expected layers on top of the disk.img)"
  local g=$VM/golden n=$(( ${#chain[@]} - 1 )) i f fmt prev
  mkdir -p "$g/ssh-state" "$g/chain"
  # bottom-up: copy layer i, point it at the copy of layer i+1 (the raw base becomes $VM/disk.img)
  prev=$VM/disk.img
  local prevfmt=raw
  for (( i = n; i >= 1; i-- )); do
    f=${chain[$i - 1]%%$'\t'*}; fmt=${chain[$i - 1]##*$'\t'}
    [ "$fmt" = qcow2 ] || die "layer $f is $fmt, only qcow2 layers are supported"
    cp --sparse=always "$f" "$g/chain/layer$i.qcow2"
    "$qimg" rebase -u -f qcow2 -F "$prevfmt" -b "$prev" "$g/chain/layer$i.qcow2"
    prev=$g/chain/layer$i.qcow2; prevfmt=qcow2
  done
  ln -sf "chain/layer1.qcow2" "$g/root-$name.qcow2"
  rm -f "$KNOWN_HOSTS"
  [ -z "$sshdir" ] || { cp "$sshdir"/id_ed25519* "$g/ssh-state/" && chmod 600 "$g/ssh-state/id_ed25519"; }
  [ -f "$g/ssh-state/id_ed25519" ] || warn "no ssh key in $g/ssh-state: pass --ssh-state DIR (the dir that holds id_ed25519), or ssh into the guest will not work"
  ok "golden adopted: $g/root-$name.qcow2 ($n layers on $VM/disk.img)"
  "$qimg" info -U --backing-chain "$g/root-$name.qcow2" | grep -E '^image|backing file:'
}

