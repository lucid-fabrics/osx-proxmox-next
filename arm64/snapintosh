# ---------------------------------------------------------------- run / snapshot / resume
CPUS=12; RAM=8G; FW=${SNAPINTOSH_FW:-ambrosia}; GPU=auto; ICD=""; MESA=""; VNC=""; VNC_INSECURE=0; SSHPORT=$SSH_PORT_DEFAULT; SECS=3600
LAUNCH_RC=0   # launch always returns 0 (it runs with its own error handling); its verdict is here and the callers act on it
PCMODE=rw; USE_PCACHE=1
MODE=cold; SNAPNAME=""; SAVE_APP=""; SAVE_OPEN_URL=""

# what --app and --open may carry: both end up in a command that runs in the guest (see lib/guestapp.py), so a strict whitelist
app_name_ok() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9.\ -]{0,63}$ ]]; }
open_url_ok() { [[ $1 =~ ^(https?|file)://[A-Za-z0-9._~:/?=#%+,@-]+$ ]]; }

parse_run_opts() {
  while [ $# -gt 0 ]; do
    case $1 in
      --cpus) CPUS=$2; shift ;;
      --fw) FW=$2; shift ;;
      --ram) RAM=$2; shift ;;
      --gpu) GPU=$2; shift ;;
      --icd) ICD=$2; shift ;;
      --mesa) MESA=$2; shift ;;
      --vnc) if [[ ${2:-} =~ ^[0-9]+$ ]]; then dec_into VNC "$2" "--vnc PORT"; shift; else VNC=5900; fi
             [ "$VNC" -ge 5900 ] && [ "$VNC" -le 65535 ] || die "--vnc PORT: a TCP port from 5900 to 65535 (display N is port 5900+N)" ;;
      --vnc-insecure) VNC_INSECURE=1 ;;
      --ssh-port) SSHPORT=$2; shift ;;
      --secs) dec_into SECS "${2:-}" --secs seconds; shift ;;
      --settle) SAVESETTLE=$2; shift ;;
      --app) app_name_ok "${2:-}" || die "--app NAME: the name of an app in /Applications (letters, digits, space, dot, dash; at most 64), for example Safari"
             SAVE_APP=$2; shift ;;
      --open) open_url_ok "${2:-}" || die "--open URL: an http://, https:// or file:// URL of letters, digits and - . _ ~ : / ? = # % + , @ only (no spaces, quotes or shell characters)"
              SAVE_OPEN_URL=$2; shift ;;
      --no-pcache) USE_PCACHE=0 ;;
      --pcache-ro) PCMODE=ro ;;
      --dry-run) DRY=1 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option $1 (snapintosh --help lists the options)" ;;
    esac
    shift
  done
}

pick_gpu() {
  # echo "1 ICD" for a real GPU, "0" for lavapipe
  if [ "$GPU" = 0 ]; then echo 0; return; fi
  local f found=""
  if [ -n "$ICD" ]; then echo "1 $ICD"; return; fi
  for f in /usr/share/vulkan/icd.d/nvidia_icd.json /usr/share/vulkan/icd.d/radeon_icd.x86_64.json \
           /usr/share/vulkan/icd.d/radeon_icd.json /usr/share/vulkan/icd.d/intel_icd.x86_64.json \
           /usr/share/vulkan/icd.d/intel_icd.json; do
    [ -f "$f" ] || continue
    # Debian's mesa-vulkan-drivers installs radeon_icd.json and intel_icd.json on every host, GPU or not: an ICD file is no proof of a
    # device (a VM with none aborted phase 2 of make-disk golden with "Failed to detect any valid GPUs"). --gpu auto asks it.
    if command -v vulkaninfo >/dev/null 2>&1 && ! VK_ICD_FILENAMES=$f timeout 30 vulkaninfo --summary 2>/dev/null \
         | grep -Eq 'deviceType *= *PHYSICAL_DEVICE_TYPE_(DISCRETE|INTEGRATED)_GPU'; then continue; fi
    found=$f; break
  done
  if [ -n "$found" ]; then echo "1 $found"
  elif [ "$GPU" = 1 ]; then die "--gpu 1 but no GPU ICD found in /usr/share/vulkan/icd.d; pass --icd"
  else echo 0; fi
}

snapname_check() { valid_snapname "$1" || die "invalid snapshot name '$1': use 1 to 64 of A-Z a-z 0-9 . _ - (first one a letter or digit, no '..')"; }
save_only_opts() { [ -z "$SAVE_APP$SAVE_OPEN_URL" ] || die "--app and --open belong to snapshot (they decide whether a save goes ahead)"; }
cmd_run() { MODE=cold; parse_run_opts "$@"; save_only_opts; launch; return "$LAUNCH_RC"; }
cmd_snapshot() {
  MODE=save; SNAPNAME=${1:-}; [ -n "$SNAPNAME" ] || die "usage: snapshot NAME [options]"; snapname_check "$SNAPNAME"; shift
  parse_run_opts "$@"; launch; return "$LAUNCH_RC"
}
cmd_resume() {
  MODE=resume; SNAPNAME=${1:-}; [ -n "$SNAPNAME" ] || die "usage: resume NAME [options]"; snapname_check "$SNAPNAME"; shift
  settime_budget >/dev/null   # a bad SETTIME_TIMEOUT stops here, before QEMU starts
  parse_run_opts "$@"; save_only_opts; launch; return "$LAUNCH_RC"
}

# bytes of a path (a unix socket address holds 107 plus the NUL, bytes, not characters)
path_bytes() { local LC_ALL=C; printf '%s' "${#1}"; }
# the sockets in a run dir (nbd.sock, qmp.sock, and ssh.ctl, to which ssh appends a 17 byte temporary suffix while it binds) must fit
# sun_path (108 bytes). The run dir is $RUNS/NAME-XXXXXX, so the name has a limit that depends on the length of SNAPINTOSH_HOME.
sock_name_check() { # NAME
  local n=$1 max
  max=$(( 107 - 17 - 8 - 7 - 1 - $(path_bytes "$RUNS") ))   # minus the ssh suffix, "/ssh.ctl", "-XXXXXX", the "/" after runs
  [ "$max" -ge 8 ] || die "SNAPINTOSH_HOME is too long ($(path_bytes "$HOME_DIR") bytes): the sockets in $RUNS/<name>-XXXXXX/ would not fit the 107 bytes of a unix socket path; use a shorter SNAPINTOSH_HOME"
  [ "$(path_bytes "$n")" -le "$max" ] || die "name '$n' is too long for this SNAPINTOSH_HOME: at most $max bytes (the sockets in the run dir $RUNS/<name>-XXXXXX/ must fit the 107 bytes of a unix socket path)"
}

launch() {
  LAUNCH_RC=0
  local Q=$PREFIX/bin/qemu-system-aarch64 QIMG=$PREFIX/bin/qemu-img QNBD=$PREFIX/bin/qemu-nbd
  sock_name_check "${SNAPNAME:-run}"
  # these paths go into QEMU option strings, where a comma starts the next option
  case $HOME_DIR$PREFIX$SNAPS in *,*|*$'\n'*) die "SNAPINTOSH_HOME, SNAPINTOSH_PREFIX and SNAPS must not contain a comma or a newline" ;; esac
  case $FW in ambrosia|avp) ;; *) die "--fw ambrosia|avp" ;; esac
  local base=$VM/golden/root-quiet.qcow2
  [ -f "$base" ] || base=$VM/golden/root-sshd.qcow2
  [ "$MODE" = golden ] && base=$VM/golden/root-sshd.qcow2   # make-disk golden phase 2: the quiet profile goes on top of phase 1
  local key=$VM/golden/ssh-state/id_ed25519
  if [ "$DRY" != 1 ]; then
    [ -x "$Q" ] || die "QEMU not built: snapintosh build"
    [ -f "$VM/aux.img" ] || die "no disk: snapintosh make-disk mac-steps"
    if [ "$FW" = ambrosia ]; then
      [ -f "$PREFIX/$AMB_DIR_REL/ambrosia.bin" ] && [ -f "$PREFIX/$AMB_DIR_REL/config.cpio" ] || die "Ambrosia not built: snapintosh build --only ambrosia"
    else
      [ -f "$VM/AVPBooter.vmapple2.bin" ] || die "legacy path needs AVPBooter.vmapple2.bin: snapintosh make-disk import --avpbooter, or run with the default --fw ambrosia"
    fi
    [ -f "$base" ] || die "no golden image: snapintosh make-disk golden"
    [ -e /dev/udmabuf ] || warn "/dev/udmabuf missing: the GPU path will not work"
  fi
  # resume: the build that saved the snapshot, or one with the same state format, or the older binary `build` kept (snapctl.py pick)
  [ "$MODE" = resume ] && [ "$DRY" != 1 ] && { Q=$(python3 -I "$LIB/snapctl.py" pick "$SNAPNAME" "$Q") || exit 3; }
  local f gpu_sel; gpu_sel=$(pick_gpu); local gpu=${gpu_sel%% *}
  local ECID; ECID=$([ -f "$VM/machineid.bin" ] && ecid || echo 0)
  local extra=""
  [ "$MODE" != cold ] && [ "$MODE" != golden ] && [ "$MODE" != warm ] && extra="-global apple-gfx-mmio.disable-argument-buffers=on"
  local pcache=""
  if [ "$USE_PCACHE" = 1 ]; then pcache=",pcache=$PCACHE_DIR,pcache-mode=$PCMODE,pcache-stats=0"; fi
  # the run dir: unique (mktemp), made by the first real step; a dry run only shows the name pattern
  local R=$RUNS/${SNAPNAME:-run}-XXXXXX

  # environment the lab run.sh sets
  # Default settings: IOFence patch on (any-build matcher, refuses unknown builds), DSB skips (P80_BC, P85_BC) and the
  # early pack open on resume (P82_PCOPEN) are on inside the binary and need no variable
  export SNAP_IOFENCE_PATCH=${SNAP_IOFENCE_PATCH:-1}
  export LP_NUM_THREADS=${LP_NUM_THREADS:-8} REIMS_VGPU_WINDOW=0 M2V_INPLACE_RT=${M2V_INPLACE_RT:-1} REIMS_VGPU_LOG=${REIMS_VGPU_LOG:-warn}
  if [ "$gpu" = 1 ]; then
    export VK_ICD_FILENAMES=${gpu_sel#* }
  else
    local m=${MESA:-$HOME_DIR/mesa}
    local lvp=""
    for f in "$m"/share/vulkan/icd.d/lvp_icd*.json; do [ -f "$f" ] && { lvp=$f; break; }; done
    if [ -n "$lvp" ]; then export VK_ICD_FILENAMES=$lvp LD_LIBRARY_PATH="$m/lib/x86_64-linux-gnu:$m/lib"; fi
    [ -n "$lvp" ] || { [ "$DRY" = 1 ] || warn "no patched lavapipe under $m (snapintosh build --only mesa): stock lavapipe lacks interlock and the guest will not render"; }
  fi

  local ramobj="memory-backend-file,id=ram0,size=$RAM,mem-path=\$MEMFD,share=on,align=2M"
  local machine bios
  local -a fwdev=()
  # sync-clock-on-load is opt-in (SYNCCLOCK=1, or SYNCCLOCK=auto: on for a snapshot younger than SYNCMAXAGE seconds, default 300).
  # It moves the guest counter forward by the time since the save, so the clock is right at once, but the guest then runs the work
  # that fell due in the gap: fine for seconds, slow for hours. The Ambrosia machine does not need it (its avp-rtc follows the host
  # through a load, 10 of 10 resumes within 1 s); the legacy --fw avp machine lags by the gap
  # until timed steps the clock about 60 s later.
  local syncclock=${SYNCCLOCK:-}
  if [ "$MODE" = resume ] && [ "$syncclock" = auto ] && [ "$DRY" != 1 ]; then
    local sage; sage=$(python3 -I "$LIB/snapctl.py" age "$SNAPNAME" 2>/dev/null || echo 999999999)
    if [ "$sage" -lt "${SYNCMAXAGE:-300}" ] 2>/dev/null; then syncclock=1; else syncclock=0; fi
  fi
  if [ "$FW" = ambrosia ]; then
    # boot args and policy (internal-use-only-unit, lp-sip0) come from the config bundle, not from machine properties
    machine="vmapple,uuid=$ECID,memory-backend=ram0,ambrosia=on"
    bios=$PREFIX/$AMB_DIR_REL/ambrosia.bin
    fwdev=(-device "loader,file=$PREFIX/$AMB_DIR_REL/config.cpio,addr=0x120000000,force-raw=on")
  else
    machine="vmapple,uuid=$ECID,internal-use-only-unit=on,memory-backend=ram0,csr-config=0x7f,xnu-boot-args=-v"
    bios=$VM/AVPBooter.vmapple2.bin
  fi
  local -a cmd=("$Q" -accel "tcg,tb-size=2047$pcache"
    -machine "$machine"
    -cpu max -smp "$CPUS" -m "$RAM"
    -object "$ramobj"
    -display none -monitor none -parallel none)
  if [ -n "$VNC" ]; then
    cmd+=(-L "$PREFIX/share/qemu")
    if [ "$VNC_INSECURE" = 1 ]; then cmd+=(-vnc "127.0.0.1:$((VNC - 5900))")
    else cmd+=(-object "secret,id=vncsec,file=$R/vnc.pass" -vnc "127.0.0.1:$((VNC - 5900)),password-secret=vncsec"); fi
  fi
  cmd+=(-serial "file:$R/serial.log" -qmp "unix:$R/qmp.sock,server=on,wait=off")
  [ "$MODE" = resume ] && cmd+=(-incoming defer)
  # shellcheck disable=SC2206
  [ -n "$extra" ] && cmd+=($extra)
  [ "$MODE" = resume ] && [ "$syncclock" = 1 ] && machine="$machine,sync-clock-on-load=on"
  cmd[4]=$machine
  cmd+=(-bios "$bios" "${fwdev[@]}"
    -drive "if=pflash,format=raw,file.filename=$R/aux,file.locking=off"
    -drive "if=pflash,format=raw,file.driver=nbd,file.server.type=unix,file.server.path=$R/nbd.sock"
    -drive "if=none,format=raw,file.filename=$R/aux,file.locking=off,id=aux"
    -device "vmapple-virtio-blk-pci,variant=aux,drive=aux,share-rw=on"
    -drive "if=none,format=raw,file.driver=nbd,file.server.type=unix,file.server.path=$R/nbd.sock,id=root"
    -device "vmapple-virtio-blk-pci,variant=root,drive=root,share-rw=on"
    -netdev "user,id=net0,ipv6=off,hostfwd=tcp:127.0.0.1:$SSHPORT-:22"
    -device "virtio-net-pci,netdev=net0,romfile=,mac=52:54:00:76:61:70")

  if [ "$DRY" = 1 ]; then
    echo "mode=$MODE fw=$FW gpu=$gpu${VK_ICD_FILENAMES:+ ICD=$VK_ICD_FILENAMES} cpus=$CPUS ram=$RAM golden=$base"
    echo "env: SNAP_IOFENCE_PATCH=$SNAP_IOFENCE_PATCH LP_NUM_THREADS=$LP_NUM_THREADS REIMS_VGPU_WINDOW=0 M2V_INPLACE_RT=$M2V_INPLACE_RT REIMS_VGPU_LOG=$REIMS_VGPU_LOG"
    printf '%q ' "${cmd[@]}"; echo
    return 0
  fi

  # Resume: refuse before anything is created if the snapshot does not match this QEMU and these options
  if [ "$MODE" = resume ]; then python3 -I "$LIB/snapctl.py" check "$SNAPNAME" "$Q" "$CPUS" "$RAM" "$extra" "$gpu" || exit 3; fi
  # From here on every exit path (die, a failing command, Ctrl-C, SIGTERM) runs cleanup_all, which stops every process this run started
  # (helper, tail, QEMU, memfd holder and what they started), qemu-nbd and the ssh master, drops an unfinished snapshot's staging
  # directory and removes an empty run dir. Ctrl-C and SIGTERM then end the CLI with 128+signal. The trap comes BEFORE the first resource.
  reap_stale "$RUNS" "$VM/golden/tmp"
  reap_leftovers "$RUNS"
  pgo_reap
  CL_PIDS=(); CL_CTLS=(); CL_RMDIR=""; CL_P1=""; CL_NBDPID=""; CL_NBDSOCK=""; CL_ABORT=(); CL_RMRUN=""; CL_RUN=""; CL_COMPACT=""
  cl_trap
  mkdir -p "$RUNS" "$PCACHE_DIR" "$SNAPS"
  R=$(mktemp -d "$RUNS/${SNAPNAME:-run}-XXXXXX")
  if [ "${PCCOMPACT:-1}" = 1 ] && [ "$USE_PCACHE" = 1 ] && [ "$PCMODE" = rw ] && [ -x "$PREFIX/bin/qemu-pcache-compact" ]; then CL_COMPACT=$PREFIX/bin/qemu-pcache-compact; fi
  CL_RUN=$R; CL_RMDIR=$R; CL_NBDPID=$R/nbd.pid; CL_NBDSOCK=$R/nbd.sock; CL_CTLS=("$R/ssh.ctl")
  echo "$$:$(pstart "$$"):$PIDNS" > "$R/cli.pid"   # who owns this run (pid, start tick, pid namespace), for reap_stale of a later command
  [ "$MODE" = save ] && CL_ABORT=("$SNAPNAME" "$R")
  # an interrupted run leaves no run dir behind (a golden keeps its overlay there: only the other modes)
  { [ "$MODE" = golden ] || [ "${KEEP_RUNS:-0}" = 1 ]; } || CL_RMRUN=$R
  { [ "$MODE" = golden ] || [ "${KEEP_RUNS:-0}" = 1 ]; } && : > "$R/keep"   # reap_leftovers keeps this one if the CLI dies
  # re-derive the arguments that carry the run dir now that its name is known (the pattern is quoted: no glob, and no `&` problem with patsub_replacement off)
  cmd=("${cmd[@]//"$RUNS/${SNAPNAME:-run}-XXXXXX"/$R}")
  local snapdir=""
  if [ "$MODE" = resume ]; then
    snapdir=$SNAPS/$SNAPNAME
    cp --sparse=always "$snapdir/aux" "$R/aux"
    "$QIMG" create -q -f qcow2 -b "$snapdir/root.qcow2" -F qcow2 "$R/root.qcow2"
  else
    cp --sparse=always "$VM/aux.img" "$R/aux"
    "$QIMG" create -q -f qcow2 -b "$base" -F qcow2 "$R/root.qcow2"
  fi
  if [ -n "$VNC" ] && [ "$VNC_INSECURE" != 1 ]; then
    python3 -I -c 'import secrets, string; print("".join(secrets.choice(string.ascii_letters + string.digits) for _ in range(8)))' > "$R/vnc.pass"
    chmod 600 "$R/vnc.pass"
    echo "vnc: 127.0.0.1:$VNC, password in $R/vnc.pass (mode 600)"
  fi
  "$QNBD" -k "$R/nbd.sock" -f qcow2 --shared=0 -t "$R/root.qcow2" --fork --pid-file="$R/nbd.pid"
  python3 -I "$LIB/memfdhold.py" "$RAM" "$R/memfd.path" $((SECS + 120)) & local mh=$!
  track "$mh"
  local i=0; until [ -s "$R/memfd.path" ]; do kill -0 "$mh" 2>/dev/null || die "memfd holder exited (is --ram $RAM valid?)"; sleep 0.1; i=$((i + 1)); [ $i -lt 100 ] || die "memfd holder did not start"; done
  cmd=("${cmd[@]/\$MEMFD/$(cat "$R/memfd.path")}")
  echo "run dir: $R   ssh: ssh -p $SSHPORT -i $key -o UserKnownHostsFile=$KNOWN_HOSTS -o StrictHostKeyChecking=accept-new root@127.0.0.1   renderer: $([ "$gpu" = 1 ] && echo "GPU ${VK_ICD_FILENAMES}" || echo lavapipe)"
  date +%s.%N > "$R/start"
  timeout "$SECS" python3 -I "$LIB/pdeath.py" "${cmd[@]}" >"$R/qemu.out" 2>&1 &
  QP=$!
  track "$QP"
  echo $QP > "$R/qemu.pid"
  # A helper that fails kills QEMU at once: nothing is left idling until --secs.
  local hp=""
  case $MODE in
    golden)
      python3 -I "$LIB/goldenctl.py" quiet "$R" "$SSHPORT" "$key" "$VM/golden/tmp/apply-quiet.sh" "${GOLDEN_SSH_TIMEOUT:-2400}" \
        >"$R/snapctl.log" 2>&1 & hp=$!
      ;;
    warm)
      python3 -I "$LIB/goldenctl.py" warm "$R" "$SSHPORT" "$key" "${GOLDEN_SSH_TIMEOUT:-2400}" >"$R/snapctl.log" 2>&1 & hp=$!
      ;;
    save)
      { SAVE_APP=$SAVE_APP SAVE_OPEN_URL=$SAVE_OPEN_URL python3 -I "$LIB/snapctl.py" save "$SNAPNAME" "$R" "$Q" "$CPUS" "$RAM" "$extra" "$gpu" "$SSHPORT" "$key" "${SAVESETTLE:-60}" \
          || { local hrc=$?; [ "$hrc" != 5 ] || echo 5 > "$R/helper.rc"; kill "$QP" 2>/dev/null; exit "$hrc"; }; } >"$R/snapctl.log" 2>&1 & hp=$!
      ;;
    resume)
      # the loading is the part that must work; the clock step afterwards (own budget, see settime_budget, and a hard
      # limit 30 s above it) only reports: a guest whose clock is off is running and usable
      local stb; stb=$(settime_budget)
      { python3 -I "$LIB/snapctl.py" incoming "$SNAPNAME" "$R" || { kill "$QP" 2>/dev/null; exit 1; }
        if [ "${SNAPINTOSH_NO_SETTIME:-0}" != 1 ]; then
          timeout -k 5 $((stb + 30)) python3 -I "$LIB/snapctl.py" settime "$R" "$SSHPORT" "$key" 0.5 "$stb" \
            || echo "SETTIME did not confirm the guest clock (helper exit status $?; the guest is running; budget $stb s, raise it with SETTIME_TIMEOUT=SECONDS)"
        fi; } >"$R/snapctl.log" 2>&1 & hp=$!
      ;;
  esac
  # show the helper's progress lines (snapshot steps, resume clock, golden phases) while it works: a save takes about 2 minutes
  # and a golden 10, and the helper only writes to $R/snapctl.log
  [ -z "$hp" ] || track "$hp"
  local tp=""
  if [ -n "$hp" ]; then tail -n +1 -F "$R/snapctl.log" 2>/dev/null & tp=$!; track "$tp"; fi
  local qrc=0 hprc=0
  wait "$QP" || qrc=$?
  # the pack QEMU appended to is compacted here, after the VM has exited, not on QEMU's exit path. qemu-pcache-compact takes the pack's lock
  # (a VM started meanwhile reads the old pack and loses nothing but its own new records), writes <pack>.tmp, fdatasync, rename. Detached, idle
  # priority, report in <pcache dir>/compact.log. PCCOMPACT=0 turns it off.
  # no -q, and a start and an end line with the exit code. lib/compact.sh retries rc 2 (lock still held by the exiting QEMU) for up to 30 s
  compact_detached "$R"
  [ -z "$hp" ] || wait "$hp" 2>/dev/null || hprc=$?
  # the exit status of a helper's subshell does not always survive its EXIT trap: a refusal (5) is also written to a file
  { [ "$MODE" = save ] && [ "$(cat "$R/helper.rc" 2>/dev/null)" = 5 ]; } && hprc=5
  kill_nbd "$R/nbd.pid" "$R/nbd.sock"; kill "$mh" 2>/dev/null || true
  local clean=1 refused=0
  if [ "$MODE" = save ]; then
    if [ "$hprc" = 0 ]; then sleep 2; python3 -I "$LIB/snapctl.py" finish "$SNAPNAME" "$R" "$Q" "$CPUS" "$RAM" "$extra" "$gpu" >>"$R/snapctl.log" 2>&1 || clean=0
    else python3 -I "$LIB/snapctl.py" abort "$SNAPNAME" "$R" || true; fi   # the older snapshot of this name stays as it was
  fi
  [ -z "$tp" ] || { sleep 1; kill "$tp" 2>/dev/null || true; wait "$tp" 2>/dev/null || true; }
  # the verdict: QEMU exited 0, reached --secs (timeout, 124) or was stopped by Ctrl-C/SIGTERM (130, 143), the helper succeeded (or was interrupted), the save's
  # finish step passed, and a golden boot finished. Anything else is a failure and the exit code says so.
  local rc=0
  # a helper killed by a signal (130, 143) is a failure, never a success: nothing it was doing is done. A save also needs QEMU to
  # have quit by itself (status 0), because that is how a finished save ends it.
  case $qrc in 0|124|130|143) ;; *) rc=1; echo "snapintosh: QEMU exited with status $qrc (log: $R/qemu.out)" >&2 ;; esac
  { [ "$MODE" = save ] && [ "$qrc" != 0 ]; } && { rc=1; echo "snapintosh: the snapshot was not saved: QEMU ended with status $qrc before the save finished (log: $R/qemu.out)" >&2; }
  { [ "$hprc" = 0 ] || { [ "$MODE" = save ] && [ "$hprc" = 5 ]; }; } || { rc=1; echo "snapintosh: the $MODE helper failed with status $hprc (log: $R/snapctl.log)" >&2; }
  # a save that refused because the app was not on screen says why in the log and ends with status 5, not the generic 1
  { [ "$MODE" = save ] && [ "$hprc" = 5 ]; } && {
    rc=5; echo "snapintosh: the snapshot was NOT saved: ${SAVE_APP:-Safari} was not on screen (see the SAVE refused line above); an older snapshot of this name is as it was" >&2
    case $qrc in 0|124|130|143) refused=1 ;; esac   # a refusal is an answer, not a failure of the run: its run dir is not kept 
  }
  [ "$clean" = 1 ] || { rc=1; echo "snapintosh: the $MODE did not complete (log: $R/snapctl.log)" >&2; }
  { [ "$MODE" = golden ] && ! grep -q '"ok": true' "$R/golden.json" 2>/dev/null; } && { rc=1; clean=0; }
  [ "$rc" = 0 ] || clean=0
  # a golden phase 2 overlay becomes the quiet golden only after the whole verdict is good (QEMU status included)
  if [ "$MODE" = golden ]; then
    if [ "$rc" = 0 ]; then mv "$R/root.qcow2" "$VM/golden/root-quiet.qcow2"
    else warn "phase 2 did not finish cleanly, overlay left in $R"; fi
  fi
  cleanup_reset   # nothing of this run is left: ssh master, nbd, memfd holder, QEMU
  # a run dir (aux copy, overlay, logs: 12 to 200 MB) is removed after a clean exit and kept after a failure.
  # KEEP_RUNS=1 keeps every run dir. A golden whose phase 2 failed keeps its overlay in $R (warned above).
  if { [ "$clean" = 1 ] || [ "$refused" = 1 ]; } && [ "${KEEP_RUNS:-0}" != 1 ]; then
    rm -rf "$R"; echo "done: run dir removed (KEEP_RUNS=1 keeps it)"
  else
    echo "done: $R"
    : > "$R/keep"   # a failed run's logs are wanted: reap_leftovers of a later command leaves it alone
  fi
  LAUNCH_RC=$rc
  return 0
}

cmd_bench() { # lib/benchctl.py drives `run`, `snapshot` and `resume` of this CLI and measures them
  need python3 "python3"; need ssh "openssh-client"
  case ${1:-} in -h|--help) python3 -I "$LIB/benchctl.py" --help; return 0 ;; esac
  export BENCH_IPSW_BUILD=$IPSW_BUILD SNAPINTOSH_CLI=$SELF BENCH_ROOT=$ROOT BENCH_HOME=$HOME_DIR BENCH_PREFIX=$PREFIX BENCH_VM=$VM BENCH_PCACHE=$PCACHE_DIR BENCH_SNAPS=$SNAPS
  python3 -I "$LIB/benchctl.py" "$@"
}

cmd_status() {
  echo "home:   $HOME_DIR"
  echo "prefix: $PREFIX $([ -x "$PREFIX/bin/qemu-system-aarch64" ] && echo '(qemu built)' || echo '(qemu not built)')"
  local f
  for f in "$DL"/*.ipsw; do [ -e "$f" ] && echo "ipsw:   $f ($(du -h "$f" | cut -f1))"; done
  [ -f "$PREFIX/$AMB_DIR_REL/ambrosia.bin" ] && echo "ambrosia: built" || echo "ambrosia: not built (snapintosh build --only ambrosia)"
  [ -f "$VM/disk.img" ] && echo "disk:   imported" || echo "disk:   not imported (make-disk mac-steps)"
  if [ -f "$VM/golden/root-quiet.qcow2" ]; then echo "golden: quiet (sshd + quiet profile)"
  elif [ -f "$VM/golden/root-sshd.qcow2" ]; then echo "golden: sshd (quiet profile not applied: make-disk golden --again)"
  else echo "golden: none (make-disk golden)"; fi
  for f in "$SNAPS"/*/meta.json; do [ -f "$f" ] && echo "snap:   $(basename "$(dirname "$f")")"; done
  return 0
}

# ---------------------------------------------------------------- main
sub=${1:-}
[ $# -gt 0 ] && shift
case $sub in build|fetch|make-disk|run|snapshot|resume|bench) ensure_home ;; esac
# umask 077 is for what holds guest state and secrets (it lives in $HOME_DIR, 0700). build and fetch write a toolchain prefix and a download
# directory that may be shared (SNAPINTOSH_PREFIX=/opt/snapintosh, fetch --out): normal modes there, so other users can use them
case $sub in build|fetch|_pgo-ns) umask 022 ;; esac
case $sub in
  check-host) cmd_check_host "$@" ;;
  build) cmd_build "$@" ;;
  _pgo-ns) cmd_pgo_ns "$@" ;;   # internal: the part of build --pgo that runs inside the private mount namespace
  fetch) cmd_fetch "$@" ;;
  make-disk) cmd_make_disk "$@" ;;
  run) cmd_run "$@" ;;
  snapshot) cmd_snapshot "$@" ;;
  resume) cmd_resume "$@" ;;
  bench) cmd_bench "$@" ;;
  install) cmd_install "$@" ;;
  status) cmd_status "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
