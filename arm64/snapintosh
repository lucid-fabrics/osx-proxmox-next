#!/usr/bin/env bash
# snapintosh: run arm64 macOS 27 on x86 Linux (QEMU TCG vmapple fork + Ambrosia boot firmware + reims-vgpu + metal2vulkan).
# One entry point. See README.md and docs/BLOCKERS.md.
set -euo pipefail
# Everything this tool writes (guest RAM in vm.state, overlays with the autologin password file, logs, the ssh key) is for the
# user alone: no group or other bits on anything it creates, and $HOME_DIR itself is 0700 (ensure_home).
umask 077
# bash 5.2+ treats `&` in the replacement of ${v//pat/rep} as "the matched text": a path with an `&` in it would be garbled. Off, so
# every replacement is literal (tests/test_launch.py runs a home with `&` in it).
shopt -u patsub_replacement 2>/dev/null || true
# a guest password exported in the caller's shell goes to goldenctl only (see make_disk_golden), never into the environment of QEMU, ssh or qemu-nbd
GUEST_PW=${SNAPINTOSH_GUEST_PASSWORD-}; unset SNAPINTOSH_GUEST_PASSWORD

SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=$(dirname "$SELF")
LIB=$ROOT/lib

# ---------------------------------------------------------------- config
# shellcheck source=pins.env
. "$ROOT/pins.env"
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/snapintosh/pins.env
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

ipsw_pick() { # BUILD: set IPSW_BUILD/VERSION/URL/SHA256/SIZE from the table in pins.env
  local b=$1 k
  case " $IPSW_BUILDS " in *" $b "*) ;; *) printf 'snapintosh: unknown build %s (tested: %s)\n' "$b" "$IPSW_BUILDS" >&2; exit 1 ;; esac
  IPSW_BUILD=$b
  for k in VERSION URL SHA256 SIZE; do eval "IPSW_$k=\${IPSW_${b}_$k}"; done
}
ipsw_pick "$IPSW_DEFAULT"

HOME_DIR=${SNAPINTOSH_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/snapintosh}
PREFIX=${SNAPINTOSH_PREFIX:-$HOME_DIR/prefix}
SRC=$HOME_DIR/src
BUILD=$HOME_DIR/build
DL=$HOME_DIR/dl
VM=$HOME_DIR/vm
PCACHE_DIR=$HOME_DIR/pcache
SNAPS=${SNAPS:-$HOME_DIR/snaps}
RUNS=$HOME_DIR/runs
KNOWN_HOSTS=$HOME_DIR/known_hosts   # the guest's ssh host key, pinned on first use (accept-new); removed when a new golden is made
export SNAPS
export SNAPINTOSH_KNOWN_HOSTS=$KNOWN_HOSTS

# rustup puts cargo, rustc and rustup in ~/.cargo/bin and only a login shell's profile adds that to PATH: a non-interactive ssh or cron
# does not, so check-host and build would report the tools missing. Appended last, so a cargo that is on PATH still wins.
cargo_bin=${CARGO_HOME:-$HOME/.cargo}/bin
case ":$PATH:" in *":$cargo_bin:"*) ;; *) [ ! -d "$cargo_bin" ] || PATH=$PATH:$cargo_bin ;; esac
export PATH

ensure_home() { mkdir -p "$HOME_DIR" && chmod 700 "$HOME_DIR"; }

# A snapshot name becomes a directory under $SNAPS and part of shell strings: letters, digits, dot, underscore, dash (1 to 64),
# first one a letter or digit, no "..". lib/snapctl.py checks the same rule again before it builds any path.
valid_snapname() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] && [[ $1 != *..* ]]; }

# the guest's machine id is the one the lab used (ECID inside machineid.bin), read at run time
SSH_PORT_DEFAULT=10022
AMB_DIR_REL=share/snapintosh/ambrosia   # under $PREFIX: ambrosia.bin and config.cpio, written by build

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_ylw=$'\033[33m'; c_off=$'\033[0m'
[ -t 1 ] || { c_red=; c_grn=; c_ylw=; c_off=; }
ok()   { printf '%s[ok]%s   %s\n' "$c_grn" "$c_off" "$*"; }
warn() { printf '%s[warn]%s %s\n' "$c_ylw" "$c_off" "$*"; NWARN=$((NWARN + 1)); }
bad()  { printf '%s[FAIL]%s %s\n' "$c_red" "$c_off" "$*"; NFAIL=$((NFAIL + 1)); }
info() { printf '       %s\n' "$*"; }
die()  { printf 'snapintosh: %s\n' "$*" >&2; exit 1; }
NWARN=0; NFAIL=0

DRY=${SNAPINTOSH_DRY:-0}

# One cleanup for every command path that starts a process or makes a resource. Arrays are global because the EXIT trap runs
# after the function that filled them has returned. A path calls `cl_trap` BEFORE it creates its first resource, registers what it
# starts (`track PID` for every background process, CL_NBDPID/CL_NBDSOCK for the qemu-nbd daemon, CL_CTLS, CL_RMDIR, CL_ABORT),
# and `cleanup_reset` clears it all when the path ends normally.
# Ctrl-C or SIGTERM runs cleanup_all and then EXITS with 128+signal (it used to carry on waiting for a helper that nobody stopped).
# A pid is never trusted on its own: `track` stores the process start time with it, and the qemu-nbd daemon (only known through the
# pid file it writes) is killed only when /proc says its command line is qemu-nbd on our socket.
pstate() { sed 's/^.*) \(.\).*$/\1/' "/proc/$1/stat" 2>/dev/null; }     # R S D T Z ... , empty when the process is gone
pstart() { sed 's/^.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $20}'; }   # start time in clock ticks since boot
# dec_into VAR VALUE NAME [UNIT]: VAR gets VALUE as a plain base 10 number. Bash reads 08 or 0900 inside $(( )) as octal (an error, or a quietly
# different number), so every number the CLI does arithmetic on goes through here: digits only, at most 9, and 10# does the rest.
dec_into() {
  [[ $2 =~ ^[0-9]{1,9}$ ]] || die "$3=$2: expected a number${4:+ of $4} (digits only, for example 600)"
  printf -v "$1" %s "$((10#$2))"
}
pidns() { readlink "/proc/${1:-$$}/ns/pid" 2>/dev/null | tr -cd '0-9'; }   # inode of the pid namespace, empty when /proc does not say
PIDNS=$(pidns)
plive() { local s; s=$(pstate "$1") || true; [ -n "$s" ] && [ "$s" != Z ]; }
children() { pgrep -P "$1" 2>/dev/null || true; }
# stop_tree PID: stop the process and everything below it. first FREEZE the tree (SIGSTOP: a stopped process forks nothing), re-listing
# until a whole pass finds no new member, so a child that is being forked at the moment of the signal (the settime `timeout` and its python
# helper) cannot slip past the list and outlive its parent. Then TERM, CONT (a stopped process acts on TERM only once it runs),
# and KILL what is still there after 4 s.
stop_tree() {
  local all=" $1 " p c i left new=1
  kill -STOP "$1" 2>/dev/null || true
  while [ "$new" = 1 ]; do
    new=0
    for p in $all; do
      for c in $(children "$p"); do
        case $all in *" $c "*) ;; *) all="$all$c "; kill -STOP "$c" 2>/dev/null || true; new=1 ;; esac
      done
    done
  done
  for p in $all; do kill -TERM "$p" 2>/dev/null || true; kill -CONT "$p" 2>/dev/null || true; done
  for i in $(seq 40); do
    left=0; for p in $all; do ! plive "$p" || left=1; done
    [ "$left" = 0 ] && return 0
    sleep 0.1
  done
  for p in $all; do kill -9 "$p" 2>/dev/null || true; done
}
CL_PIDS=(); CL_CTLS=(); CL_RMDIR=""; CL_P1=""; CL_NBDPID=""; CL_NBDSOCK=""; CL_ABORT=(); CL_RMRUN=""; CL_RUN=""; CL_COMPACT=""; CL_PGO=""
# compact_detached RUNDIR: Starts the detached pack compactor (CL_COMPACT = qemu-pcache-compact, set by `launch` when it applies) for the pack
# the QEMU of RUNDIR had open read-write, once. It runs on a normal end AND from cleanup_all: before this fix a Ctrl-C or SIGTERM (how a user ends a VM)
# left the trap without compacting, so a pack that was only ever ended that way grew to its 8 GiB limit, where every new translation is then dropped
# for the rest of each boot (found by the size-cap measurement). The compactor waits for the pack lock (lib/compact.sh), so QEMU may still be exiting.
compact_detached() {
  local pck
  [ -n "$CL_COMPACT" ] && [ -n "$1" ] || return 0
  pck=$(sed -n 's/.*pcache: \(\/[^ ,]*\.pack\), rw,.*/\1/p' "$1/qemu.out" 2>/dev/null | head -1) || true
  [ -z "$pck" ] || ( setsid nohup sh "$LIB/compact.sh" "$pck" "$CL_COMPACT" >>"$PCACHE_DIR/compact.log" 2>&1 </dev/null & )
  CL_COMPACT=""
}
track() { local st; st=$(pstart "$1") || true; [ -z "$st" ] || CL_PIDS+=("$1:$st"); }
kill_nbd() { # PIDFILE SOCKET: the qemu-nbd this run started, and nothing else (a stale pid file may name any process)
  local p c
  [ -n "$1" ] || return 0
  p=$(cat "$1" 2>/dev/null || true); [[ $p =~ ^[0-9]+$ ]] || return 0
  c=$(tr '\0' ' ' 2>/dev/null < "/proc/$p/cmdline" || true)   # 2> first: a missing file's error comes from the redirection
  case $c in *qemu-nbd*"$2"*) kill "$p" 2>/dev/null || true ;; esac
}
# run_procs RUNDIR [MINSTART]: the processes of this user that belong to a run directory, found by what they were started with (a helper, the
# `timeout` wrapper and QEMU, memfdhold, the progress tail, the ssh master), not by who their parent is. a Ctrl-C or SIGTERM sent
# to the whole process group kills the helper's subshell before our trap runs, and what it had started (the settime `timeout` has its own process
# group, so the group signal misses it) is then a child of init, which no walk down from a tracked pid finds. The run dir is unique to this run.
# With MINSTART (reap_stale) only processes of OUR pid namespace that started at or after that clock tick are listed: a process of another
# namespace (a container that shares the home) can show the same run dir without being ours to kill.
# The ssh ControlPersist master renames itself ("ssh: RUNDIR/ssh.ctl [mux]"), so for it the whole cmdline is one string.
# A process that exits during the scan is skipped without a word: every read of /proc/PID is in a group that discards its errors.
run_procs() {
  local p a s c
  local -a av
  for p in /proc/[0-9]*; do
    p=${p#/proc/}
    [ "$p" != "$$" ] && [ -O "/proc/$p" ] 2>/dev/null || continue
    av=(); { mapfile -d '' -t av < "/proc/$p/cmdline"; } 2>/dev/null || continue
    [ "${#av[@]}" -ge 1 ] || continue
    case ${av[0]} in "ssh: "*) c=ssh: ;; *) c=${av[0]##*/} ;; esac   # the title of the ControlPersist master has a "/" in it
    case $c in
      timeout|python3|python|qemu-system-aarch64|ssh) [ "${#av[@]}" -gt 1 ] || continue ;;
      "ssh:") ;;
      tail) [ "${av[1]-}" = -n ] && [ "${av[3]-}" = -F ] || continue ;;   # only the one we start: tail -n +1 -F RUNDIR/snapctl.log
      *) continue ;;
    esac
    for a in "${av[@]}"; do
      case $a in "$1"|"$1"/*|*:"$1"/*|*=*"$1"/*|"ssh: $1"/*) ;; *) continue ;; esac
      if [ -n "${2:-}" ]; then
        [ -n "$PIDNS" ] && [ "$(pidns "$p")" = "$PIDNS" ] || break
        s=$(pstart "$p"); [[ $s =~ ^[0-9]+$ ]] && [ "$s" -ge "$2" ] || break
      fi
      echo "$p"; break
    done
  done
}
stop_run_procs() { local p; for p in $(run_procs "$1"); do stop_tree "$p"; done; }
# reap_stale RUNS: . A snapintosh that was SIGKILLed (or lost its `timeout` wrapper before pdeath.py existed) can leave its QEMU
# and helpers running, holding the ssh port and the pack lock. A run dir is stale when its cli.pid ("PID:START:PIDNS", written by the run) names
# a snapintosh of THIS pid namespace that is gone (pid plus start time, so a reused pid does not count). Only a process of this namespace that
# started after that snapintosh did is stopped. Everything else is skipped and said: a run dir of another namespace (a container with the same
# home), an old cli.pid without a namespace, a run dir without cli.pid, a process that does not provably belong to the dead run.
# A run of a live snapintosh (a second run on another port) is left alone. The run dir stays for its logs.
# QEMU and helpers are also started outside $RUNS, by golden phase 1 in $VM/golden/tmp (it writes the same cli.pid). Every
# directory that holds a cli.pid and a run's processes is passed as an extra argument, so the same rules cover it.
reap_stale() {
  local rd cp st ns pids all p
  for rd in "$1"/*/ "${@:2}"; do
    rd=${rd%/}; [ -d "$rd" ] || continue
    all=$(run_procs "$rd" | tr '\n' ' '); case $all in *[0-9]*) ;; *) continue ;; esac
    if [ ! -f "$rd/cli.pid" ]; then reap_skip "$rd" "$all" "it has no cli.pid, so nothing proves it is from a dead run"; continue; fi
    cp=$(cat "$rd/cli.pid" 2>/dev/null || true); st=${cp#*:}; cp=${cp%%:*}; ns=""
    case $st in *:*) ns=${st#*:}; st=${st%%:*} ;; esac
    if ! [[ $cp =~ ^[0-9]+$ && $st =~ ^[0-9]+$ ]]; then reap_skip "$rd" "$all" "its cli.pid is unreadable"; continue; fi
    if [ -z "$ns" ] || [ -z "$PIDNS" ]; then reap_skip "$rd" "$all" "its cli.pid does not record a pid namespace"; continue; fi
    if [ "$ns" != "$PIDNS" ]; then reap_skip "$rd" "$all" "its snapintosh ran in another pid namespace (a container?)"; continue; fi
    [ "$(pstart "$cp")" != "$st" ] || continue   # its snapintosh still lives
    pids=$(run_procs "$rd" "$st" | tr '\n' ' ')
    for p in $all; do case " $pids " in *" $p "*) ;; *) reap_skip "$rd" "$p" "it is not provably from that run (other namespace or started before it)" ;; esac; done
    case $pids in *[0-9]*) ;; *) continue ;; esac
    echo "snapintosh: stopping pid(s) ${pids% } of an earlier snapintosh that died (run dir $rd); they could still hold the ssh port and the pack lock" >&2
    for p in $pids; do stop_tree "$p"; done
    kill_nbd "$rd/nbd.pid" "$rd/nbd.sock"
    ssh -o "ControlPath=\"$rd/ssh.ctl\"" -O exit root@127.0.0.1 >/dev/null 2>&1 || true
  done
  return 0
}
# reap_leftovers RUNS: . reap_stale stops what a dead snapintosh left running; this removes what it left on disk. A run dir
# whose cli.pid names a dead snapintosh of this pid namespace (the proof cli_dead gives) and that no process still names is removed, and with
# it the `.stage-*` of its save (the guest RAM, 4 GiB) and `.old-*` in the snapshot dir; the same files whose run dir is long gone go too
# (snapctl.py reap). A run dir with a `keep` marker (golden, KEEP_RUNS=1: its files are wanted) stays. Said on stderr, never fatal.
reap_leftovers() {
  local rd b dead=()
  for rd in "$1"/*/; do
    rd=${rd%/}; [ -d "$rd" ] || continue
    { [ -f "$rd/cli.pid" ] && cli_dead "$rd"; } || continue
    [ -z "$(run_procs "$rd")" ] || continue   # something of it still runs and was not provably ours (reap_stale said so): leave it all
    dead+=("${rd##*/}")
  done
  python3 -I "$LIB/snapctl.py" reap "$1" "$([ "$SNAPS" = "$HOME_DIR/snaps" ] && echo 1 || echo 0)" "${dead[@]}" >&2 || true
  for b in "${dead[@]}"; do
    [ -f "$1/$b/keep" ] && continue
    echo "snapintosh: removed run dir $1/$b of an earlier snapintosh that died" >&2
    rm -rf "${1:?}/$b"
  done
  return 0
}
# cli_dead DIR: true when DIR/cli.pid names a snapintosh of this pid namespace that is gone (pid plus start tick), the same proof reap_stale uses
cli_dead() {
  local cp st
  cp=$(cat "$1/cli.pid" 2>/dev/null || true); st=${cp#*:}; cp=${cp%%:*}
  [ -n "$PIDNS" ] && [ "${st##*:}" = "$PIDNS" ] || return 1
  st=${st%%:*}; [[ $cp =~ ^[0-9]+$ && $st =~ ^[0-9]+$ ]] || return 1
  [ "$(pstart "$cp")" != "$st" ]
}
reap_skip() { echo "snapintosh: skipped pid(s) ${2% } that name run dir $1: $3; stop them yourself if they are stale" >&2; }
cleanup_all() {
  local x p st i
  [ -z "${CL_RUN:-}" ] || compact_detached "$CL_RUN"   # before anything is removed: it reads the run dir's qemu.out
  for x in "${CL_CTLS[@]}"; do ssh -o "ControlPath=\"$x\"" -O exit root@127.0.0.1 >/dev/null 2>&1 || true; done
  # newest first: the progress tail and the helper stop before QEMU does (a helper that loses its QEMU first prints a traceback)
  for ((i = ${#CL_PIDS[@]} - 1; i >= 0; i--)); do x=${CL_PIDS[i]}; p=${x%%:*}; st=${x#*:}; if [ "$(pstart "$p")" = "$st" ]; then stop_tree "$p"; fi; done
  [ -z "${CL_PGO:-}" ] || { pgo_stop_ns "$CL_PGO"; pgo_unstage; }      # a --pgo build: what its namespace still holds, even if the tree walk above missed it
  [ -z "${CL_RUN:-}" ] || stop_run_procs "$CL_RUN"   # what is left of this run even if its parent died first (see run_procs)
  kill_nbd "$CL_NBDPID" "$CL_NBDSOCK"
  # a save that did not finish: its staging directory goes (the helper is stopped above, so nothing writes into it any more)
  if [ "${#CL_ABORT[@]}" = 2 ]; then python3 -I "$LIB/snapctl.py" abort "${CL_ABORT[0]}" "${CL_ABORT[1]}" >/dev/null 2>&1 || true; fi
  [ -z "$CL_RMRUN" ] || rm -rf "$CL_RMRUN"
  [ -z "$CL_RMDIR" ] || rmdir "$CL_RMDIR" 2>/dev/null || true
  # make-disk golden phase 1 that did not finish: keep the overlay under another name, never as a golden
  if [ -n "$CL_P1" ] && [ -f "$CL_P1" ]; then mv "$CL_P1" "${CL_P1%.qcow2}.failed.qcow2" 2>/dev/null || true; fi
  return 0
}
on_signal() { trap - EXIT INT TERM HUP; cleanup_all; exit "$1"; }
cl_trap() { trap cleanup_all EXIT; trap 'on_signal 130' INT; trap 'on_signal 143' TERM; trap 'on_signal 129' HUP; }
# a normal end first forgets CL_P1: cleanup_all renames that overlay to .failed, which made every successful phase 1 of make-disk golden
# throw its own result away ("no golden image" at phase 2)
cleanup_reset() { CL_P1=""; CL_RMRUN=""; CL_ABORT=(); cleanup_all; CL_PIDS=(); CL_CTLS=(); CL_RMDIR=""; CL_P1=""; CL_NBDPID=""; CL_NBDSOCK=""; CL_ABORT=(); CL_RUN=""; CL_COMPACT=""; CL_PGO=""; trap - EXIT INT TERM HUP; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing tool: $1 ($2)"; }

install_die() { printf 'snapintosh: %s\n' "$*" >&2; exit 2; }
install_path_ok() { [[ $1 =~ ^/[A-Za-z0-9._@+/-]+$ ]] && [[ $1 != *..* ]]; }
# install: restore macOS into a raw disk with no Mac, using the restore host in lib/install. --dry-run prints the
# restore plan and the QEMU command and writes nothing. Without it the pipeline runs: 0 is installed, 3 is
# install-pending (the restore ended Status 0 but the first-boot LocalPolicy is not there yet; pass --policy FILE
# once mkpolicy-hack.py made it), 2 is a bad input and anything else is the pipeline's own status. The first boot
# still needs the policy and the Ambrosia patch, see lib/install/README.md.
cmd_install() {
  local ipsw="" aux="" ecid="" disk="" policy="" dry=0 tss=0 f w runs R qemu bundle ramdisk ambrosia rc
  while [ $# -gt 0 ]; do
    case $1 in
      --ipsw) ipsw=${2:-}; shift ;;
      --aux) aux=${2:-}; shift ;;
      --ecid) ecid=${2:-}; shift ;;
      --disk) disk=${2:-}; shift ;;
      --policy) policy=${2:-}; shift ;;
      --tss) tss=1 ;;
      --dry-run) dry=1 ;;
      -h|--help) usage; return 0 ;;
      *) install_die "unknown option $1 (install takes --ipsw --aux --ecid --disk [--policy] [--tss] [--dry-run])" ;;
    esac
    shift
  done
  if [ -z "$ipsw" ]; then
    for f in "$DL"/*.ipsw; do if [ -f "$f" ]; then ipsw=$f; fi; done
    if [ -z "$ipsw" ]; then install_die "no IPSW under $DL: snapintosh fetch, or pass --ipsw FILE"; fi
  fi
  if [ -z "$aux" ]; then aux=$VM/aux.img; fi
  if [ -z "$ecid" ] && [ -f "$VM/machineid.bin" ]; then ecid=$(ecid); fi
  if [ -z "$ecid" ]; then install_die "no ECID: pass --ecid N (the machine uuid the restore is personalized for)"; fi
  if [ -z "$disk" ]; then disk=$VM/install.raw; fi
  install_path_ok "$ipsw" || install_die "--ipsw: an absolute path of letters, digits and . _ + @ / - (no ..)"
  install_path_ok "$aux" || install_die "--aux: an absolute path of letters, digits and . _ + @ / - (no ..)"
  install_path_ok "$disk" || install_die "--disk: an absolute path of letters, digits and . _ + @ / - (no ..)"
  [ -f "$ipsw" ] || install_die "no such IPSW: $ipsw"
  [ -f "$aux" ] || install_die "no such aux image: $aux (the Mac step writes it, or pass --aux FILE)"
  { [[ $ecid =~ ^[0-9]{1,20}$ ]] && python3 -I -c 'import sys; raise SystemExit(not 0 < int(sys.argv[1]) < 2**64)' "$ecid"; } \
    || install_die "--ecid (ECID): decimal digits (at most 20), not 0 and below 2^64"
  if [ -d "$disk" ]; then install_die "--disk is a directory: $disk"; fi
  if [ -n "$policy" ]; then
    install_path_ok "$policy" || install_die "--policy: an absolute path of letters, digits and . _ + @ / - (no ..)"
    [ -f "$policy" ] || install_die "no such policy image: $policy"
  fi
  w=${SNAPINTOSH_INSTALL_BUNDLE:-$HOME_DIR/install/bundle}
  runs=${SNAPINTOSH_INSTALL_RUNS:-$HOME_DIR/install/runs}
  R=$runs/install
  qemu=${QEMU:-$PREFIX/bin/qemu-system-aarch64}
  bundle=${BUNDLE:-$w/restore.cpio}
  ramdisk=${RAMDISK:-$w/restore-ramdisk.im4p}
  ambrosia=${AMBROSIA:-$w/ambrosia-r4.bin}
  local extra="-chardev socket,id=vusb,path=$R/vusb.sock,server=on,wait=off -device vmapple-virtio-usb-pci,chardev=vusb"
  if [ "$dry" = 1 ]; then
    echo "restore plan (dry run, nothing is written)"
    echo "  ipsw:   $ipsw"
    echo "  aux:    $aux (its first 16384 bytes become the NVRAM bank)"
    echo "  ecid:   $ecid"
    echo "  disk:   $disk ($(if [ -s "$disk" ]; then echo reused; else echo made; fi))"
    if [ -n "$policy" ]; then echo "  policy: $policy (added to the restore bundle as local-policy.img4)"; fi
    echo "  run:    $R"
    echo "  1. drop the aux's first 16 KiB into $R/aux"
    echo "  2. make the raw disk when it is missing"
    echo "  3. boot Ambrosia's restore mode; restored drives m2bhost.py over the virtio USB port"
    echo "  4. answer the data requests from the IPSW and Apple's TSS, stop QEMU at the guest's StatusMsg"
    echo "QEMU command:"
    QEMU=$qemu AUX=$aux DISK=$disk ECID=$ecid BUNDLE=$bundle RAMDISK=$ramdisk AMBROSIA=$ambrosia \
      SNAPINTOSH_INSTALL_RUNS=$runs EXTRA=$extra bash "$LIB/install/run-restore.sh" --print install
    return 0
  fi
  [ -x "$qemu" ] || install_die "QEMU not built: snapintosh build (with the qemu-m2b patches, see pins.env)"
  [ -f "$bundle" ] || install_die "no restore bundle at $bundle (see lib/install/README.md)"
  [ -f "$ramdisk" ] || install_die "no restore ramdisk at $ramdisk (see lib/install/README.md)"
  [ -f "$ambrosia" ] || install_die "no Ambrosia restore build at $ambrosia (see lib/install/README.md)"
  ensure_home; mkdir -p "$runs" "$w"
  if [ -n "$policy" ]; then
    python3 -I "$LIB/install/mkbundle.py" "$bundle" "$w/restore-policy.cpio" "local-policy.img4=$policy" \
      || install_die "could not add the policy to the restore bundle"
    bundle=$w/restore-policy.cpio
  fi
  export QEMU AUX=$aux DISK=$disk ECID=$ecid BUNDLE=$bundle RAMDISK=$ramdisk AMBROSIA=$ambrosia IPSW=$ipsw
  export SNAPINTOSH_INSTALL_RUNS=$runs EXTRA=$extra
  local -a targs=()
  if [ "$tss" = 1 ]; then targs+=(--tss); fi
  rc=0
  bash "$LIB/install/go.sh" install "${targs[@]}" || rc=$?
  if [ "$rc" = 0 ] && [ -z "$policy" ]; then
    echo "install-pending: the restore ended Status 0, but the first boot still needs the LocalPolicy" >&2
    echo "  build it with lib/install/mkpolicy-hack.py, then pass --policy FILE to snapintosh install" >&2
    exit 3
  fi
  if [ "$rc" != 0 ]; then
    echo "snapintosh: install failed with status $rc (logs: $R/host.out, $R/qemu.out)" >&2
    exit "$rc"
  fi
  ok "installed: $disk"
}

usage() {
  cat <<'EOF'
usage: snapintosh <command> [options]

  check-host                 CPU, RAM, disk, Vulkan device and extensions, udmabuf limits
  build [--only X] [-j N] [--pgo]
                             build reims-vgpu + metal2vulkan, the QEMU fork and Ambrosia (X: reims, qemu, ambrosia, mesa).
                             --pgo (opt-in, off by default): build QEMU with profile-guided optimisation and full LTO. It trains on a boot
                             of your golden, so it needs a working build and a golden first and takes about 50 minutes on 6 cores, up to 4 h at its bounds (README)
  build --deps [--apt]       print the Debian/Ubuntu packages and the cross toolchain the build needs (--apt: package names only, one per line)
  fetch [--build B] [--url U [--sha256 H]] [--out D]
                             download the macOS 27 IPSW from Apple (resumable). The pinned builds are checked for size and sha256;
                             a --url file is checked for the size the server announces, and for the hash when you pass --sha256.
                             B: 26A428 (27.0, default, the lab build) or 26B131 (27.2.1, supported, not booted by us)
  make-disk <step>           IPSW to a bootable disk:
      mac-steps [--build B]    print the steps that need a Mac (they cannot be done on Linux)
      import DIR [--avpbooter F]   import what the Mac produced (disk.img aux.img machineid.bin hardwaremodel.bin);
                               AVPBooter is only for the legacy --fw avp path
      adopt-golden FILE [--ssh-state DIR] [--name quiet|sshd]
                               use an existing golden (a qcow2 overlay chain on the same disk.img, for example a lab
                               root-quiet3.qcow2) instead of making one: copies the chain, rebases it onto the imported
                               disk, copies the ssh key. No Mac, no single-user boot
      golden [BASE] [--no-quiet] [--again] [--warm N] [--user U] [--password-file F] [run options: --cpus --ram --gpu --icd --mesa --ssh-port --secs]
                               make the tuned golden from the installed disk, no Mac and no manual step: phase 1 is a
                               single-user boot (root ssh key, sshd job with ProcessType Interactive, timed fix, autologin
                               fallback), phase 2 one normal boot over ssh (quiet profile). BASE is read only
                               (default: the imported disk.img). --again redoes phase 2 only. --user is the account for
                               autologin (default snap, a macOS short name); its password (default snaplab) is read from
                               --password-file or the environment variable SNAPINTOSH_GUEST_PASSWORD, never from the command line. Both boots fill the
                               translation cache; --warm N (default 0 = off) then boots the finished golden N times
                               to the desktop, opens and quits Safari, so the first `run` starts warm
      warm [N] [run options]   the warm-up boots alone, for a golden that came from adopt-golden or an old make-disk golden
      sshd-interactive         optional: sshd job ProcessType Interactive, notes and guest script
      quiet                    optional: the quiet guest profile over ssh (faster boot), notes
  run [options]              boot the guest with the default settings (Ambrosia, 12 vCPUs, IOFence patch, DSB skips, ARP seed)
  snapshot NAME [options]    boot, wait for ssh, save a snapshot, quit
  resume NAME [options]      restore a snapshot
  install --ipsw F --aux F --ecid N --disk F [--policy F] [--tss] [--dry-run]
                             restore macOS into a raw disk with no Mac, over the virtio USB restore host (lib/install).
                             --dry-run prints the restore plan and the QEMU command and writes nothing. 0 is installed,
                             3 is install-pending (restore done, first-boot LocalPolicy still needed: --policy),
                             other is a failure. --tss allows the requests to Apple's TSS; the first boot and the
                             Ambrosia patch remain, see lib/install/README.md
  bench [options]            measure boot to ssh and Dock, Safari cold launch, drag fps, resume time and Safari from a resume:
                             N runs (--runs, default 3), JSON plus a table with median and spread, host info (see README).
                             --save-settle S (default 120) is the snapshot settle; all options: bench --help
  status                     show what is installed

run/snapshot/resume options:
  --cpus N        guest vCPUs (default 12)       --ram SIZE   guest RAM (default 8G)
  --fw ambrosia|avp   boot firmware (default ambrosia; avp = legacy AVPBooter path, needs AVPBooter from your Mac)
  --gpu auto|0|1  1 = host Vulkan GPU, 0 = lavapipe (default auto: 1 if a non-CPU device exists)
  --icd FILE      Vulkan ICD json for --gpu 1 (default: the first non-llvmpipe one found)
  --mesa DIR      Mesa prefix with lavapipe for --gpu 0 (default: the one `build --only mesa` made)
  --vnc [PORT]    VNC on 127.0.0.1 (default 5900, loopback only) with a random password: the file is <run dir>/vnc.pass (mode 600,
                  the path is printed). The guest logs in as an admin by itself, so an open VNC port would hand that desktop to every local user
  --vnc-insecure  with --vnc: no password (any local user can connect)
  --ssh-port P    host port forwarded to guest sshd (default 10022)
  --secs N        stop after N seconds (default 3600)
  --settle N      snapshot only: seconds between the first ssh answer and the save (default 60). Open Safari or anything
                  else you want in the snapshot inside that window; the page must be drawn before the save
  --open URL      snapshot only: open URL in Safari for you (after the Dock and Finder are up, through the robust open helper) and
                  require its window on screen at the save. Implies --app Safari. The URL may not contain & (one query parameter at most)
  --app NAME      snapshot only: the app that must be on screen at the save: wait for its window (at most APPWAIT s, default 180), and
                  refuse the save with status 5 when it never shows. Without --app, a running Safari is checked and a miss only warns
  --no-pcache     do not use the persistent translation cache
  --pcache-ro     use the cache without appending to it
  --dry-run       print the QEMU command and exit
